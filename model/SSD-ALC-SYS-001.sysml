        part def <'PHY-CT-04'> PHY_CT_04 { doc /* Ku帯電子アセンブリ（EA1・EA2）（数量：2、通信・追跡（C&T）） */ }
        part def <'PHY-CT-05'> PHY_CT_05 { doc /* UHF送受信機（ATC送受信機）（数量：1（IFM配置図の箱数）、通信・追跡（C&T）） */ }
        part def <'PHY-CT-06'> PHY_CT_06 { doc /* ACCU（音声中央制御装置）（数量：1箱（内部に冗長なACCU 2系統）、通信・追跡（C&T）） */ }
        part def <'PHY-CT-07'> PHY_CT_07 { doc /* S 帯の信号処理・増幅機器（プリアンプ・電力増幅器・アンテナ切替・NSP・COMSEC・FM 信号処理器・FM 送信機・GCIL）（数量：プリアンプ 2・電力増幅器 2・アンテナ切替 1・NSP 2・COMSEC 1・FM 信号処理器 2・FM 送信機 2・GCIL 1、通信・追跡（C&T）） */ }
        part def <'PHY-CT-08'> PHY_CT_08 { doc /* S 帯 FM 半球アンテナ・UHF 下面アンテナ（数量：半球アンテナ 2・UHF アンテナ 1、通信・追跡（C&T）） */ }
        part def <'PHY-CT-09'> PHY_CT_09 { doc /* Ku 帯信号処理器（KuSP）（数量：1、通信・追跡（C&T）） */ }
        part def <'PHY-CT-10'> PHY_CT_10 { doc /* PCMMU（PCM マスタユニット）（数量：2、通信・追跡（C&T）） */ }
        part def <'PHY-CT-11'> PHY_CT_11 { doc /* SSOR（宇宙対宇宙オービタ無線）と SSOR アンテナ（数量：SSOR 2・アンテナ 2、通信・追跡（C&T）） */ }
