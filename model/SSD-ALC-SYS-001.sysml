        part def <'PHY-DPS-03'> PHY_DPS_03 { doc /* MDM（マルチプレクサ／デマルチプレクサ）（数量：オービタ20（DPS用13・OI用7）＋SRB用4、データ処理系（DPS）） */ }
        part def <'PHY-DPS-04'> PHY_DPS_04 { doc /* IDP（統合表示処理装置、MEDS）（数量：4（ほかにMDU 11・ADC 4・キーボード3）、データ処理系（DPS）） */ }
        part def <'PHY-DPS-05'> PHY_DPS_05 { doc /* MTU（マスタタイミングユニット）（数量：1（内部に発振器2）、データ処理系（DPS）） */ }
        part def <'PHY-DPS-06'> PHY_DPS_06 { doc /* データバス網（飛行重要 FC1〜8・ペイロード・打上げ・大容量記憶・表示/キーボード・計装/PCMMU・計算機間通信）（数量：1式（バス 28本）、データ処理系（DPS）） */ }
        part def <'PHY-DPS-07'> PHY_DPS_07 { doc /* EIU（エンジンインタフェースユニット）・MEC（マスターイベントコントローラ）（数量：EIU 3・MEC 2、データ処理系（DPS）） */ }
        part def <'PHY-GNC-01'> PHY_GNC_01 { doc /* IMU（慣性計測装置）（数量：3、誘導・航法・制御（GN&C）） */ }
        part def <'PHY-GNC-02'> PHY_GNC_02 { doc /* スタートラッカ（ST）（数量：2（−Y軸用・−Z軸用）、誘導・航法・制御（GN&C）） */ }
        part def <'PHY-GNC-03'> PHY_GNC_03 { doc /* TACAN（戦術航法装置）／GPS受信機（数量：TACAN 3（三重GPS未改修機）／GPS受信機3（OV-105）、誘導・航法・制御（GN&C）） */ }
