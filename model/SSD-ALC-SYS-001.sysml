    // ---- 振る舞いの割付：活動図の行動 → 部品、シーケンス図の生存線 → 部品
    package BehaviorAllocation {
        doc /* 活動・シーケンスの定義ごとに使用（action・occurrence）を置き、その中の行動・生存線を割り付ける */
        action mpsHeliumLeakResponse : SSD_BEH_ORB_002::MpsHeliumLeakResponse;
        action fuelCellCoolingLossResponse : SSD_BEH_ORB_002::FuelCellCoolingLossResponse;
