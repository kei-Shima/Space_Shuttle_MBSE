        part def <'PHY-GNC-05'> PHY_GNC_05 { doc /* MLS（マイクロ波着陸システム。F-GNC-01とIFMの表記はMSBLS）（数量：3（各セットはKu帯受信送信機と復号器）、誘導・航法・制御（GN&C）） */ }
        part def <'PHY-GNC-06'> PHY_GNC_06 { doc /* ATVC（上昇推力方向制御装置）（数量：4、誘導・航法・制御（GN&C）） */ }
        part def <'PHY-RCS-01'> PHY_RCS_01 { doc /* 前部RCS噴射器（主噴射器・バーニア噴射器）（数量：16（主14、バーニア2）、姿勢制御系（RCS）） */ }
