        allocate Functions::FN_ET_ITK::F_ET_ITK_02 to context.sts.et.itk;
        allocate Functions::FN_ET_ITK::F_ET_ITK_03 to context.sts.et.itk;
        allocate Functions::FN_ET_ITK::F_ET_ITK_04 to context.sts.et.itk;
        allocate Functions::FN_ET_ITK::F_ET_ITK_05 to context.sts.et.itk;
        allocate Functions::FN_ET_ITK::F_ET_ITK_06 to context.sts.et.itk;
        allocate Functions::FN_ET_LH2::F_ET_LH2_01 to context.sts.et.lh2;
        allocate Functions::FN_ET_LH2::F_ET_LH2_02 to context.sts.et.lh2;
        allocate Functions::FN_ET_LH2::F_ET_LH2_03 to context.sts.et.lh2;
        allocate Functions::FN_ET_LH2::F_ET_LH2_04 to context.sts.et.lh2;
        allocate Functions::FN_ET_LH2::F_ET_LH2_05 to context.sts.et.lh2;
        allocate Functions::FN_ET_LH2::F_ET_LH2_06 to context.sts.et.lh2;
        allocate Functions::FN_ET_LOX::F_ET_LOX_01 to context.sts.et.lox;
        allocate Functions::FN_ET_LOX::F_ET_LOX_02 to context.sts.et.lox;
        allocate Functions::FN_ET_LOX::F_ET_LOX_03 to context.sts.et.lox;
        allocate Functions::FN_ET_LOX::F_ET_LOX_04 to context.sts.et.lox;
        allocate Functions::FN_ET_LOX::F_ET_LOX_05 to context.sts.et.lox;
        allocate Functions::FN_ET_LOX::F_ET_LOX_06 to context.sts.et.lox;
        allocate Functions::FN_ET_LOX::F_ET_LOX_07 to context.sts.et.lox;
        allocate Functions::FN_ET_SEP::F_ET_SEP_01 to context.sts.et.sep;
        allocate Functions::FN_ET_SEP::F_ET_SEP_02 to context.sts.et.sep;
        allocate Functions::FN_ET_SEP::F_ET_SEP_03 to context.sts.et.sep;
        allocate Functions::FN_ET_SEP::F_ET_SEP_04 to context.sts.et.sep;
        allocate Functions::FN_ET_SEP::F_ET_SEP_05 to context.sts.et.sep;
        allocate Functions::FN_ET_SEP::F_ET_SEP_06 to context.sts.et.sep;
        allocate Functions::FN_ET_SEP::F_ET_SEP_07 to context.sts.et.sep;
        allocate Functions::FN_ET_TPS::F_ET_TPS_01 to context.sts.et.tps;
        allocate Functions::FN_ET_TPS::F_ET_TPS_02 to context.sts.et.tps;
        allocate Functions::FN_ET_TPS::F_ET_TPS_03 to context.sts.et.tps;
        allocate Functions::FN_ET_TPS::F_ET_TPS_04 to context.sts.et.tps;
        allocate Functions::FN_ET_TPS::F_ET_TPS_05 to context.sts.et.tps;
        allocate Functions::FN_ET_TPS::F_ET_TPS_06 to context.sts.et.tps;
        allocate Functions::FN_ET_UMB::F_ET_UMB_01 to context.sts.et.umb;
