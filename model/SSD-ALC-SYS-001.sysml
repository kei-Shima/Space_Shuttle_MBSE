        part def <'PHY-RCS-03'> PHY_RCS_03 { doc /* 前部RCS推進薬タンク・ヘリウムタンク（数量：推進薬タンク2（燃料1・酸化剤1）、ヘリウムタンク2、姿勢制御系（RCS）） */ }
        part def <'PHY-RCS-04'> PHY_RCS_04 { doc /* 後部RCS推進薬タンク・ヘリウムタンク（数量：各ポッドに推進薬タンク2（燃料1・酸化剤1）とヘリウムタンク2（計：推進薬タンク4、ヘリウムタンク4）、姿勢制御系（RCS）） */ }
        part def <'PHY-RCS-05'> PHY_RCS_05 { doc /* RJDF（前部反動噴射器ドライバ）（数量：2（RJDF 1・RJDF 2）、姿勢制御系（RCS）） */ }
        part def <'PHY-RCS-06'> PHY_RCS_06 { doc /* 後部 RCS クロスフィード弁・マニホールド隔離弁（数量：各ポッド：クロスフィード弁 2対・マニホールド隔離弁 5対、姿勢制御系（RCS）） */ }
        part def <'PHY-RCS-07'> PHY_RCS_07 { doc /* RJDA（後部反動噴射器ドライバ）（数量：2、姿勢制御系（RCS）） */ }
        part def <'PHY-RCS-08'> PHY_RCS_08 { doc /* RCS ヒータ（前部モジュールのパネルヒータ・ポッドのヒータ区域・噴射器ヒータ）（数量：1式、姿勢制御系（RCS）） */ }
        part def <'PHY-EPS-01'> PHY_EPS_01 { doc /* 燃料電池発電装置（FC）（数量：3、電力系（EPS）） */ }
        part def <'PHY-EPS-02'> PHY_EPS_02 { doc /* PRSD極低温反応剤タンク（H2・O2タンク組）（数量：最大5組（1組はH2タンク1個とO2タンク1個。搭載組数はミッションと機体で異なる）、電力系（EPS）） */ }
        part def <'PHY-EPS-03'> PHY_EPS_03 { doc /* 静止型インバータ（INV）（数量：9（交流母線3系統×各3相）、電力系（EPS）） */ }
        part def <'PHY-EPS-04'> PHY_EPS_04 { doc /* 電力制御アセンブリ（PCA）と配電アセンブリ（DA）（数量：DA 3、PCA：前方・中部・後部の各1〜3と後部4〜6、電力系（EPS）） */ }
        part def <'PHY-EPS-05'> PHY_EPS_05 { doc /* モータ制御アセンブリ（MCA）（数量：10（前方3・中部4・後部3）、電力系（EPS）） */ }
        part def <'PHY-ECLSS-01'> PHY_ECLSS_01 { doc /* 大気再生系（ARS）の床下機器：キャビンファン・キャビン熱交換器・水酸化リチウム（LiOH）キャニスタ・水冷却ループ水ポンプ（数量：キャビンファン2基（A・B）、LiOHキャニスタ2個（装着）＋予備最大30個、水ポンプ3台（ループ1に2台、ループ2に1台）、環境制御・生命維持（ECLSS）） */ }
        part def <'PHY-ECLSS-02'> PHY_ECLSS_02 { doc /* 供給水タンク・廃水タンク（給水・廃水系）（数量：供給水タンク4基（A〜D、各使用可能容量165ポンド）、廃水タンク1基（165ポンド）、環境制御・生命維持（ECLSS）） */ }
        part def <'PHY-ECLSS-03'> PHY_ECLSS_03 { doc /* 与圧系（PCS）窒素タンク（GN2）（数量：OV-103・OV-105は標準の6基構成、OV-104は5基（系統1に2基、系統2に3基）。ミッションキットとして追加タンクを搭載することがある、環境制御・生命維持（ECLSS）） */ }
        part def <'PHY-ECLSS-04'> PHY_ECLSS_04 { doc /* 能動熱制御系（ATCS）フレオン冷却ループのポンプパッケージ（フレオンポンプ・アキュムレータ）とフレオン／水熱交換器（数量：フレオンループ2系統、各ループにポンプ2台とアキュムレータ1基、環境制御・生命維持（ECLSS）） */ }
        part def <'PHY-ECLSS-05'> PHY_ECLSS_05 { doc /* 放熱器パネル（ATCS）（数量：各ペイロードベイドアに4枚（前方2枚は展開式、後方2枚は固定式）、環境制御・生命維持（ECLSS）） */ }
        part def <'PHY-ECLSS-06'> PHY_ECLSS_06 { doc /* フラッシュエバポレータ系（FES）とアンモニアボイラ系（数量：FES：高負荷エバポレータ1基とトッピングエバポレータ1基、コントローラ3台（プライマリA・プライマリB・セカンダリ）。アンモニア：貯蔵・制御系2系統（各タンク49ポンド）と共通ボイラ1基、環境制御・生命維持（ECLSS）） */ }
        part def <'PHY-ECLSS-07'> PHY_ECLSS_07 { doc /* フレオンループの熱交換器・弁（燃料電池熱交換器・カーゴ熱交換器・ペイロード熱交換器・O2 リストリクタ・流量配分弁モジュール）（数量：熱交換器 3・O2 リストリクタ 3・流量配分弁モジュール 1、環境制御・生命維持（ECLSS）） */ }
        part def <'PHY-ECLSS-08'> PHY_ECLSS_08 { doc /* コールドプレート網（中胴の左右、後部アビオニクスベイ4・5・6、レートジャイロ）（数量：1式、環境制御・生命維持（ECLSS）） */ }
        part def <'PHY-ECLSS-09'> PHY_ECLSS_09 { doc /* 油圧熱交換器（フレオン／作動油、油圧系統1〜3）（数量：3（各油圧系統に1）、環境制御・生命維持（ECLSS）） */ }
        part def <'PHY-ECLSS-10'> PHY_ECLSS_10 { doc /* GSE 熱交換器（地上冷却）（数量：1、環境制御・生命維持（ECLSS）） */ }
        part def <'PHY-APU-01'> PHY_APU_01 { doc /* APU（補助動力装置、改良型IAPU）（数量：3、補助動力・油圧（APU/HYD）） */ }
        part def <'PHY-APU-02'> PHY_APU_02 { doc /* APU燃料タンク（ヒドラジンタンク）（数量：3（各APUに1）、補助動力・油圧（APU/HYD）） */ }
        part def <'PHY-APU-03'> PHY_APU_03 { doc /* WSB（水噴霧ボイラ）（数量：3（APU・油圧系統ごとに1）、補助動力・油圧（APU/HYD）） */ }
        part def <'PHY-APU-04'> PHY_APU_04 { doc /* 主油圧ポンプ（可変容量形）（数量：3（各油圧系統に1）、補助動力・油圧（APU/HYD）） */ }
        part def <'PHY-APU-05'> PHY_APU_05 { doc /* 油圧リザーバ・ブートストラップアキュムレータ・循環ポンプ（各油圧系統の制御部）（数量：各3（各油圧系統に1組）、補助動力・油圧（APU/HYD）） */ }
        part def <'PHY-APU-06'> PHY_APU_06 { doc /* 噴射器冷却水タンクと水制御弁（3台共用）（数量：1、補助動力・油圧（APU/HYD）） */ }
        part def <'PHY-APU-07'> PHY_APU_07 { doc /* 油圧の分配弁・フィルタ（フィルタモジュール・プライオリティ弁、MPS/TVC 隔離弁、ブレーキ隔離弁、脚伸展弁）（数量：フィルタモジュール 3・隔離弁 6・脚伸展弁群 1、補助動力・油圧（APU/HYD）） */ }
        part def <'PHY-OMS-01'> PHY_OMS_01 { doc /* OMSエンジン（軌道制御エンジン）（数量：2（左右各1）、軌道制御系（OMS）） */ }
        part def <'PHY-OMS-02'> PHY_OMS_02 { doc /* OMS推進薬タンク（燃料MMH・酸化剤N2O4）（数量：4（各ポッドに燃料1・酸化剤1）、軌道制御系（OMS）） */ }
        part def <'PHY-OMS-03'> PHY_OMS_03 { doc /* OMSヘリウムタンク（推進薬加圧用高圧Heタンク）（数量：2（各ポッドに1）、軌道制御系（OMS）） */ }
        part def <'PHY-OMS-04'> PHY_OMS_04 { doc /* OMS TVCジンバルアクチュエータ（電気機械式、アクティブ／スタンバイ制御器付き）（数量：4（各エンジンにピッチ用1・ヨー用1）、軌道制御系（OMS）） */ }
        part def <'PHY-OMS-05'> PHY_OMS_05 { doc /* OMSクロスフィード配管・クロスフィード弁（数量：1式（左右ポッド間の燃料・酸化剤クロスフィード配管）、軌道制御系（OMS）） */ }
        part def <'PHY-MPS-01'> PHY_MPS_01 { doc /* SSME（スペースシャトル主エンジン）（数量：3、主推進系（MPS）） */ }
        part def <'PHY-MPS-02'> PHY_MPS_02 { doc /* SSMEコントローラ（主エンジン制御器）（数量：3（各SSMEに1台）、主推進系（MPS）） */ }
        part def <'PHY-MPS-03'> PHY_MPS_03 { doc /* SSME TVCサーボアクチュエータ（ジンバルアクチュエータ）（数量：6（各SSMEにピッチ用1・ヨー用1）、主推進系（MPS）） */ }
        part def <'PHY-MPS-04'> PHY_MPS_04 { doc /* ATVC（上昇推力方向制御装置）（数量：4、主推進系（MPS）） */ }
        part def <'PHY-MPS-05'> PHY_MPS_05 { doc /* MPSヘリウムタンク（He供給タンク）（数量：10（4.7 ft³×7、17.3 ft³×3）、主推進系（MPS）） */ }
        part def <'PHY-MPS-06'> PHY_MPS_06 { doc /* 推進薬マニホールド・SSME供給管（PMS：17インチLO2・LH2マニホールド、12インチ供給管、プリバルブ）（数量：マニホールド2（LO2・LH2）、SSME供給管は各推進薬3本（各エンジン1本、プリバルブ付き）、主推進系（MPS）） */ }
        part def <'PHY-MPS-07'> PHY_MPS_07 { doc /* GO2・GH2 加圧ラインと ET 加圧マニホールド（数量：GO2 加圧ライン 3・GH2 加圧ライン 3・マニホールド 2、主推進系（MPS）） */ }
        part def <'PHY-MPS-08'> PHY_MPS_08 { doc /* 充填排出弁・ダンプ弁・マニホールド再加圧弁（数量：LO2・LH2 充填排出弁 各2・バックアップ LH2 ダンプ弁 2・再加圧弁・調圧器 4、主推進系（MPS）） */ }
        part def <'PHY-TPS-01'> PHY_TPS_01 { doc /* 強化炭素－炭素（RCC）ノーズキャップ・チャインパネル・前部オービタ／ET結合部周辺（数量：ノーズキャップ1、チャインパネル、前部オービタ／ET結合部周辺（枚数は出典に記載なし）、熱防護系（TPS）） */ }
        part def <'PHY-TPS-02'> PHY_TPS_02 { doc /* 強化炭素－炭素（RCC）主翼前縁（数量：左右主翼の前縁（パネル枚数は出典に記載なし）、熱防護系（TPS）） */ }
        part def <'PHY-TPS-03'> PHY_TPS_03 { doc /* 高温再使用表面断熱材（HRSI）黒タイル（一部はFRCIタイル）（数量：—（枚数は出典に記載なし）、熱防護系（TPS）） */ }
        part def <'PHY-TPS-04'> PHY_TPS_04 { doc /* 低温再使用表面断熱材（LRSI）白タイルと改良型柔軟再使用表面断熱材（AFRSI）ブランケット（数量：—（枚数・面積は出典に記載なし）、熱防護系（TPS）） */ }
        part def <'PHY-TPS-05'> PHY_TPS_05 { doc /* フェルト再使用表面断熱材（FRSI）白ブランケット（数量：—（面積は出典に記載なし）、熱防護系（TPS）） */ }
        part def <'PHY-STR-01'> PHY_STR_01 { doc /* 前部胴体（上部・下部胴体、ノーズ部、前脚格納部）（数量：1式（上部と下部の2部分）、構造（STR）） */ }
        part def <'PHY-STR-02'> PHY_STR_02 { doc /* 乗員室（3層の与圧容器）（数量：1式（フライトデッキ・ミッドデッキ・下部機器ベイの3層）、構造（STR）） */ }
        part def <'PHY-STR-03'> PHY_STR_03 { doc /* 中部胴体（ペイロードベイ構造）（数量：1式（長さ60フィート、幅17フィート、高さ13フィート、約13,502ポンド）、主フレーム組立12、構造（STR）） */ }
        part def <'PHY-STR-04'> PHY_STR_04 { doc /* 主翼（左右、エレボン付き）（数量：左右2枚（最大厚さ5フィート）、エレボンは各翼2セグメント（各3ヒンジ）、構造（STR）） */ }
        part def <'PHY-STR-05'> PHY_STR_05 { doc /* 後部胴体（外殻・推力構造・二次構造）とボディフラップ（数量：後部胴体1式（長さ約18フィート、幅22フィート、高さ20フィート）、推力構造（主に拡散接合チタン製トラス部材28本）、ボディフラップ1（回転アクチュエータ4基）、構造（STR）） */ }
        part def <'PHY-STR-06'> PHY_STR_06 { doc /* 垂直尾翼（フィン・ラダー／スピードブレーキ）（数量：1式（フィン、2つに割れるラダー／スピードブレーキ）、構造（STR）） */ }
        part def <'PHY-MECH-01'> PHY_MECH_01 { doc /* ペイロードベイドア（PLBD）と扉駆動・ラッチ用電気機械式アクチュエータ（PDU）（数量：扉2枚（左舷・右舷、各5セグメント）、扉駆動PDU各1基、ラッチ計32個（センターライン16個を4ガング、前後の隔壁ラッチ各8個）、ヒンジ各13個、機械系（MECH）） */ }
        part def <'PHY-MECH-02'> PHY_MECH_02 { doc /* 外部タンク（ET）アンビリカル扉とラッチ（数量：扉2枚（左：液体水素側、右：液体酸素側）、センターラインラッチ、各開口内のアップロックラッチ3個、機械系（MECH）） */ }
        part def <'PHY-MECH-03'> PHY_MECH_03 { doc /* アクティブベント系（AVS）のベント扉とアクチュエータ（数量：ベントポート14か所（各舷7か所）。当初は18か所、機械系（MECH）） */ }
        part def <'PHY-MECH-04'> PHY_MECH_04 { doc /* 前脚（NLG）・前脚扉・前輪操舵アクチュエータ（数量：前脚1基（緩衝支柱1本、車輪・タイヤ2組）、前脚扉2枚、機械系（MECH）） */ }
        part def <'PHY-MECH-05'> PHY_MECH_05 { doc /* 主脚（MLG）と電気油圧式ディスクブレーキ・アンチスキッド（数量：主脚2基（左右、各車輪・タイヤ2組）、主脚扉各1枚、ブレーキ4組（主脚車輪ごと）、機械系（MECH）） */ }
        part def <'PHY-MECH-06'> PHY_MECH_06 { doc /* ドラッグシュート（数量：1式（パイロットシュート9フィート、メインシュート40フィート）、機械系（MECH）） */ }
        part def <'PHY-CW-01'> PHY_CW_01 { doc /* C/W電子ユニット（注意警報電子ユニット）（数量：1（内部に電源装置A・B）、警報系（C/W）） */ }
        part def <'PHY-CW-02'> PHY_CW_02 { doc /* 注意警報表示マトリクス（パネルF7）（数量：1（40灯）、警報系（C/W）） */ }
        part def <'PHY-CW-03'> PHY_CW_03 { doc /* MASTER ALARM押しボタン表示灯（数量：4、警報系（C/W）） */ }
        part def <'PHY-CW-04'> PHY_CW_04 { doc /* C/W限界値設定・パラメータ状態パネル（パネルR13U）（数量：1（パラメータ状態灯120）、警報系（C/W）） */ }
        part def <'PHY-CW-05'> PHY_CW_05 { doc /* 煙検知器（クラス1警報）（数量：9（A群5・B群4。SCOMの配置記述からの計数）、警報系（C/W）） */ }
        part def <'PHY-CREW-01'> PHY_CREW_01 { doc /* 乗員座席（CDR席S1・PLT席S2・MS席）（数量：フライトデッキ4席、ミッドデッキ3席（MS席と同型の座席を3〜4席装着できる）、乗員系・脱出系（CREW）） */ }
        part def <'PHY-CREW-02'> PHY_CREW_02 { doc /* 睡眠設備（寝袋・4段式固定睡眠ステーション）（数量：寝袋は乗員ごとに1つ。24時間運用ミッションでは4段式固定睡眠ステーションを搭載、乗員系・脱出系（CREW）） */ }
        part def <'PHY-CREW-03'> PHY_CREW_03 { doc /* サイドハッチと投棄・キャビンベント火工品系（数量：サイドハッチ1（直径40インチ）、Tハンドル2本（キャビンベント用・ハッチ投棄用）、乗員系・脱出系（CREW）） */ }
        part def <'PHY-CREW-04'> PHY_CREW_04 { doc /* 脱出ポールと緊急脱出スライド（数量：脱出ポール1本（ランヤード8本のマガジン付き）、緊急脱出スライド1式（膨張式スライド・アルゴンボトルなど）、乗員系・脱出系（CREW）） */ }
        part def <'PHY-CREW-05'> PHY_CREW_05 { doc /* 頭上脱出窓（W8）と緊急降下器（Sky Genie）（数量：頭上窓W8 1（3枚重ね、開口20×20インチ）、緊急降下器7個（乗員1人に1個）、乗員系・脱出系（CREW）） */ }
        part def <'PHY-PLS-01'> PHY_PLS_01 { doc /* 遠隔マニピュレータシステム（RMS）アーム（数量：1基（6関節＋エンドエフェクタ、長さ50フィート3インチ、直径15インチ）、ペイロード支援（PDRS・ODS）） */ }
        part def <'PHY-PLS-02'> PHY_PLS_02 { doc /* マニピュレータ位置決め機構（MPM）とマニピュレータ保持ラッチ（MRL）（数量：左舷：支持組立4（肩部取付点1＋MRL付きペデスタル3）、右舷（OBSS用）：MRL付きペデスタル3、ペイロード支援（PDRS・ODS）） */ }
        part def <'PHY-PLS-03'> PHY_PLS_03 { doc /* マニピュレータ制御インタフェースユニット（MCIU）とRMS専用表示・操作器（数量：MCIU 1台（RMSフライトでは通常予備1台を搭載）、ペイロード支援（PDRS・ODS）） */ }
        part def <'PHY-PLS-04'> PHY_PLS_04 { doc /* オービタドッキングシステム（ODS）：トラス組立とAPDSドッキング機構（数量：1式（外部エアロック・トラス組立・APDSの3主要構成品）。APDSは構造フック12対とペタル3枚の伸展式ガイドリングを持つ、ペイロード支援（PDRS・ODS）） */ }
        part def <'PHY-PLS-05'> PHY_PLS_05 { doc /* APDSアビオニクス（PSU・DSCU・DMCU・PACU・LACU・DCU・PFCU）と操作パネル（A6L・A7L）（数量：アビオニクスボックス9台、操作パネル2面、ペイロード支援（PDRS・ODS）） */ }
        part def <'PHY-EVA-01'> PHY_EVA_01 { doc /* 船外活動ユニット（EMU）（数量：ベースラインのミッションで2着、船外活動（EVA/EMU）） */ }
        part def <'PHY-EVA-02'> PHY_EVA_02 { doc /* 外部エアロック（ハッチ3基・EMU支援機器付き）（数量：1基（直径63インチ、長さ83インチ強、D形40インチ開口のハッチ3基：内側ハッチ・EVハッチ・ドッキングハッチ）、船外活動（EVA/EMU）） */ }
        part def <'PHY-EVA-03'> PHY_EVA_03 { doc /* ペイロードベイのEVA支援機器（スライドワイヤ・EVAウインチ・ハンドレール）（数量：スライドワイヤ2本（各舷1本、長さ約46フィート）、EVAウインチ（前後の隔壁）、船外活動（EVA/EMU）） */ }
        part def OrbiterLayout {
            doc /* オービタの物理配置：区画と、区画に置いた機器 */
            part <'FD'> fd : Compartment {
                doc /* フライトデッキ */
                part phy_dps_04 : PHY_DPS_04[4];
                part phy_gnc_01 : PHY_GNC_01[3];
                part phy_cw_02 : PHY_CW_02[1];
                part phy_cw_04 : PHY_CW_04[1];
                part phy_crew_05 : PHY_CREW_05;
                part phy_pls_03 : PHY_PLS_03;
            }
            part <'MD'> md : Compartment {
                doc /* ミッドデッキ */
                part phy_crew_02 : PHY_CREW_02;
                part phy_crew_03 : PHY_CREW_03;
                part phy_crew_04 : PHY_CREW_04;
            }
            part <'LEB'> leb : Compartment {
                doc /* 下部機器ベイ */
                part phy_eclss_01 : PHY_ECLSS_01;
                part phy_eclss_02 : PHY_ECLSS_02;
            }
            part <'AVB1'> avb1 : Compartment {
                doc /* 前方アビオニクスベイ1 */
                part phy_ct_06 : PHY_CT_06;
            }
            part <'AVB2'> avb2 : Compartment { doc /* 前方アビオニクスベイ2（配分表の機器なし） */ }
            part <'AVB3A'> avb3a : Compartment {
                doc /* 前方アビオニクスベイ3A */
                part phy_ct_01 : PHY_CT_01[2];
                part phy_ct_04 : PHY_CT_04[2];
                part phy_ct_05 : PHY_CT_05[1];
                part phy_ct_07 : PHY_CT_07;
                part phy_cw_01 : PHY_CW_01[1];
            }
            part <'AVB3B'> avb3b : Compartment {
                doc /* 前方アビオニクスベイ3B */
                part phy_ct_09 : PHY_CT_09[1];
                part phy_dps_05 : PHY_DPS_05[1];
            }
            part <'AVBF'> avbf : Compartment {
                doc /* 前方アビオニクスベイ（複数） */
                part phy_ct_10 : PHY_CT_10[2];
                part phy_dps_01 : PHY_DPS_01[5];
                part phy_dps_02 : PHY_DPS_02[2];
                part phy_gnc_03 : PHY_GNC_03;
                part phy_gnc_05 : PHY_GNC_05[3];
                part phy_rcs_05 : PHY_RCS_05[2];
                part phy_eps_03 : PHY_EPS_03[9];
            }
            part <'AIRLOCK'> airlock : Compartment {
                doc /* エアロック */
                part phy_ct_11 : PHY_CT_11;
                part phy_pls_05 : PHY_PLS_05;
                part phy_eva_01 : PHY_EVA_01;
                part phy_eva_02 : PHY_EVA_02;
            }
            part <'FWD'> fwd : Compartment {
                doc /* 前部胴体（乗員室の外） */
                part phy_ct_02 : PHY_CT_02[4];
                part phy_ct_08 : PHY_CT_08;
                part phy_gnc_02 : PHY_GNC_02[2];
                part phy_tps_01 : PHY_TPS_01;
                part phy_str_01 : PHY_STR_01;
                part phy_mech_04 : PHY_MECH_04;
            }
            part <'FRCS'> frcs : Compartment {
                doc /* 前部 RCS モジュール */
                part phy_rcs_01 : PHY_RCS_01[16];
                part phy_rcs_03 : PHY_RCS_03;
            }
            part <'PLB'> plb : Compartment {
                doc /* ペイロードベイ */
                part phy_ct_03 : PHY_CT_03[1];
                part phy_eclss_03 : PHY_ECLSS_03;
                part phy_eclss_05 : PHY_ECLSS_05;
                part phy_mech_01 : PHY_MECH_01;
                part phy_pls_01 : PHY_PLS_01;
                part phy_pls_02 : PHY_PLS_02;
                part phy_pls_04 : PHY_PLS_04;
                part phy_eva_03 : PHY_EVA_03;
            }
            part <'MID'> mid : Compartment {
                doc /* 中部胴体（床下・側面） */
                part phy_eps_01 : PHY_EPS_01[3];
                part phy_eps_02 : PHY_EPS_02;
                part phy_eclss_04 : PHY_ECLSS_04;
                part phy_eclss_07 : PHY_ECLSS_07;
                part phy_str_03 : PHY_STR_03;
            }
            part <'AFT'> aft : Compartment {
                doc /* 後部胴体 */
                part phy_eclss_06 : PHY_ECLSS_06;
                part phy_eclss_09 : PHY_ECLSS_09[3];
                part phy_eclss_10 : PHY_ECLSS_10[1];
                part phy_apu_01 : PHY_APU_01[3];
                part phy_apu_02 : PHY_APU_02[3];
                part phy_apu_03 : PHY_APU_03[3];
                part phy_apu_04 : PHY_APU_04[3];
                part phy_apu_05 : PHY_APU_05;
                part phy_apu_06 : PHY_APU_06[1];
                part phy_oms_05 : PHY_OMS_05;
                part phy_mps_01 : PHY_MPS_01[3];
                part phy_mps_02 : PHY_MPS_02[3];
                part phy_mps_03 : PHY_MPS_03[6];
                part phy_mps_06 : PHY_MPS_06;
                part phy_mps_07 : PHY_MPS_07;
                part phy_mps_08 : PHY_MPS_08;
                part phy_str_05 : PHY_STR_05;
                part phy_mech_02 : PHY_MECH_02;
            }
            part <'AVBA'> avba : Compartment {
                doc /* 後部アビオニクスベイ4〜6 */
                part phy_dps_07 : PHY_DPS_07;
                part phy_gnc_06 : PHY_GNC_06[4];
                part phy_rcs_07 : PHY_RCS_07[2];
                part phy_mps_04 : PHY_MPS_04[4];
            }
            part <'POD'> pod : Compartment {
                doc /* OMS/RCS ポッド */
                part phy_rcs_02 : PHY_RCS_02[28];
                part phy_rcs_04 : PHY_RCS_04;
                part phy_rcs_06 : PHY_RCS_06;
                part phy_oms_01 : PHY_OMS_01[2];
                part phy_oms_02 : PHY_OMS_02[4];
                part phy_oms_03 : PHY_OMS_03[2];
                part phy_oms_04 : PHY_OMS_04[4];
            }
            part <'WING'> wing : Compartment {
                doc /* 主翼 */
                part phy_tps_02 : PHY_TPS_02;
                part phy_str_04 : PHY_STR_04;
                part phy_mech_05 : PHY_MECH_05;
            }
            part <'VT'> vt : Compartment {
                doc /* 垂直尾翼 */
                part phy_str_06 : PHY_STR_06;
                part phy_mech_06 : PHY_MECH_06;
            }
            part <'MULTI'> multi : Compartment {
                doc /* 複数区画に分散 */
                part phy_dps_03 : PHY_DPS_03;
                part phy_dps_06 : PHY_DPS_06;
                part phy_gnc_04 : PHY_GNC_04;
                part phy_rcs_08 : PHY_RCS_08;
                part phy_eps_04 : PHY_EPS_04;
                part phy_eps_05 : PHY_EPS_05[10];
                part phy_eclss_08 : PHY_ECLSS_08;
                part phy_apu_07 : PHY_APU_07;
                part phy_mps_05 : PHY_MPS_05[10];
                part phy_tps_03 : PHY_TPS_03;
                part phy_tps_04 : PHY_TPS_04;
                part phy_tps_05 : PHY_TPS_05;
                part phy_str_02 : PHY_STR_02;
                part phy_mech_03 : PHY_MECH_03;
                part phy_cw_03 : PHY_CW_03[4];
                part phy_cw_05 : PHY_CW_05[9];
                part phy_crew_01 : PHY_CREW_01;
            }
        }
        part orbiterLayout : OrbiterLayout;
    }
    // ---- 論理の割付：機能 → 機能行を持つ機能説明書の部品
    package LogicalAllocation {
        allocate Functions::FN_EXT::F_NET_01 to context.ext;
        allocate Functions::FN_EXT::F_NET_02 to context.ext;
        allocate Functions::FN_EXT::F_NET_03 to context.ext;
        allocate Functions::FN_EXT::F_NET_04 to context.ext;
