            <mxGeometry x="140" y="1480" width="130" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-254" value="OMS の搭載量は OV-103/104 で最大 25064 lb・最小 10800 lb で、機体の変数として速度変化の能力の上限に効く" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="270" y="1480" width="1170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p109-v-255" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;上＝機体の違い（行＝特徴、列＝機体。「不明」＝資料に記述が無い、「—」＝当てはまらない）、中＝ミッションキット、下＝収支（SSD-BUD-ORB-001）への効き方。ID は定義書の行、機能説明書・収支の行の欄はその文書を開く。&lt;br&gt;同じ構成を SysML v2 テキスト model/SSD-VAR-ORB-001.sysml の OrbiterVariant（variation）とミッションキットの part def に示す。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
