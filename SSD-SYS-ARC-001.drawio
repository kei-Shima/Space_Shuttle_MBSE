        <mxCell id="p154-v-102" value="医療（キット・診断・相談）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="742" width="260" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-103" value="SOMS（用途別のサブパックに分けた医療キット・鋭利物の容器・患者と救助者の拘束具・蘇生器）を中甲板のロッカーに収め、機上の Medical" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
