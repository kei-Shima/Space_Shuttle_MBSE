        </UserObject>
        <UserObject label="RCST-01" id="p137-v-19" link="docs/SSD-BEH-ORB-006.html#RCST-01" tooltip="RCST-01：MECO 後の姿勢保持、ET 分離で −Z 並進">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p137-v-6" target="p137-v-7">
