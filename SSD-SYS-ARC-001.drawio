            <mxGeometry x="140" y="1336" width="130" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-236" value="RCRS の機体では予備2日分の LiOH の不足も RCRS の連続運転で賄える。ただし OI-33 時点で RCRS に対応する機体は無い" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="270" y="1336" width="1170" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-06" id="p109-v-237" link="docs/SSD-VAR-ORB-001.html#MK-06" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1360" width="100" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="BUD-CON-04" id="p109-v-238" link="docs/SSD-BUD-ORB-001.html#BUD-CON-04" tooltip="開く">
