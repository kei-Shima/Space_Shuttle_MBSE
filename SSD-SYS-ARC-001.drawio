            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="940" y="225" />
                <mxPoint x="1180" y="225" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-01&lt;br&gt;送受信データ" id="p2-IF-ORB-01" link="docs/SSD-FD-CT-001.html#IF-ORB-01" tooltip="IF-ORB-01：地上へのダウンリンクには、GPCが収集したデータ（ダウンリスト）、ペイロードデータ、計測データ、機上音声が含まれる。 機上の状態ベクトルは、地上管制網から通信アップリンクで定期的に更新される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.42;exitDx=0;exitDy=0;entryX=0;entryY=0.42;entryDx=0;entryDy=0;" edge="1" parent="p2-L_dat" source="p2-B-CT" target="p2-B-DPS">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-02&lt;br&gt;GN&amp;C処理" id="p2-IF-ORB-02" link="docs/SSD-FD-DPS-001.html#IF-ORB-02" tooltip="IF-ORB-02：上昇・再突入では、5台中4台のGPCに同一のPASSソフトウェアを搭載し、GN&amp;C機能を同時・冗長に実行する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.42;exitDx=0;exitDy=0;entryX=0;entryY=0.42;entryDx=0;entryDy=0;" edge="1" parent="p2-L_dat" source="p2-B-DPS" target="p2-B-GNC">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-03&lt;br&gt;噴射指令" id="p2-IF-ORB-03" link="docs/SSD-FD-GNC-001.html#IF-ORB-03" tooltip="IF-ORB-03：軌道投入後、GN&amp;C系はRCSとOMSを用いてオービタの姿勢と並進を制御する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.42;exitDx=0;exitDy=0;entryX=0;entryY=0.42;entryDx=0;entryDy=0;" edge="1" parent="p2-L_dat" source="p2-B-GNC" target="p2-B-RCS">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-04&lt;br&gt;噴射・ジンバル指令" id="p2-IF-ORB-04" link="docs/SSD-FD-GNC-001.html#IF-ORB-04" tooltip="IF-ORB-04：軌道投入後、GN&amp;C系はRCSとOMSを用いてオービタの姿勢と並進を制御する。 各OMSエンジンの2基のジンバルアクチュエータは、汎用コンピュータ（GPC）の制御信号で駆動される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="p2-L_dat" source="p2-B-GNC" target="p2-B-OMS">
            <mxGeometry relative="1" as="geometry" x="-0.3">
              <Array as="points">
                <mxPoint x="1480" y="452" />
                <mxPoint x="1480" y="706" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-05&lt;br&gt;OMS推進薬（連結）" id="p2-IF-ORB-05" link="docs/SSD-FD-OMS-001.html#IF-ORB-05" tooltip="IF-ORB-05：OMS－後部RCS連結により、軌道上では後部RCSがどちらのOMSポッドの推進薬も使える。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.65;exitY=0;exitDx=0;exitDy=0;entryX=0.65;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p2-L_flu" source="p2-B-OMS" target="p2-B-RCS">
            <mxGeometry relative="1" as="geometry" x="-0.5" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-06&lt;br&gt;SSME 指令（EIU×3）" id="p2-IF-ORB-06" link="docs/SSD-FD-DPS-001.html#IF-ORB-06" tooltip="IF-ORB-06：DPSには、SSMEへ指令を送る3台のSSMEインタフェースユニットが含まれる。 MPSは、データ処理系と重要なインタフェースを持つ。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="p2-L_dat" source="p2-B-DPS" target="p2-B-MPS">
            <mxGeometry relative="1" as="geometry" x="0.65">
              <Array as="points">
                <mxPoint x="1108" y="461" />
                <mxPoint x="1108" y="998" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-07&lt;br&gt;ジンバル・弁 油圧" id="p2-IF-ORB-07" link="docs/SSD-FD-APU-001.html#IF-ORB-07" tooltip="IF-ORB-07：各油圧系は、SSMEのジンバルによる推力方向制御と、SSMEの各種制御弁の作動に油圧を供給する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B3FA0;strokeWidth=2;fontColor=#7B3FA0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p2-L_hyd" source="p2-B-APU" target="p2-B-MPS">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-08&lt;br&gt;空力舵面 油圧" id="p2-IF-ORB-08" link="docs/SSD-FD-APU-001.html#IF-ORB-08" tooltip="IF-ORB-08：各油圧系は、空力舵面（エレボン、ボディフラップ、ラダー／スピードブレーキ）の駆動に油圧を供給する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B3FA0;strokeWidth=2;fontColor=#7B3FA0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p2-L_hyd" source="p2-B-APU" target="p2-B-GNC">
            <mxGeometry relative="1" as="geometry" x="-0.5" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-09&lt;br&gt;極低温O2" id="p2-IF-ORB-09" link="docs/SSD-FD-EPS-001.html#IF-ORB-09" tooltip="IF-ORB-09：反応剤貯蔵・分配（PRSD）サブシステムは、乗員室の与圧用に極低温酸素をECLSSへ供給する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="p2-L_flu" source="p2-B-EPS" target="p2-B-ECLSS">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-10&lt;br&gt;生成水" id="p2-IF-ORB-10" link="docs/SSD-FD-EPS-001.html#IF-ORB-10" tooltip="IF-ORB-10：燃料電池の生成水は乗員室下部デッキの飲料水タンクへ送られ、乗員の飲用やフレオン冷却ループの冷却に使われる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p2-L_flu" source="p2-B-EPS" target="p2-B-ECLSS">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-11&lt;br&gt;排熱" id="p2-IF-ORB-11" link="docs/SSD-FD-EPS-001.html#IF-ORB-11" tooltip="IF-ORB-11：燃料電池の排熱は、熱交換器を通じてフレオン冷却ループへ移される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="p2-L_thm" source="p2-B-EPS" target="p2-B-ECLSS">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-12&lt;br&gt;作動油保温" id="p2-IF-ORB-12" link="docs/SSD-FD-ECLSS-001.html#IF-ORB-12" tooltip="IF-ORB-12：各油圧系は油圧／フレオン熱交換器を備える。 軌道上では、油圧作動油はフレオンループの熱で保温される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p2-L_thm" source="p2-B-ECLSS" target="p2-B-APU">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-13&lt;br&gt;アビオニクス冷却" id="p2-IF-ORB-13" link="docs/SSD-FD-ECLSS-001.html#IF-ORB-13" tooltip="IF-ORB-13：乗員室とフライトデッキの電子機器の排熱は、循環する冷却水系で集められ、ペイロードベイドアの放熱パネルへ運ばれる（図ではアビオニクスの代表としてDPSに接続）。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p2-L_thm" source="p2-B-ECLSS" target="p2-B-DPS">
            <mxGeometry relative="1" as="geometry" x="-0.5" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-15&lt;br&gt;LH2/LOX" id="p2-IF-ORB-15" link="docs/SSD-FD-MPS-001.html#IF-ORB-15" tooltip="IF-ORB-15：外部タンクは液体水素と液体酸素を3基のSSMEへ加圧供給する。 オービタ内の17インチ液体酸素・液体水素切離しアンビリカルは、外部タンク投棄時に油圧で格納される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.8947;entryDx=0;entryDy=0;" edge="1" parent="p2-L_flu" source="p2-B-ET2" target="p2-B-MPS">
            <mxGeometry relative="1" as="geometry" x="0.7574">
              <Array as="points">
                <mxPoint x="1570" y="1490" />
                <mxPoint x="1440" y="1490" />
                <mxPoint x="1440" y="1130" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-19&lt;br&gt;計測・警報" id="p2-IF-ORB-19" link="docs/SSD-FD-ECLSS-001.html#IF-ORB-19" tooltip="IF-ORB-19：水冷却ループのポンプ出口圧力とポンプ前後の差圧はシステム管理用GPCへ送られ、DPS表示（DISP 88 APU/ENVIRON THERM）に表示される。 煙検知素子は警報を発し、煙濃度の情報をCRTと計器盤L1に表示する。 FES制御器は、GPC位置ではバックアップ飛行システム（BFS）の計算機が自動でオン・オフする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.35;exitY=0;exitDx=0;exitDy=0;entryX=0.35;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p2-L_dat" source="p2-B-ECLSS" target="p2-B-DPS">
            <mxGeometry relative="1" as="geometry" x="0.5" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-21&lt;br&gt;ATVC（SSME）" id="p2-IF-ORB-21" link="docs/SSD-FD-GNC-001.html#IF-ORB-21" tooltip="IF-ORB-21：オービタのFCSのATVCは、打上げと第1段上昇中は3基の主エンジンと2本のSRB、第2段上昇中は主エンジンのみの推力方向を定めて、姿勢と軌道を制御する。 ATVCの指令はGPCの飛行制御系が生成した位置指令に始まり、SSMEとSRBのサーボアクチュエータでノズルを首振りさせて終わる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9333;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.2632;entryDx=0;entryDy=0;" edge="1" parent="p2-L_dat" source="p2-B-GNC" target="p2-B-MPS">
            <mxGeometry relative="1" as="geometry" x="0.3931">
              <Array as="points">
                <mxPoint x="1400" y="620" />
                <mxPoint x="1440" y="620" />
                <mxPoint x="1440" y="1010" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-22&lt;br&gt;ATVC（SRB）" id="p2-IF-ORB-22" link="docs/SSD-FD-GNC-001.html#IF-ORB-22" tooltip="IF-ORB-22：誘導系からの指令はATVCドライバへ送られ、ドライバは指令に比例した信号を主エンジンとSRBの各サーボアクチュエータへ送る。 各FCSチャネルのATVCは、6つのSSMEドライバと4つのSRBドライバを持つ。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p2-L_dat" source="p2-B-GNC" target="p2-B-SRB2">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-23&lt;br&gt;APU 計測・制御" id="p2-IF-ORB-23" link="docs/SSD-FD-APU-001.html#IF-ORB-23" tooltip="IF-ORB-23：各燃料タンクの温度と窒素圧力はAPU制御器が監視してGPCへ送り、GPCが燃料量を計算して専用表示器に示す。 循環ポンプのスイッチをGPC位置にすると、SM GPCが油圧配管温度やアキュムレータ圧力に基づく制御プログラムでポンプを入り切りする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.9333;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p2-L_dat" source="p2-B-APU" target="p2-B-DPS">
            <mxGeometry relative="1" as="geometry" x="0.5789">
              <Array as="points">
                <mxPoint x="1210" y="510" />
                <mxPoint x="980" y="510" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-26&lt;br&gt;点火・分離（MEC）" id="p2-IF-ORB-26" link="docs/SSD-FD-DPS-001.html#IF-ORB-26" tooltip="IF-ORB-26：固体ロケットモータの点火指令は、オービタのコンピュータからMECを通じて各SRBのS&amp;A装置のNSI起爆器へ送られる。 マスターイベントコントローラ（MEC）は、SRBを外部タンクから、外部タンクをオービタから切り離す火工品を起爆する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9333;exitY=0;exitDx=0;exitDy=0;entryX=0.3333;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p2-L_dat" source="p2-B-DPS" target="p2-B-SRB2">
            <mxGeometry relative="1" as="geometry" x="0.3263">
              <Array as="points">
                <mxPoint x="980" y="240" />
                <mxPoint x="1220" y="240" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-35&lt;br&gt;EPS 機器冷却" id="p2-IF-ORB-35" link="docs/SSD-FD-ECLSS-001.html#IF-ORB-35" tooltip="IF-ORB-35：前方アビオニクスベイ1〜3の電力制御組立・負荷制御組立・モータ制御組立・インバータはコールドプレートに搭載され、水冷却ループで冷却される。 中胴の電気部品はコールドプレートに取り付けられフレオン21ループで冷却され、前部アビオニクスベイ1〜3の電力・負荷・モータ制御組立とインバータは水冷却ループで冷却され、インバータ配電組立は空冷である。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.9333;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p2-L_thm" source="p2-B-ECLSS" target="p2-B-EPS">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="730" y="850" />
                <mxPoint x="560" y="850" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-36&lt;br&gt;ET 結合" id="p2-IF-ORB-36" link="docs/SSD-FD-STR-001.html#IF-ORB-36" tooltip="IF-ORB-36：前部のオービタ／外部タンク結合金具は、Xo = 378隔壁と前脚格納部の後方の外板構造にある。 オービタ／外部タンクの2つの後部結合点は、後部胴体のロンジロン金具で結合する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p2-L_str" source="p2-B-STR" target="p2-B-ET2">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-37&lt;br&gt;外板の熱防護" id="p2-IF-ORB-37" link="docs/SSD-FD-TPS-001.html#IF-ORB-37" tooltip="IF-ORB-37：TPSはオービタの外部構造外板に施工した各種材料から成り、主に再突入時に外板を許容温度内に保つ。 再突入時は、TPS材料がアルミニウムとグラファイトエポキシ製の外板を350°Fを超える温度から守る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p2-L_thm" source="p2-B-TPS" target="p2-B-STR">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-38&lt;br&gt;ドア構造支持" id="p2-IF-ORB-38" link="docs/SSD-FD-MECH-001.html#IF-ORB-38" tooltip="IF-ORB-38：ペイロードベイドアは中部胴体を構造的に支持し、各扉は13個のヒンジ（固定5・可動8）で中部胴体に結合する。 ペイロードベイドアのロンジロンと関連構造は13個のヒンジに取り付けられ、ヒンジがドアからの鉛直反力を受ける。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.5789;exitDx=0;exitDy=0;entryX=0;entryY=0.5789;entryDx=0;entryDy=0;" edge="1" parent="p2-L_str" source="p2-B-MECH" target="p2-B-STR">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-39&lt;br&gt;脚・ブレーキ・NWS 油圧" id="p2-IF-ORB-39" link="docs/SSD-FD-APU-001.html#IF-ORB-39" tooltip="IF-ORB-39：脚下げを指令すると、油圧系1の圧力で各脚のアップロックフックが外れる。 4つの主脚ブレーキにはそれぞれ2系統の油圧系から圧力を供給し、油圧系1・2の圧力が約1,000 psiを下回ると切替弁で油圧系3に切り替わる。 油圧系1・2は、前輪操舵系NWS 1・2のいずれにも冗長な油圧を供給する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B3FA0;strokeWidth=2;fontColor=#7B3FA0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.2632;entryDx=0;entryDy=0;" edge="1" parent="p2-L_hyd" source="p2-B-APU" target="p2-B-MECH">
            <mxGeometry relative="1" as="geometry" x="0.3695">
              <Array as="points">
                <mxPoint x="1150" y="940" />
                <mxPoint x="1090" y="940" />
                <mxPoint x="1090" y="1330" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-43&lt;br&gt;警報音" id="p2-IF-ORB-43" link="docs/SSD-FD-CW-001.html#IF-ORB-43" tooltip="IF-ORB-43：聴覚の合図は通信系へ送られ、乗員のヘッドセットやスピーカボックスへ配られる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.2632;exitDx=0;exitDy=0;entryX=0;entryY=0.8947;entryDx=0;entryDy=0;" edge="1" parent="p2-L_dat" source="p2-B-CW" target="p2-B-CT">
            <mxGeometry relative="1" as="geometry" x="-0.3724">
