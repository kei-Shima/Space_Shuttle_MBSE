            <mxGeometry x="40" y="1480" width="100" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="BUD-PRP-01" id="p109-v-253" link="docs/SSD-BUD-ORB-001.html#BUD-PRP-01" tooltip="開く">
