          <mxGeometry x="0" y="30" width="220" height="40" as="geometry" />
        </mxCell>
        <UserObject label="▶ 説明書 SSD-FD-CW-PRI-001" id="p56-v-33" link="docs/SSD-FD-CW-PRI-001.html" tooltip="クリックで SSD-FD-CW-PRI-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F5FAD;fontColor=#1F5FAD;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p56-B-CW56">
            <mxGeometry x="10" y="76" width="200" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="電力系（EPS）：直流配電" id="p56-B-EPS56" tooltip="28 VDC 主母線A・B・C（図6参照）" doc_no="SSD-FD-EPS-DC-001" abbr="EPS" 分類="電力・環境・油圧">
          <mxCell style="swimlane;html=1;whiteSpace=wrap;startSize=30;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#FBF1CF;swimlaneFillColor=#FFFFFF;strokeColor=#A77B00;strokeWidth=1.5;fontColor=#15202B;fontStyle=1;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
            <mxGeometry x="30" y="450" width="220" height="110" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p56-v-34" value="・28 VDC 主母線A・B・C（図6参照）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p56-B-EPS56">
          <mxGeometry x="0" y="30" width="220" height="40" as="geometry" />
        </mxCell>
        <UserObject label="▶ 説明書 SSD-FD-EPS-DC-001" id="p56-v-35" link="docs/SSD-FD-EPS-DC-001.html" tooltip="クリックで SSD-FD-EPS-DC-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#A77B00;fontColor=#A77B00;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p56-B-EPS56">
            <mxGeometry x="10" y="76" width="200" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="熱交換器・コールドプレート網" id="p56-B-THX56" tooltip="フレオン／油圧熱交換器（図8参照）" doc_no="SSD-FD-TCS-HX-001" abbr="THX" 分類="電力・環境・油圧">
          <mxCell style="swimlane;html=1;whiteSpace=wrap;startSize=30;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#FBF1CF;swimlaneFillColor=#FFFFFF;strokeColor=#A77B00;strokeWidth=1.5;fontColor=#15202B;fontStyle=1;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
            <mxGeometry x="380" y="1120" width="280" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p56-v-36" value="・フレオン／油圧熱交換器（図8参照）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p56-B-THX56">
          <mxGeometry x="0" y="30" width="280" height="30" as="geometry" />
        </mxCell>
        <UserObject label="▶ 機能説明書　SSD-FD-TCS-HX-001" id="p56-v-37" link="docs/SSD-FD-TCS-HX-001.html" tooltip="クリックで SSD-FD-TCS-HX-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#A77B00;fontColor=#A77B00;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p56-B-THX56">
            <mxGeometry x="10" y="66" width="260" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-01&lt;br&gt;ヒドラジン" id="p56-IF-APU-01" link="docs/SSD-FD-APU-FUL-001.html#IF-APU-01" tooltip="IF-APU-01：加圧したヒドラジンを、燃料タンク隔離弁とフィルタからガス発生器弁モジュール（直列の主・副燃料制御弁）を経てガス発生器へ送る。ガス発生器は触媒の作用で燃料を分解し、その高温ガスで単段・2回通過のタービンを回す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p56-L_flu" source="p56-B-FUL" target="p56-B-TRB">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-02&lt;br&gt;弁制御・計測" id="p56-IF-APU-02" link="docs/SSD-FD-APU-CTL-001.html#IF-APU-02" tooltip="IF-APU-02：APU制御器は主燃料制御弁をパルス駆動してAPUの回転数を保ち、主弁が電力を失って全開になると副弁がパルス駆動で回転数を制御する。各燃料タンクの温度とGN2圧力はAPU制御器が監視する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p56-L_dat" source="p56-B-CTL" target="p56-B-FUL">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-03&lt;br&gt;タンク弁開閉" id="p56-IF-APU-03" link="docs/SSD-FD-APU-OPS-001.html#IF-APU-03" tooltip="IF-APU-03：パネルR2のAPU FUEL TK VLV 1・2・3スイッチをOPENにすると各APUの2個の燃料タンク隔離弁が通電して開き、CLOSEにするか電力を失うと両弁が閉じる。APUの自動停止の後は、隔離弁が再び開いて高温のガス発生器床へ燃料が流れないよう、APU FUEL TK VLVスイッチをCLOSEにする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p56-L_dat" source="p56-B-OPS" target="p56-B-FUL">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-04&lt;br&gt;軸動力" id="p56-IF-APU-04" link="docs/SSD-FD-APU-TRB-001.html#IF-APU-04" tooltip="IF-APU-04：タービンの軸動力を減速ギアボックスを介して対応する主油圧ポンプへ送り、主油圧ポンプは通常3,918 rpmで回る。HYD MAIN PUMP PRESSスイッチがNORMのままでは、APUを始動できない。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p56-L_str" source="p56-B-TRB" target="p56-B-HYD">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-05&lt;br&gt;潤滑油冷却" id="p56-IF-APU-05" link="docs/SSD-FD-APU-TRB-001.html#IF-APU-05" tooltip="IF-APU-05：各APUの潤滑油を、対応する水噴霧ボイラの熱交換器に通して冷却する。ボイラは潤滑油を約250°Fに保ち、潤滑油はボイラを2回通る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p56-L_thm" source="p56-B-TRB" target="p56-B-WSB">
            <mxGeometry relative="1" as="geometry" x="-0.2391">
              <Array as="points">
                <mxPoint x="1860" y="430" />
                <mxPoint x="1860" y="960" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-06&lt;br&gt;加圧・ヒータ" id="p56-IF-APU-06" link="docs/SSD-FD-APU-CTL-001.html#IF-APU-06" tooltip="IF-APU-06：APU制御器は、ギアボックス圧力が5.2 psi未満になると潤滑油系のGN2加圧弁を通電して開き、掃気と潤滑油ポンプの運転に必要なギアボックス圧力を保つ。ガス発生器床ヒータは、床温度センサの信号を受ける制御器内の比較器で360〜425°Fに保たれる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p56-L_dat" source="p56-B-CTL" target="p56-B-TRB">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="640" y="230" />
                <mxPoint x="1210" y="230" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-07&lt;br&gt;作動油冷却" id="p56-IF-APU-07" link="docs/SSD-FD-APU-HYD-001.html#IF-APU-07" tooltip="IF-APU-07：主油圧ポンプが送る作動油を、対応する水噴霧ボイラの油圧用熱交換器に通して冷却する。作動油は温度が210°Fになるとボイラへ導かれ、190°Fに下がると温度制御のバイパス弁でボイラを迂回する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p56-L_thm" source="p56-B-HYD" target="p56-B-WSB">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-08&lt;br&gt;循環・蓄圧" id="p56-IF-APU-08" link="docs/SSD-FD-APU-CIR-001.html#IF-APU-08" tooltip="IF-APU-08：循環ポンプの高圧側は軌道上で休止中のアキュムレータ圧力を保ち、低圧側は作動油を油圧配管に循環させて低温部を温める。循環ポンプの出口のアンローダ弁は、アキュムレータ圧力が2,563 psiaを超えるまで高圧側の吐出をアキュムレータへ送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B3FA0;strokeWidth=2;fontColor=#7B3FA0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p56-L_hyd" source="p56-B-CIR" target="p56-B-HYD">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="640" y="770" />
                <mxPoint x="1210" y="770" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-09&lt;br&gt;SSME・TVC" id="p56-IF-APU-09" link="docs/SSD-FD-APU-HYD-001.html#IF-APU-09" tooltip="IF-APU-09：3系統の油圧を、パネルR4のMPS/TVC ISOL VLVスイッチで開閉する隔離弁を経て、各SSMEの油圧作動弁5個の作動と推力方向制御（TVC）のために供給する。各SSMEのサーボアクチュエータは3系統のうち2系統（主・待機）から油圧を受け、各アクチュエータの切替弁が1系統を選ぶ。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B3FA0;strokeWidth=2;fontColor=#7B3FA0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.7857;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p56-L_hyd" source="p56-B-HYD" target="p56-B-MPS56">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="1400" y="830" />
                <mxPoint x="1560" y="830" />
                <mxPoint x="1560" y="890" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-10&lt;br&gt;空力舵面" id="p56-IF-APU-10" link="docs/SSD-FD-APU-HYD-001.html#IF-APU-10" tooltip="IF-APU-10：3系統の油圧を7面の空力舵面を駆動する油圧アクチュエータへ供給し、4基のエレボンのサーボアクチュエータにはそれぞれ3系統すべての油圧を供給する。エレボンの切替弁は主系の圧力が約1,200〜1,500 psiaに下がると第1待機系に、さらに第1待機系が下がると第2待機系に切り替える。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B3FA0;strokeWidth=2;fontColor=#7B3FA0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="p56-L_hyd" source="p56-B-HYD" target="p56-B-GNC56">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-11&lt;br&gt;脚・制動・操舵" id="p56-IF-APU-11" link="docs/SSD-FD-APU-HYD-001.html#IF-APU-11" tooltip="IF-APU-11：油圧系1の圧力を前脚・主脚のアップロックのアクチュエータへ送って脚を展開させ、油圧系1・2（系3が予備）を主脚ブレーキへ、油圧系1・2を前輪操舵へ供給する。ブレーキ隔離弁1・2・3は、主脚の接地を感知した後のGPC指令で開く。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B3FA0;strokeWidth=2;fontColor=#7B3FA0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p56-L_hyd" source="p56-B-HYD" target="p56-B-MECH56">
            <mxGeometry relative="1" as="geometry" x="0.125">
              <Array as="points">
                <mxPoint x="1440" y="770" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-12&lt;br&gt;APU計測" id="p56-IF-APU-12" link="docs/SSD-FD-APU-CTL-001.html#IF-APU-12" tooltip="IF-APU-12：APU制御器は燃料タンクの温度とGN2圧力をGPCへ送り、GPCが燃料量を計算して専用のMEDS表示のAPU FUEL/H2O QTY計に示す。潤滑油ポンプの出口圧力・出口温度とWSBからの戻り温度は、APU制御器からGPCを経てBFS SM SYS SUMM 2に表示される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3333;entryDx=0;entryDy=0;" edge="1" parent="p56-L_dat" source="p56-B-CTL" target="p56-B-DPS56">
            <mxGeometry relative="1" as="geometry" x="-0.4421">
              <Array as="points">
                <mxPoint x="450" y="520" />
                <mxPoint x="270" y="520" />
                <mxPoint x="270" y="630" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-13&lt;br&gt;循環ポンプ制御" id="p56-IF-APU-13" link="docs/SSD-FD-APU-CIR-001.html#IF-APU-13" tooltip="IF-APU-13：HYD CIRC PUMPスイッチがGPCのとき、SM GPCは油圧配管の温度とアキュムレータ圧力に基づく制御プログラムで循環ポンプを入り切りする。循環ポンプの出口圧力と油圧配管・機器の温度は、PASSのSM HYD THERMAL表示（DISP 87）に示される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p56-L_dat" source="p56-B-DPS56" target="p56-B-CIR">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-14&lt;br&gt;ボイラ水量" id="p56-IF-APU-14" link="docs/SSD-FD-APU-WSB-001.html#IF-APU-14" tooltip="IF-APU-14：各ボイラのGN2容器と水タンクの冗長な圧力・温度センサの値を制御器を通してSM GPCへ送り、GPCが水タンクの量を計算して専用のMEDS表示へ送る。ボイラの水量・窒素タンク圧力・調圧器圧力・窒素タンク温度は、軌道上ではSM APU/HYD表示（DISP 86）の右側に示される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.8667;entryDx=0;entryDy=0;" edge="1" parent="p56-L_dat" source="p56-B-WSB" target="p56-B-DPS56">
            <mxGeometry relative="1" as="geometry" x="-0.1875">
              <Array as="points">
                <mxPoint x="270" y="900" />
                <mxPoint x="270" y="710" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-15&lt;br&gt;過速度・低速度" id="p56-IF-APU-15" link="docs/SSD-FD-APU-CTL-001.html#IF-APU-15" tooltip="IF-APU-15：APU制御器が監視する回転数が80%未満または129%超になると、自動停止の有効・禁止によらずF7のAPU UNDERSPEED・APU OVERSPEEDの警報灯が点灯し、警報音が出る。主C/WのハードウェアにはAPU 1〜3のOVERSPEED（チャンネル68・78・88）とUNDERSPEED（98・108・118）が割り当てられている。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.8182;entryDx=0;entryDy=0;" edge="1" parent="p56-L_dat" source="p56-B-CTL" target="p56-B-CW56">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-16&lt;br&gt;油圧低下" id="p56-IF-APU-16" link="docs/SSD-FD-APU-HYD-001.html#IF-APU-16" tooltip="IF-APU-16：各油圧系のフィルタモジュールの圧力センサAは、系統1・2・3のいずれかの圧力が2,400 psi未満になるとF7の黄色のHYD PRESS灯へ入力を与える。油圧が2,400 psi未満になると、赤のBACKUP C/W ALARMも点灯する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.4545;entryDx=0;entryDy=0;" edge="1" parent="p56-L_dat" source="p56-B-HYD" target="p56-B-CW56">
            <mxGeometry relative="1" as="geometry" x="0.2764">
              <Array as="points">
                <mxPoint x="1480" y="600" />
                <mxPoint x="1480" y="210" />
                <mxPoint x="270" y="210" />
                <mxPoint x="270" y="350" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-17&lt;br&gt;28 VDC" id="p56-IF-APU-17" link="docs/SSD-FD-APU-CTL-001.html#IF-APU-17" tooltip="IF-APU-17：パネルR2のAPU CNTLR PWRスイッチをONにすると、その制御器とAPUに28 V直流電力が送られる。APU・燃料系・水系のヒータもパネルA12のスイッチで給電され、サーモスタットで自動制御される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.4545;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p56-L_pow" source="p56-B-EPS56" target="p56-B-CTL">
            <mxGeometry relative="1" as="geometry" x="-0.2381">
              <Array as="points">
                <mxPoint x="410" y="500" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-18&lt;br&gt;主母線電力" id="p56-IF-APU-18" link="docs/SSD-FD-APU-CIR-001.html#IF-APU-18" tooltip="IF-APU-18：各循環ポンプは、パネルA12のHYD CIRC PUMP POWERスイッチで選ぶ2系統の主母線のどちらかから給電される。故障処置手順の公称構成では、循環ポンプ1・2・3の電源はそれぞれMNA・MNB・MNCである。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.8182;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="p56-L_pow" source="p56-B-EPS56" target="p56-B-CIR">
            <mxGeometry relative="1" as="geometry" x="-0.4211">
              <Array as="points">
                <mxPoint x="360" y="540" />
                <mxPoint x="360" y="600" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-19&lt;br&gt;R2スイッチ" id="p56-IF-APU-19" link="docs/SSD-FD-APU-OPS-001.html#IF-APU-19" tooltip="IF-APU-19：パネルR2のAPU OPERATEスイッチをSTART/RUNにすると、対応する制御器がAPUの始動を開始し、ガス発生器と燃料ポンプのヒータの電力を自動で断つ。APU AUTO SHUT DOWNスイッチをENABLEにすると制御器の自動停止の機能が有効になり、INHIBITにすると禁止される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p56-L_dat" source="p56-B-OPS" target="p56-B-CTL">
            <mxGeometry relative="1" as="geometry" x="0.2222">
              <Array as="points">
                <mxPoint x="810" y="470" />
                <mxPoint x="640" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-20&lt;br&gt;主ポンプ圧" id="p56-IF-APU-20" link="docs/SSD-FD-APU-OPS-001.html#IF-APU-20" tooltip="IF-APU-20：パネルR2のHYD MAIN PUMP PRESSスイッチをLOWにすると減圧弁が通電して主ポンプの吐出圧を500〜1,000 psiに下げる。APUの始動後にHYD MAIN PUMP PRESSスイッチをLOWからNORMにすると、減圧弁の通電が切れて吐出圧が2,900〜3,100 psiに上がる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p56-L_dat" source="p56-B-OPS" target="p56-B-HYD">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-21&lt;br&gt;R2ボイラ" id="p56-IF-APU-21" link="docs/SSD-FD-APU-OPS-001.html#IF-APU-21" tooltip="IF-APU-21：パネルR2のBOILER N2 SUPPLY 1・2・3スイッチで各ボイラの窒素遮断弁を開閉し、遮断弁は2つの独立したソレノイドで主・副どちらの制御器からも操作できる。制御器が有効で、窒素遮断弁が開、蒸気ベントのノズル温度が130°F超、作動油のバイパス弁が正しい位置のとき、R2のAPU/HYD READY TO START表示へ準備完了の信号を送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0.1071;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p56-L_dat" source="p56-B-OPS" target="p56-B-WSB">
            <mxGeometry relative="1" as="geometry" x="0.2222">
              <Array as="points">
                <mxPoint x="1040" y="830" />
                <mxPoint x="1210" y="830" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-03&lt;br&gt;油圧熱交換器" id="p56-IF-TCS-03" link="docs/SSD-FD-TCS-HX-001.html#IF-TCS-03" tooltip="IF-TCS-03：軌道上の循環時はフレオンがフレオン／油圧作動油熱交換器で油圧作動油を加温する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p56-L_thm" source="p56-B-CIR" target="p56-B-THX56">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
