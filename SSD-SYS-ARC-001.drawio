            <mxGeometry relative="1" as="geometry" x="-0.5">
              <Array as="points">
                <mxPoint x="810" y="600" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-AVB-07&lt;br&gt;AC1〜3電力" id="p32-IF-AVB-07" link="docs/SSD-FD-ARS-AVB-FAN-001.html#IF-AVB-07" tooltip="IF-AVB-07：各ファンにはパネルL4の3個の遮断器を通して三相交流を供給し、ベイ1のファンA・BはAC1・AC2、ベイ2はAC2・AC3、ベイ3はAC3・AC1から受ける。ベイ1・2のファンは三相115 V ACの111 W電動機である。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.3824;exitY=1;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p32-L_pow" source="p32-B-EPS32" target="p32-B-FAN">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-AVB-08&lt;br&gt;選択・入切り" id="p32-IF-AVB-08" link="docs/SSD-FD-ARS-AVB-OPS-001.html#IF-AVB-08" tooltip="IF-AVB-08：運用規則に従い、パネルL1のAV BAY 1・2・3 FAN A・Bスイッチで運転するファンを選び、入切りする。打上げ時には、各ベイの1台のファンが運転済みである。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p32-L_dat" source="p32-B-OPS" target="p32-B-FAN">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-AVB-09&lt;br&gt;冷却空気" id="p32-IF-AVB-09" link="docs/SSD-FD-ARS-AVB-HX-001.html#IF-AVB-09" tooltip="IF-AVB-09：ベイ熱交換器で水冷却ループにより冷やした空気を、ベイへ戻す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p32-L_flu" source="p32-B-HX" target="p32-B-CIR">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-AVB-10&lt;br&gt;ベイ熱交換器" id="p32-IF-AVB-10" link="docs/SSD-FD-ARS-AVB-HX-001.html#IF-AVB-10" tooltip="IF-AVB-10：各ベイの空気/水熱交換器で、水冷却ループがファン出口空気から熱を受け取る。熱交換器を出る空気は、水冷却ループのポンプ出口温度より約10°F高い（A18-101C）。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p32-L_thm" source="p32-B-HX" target="p32-B-WCL32">
            <mxGeometry relative="1" as="geometry" x="0.3636">
              <Array as="points">
                <mxPoint x="1440" y="830" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-AVB-11&lt;br&gt;温度計測点" id="p32-IF-AVB-11" link="docs/SSD-FD-ARS-AVB-HX-001.html#IF-AVB-11" tooltip="IF-AVB-11：ミッドデッキ床下のファンプレナムで、ベイの空気/水熱交換器の近くにある温度センサがベイの空気温度を測る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p32-L_flu" source="p32-B-HX" target="p32-B-MON">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-AVB-12&lt;br&gt;温度・差圧" id="p32-IF-AVB-12" link="docs/SSD-FD-ARS-AVB-MON-001.html#IF-AVB-12" tooltip="IF-AVB-12：ベイ温度とファン差圧の表示・警報を、ファンとベイ冷却の喪失判定（A17-103・105）と、切替・処置の判断に使う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p32-L_dat" source="p32-B-MON" target="p32-B-OPS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-AVB-13&lt;br&gt;出口温度" id="p32-IF-AVB-13" link="docs/SSD-FD-ARS-AVB-MON-001.html#IF-AVB-13" tooltip="IF-AVB-13：ファン下流の温度センサのデータを、AIR TEMP計器と主C&amp;Wのハードウェアチャネル84・94・104（AV BAY/CABIN AIR灯）へ送る。ベイ温度はSM SYS SUMM 2とSPEC 66 ENVIRONMENTにも表示される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.3571;exitY=1;exitDx=0;exitDy=0;entryX=0.3571;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p32-L_dat" source="p32-B-MON" target="p32-B-DPS32">
            <mxGeometry relative="1" as="geometry" x="0.6" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-AVB-14&lt;br&gt;ファン差圧" id="p32-IF-AVB-14" link="docs/SSD-FD-ARS-AVB-MON-001.html#IF-AVB-14" tooltip="IF-AVB-14：ファン差圧をSM SYS SUMM 2（DISP 79）に表示する。差圧はSPEC 66でも監視され、2.5 in H2O未満または4.3 in H2O超（改良型ファンは4.5・7.8）でSM警報を出す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p32-L_dat" source="p32-B-MON" target="p32-B-DPS32">
            <mxGeometry relative="1" as="geometry" x="-0.2" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-AVB-15&lt;br&gt;AC φB" id="p32-IF-AVB-15" link="docs/SSD-FD-ARS-AVB-MON-001.html#IF-AVB-15" tooltip="IF-AVB-15：Av Bay 1・2・3の信号調整器には、それぞれAC3・AC1・AC2のB相をパネルL4の遮断器から供給する。信号調整器を失うとファンの状態が分からなくなるため、両ファンを運転する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.0441;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="p32-L_pow" source="p32-B-EPS32" target="p32-B-MON">
            <mxGeometry relative="1" as="geometry" x="-0.3226">
              <Array as="points">
                <mxPoint x="810" y="230" />
                <mxPoint x="360" y="230" />
                <mxPoint x="360" y="600" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-FDS-01&lt;br&gt;ベイ空気" id="p32-IF-FDS-01" link="docs/SSD-FD-ECL-FDS-DET-001.html#IF-FDS-01" tooltip="IF-FDS-01：各アビオニクスベイ（1・2・3A）の上部と下部の近くに煙感知器A・Bがあり、ベイ内を循環する空気を吸引して煙を検知する。ベイの両ファンが故障して空気が循環しない場合は、そのベイの煙検知を喪失とみなす（A17-2A）。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p32-L_flu" source="p32-B-CIR" target="p32-B-DET32">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-FDS-08&lt;br&gt;Halon放出" id="p32-IF-FDS-08" link="docs/SSD-FD-ECL-FDS-FIX-001.html#IF-FDS-08" tooltip="IF-FDS-08：AGENT DISCHでPICがボトルの火工弁を作動させ、Halon 1301をアビオニクスベイへ放出する。放出でベイ内のHalon濃度は7.5〜9.5%になり、消火には4〜5%が必要である。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="p32-L_flu" source="p32-B-FIX32" target="p32-B-CIR">
            <mxGeometry relative="1" as="geometry" x="0.5">
              <Array as="points">
                <mxPoint x="1570" y="470" />
                <mxPoint x="1570" y="420" />
                <mxPoint x="1560" y="420" />
                <mxPoint x="1560" y="390" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-FDS-11&lt;br&gt;ポート放出" id="p32-IF-FDS-11" link="docs/SSD-FD-ECL-FDS-PFE-001.html#IF-FDS-11" tooltip="IF-FDS-11：携帯消火器はアビオニクスベイの火災では固定ボトルの予備で、ベイへ放出するとベイ内のHalon濃度は6〜7%になる。煙検知を失ったベイでは、再突入のための機器の電源投入前に携帯のHalonボトルをそのベイへ放出する（A17-51A）。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p32-L_flu" source="p32-B-PFE32" target="p32-B-CIR">
            <mxGeometry relative="1" as="geometry" x="0.46">
              <Array as="points">
                <mxPoint x="1480" y="710" />
                <mxPoint x="1480" y="470" />
                <mxPoint x="1440" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
