          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F5FAD;fontColor=#1F5FAD;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p56-B-DPS56">
            <mxGeometry x="10" y="116" width="200" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="C/W：主C/W（ハードウェア）" id="p56-B-CW56" tooltip="F7の警報灯・主C/W（図62参照）" doc_no="SSD-FD-CW-PRI-001" abbr="CW" 分類="アビオニクス">
