        <UserObject label="IF-ECL-01&lt;br&gt;極低温O2" id="p3-IF-ECL-01" link="docs/SSD-FD-ECL-PCS-001.html#IF-ECL-01" tooltip="IF-ECL-01：ARPCSは酸素・窒素の2ガス方式で、酸素は反応剤貯蔵・分配（PRSD）サブシステムから得る。 PRSDは、燃料電池とARPCSへ極低温の水素・酸素を貯蔵・分配する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.0444;exitDx=0;exitDy=0;entryX=0;entryY=0.1695;entryDx=0;entryDy=0;" edge="1" parent="p3-L_flu" source="p3-B-EPS3" target="p3-B-PCS">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-02&lt;br&gt;O2/N2補給" id="p3-IF-ECL-02" link="docs/SSD-FD-ECL-PCS-001.html#IF-ECL-02" tooltip="IF-ECL-02：乗員室は14.7±0.2 psiaに与圧され、平均で窒素80%・酸素20%の混合気に維持される。 窒素は窒素貯蔵タンクから得る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.4237;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p3-L_flu" source="p3-B-PCS" target="p3-B-CAB">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-03&lt;br&gt;N2加圧" id="p3-IF-ECL-03" link="docs/SSD-FD-ECL-PCS-001.html#IF-ECL-03" tooltip="IF-ECL-03：各飲料水タンクと廃水タンクは、乗員室の窒素供給系から16 psigの窒素で加圧される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p3-L_flu" source="p3-B-PCS" target="p3-B-H2O">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-04&lt;br&gt;EMU用O2" id="p3-IF-ECL-04" link="docs/SSD-FD-ECL-PCS-001.html#IF-ECL-04" tooltip="IF-ECL-04：SCU接続時は、オービタの酸素系から900±500 psiaの酸素がエアロック盤AW82Bを通じて供給される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p3-L_flu" source="p3-B-PCS" target="p3-B-ALS">
            <mxGeometry relative="1" as="geometry" x="0.3">
              <Array as="points">
                <mxPoint x="520" y="238" />
                <mxPoint x="1264" y="238" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-05&lt;br&gt;空気循環" id="p3-IF-ECL-05" link="docs/SSD-FD-ECL-ARS-001.html#IF-ECL-05" tooltip="IF-ECL-05：ARSは相対湿度を30〜75%に制御し、二酸化炭素と一酸化炭素を無害な濃度に保ち、乗員室の温度と換気を制御する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p3-L_flu" source="p3-B-ARS" target="p3-B-CAB">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-06&lt;br&gt;排熱（インターチェンジャ）" id="p3-IF-ECL-06" link="docs/SSD-FD-ECL-ARS-001.html#IF-ECL-06" tooltip="IF-ECL-06：水冷却ループは、水とフレオン21冷却ループの熱交換器（インターチェンジャ）で熱をATCSへ渡す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p3-L_thm" source="p3-B-ARS" target="p3-B-ATCS">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-07&lt;br&gt;凝縮水" id="p3-IF-ECL-07" link="docs/SSD-FD-ECL-ARS-001.html#IF-ECL-07" tooltip="IF-ECL-07：廃水タンクは、ARSの湿度分離器と廃棄物収集系から廃水を受け入れる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.4237;exitDx=0;exitDy=0;entryX=1;entryY=0.4237;entryDx=0;entryDy=0;" edge="1" parent="p3-L_flu" source="p3-B-ARS" target="p3-B-H2O">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-08&lt;br&gt;アビオニクス冷却（水）" id="p3-IF-ECL-08" link="docs/SSD-FD-ECL-ARS-001.html#IF-ECL-08" tooltip="IF-ECL-08：水冷却ループは、3つのアビオニクスベイの空気／水熱交換器とコールドプレートを通じて電子機器を冷却する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p3-L_thm" source="p3-B-ARS" target="p3-B-DPS3">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1018" y="885" />
                <mxPoint x="1710" y="885" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-09&lt;br&gt;燃料電池排熱" id="p3-IF-ECL-09" link="docs/SSD-FD-ECL-ATCS-001.html#IF-ECL-09" tooltip="IF-ECL-09：ATCSは、各燃料電池の熱交換器から熱を受け取る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.7444;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p3-L_thm" source="p3-B-EPS3" target="p3-B-ATCS">
