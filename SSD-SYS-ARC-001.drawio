        <mxCell id="p54-v-26" value="・OMS推進薬・クロスフィード管" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p54-B-OMS54">
          <mxGeometry x="0" y="30" width="220" height="30" as="geometry" />
        </mxCell>
        <UserObject label="▶ 説明書 SSD-FD-OMS-XFD-001" id="p54-v-27" link="docs/SSD-FD-OMS-XFD-001.html" tooltip="クリックで SSD-FD-OMS-XFD-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C24A0C;fontColor=#C24A0C;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p54-B-OMS54">
            <mxGeometry x="10" y="66" width="200" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="電力系（EPS）" id="p54-B-EPS54" tooltip="主母線MNA〜C・AC1〜AC3" doc_no="SSD-FD-EPS-001" abbr="EPS" 分類="電力・環境・油圧">
          <mxCell style="swimlane;html=1;whiteSpace=wrap;startSize=30;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#FBF1CF;swimlaneFillColor=#FFFFFF;strokeColor=#A77B00;strokeWidth=1.5;fontColor=#15202B;fontStyle=1;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
            <mxGeometry x="380" y="1120" width="1080" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p54-v-28" value="・主母線MNA〜C・AC1〜AC3" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p54-B-EPS54">
          <mxGeometry x="0" y="30" width="1080" height="30" as="geometry" />
        </mxCell>
        <UserObject label="▶ 機能説明書　SSD-FD-EPS-001" id="p54-v-29" link="docs/SSD-FD-EPS-001.html" tooltip="クリックで SSD-FD-EPS-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#A77B00;fontColor=#A77B00;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p54-B-EPS54">
            <mxGeometry x="10" y="66" width="1060" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="警報系（C/W）" id="p54-B-CW54" tooltip="F7警報灯・故障メッセージ" doc_no="SSD-FD-CW-001" abbr="CW" 分類="アビオニクス">
          <mxCell style="swimlane;html=1;whiteSpace=wrap;startSize=30;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#DCE8F6;swimlaneFillColor=#FFFFFF;strokeColor=#1F5FAD;strokeWidth=1.5;fontColor=#15202B;fontStyle=1;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
            <mxGeometry x="30" y="250" width="220" height="800" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p54-v-30" value="・F7警報灯・故障メッセージ" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p54-B-CW54">
          <mxGeometry x="0" y="30" width="220" height="730" as="geometry" />
        </mxCell>
        <UserObject label="▶ 説明書 SSD-FD-CW-001" id="p54-v-31" link="docs/SSD-FD-CW-001.html" tooltip="クリックで SSD-FD-CW-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F5FAD;fontColor=#1F5FAD;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p54-B-CW54">
            <mxGeometry x="10" y="766" width="200" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-01&lt;br&gt;調圧He" id="p54-IF-RCS-01" link="docs/SSD-FD-RCS-HEP-001.html#IF-RCS-01" tooltip="IF-RCS-01：ヘリウムタンクのガスを隔離弁・調圧器を経て、調圧器組立と推進薬タンクの間にある逆止弁組立を通して燃料タンクと酸化剤タンクのアレージへ送る。調圧器は一次段で242〜248 psig、二次段で253〜259 psigに調圧する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p54-L_flu" source="p54-B-HEP" target="p54-B-PRP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-02&lt;br&gt;燃料・酸化剤" id="p54-IF-RCS-02" link="docs/SSD-FD-RCS-PRP-001.html#IF-RCS-02" tooltip="IF-RCS-02：推進薬タンクの燃料・酸化剤をタンク隔離弁とマニホールド隔離弁を通して各マニホールドの噴射器へ送り、マニホールド1〜4は主噴射器、5はバーニア噴射器に供給する。推進薬は噴射器で霧化・着火して高温のガスと推力を生む。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p54-L_flu" source="p54-B-PRP" target="p54-B-JET">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-03&lt;br&gt;弁駆動・Pc" id="p54-IF-RCS-03" link="docs/SSD-FD-RCS-RJD-001.html#IF-RCS-03" tooltip="IF-RCS-03：RJDはGPCの噴射指令を二元弁を開く電圧に変えて各噴射器の燃料・酸化剤の弁へ加え、噴射を開始させる。噴射器の燃焼室圧はRJDの電子回路で検知され、26 psia未満ではPc離散信号がゼロとなる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p54-L_dat" source="p54-B-RJD" target="p54-B-JET">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-04&lt;br&gt;Pc・出力離散" id="p54-IF-RCS-04" link="docs/SSD-FD-RCS-RJD-001.html#IF-RCS-04" tooltip="IF-RCS-04：RJDが生成する燃焼室圧の離散信号を、実際に噴射したことの表示としてRMへ送る。RMはPc離散信号、CMD B、ドライバ出力離散信号を噴射器の故障の検知に使う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p54-L_dat" source="p54-B-RJD" target="p54-B-RM">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-05&lt;br&gt;噴射器温度" id="p54-IF-RCS-05" link="docs/SSD-FD-RCS-JET-001.html#IF-RCS-05" tooltip="IF-RCS-05：各噴射器の燃料・酸化剤の噴射器温度をRMへ送り、RMの限界を3周期続けて下回ると漏れ（fail-leak）と判定させる。漏れの限界は、主噴射器で酸化剤30°F・燃料20°F、OPS 2のバーニアで130°Fである。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p54-L_dat" source="p54-B-JET" target="p54-B-RM">
            <mxGeometry relative="1" as="geometry" x="0.2222">
              <Array as="points">
                <mxPoint x="1040" y="470" />
                <mxPoint x="1210" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-06&lt;br&gt;弁状態・閉指令" id="p54-IF-RCS-06" link="docs/SSD-FD-RCS-RM-001.html#IF-RCS-06" tooltip="IF-RCS-06：RMは、マニホールド隔離弁の4つのマイクロスイッチ離散信号（OX OP・OX CL・FU OP・FU CL）からマニホールドの状態を評価する。OPS 2・8でfail-onが通報され、AUTO MANF CLが有効でスイッチがGPC位置なら、GPCが該当するマニホールドを自動で閉じる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.1071;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="p54-L_dat" source="p54-B-RM" target="p54-B-PRP">
            <mxGeometry relative="1" as="geometry" x="-0.4286">
              <Array as="points">
                <mxPoint x="1210" y="230" />
                <mxPoint x="360" y="230" />
                <mxPoint x="360" y="600" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-07&lt;br&gt;噴射器加熱" id="p54-IF-RCS-07" link="docs/SSD-FD-RCS-HTR-001.html#IF-RCS-07" tooltip="IF-RCS-07：各噴射器のヒータ（主噴射器20 W、後ろ向きの4基は30 W、バーニア10 W）が噴射器を安全な作動温度に保つ。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p54-L_thm" source="p54-B-HTR" target="p54-B-JET">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-08&lt;br&gt;推進薬加熱" id="p54-IF-RCS-08" link="docs/SSD-FD-RCS-HTR-001.html#IF-RCS-08" tooltip="IF-RCS-08：前部モジュールのパネルヒータと各ポッドの9ゾーンのヒータ（A・B系）が、タンクと配管の推進薬を概ね55〜75°Fに保つ。重要なヒータ回路はRCSのタンク・He配管、推進薬配管（RCSハウジング）、マニホールド配管を保護し、すべて冗長である。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0;exitY=0.45;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="p54-L_thm" source="p54-B-HTR" target="p54-B-PRP">
            <mxGeometry relative="1" as="geometry" x="0.2424">
              <Array as="points">
                <mxPoint x="680" y="940" />
                <mxPoint x="680" y="730" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-09&lt;br&gt;弁電源" id="p54-IF-RCS-09" link="docs/SSD-FD-RCS-PRP-001.html#IF-RCS-09" tooltip="IF-RCS-09：前部RCSの弁にはパネルMA73CのAC1・AC2・AC3 FWD RCS VLVの遮断器（9個）から、後部ポッドの弁にはAFT POD VLVの遮断器（9個）から三相交流を供給し、電動機制御組立（MCA）のロジック電源はMNA・MNB・MNCから受ける。後部のマニホールド隔離弁1〜4の弁ロジック電源はPOD AMC1〜3（MNA/B・MNB/C・MNC/A）の母線から得ており、これらの母線を失うとRCS PWR FAILとなる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.2407;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p54-L_pow" source="p54-B-EPS54" target="p54-B-PRP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-10&lt;br&gt;RJD電源" id="p54-IF-RCS-10" link="docs/SSD-FD-RCS-RJD-001.html#IF-RCS-10" tooltip="IF-RCS-10：パネルO14・O15・O16のスイッチを通して、主噴射器のRJDのLOGIC・DRIVER電源（16個）とバーニアのRJD（L5・F5・R5 DRIVER）に給電する。各RJDには冗長な2系統の電源がある。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.7685;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p54-L_pow" source="p54-B-EPS54" target="p54-B-RJD">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-11&lt;br&gt;ヒータ電源" id="p54-IF-RCS-11" link="docs/SSD-FD-RCS-HTR-001.html#IF-RCS-11" tooltip="IF-RCS-11：噴射器ヒータは主母線の直流配電から給電され、例えば主母線MNAのDA1を失うと後部RCS左右のJET 2ヒータ（FSM経由）が失われる。パネルA14のコネクタP9644のソケットAには、RCS JETヒータ用の主母線MNBの24 V直流電力が来ている。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p54-L_pow" source="p54-B-EPS54" target="p54-B-HTR">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-12&lt;br&gt;タンク圧・漏れ" id="p54-IF-RCS-12" link="docs/SSD-FD-RCS-PRP-001.html#IF-RCS-12" tooltip="IF-RCS-12：推進薬タンクのアレージ圧が200 psia未満か312 psia超になると、該当するLEFT RCS・FWD RCS・RIGHT RCSの赤色灯を点灯させる。燃料と酸化剤の量の差が9.5%を超えた場合も同じ灯を点灯させ、BACKUP C/W ALARMを作動させてDPSの表示に故障メッセージを送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.525;entryDx=0;entryDy=0;" edge="1" parent="p54-L_dat" source="p54-B-PRP" target="p54-B-CW54">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-13&lt;br&gt;噴射器故障" id="p54-IF-RCS-13" link="docs/SSD-FD-RCS-RM-001.html#IF-RCS-13" tooltip="IF-RCS-13：RMが検知した噴射器の故障は、黄色のRCS JET灯と赤色のBACKUP C/W ALARM灯を点灯させ、DPSの表示に故障メッセージを送る。PASSでは、噴射器のfail-on・fail-off・fail-leakでF(L,R) RCS X JETの故障メッセージを表示する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.0625;entryDx=0;entryDy=0;" edge="1" parent="p54-L_dat" source="p54-B-RM" target="p54-B-CW54">
            <mxGeometry relative="1" as="geometry" x="-0.0619">
              <Array as="points">
                <mxPoint x="1250" y="210" />
                <mxPoint x="270" y="210" />
                <mxPoint x="270" y="300" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-14&lt;br&gt;He圧低下" id="p54-IF-RCS-14" link="docs/SSD-FD-RCS-HEP-001.html#IF-RCS-14" tooltip="IF-RCS-14：ポッドのヘリウム圧（燃料か酸化剤）が500 psi未満になると、F(L,R) He Pの故障メッセージを出す。このメッセージには、ポケットチェックリストのRCS LEAK ISOLの手順で対処する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="p54-L_dat" source="p54-B-HEP" target="p54-B-CW54">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-15&lt;br&gt;温度警報" id="p54-IF-RCS-15" link="docs/SSD-FD-RCS-HTR-001.html#IF-RCS-15" tooltip="IF-RCS-15：構造の温度がI-loadの上下限を超えると、SMアラート「S89 PRPLT THRM RCS」を出す（OPS 2）。故障処置10.3aでは、前部RCSの燃料（酸化剤）の温度が46°F未満か105°F超などで処置に入り、他方のヒータ系に切り替えて原因を切り分ける。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.65;exitDx=0;exitDy=0;entryX=1;entryY=0.9125;entryDx=0;entryDy=0;" edge="1" parent="p54-L_dat" source="p54-B-HTR" target="p54-B-CW54">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-16&lt;br&gt;弁スイッチ" id="p54-IF-RCS-16" link="docs/SSD-FD-RCS-OPS-001.html#IF-RCS-16" tooltip="IF-RCS-16：運用規則と手順に従い、パネルO7・O8のスイッチで推進薬系の弁（タンク隔離・マニホールド隔離・クロスフィード）を操作する。トークバックは弁の対が開ならOP、閉ならCL、移動中や不一致ならバーバーポールを示す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="p54-L_dat" source="p54-B-OPS" target="p54-B-PRP">
            <mxGeometry relative="1" as="geometry" x="0.2424">
              <Array as="points">
                <mxPoint x="680" y="390" />
                <mxPoint x="680" y="600" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-17&lt;br&gt;He弁操作" id="p54-IF-RCS-17" link="docs/SSD-FD-RCS-OPS-001.html#IF-RCS-17" tooltip="IF-RCS-17：パネルO7・O8のHe PRESS A・Bスイッチでヘリウム隔離弁を操作し、調圧器の故障ではRCS REGULATOR RECONFIGの手順で使う加圧経路を切り替える。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p54-L_dat" source="p54-B-OPS" target="p54-B-HEP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-18&lt;br&gt;SPEC 23入力" id="p54-IF-RCS-18" link="docs/SSD-FD-RCS-OPS-001.html#IF-RCS-18" tooltip="IF-RCS-18：SPEC 23の項目入力で、噴射器の手動の選択解除・再選択、マニホールド状態の開・閉の上書き、ポッドの故障限度の変更を行う。マニホールドの自動閉（AUTO MANF CL）はSPEC 23で有効にする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p54-L_dat" source="p54-B-OPS" target="p54-B-RM">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-19&lt;br&gt;ヒータ操作" id="p54-IF-RCS-19" link="docs/SSD-FD-RCS-OPS-001.html#IF-RCS-19" tooltip="IF-RCS-19：運用規則に従い、パネルA14のヒータスイッチでヒータ系（A・B）の選択と入切を行う。ヒータ系は飛行中に少なくとも一度は冗長側（A・B）へ切り替える。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="p54-L_dat" source="p54-B-OPS" target="p54-B-HTR">
            <mxGeometry relative="1" as="geometry" x="-0.5529">
              <Array as="points">
                <mxPoint x="760" y="430" />
                <mxPoint x="760" y="900" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-14&lt;br&gt;噴射指令" id="p54-IF-GNC-14" link="docs/SSD-FD-GNC-FCS-001.html#IF-GNC-14" tooltip="IF-GNC-14：RCS DAPは、OMS噴射中を除く軌道上の全期間に、RCSジェットの噴射指令で機体の姿勢と角速度を制御する。再突入ではエアロジェットDAPがピッチの角速度誤差を動圧40 psfまでジェットの指令に変える。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p54-L_dat" source="p54-B-GNC54" target="p54-B-RJD">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-11&lt;br&gt;OMS推進薬" id="p54-IF-OMS-11" link="docs/SSD-FD-OMS-XFD-001.html#IF-OMS-11" tooltip="IF-OMS-11：OMS－RCSインタコネクトでは、OMSクロスフィード配管とRCSクロスフィード弁を通して、どちらかのOMSポッドの推進薬を後部RCSジェットへ送る。OMSエンジンが故障した場合は、インタコネクトでOMS推進薬を後部RCSへ送り、後部RCSの+Xジェットで予定のOMS噴射を完了できる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="p54-L_flu" source="p54-B-OMS54" target="p54-B-PRP">
            <mxGeometry relative="1" as="geometry" x="0.1731">
              <Array as="points">
