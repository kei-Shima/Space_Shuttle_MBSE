        <UserObject label="宇宙空間（船外）" id="p18-B-SPACE18" tooltip="PLB経由の逃し・ベント・真空ベント" doc_no="—" abbr="SPACE" 分類="外部（地上・宇宙インフラ）">
          <mxCell style="swimlane;html=1;whiteSpace=wrap;startSize=30;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=1.5;fontColor=#15202B;fontStyle=1;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
