          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p64-L_dat" source="p64-B-OPS" target="p64-B-MED">
