              <Array as="points">
                <mxPoint x="460" y="437" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-SYS-04&lt;br&gt;S帯／Ku帯" id="p1-IF-SYS-04" link="docs/SSD-FD-ORB-001.html#IF-SYS-04" tooltip="IF-SYS-04：S帯のフォワードリンクとリターンリンクは、地上局網STDNまたはTDRSを経由する。 S帯とKu帯のリンクは、いずれもNASAのTDRSシステムとの間で維持される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5F6B7A;strokeWidth=2;fontColor=#5F6B7A;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-L_rf" source="p1-B-ORB" target="p1-B-NET">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1280" y="300" />
                <mxPoint x="1280" y="195" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-SYS-05&lt;br&gt;ダウンリンク／アップリンク" id="p1-IF-SYS-05" link="docs/SSD-FD-EXT-001.html#IF-SYS-05" tooltip="IF-SYS-05：TDRSSのホワイトサンズ地上局（WSGT）が、シャトルのS帯・Ku帯リターンリンク信号を処理する。 ミッション管制センターの飛行管制官は、機体から地上へのデータ伝送（ダウンリンク）で機上システムの状態を監視する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p1-L_dat" source="p1-B-NET" target="p1-B-MCC">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-SYS-06&lt;br&gt;打上げデータバス×2" id="p1-IF-SYS-06" link="docs/SSD-FD-ORB-001.html#IF-SYS-06" tooltip="IF-SYS-06：2系統の双方向の打上げデータバス（LDB）が、機上コンピュータ系と打上げ処理システムを結ぶ。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-L_dat" source="p1-B-ORB" target="p1-B-LPS">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1330" y="450" />
                <mxPoint x="1330" y="785" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-SYS-08&lt;br&gt;ET 分離・給電" id="p1-IF-SYS-08" link="docs/SSD-FD-ORB-001.html#IF-SYS-08" tooltip="IF-SYS-08：外部タンクとオービタの間の電気・燃料アンビリカルは、オービタ下面の2つの後部アンビリカル開口から機内に入り、その空洞にオービタ／外部タンク結合点と燃料・電気の切離し部がある。 オービタのGPCが外部タンク分離を指令すると、火工品でボルトが切断される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5455;exitY=1;exitDx=0;exitDy=0;entryX=0.5667;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p1-L_dat" source="p1-B-ORB" target="p1-B-ET">
            <mxGeometry relative="1" as="geometry" x="-0.4" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-SYS-10&lt;br&gt;ホールドダウン" id="p1-IF-SYS-10" link="docs/SSD-FD-SRB-001.html#IF-SYS-10" tooltip="IF-SYS-10：各SRBは4本のホールドダウンポストを持ち、移動式発射台の支持ポストにはめ込んで、ホールドダウンボルトで固定する。 ボルト上端のフランジブルナットには2個のNSI起爆器があり、固体ロケットモータの点火指令で点火されて機体を解放する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.0938;exitY=1;exitDx=0;exitDy=0;entryX=0.9375;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p1-L_str" source="p1-B-LPS" target="p1-B-SRB">
            <mxGeometry relative="1" as="geometry" x="0.022">
              <Array as="points">
                <mxPoint x="1450" y="910" />
                <mxPoint x="600" y="910" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-SYS-09&lt;br&gt;T-0 アンビリカル" id="p1-IF-SYS-09" link="docs/SSD-FD-EXT-001.html#IF-SYS-09" tooltip="IF-SYS-09：打上げ前は、地上支援設備の液体酸素と液体水素が、それぞれのT-0アンビリカルから充填・排出弁と機体の供給配管マニホールドを通って送られる。 後部電力制御組立の電力接触器は、燃料電池が給電を引き継ぐまで、地上から供給される28 V直流電力をT-0アンビリカルを通じてオービタへ配電する。 着陸後は、右側のT-0アンビリカルに地上の空調パージ装置をつなぎ、後部胴体、ペイロードベイ、前部胴体、主翼、垂直尾翼、OMS/RCSポッドへ冷却空気を送って再突入の熱を除く。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.7059;exitDx=0;exitDy=0;entryX=0.9091;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p1-L_flu" source="p1-B-LPS" target="p1-B-ORB">
            <mxGeometry relative="1" as="geometry" x="-0.5">
              <Array as="points">
                <mxPoint x="1100" y="820" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
