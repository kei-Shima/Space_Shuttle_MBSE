        <mxCell id="p86-v-30" value="&lt;b style='font-size:12px'&gt;行動と機能&lt;/b&gt;&lt;table style='border-collapse:collapse;width:100%;font-size:10px;margin-top:4px;'&gt;&lt;tr&gt;&lt;th align='left'&gt;ID&lt;/th&gt;&lt;th align='left'&gt;行動&lt;/th&gt;&lt;th align='left'&gt;機能&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;AC-LK-01&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;減圧の警報（クラクソン・MASTER ALARM・CABIN ATM 灯）&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;F-ECL-PCS-10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;AC-LK-02&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;客室の逃し弁の隔離弁を閉じ、表示と計器で漏れを確かめる&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;F-ECL-PCS-04&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;AC-LK-03&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;大きな漏れでは 8 psi の非常用調圧器が流量を与える&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;F-ECL-PCS-09&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;AC-LK-07&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;上昇のアボートまたは緊急の軌道離脱（漏れ率で決める）&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;AC-LK-04&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;追加の漏れ隔離の手順を行う&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;F-ECL-PCS-07&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;AC-LK-05&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;減電する&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;F-EPS-DC-03&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;AC-LK-06&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;軌道離脱の準備をする&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1060" y="130" width="600" height="250" as="geometry" />
        </mxCell>
