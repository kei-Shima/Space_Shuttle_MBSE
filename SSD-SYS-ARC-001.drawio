          </mxCell>
        </UserObject>
        <mxCell id="p109-v-224" value="EDO パレットを積むと8組（最大18日）となり、余裕が大きく増える" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="270" y="1240" width="1170" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-08" id="p109-v-225" link="docs/SSD-VAR-ORB-001.html#MK-08" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1264" width="100" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="BUD-PWR-05" id="p109-v-226" link="docs/SSD-BUD-ORB-001.html#BUD-PWR-05" tooltip="開く">
