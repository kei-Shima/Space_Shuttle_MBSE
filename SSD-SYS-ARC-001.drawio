        </UserObject>
        <UserObject label="&lt;b&gt;AL-SH-0&lt;/b&gt; クラス0 限界検知&lt;br&gt;&lt;span style='font-size:10px'&gt;視覚：DPS 表示のパラメータの隣の上下の矢印（↑↓）。下向きは下限への到達と通常と違う状態（&lt;br&gt;音：無し&lt;/span&gt;" id="p152-v-11" link="docs/SSD-CIF-ORB-001.html#AL-SH-0" tooltip="AL-SH-0 クラス0 限界検知">
          <mxCell style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DCE8F6;strokeColor=#1F5FAD;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="60" y="564" width="560" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;AL-SH-A1&lt;/b&gt; 補助：DPS 表示の故障メッセージと記号&lt;br&gt;&lt;span style='font-size:10px'&gt;視覚：故障メッセージ（ACK まで点滅、MSG RESET で消える。GPC のメッセージはオ&lt;br&gt;音：無し（クラス2・3の報知に伴うときはそれぞれの音）&lt;/span&gt;" id="p152-v-12" link="docs/SSD-CIF-ORB-001.html#AL-SH-A1" tooltip="AL-SH-A1 補助：DPS 表示の故障メッセージと記号">
          <mxCell style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DCE8F6;strokeColor=#1F5FAD;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="60" y="682" width="560" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;AL-SH-A2&lt;/b&gt; 補助：系ごとの状態の表示灯・トークバック・表示の色&lt;br&gt;&lt;span style='font-size:10px'&gt;視覚：MAIN ENGINE STATUS 灯（赤＝停止・レッドライン違反、琥珀＝指令・データ&lt;br&gt;音：灯だけのもの（MAIN ENGINE STATUS・PFD の枠など）と、C&amp;amp;W・SM &lt;/span&gt;" id="p152-v-13" link="docs/SSD-CIF-ORB-001.html#AL-SH-A2" tooltip="AL-SH-A2 補助：系ごとの状態の表示灯・トークバック・表示の色">
          <mxCell style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#DCE8F6;strokeColor=#1F5FAD;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="60" y="800" width="560" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;AL-STD-1&lt;/b&gt; 緊急（火災）&lt;br&gt;&lt;span style='font-size:10px'&gt;視覚：赤の点滅&lt;br&gt;音：サイレン（650〜1,500 Hz を 5 s で往復）＋音声「Emergency Fi&lt;/span&gt;" id="p152-v-14" link="docs/SSD-CIF-ORB-001.html#AL-STD-1" tooltip="AL-STD-1 緊急（火災）">
