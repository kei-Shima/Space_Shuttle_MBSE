          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="566" width="70" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p154-v-72" value="被服" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="566" width="260" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-73" value="飛行前に各乗員が必須・任意の飛行装備の一覧から被服と着用装備を選び、軌道上ではズボン・上着・シャツ・睡眠用ショーツなどを着る。g スーツは突" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="566" width="640" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-74" value="3" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1010" y="566" width="90" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-75" value="&lt;span style='display:inline-block;width:73px;background:#C8E6C9'&gt;1&lt;/span&gt;&lt;span style='display:inline-block;width:146px;background:#FFF59D'&gt;2&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1100" y="566" width="260" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-76" value="REQ-CREW-01" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1360" y="566" width="360" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HF-08&lt;/b&gt;" id="p154-v-77" link="docs/SSD-HAB-ORB-001.html#HF-08" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="604" width="70" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p154-v-78" value="清掃・ごみ" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="604" width="260" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-79" value="各乗員が1日に何度か家事（WMC・食事区域・空気フィルタの清掃、ごみの処理、LiOH の交換）を行い、殺菌性の洗浄剤・使い捨ての手袋・ワイプ" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="604" width="640" height="38" as="geometry" />
        </mxCell>
