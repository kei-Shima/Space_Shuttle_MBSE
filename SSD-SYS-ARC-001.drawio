        <mxCell id="p121-v-5" value="&lt;b&gt;原因&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="420" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p121-v-6" value="&lt;b&gt;ハザード&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="150" width="300" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p121-v-7" value="&lt;b&gt;管理策（種類：管理策 → 要求・警報・規則）&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="960" y="150" width="520" height="26" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HZ-01 キャビン・アビオニクスベイの火災&lt;/b&gt;&lt;br&gt;破局的・起こりやすさ 中&lt;br&gt;乗員の負傷・死亡、重要機器の喪失（乗員・機体の喪失）" id="p121-v-8" link="docs/SSD-HAZ-ORB-001.html#HZ-01" tooltip="HZ-01">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="560" y="216" width="300" height="196" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HC-01&lt;/b&gt; アビオニクスベイの電気的短絡・アークトラッキング" id="p121-v-9" link="docs/SSD-HAZ-ORB-001.html#HC-01" tooltip="HC-01">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFF3E0;strokeColor=#E4570E;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="190" width="420" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HC-02&lt;/b&gt; キャビン内の機器・材料の燃焼（ファンの対流で酸化剤が供給される）" id="p121-v-10" link="docs/SSD-HAZ-ORB-001.html#HC-02" tooltip="HC-02">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFF3E0;strokeColor=#E4570E;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="250" width="420" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HC-03&lt;/b&gt; 酸素の多い大気（ヘルメット着用中の酸素の多い呼気で PPO2 が可燃限界に近づく）" id="p121-v-11" link="docs/SSD-HAZ-ORB-001.html#HC-03" tooltip="HC-03">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFF3E0;strokeColor=#E4570E;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="310" width="420" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-01&lt;/b&gt; 警報：イオン化式の煙感知器で煙濃度・急増を検知し、サイレン・MASTER ALARM・SMOKE DETECTION 灯で知らせる（クラス1）&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-ECLSS-11・REQ-CW-06・EM-01・A17-1&lt;/span&gt;" id="p121-v-12" link="docs/SSD-HAZ-ORB-001.html#HM-01" tooltip="HM-01">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="190" width="520" height="56" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-02&lt;/b&gt; 手順：ファンを止め、ヘルメット・QDM で身を守り、固定式・携帯式のハロンで消火する&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-ECLSS-11・EM-01・A17-53&lt;/span&gt;" id="p121-v-13" link="docs/SSD-HAZ-ORB-001.html#HM-02" tooltip="HM-02">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="262" width="520" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-03&lt;/b&gt; 飛行規則：火災後はベイの機器を電源断して着火源を減らし、短絡した回路は回路保護を再投入しない&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-EPS-17・A17-53・A9-105&lt;/span&gt;" id="p121-v-14" link="docs/SSD-HAZ-ORB-001.html#HM-03" tooltip="HM-03">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="322" width="520" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-04&lt;/b&gt; 運用制約：大気を浄化できず PPO2 を可燃限界より下に保てなければ早期に軌道離脱する（生命維持の Go/No-Go）&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-ECLSS-12・A17-1001&lt;/span&gt;" id="p121-v-15" link="docs/SSD-HAZ-ORB-001.html#HM-04" tooltip="HM-04">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="382" width="520" height="56" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HZ-02 キャビンの減圧（与圧の喪失）&lt;/b&gt;&lt;br&gt;破局的・起こりやすさ 中&lt;br&gt;呼吸用酸素と機器冷却の喪失、窓の両ペインの喪失で乗員とオービタの喪失" id="p121-v-16" link="docs/SSD-HAZ-ORB-001.html#HZ-02" tooltip="HZ-02">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="560" y="540" width="300" height="240" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HC-04&lt;/b&gt; 与圧殻・窓の破損（上昇初期の差圧、デブリの衝突）" id="p121-v-17" link="docs/SSD-HAZ-ORB-001.html#HC-04" tooltip="HC-04">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFF3E0;strokeColor=#E4570E;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="488" width="420" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HC-05&lt;/b&gt; PCS（O2/N2 供給）の隔離できない漏れ・制御の故障" id="p121-v-18" link="docs/SSD-HAZ-ORB-001.html#HC-05" tooltip="HC-05">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFF3E0;strokeColor=#E4570E;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="548" width="420" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HC-06&lt;/b&gt; 正圧逃し弁の不作動（過大圧）・キャビンベント弁の不用意な開放" id="p121-v-19" link="docs/SSD-HAZ-ORB-001.html#HC-06" tooltip="HC-06">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFF3E0;strokeColor=#E4570E;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="608" width="420" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-05&lt;/b&gt; 警報：dP/dT −0.08 psi/min でクラクソン・MASTER ALARM、客室圧・PPO2・O2/N2 流量の限界外で CABIN ATM 灯&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-ECLSS-02・REQ-CW-06・EM-02・CW-06&lt;/span&gt;" id="p121-v-20" link="docs/SSD-HAZ-ORB-001.html#HM-05" tooltip="HM-05">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="488" width="520" height="56" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-06&lt;/b&gt; 手順：漏れの大きさの評価・逃し弁の隔離弁を閉じての確認・再構成による隔離・電源の削減・軌道離脱の準備&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-ECLSS-01・CW-06・A17-201&lt;/span&gt;" id="p121-v-21" link="docs/SSD-HAZ-ORB-001.html#HM-06" tooltip="HM-06">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="560" width="520" height="56" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-07&lt;/b&gt; 飛行規則：漏れの率で intact アボート・AOA を選び、軌道上は 8 psia を保って TMAX までに軌道離脱する&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-ECLSS-03・REQ-SYS-15・A17-201・A17-258&lt;/span&gt;" id="p121-v-22" link="docs/SSD-HAZ-ORB-001.html#HM-07" tooltip="HM-07">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="632" width="520" height="56" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-08&lt;/b&gt; 設計：窓に圧力ペインと冗長ペインを持たせ、片方が壊れたらキャビン圧を 10.2 psi に下げて次の PLS で帰還する&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-STR-03・REQ-STR-04・A10-382&lt;/span&gt;" id="p121-v-23" link="docs/SSD-HAZ-ORB-001.html#HM-08" tooltip="HM-08">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="704" width="520" height="56" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-09&lt;/b&gt; 設計：2つの正圧逃し弁を全飛行段階で有効にし、キャビンベント弁は上昇後に回路遮断器を開けて誤開放を防ぐ&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-ECLSS-02・A17-252・A17-253&lt;/span&gt;" id="p121-v-24" link="docs/SSD-HAZ-ORB-001.html#HM-09" tooltip="HM-09">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="776" width="520" height="56" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HZ-04 電力の喪失（燃料電池・極低温反応剤・主母線）&lt;/b&gt;&lt;br&gt;破局的・起こりやすさ 低&lt;br&gt;すべての電力の喪失による乗員・機体の喪失、燃料電池内の O2/H2 混合による爆発" id="p121-v-25" link="docs/SSD-HAZ-ORB-001.html#HZ-04" tooltip="HZ-04">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="560" y="928" width="300" height="240" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HC-11&lt;/b&gt; 極低温反応剤（O2・H2）のタンク・マニホールドの漏れ、ヒータの短絡" id="p121-v-26" link="docs/SSD-HAZ-ORB-001.html#HC-11" tooltip="HC-11">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFF3E0;strokeColor=#E4570E;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="882" width="420" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HC-12&lt;/b&gt; 燃料電池の冷却喪失（冷却材ポンプ・交流母線・ECU・ESS 母線の故障、冷却材の漏れ）" id="p121-v-27" link="docs/SSD-HAZ-ORB-001.html#HC-12" tooltip="HC-12">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFF3E0;strokeColor=#E4570E;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="942" width="420" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HC-13&lt;/b&gt; 反応剤弁の閉故障による燃料電池の停止" id="p121-v-28" link="docs/SSD-HAZ-ORB-001.html#HC-13" tooltip="HC-13">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFF3E0;strokeColor=#E4570E;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1002" width="420" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HC-14&lt;/b&gt; 主母線・制御母線の短絡" id="p121-v-29" link="docs/SSD-HAZ-ORB-001.html#HC-14" tooltip="HC-14">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFF3E0;strokeColor=#E4570E;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1062" width="420" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-15&lt;/b&gt; 設計：逆止弁で漏れたタンクから他のタンクへの逆流を止め、マニホールドの隔離弁で漏れを隔離する。O2 ヒータは電流差センサで短絡を切る&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-EPS-13・REQ-EPS-10・CW-01・CW-02・CW-07・A9-260・A9-204&lt;/span&gt;" id="p121-v-30" link="docs/SSD-HAZ-ORB-001.html#HM-15" tooltip="HM-15">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="882" width="520" height="56" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-16&lt;/b&gt; 飛行規則：冷却を失った燃料電池は 7 kW で9分以内に停止し、バスタイで主母線を保つ&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-EPS-15・REQ-EPS-03・CW-04・CW-05・A9-1・A9-60&lt;/span&gt;" id="p121-v-31" link="docs/SSD-HAZ-ORB-001.html#HM-16" tooltip="HM-16">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="954" width="520" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-17&lt;/b&gt; 手順：反応剤弁の警報では PLT が直ちに弁の再開とバスタイを試み、確認された故障では燃料電池を停止する&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-EPS-03・CW-03・A9-1&lt;/span&gt;" id="p121-v-32" link="docs/SSD-HAZ-ORB-001.html#HM-17" tooltip="HM-17">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="1014" width="520" height="56" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-18&lt;/b&gt; 設計：3基の燃料電池を独立した主母線に給電させ、RPC・ヒューズ・回路遮断器で短絡を切る。健全な母線を短絡した母線に結ばない&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-EPS-03・REQ-EPS-07・REQ-EPS-17・CW-08・A9-107&lt;/span&gt;" id="p121-v-33" link="docs/SSD-HAZ-ORB-001.html#HM-18" tooltip="HM-18">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="1086" width="520" height="56" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-19&lt;/b&gt; 飛行規則：極低温タンク・燃料電池・母線の喪失の数で MDF・次の PLS を判定し、上昇中の極低温の喪失は地上までの時間が最短のアボートとする&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-EPS-18・REQ-SYS-14・A9-1001・A2-54&lt;/span&gt;" id="p121-v-34" link="docs/SSD-HAZ-ORB-001.html#HM-19" tooltip="HM-19">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="1158" width="520" height="56" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HZ-10 TPS（タイル・RCC・熱窓）の損傷による再突入の過熱&lt;/b&gt;&lt;br&gt;破局的・起こりやすさ 高&lt;br&gt;再突入中の構造破壊（乗員・機体の喪失、STS-107）" id="p121-v-35" link="docs/SSD-HAZ-ORB-001.html#HZ-10" tooltip="HZ-10">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFEBEE;strokeColor=#B71C1C;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="560" y="1286" width="300" height="240" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HC-29&lt;/b&gt; 上昇中の ET 発泡断熱材などの落下物の衝突" id="p121-v-36" link="docs/SSD-HAZ-ORB-001.html#HC-29" tooltip="HC-29">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFF3E0;strokeColor=#E4570E;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1264" width="420" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HC-30&lt;/b&gt; 軌道デブリ・微小隕石の衝突" id="p121-v-37" link="docs/SSD-HAZ-ORB-001.html#HC-30" tooltip="HC-30">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFF3E0;strokeColor=#E4570E;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1324" width="420" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HC-31&lt;/b&gt; 突き出たギャップフィラー・熱窓ガラスの損傷、接着層の低温による脆化" id="p121-v-38" link="docs/SSD-HAZ-ORB-001.html#HC-31" tooltip="HC-31">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFF3E0;strokeColor=#E4570E;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1384" width="420" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-42&lt;/b&gt; 検査：上昇中の落下物と衝突を地上・ET のカメラ、レーダ、翼前縁の衝突検知計装で監視する&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-ET-07&lt;/span&gt;" id="p121-v-39" link="docs/SSD-HAZ-ORB-001.html#HM-42" tooltip="HM-42">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="1264" width="520" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-43&lt;/b&gt; 検査：OBSS による軌道上の TPS 全域の点検と、RPM での ISS からの撮影、損傷評価チームの判定&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-TPS-01&lt;/span&gt;" id="p121-v-40" link="docs/SSD-HAZ-ORB-001.html#HM-43" tooltip="HM-43">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="1324" width="520" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-44&lt;/b&gt; 手順：突き出たギャップフィラーなど再突入の加熱を増やす異常は EVA で取り除く&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-EVA-06&lt;/span&gt;" id="p121-v-41" link="docs/SSD-HAZ-ORB-001.html#HM-44" tooltip="HM-44">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="1384" width="520" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-45&lt;/b&gt; 運用制約：デブリに弱い姿勢（-ZVV）の時間を制限し、姿勢で TPS の接着層の温度を管理する&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-TPS-03・REQ-STR-08・A2-131・A18-401・A18-451&lt;/span&gt;" id="p121-v-42" link="docs/SSD-HAZ-ORB-001.html#HM-45" tooltip="HM-45">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="1444" width="520" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;HM-46&lt;/b&gt; 飛行規則：外側の熱窓ガラスの破損では熱応力の小さい RTLS でアボートする&lt;br&gt;&lt;span style='color:#3B4654'&gt;REQ-STR-04・A10-381・A2-54&lt;/span&gt;" id="p121-v-43" link="docs/SSD-HAZ-ORB-001.html#HM-46" tooltip="HM-46">
          <mxCell style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="960" y="1504" width="520" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" id="p121-v-44" link="docs/SSD-HAZ-ORB-001.html#HC-01" tooltip="HC-01 → HZ-01">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5F6B7A;strokeWidth=2;fontColor=#5F6B7A;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;endArrow=block;endFill=1;endSize=7;exitX=1.0;exitY=0.4545;exitDx=0;exitDy=0;entryX=0.0;entryY=0.0714;entryDx=0;entryDy=0;" edge="1" parent="1" source="p121-v-9" target="p121-v-8">
