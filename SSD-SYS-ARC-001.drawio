        <UserObject label="IF-AVB-01&lt;br&gt;吸込み空気" id="p32-IF-AVB-01" link="docs/SSD-FD-ARS-AVB-CIR-001.html#IF-AVB-01" tooltip="IF-AVB-01：ベイの床から空冷機器と300ミクロンフィルタを通した空気を、ベイファンの入口へ送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p32-L_flu" source="p32-B-CIR" target="p32-B-FAN">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-AVB-02&lt;br&gt;GPC空冷" id="p32-IF-AVB-02" link="docs/SSD-FD-ARS-AVB-CIR-001.html#IF-AVB-02" tooltip="IF-AVB-02：GPC 1・4（ベイ1）、GPC 2・5（ベイ2）、GPC 3（ベイ3）は、ベイファンが循環させる空気で強制空冷される。ベイファンを止めてよい時間は、GPCの冷却の制約から最大26分である（A18-501）。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p32-L_thm" source="p32-B-CIR" target="p32-B-DPS32">
            <mxGeometry relative="1" as="geometry" x="0.41">
              <Array as="points">
                <mxPoint x="1440" y="240" />
                <mxPoint x="1860" y="240" />
                <mxPoint x="1860" y="900" />
                <mxPoint x="670" y="900" />
                <mxPoint x="670" y="840" />
                <mxPoint x="640" y="840" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-AVB-03&lt;br&gt;IDA空冷" id="p32-IF-AVB-03" link="docs/SSD-FD-ARS-AVB-CIR-001.html#IF-AVB-03" tooltip="IF-AVB-03：前方ベイ1〜3のインバータ分配組立は、ベイの空気で空冷される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.7941;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p32-L_thm" source="p32-B-CIR" target="p32-B-EPS32">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-AVB-04&lt;br&gt;TACAN空冷" id="p32-IF-AVB-04" link="docs/SSD-FD-ARS-AVB-CIR-001.html#IF-AVB-04" tooltip="IF-AVB-04：交流で動くGould製TACANはベイファンで冷却され、冷却を失うと5分以内に短絡しうる。冷却を回復できない場合は、ベイ内のTACANとMLSを早急に断電する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p32-L_thm" source="p32-B-CIR" target="p32-B-GNC32">
            <mxGeometry relative="1" as="geometry" x="-0.6429">
              <Array as="points">
                <mxPoint x="1560" y="430" />
                <mxPoint x="1560" y="590" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-AVB-05&lt;br&gt;送風" id="p32-IF-AVB-05" link="docs/SSD-FD-ARS-AVB-FAN-001.html#IF-AVB-05" tooltip="IF-AVB-05：ファンの出口は空気をそのベイの熱交換器へ送り、非運転ファンの出口の逆止弁が逆流を防ぐ。">
