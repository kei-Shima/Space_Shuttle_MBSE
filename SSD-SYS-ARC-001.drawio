        <mxCell id="p102-v-27" value="&lt;b style='font-size:12px'&gt;遷移（トリガ［ガード］）&lt;/b&gt;&lt;table style='border-collapse:collapse;width:100%;font-size:10px;margin-top:4px;'&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;TCT-01&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;TC-GSE→TC-INER&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;リフトオフ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;TCT-02&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;TC-INER→TC-FES&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;SRB分離でBFSがFESをON［140,000 ft超（MM103）］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;TCT-03&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;TC-FES→TC-RADF&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;放熱器へ流し、ドアを開く［軌道投入後］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;TCT-04&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;TC-RADF→TC-RADO&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;トッピングFESを停止［放熱器で冷却が足りる］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;TCT-05&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;TC-RADO→TC-RADF&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;FESが補助を開始［暖かい姿勢・高い熱負荷］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;TCT-06&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;TC-RAD→TC-CSK&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;RAD OUT設定をHI、FES再起動［離脱準備・ドア閉鎖前］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;TCT-07&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;TC-CSK→TC-FES&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;放熱器をバイパス［約1時間後］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;TCT-08&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;TC-FES→TC-RCSK&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;V=12kで放熱器流を再開［コールドソーク済み］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;TCT-09&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;TC-FES→TC-NH3&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;BFSがNH3ボイラをON［アボート（MM304の120k ft・MM602）］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;TCT-10&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;TC-RCSK→TC-NH3&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;放熱器出口温度55°F到達［着陸後］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;TCT-11&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;TC-NH3→TC-GSE&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;地上冷却カートの接続完了&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1370" y="130" width="600" height="249" as="geometry" />
        </mxCell>
