          </mxCell>
        </UserObject>
        <UserObject label="IF-FDS-03&lt;br&gt;煙濃度" id="p26-IF-FDS-03" link="docs/SSD-FD-ECL-FDS-DET-001.html#IF-FDS-03" tooltip="IF-FDS-03：各感知器の濃度のアナログ出力はGPCへ送られてSM SYS SUMM 1（SPEC 78）に表示され、2.0 mg/m³でバックアップC&amp;Wが警報を出す。OI MDM（OF1）を失うと一部の感知器の濃度計測が失われるが、ハードウェアの煙警報は残る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2059;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p26-L_dat" source="p26-B-DET" target="p26-B-DPS26">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-FDS-04&lt;br&gt;主母線A・B・C" id="p26-IF-FDS-04" link="docs/SSD-FD-ECL-FDS-DET-001.html#IF-FDS-04" tooltip="IF-FDS-04：感知器には、パネルO14・O15・O16のSMOKE DETN遮断器から、主母線A（L/R FLT DK、BAY 2A/3B）・B（BAY 1B/3A）・C（CABIN、BAY 1A/2B）の電力を供給する。主母線A（DA1）を失うと、フライトデッキ左右・ベイ2のA・ベイ3AのBの感知器が失われ、キャビンの感知器は残る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.2037;exitY=0;exitDx=0;exitDy=0;entryX=0.7857;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p26-L_pow" source="p26-B-EPS26" target="p26-B-DET">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-FDS-05&lt;br&gt;リセット・試験" id="p26-IF-FDS-05" link="docs/SSD-FD-ECL-FDS-ALM-001.html#IF-FDS-05" tooltip="IF-FDS-05：パネルL1のSENSOR RESETで感知器の論理回路をリセットし、CIRCUIT TESTでA群またはB群の感知器にCNTL BUS BC3の28 Vを加えて灯と20秒の時間遅れを試験する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p26-L_dat" source="p26-B-ALM" target="p26-B-DET">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-FDS-06&lt;br&gt;サイレン・MA" id="p26-IF-FDS-06" link="docs/SSD-FD-ECL-FDS-ALM-001.html#IF-FDS-06" tooltip="IF-FDS-06：煙警報でC&amp;Wのサイレンを鳴らし、パネルF2・F4・A7・MO52Jの4つのMASTER ALARM灯を点灯させる。C&amp;Wの電源A（B）を失うと、音声発生器A（B）による煙警報音が失われる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.7941;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p26-L_dat" source="p26-B-ALM" target="p26-B-DPS26">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-FDS-07&lt;br&gt;警報表示" id="p26-IF-FDS-07" link="docs/SSD-FD-ECL-FDS-ALM-001.html#IF-FDS-07" tooltip="IF-FDS-07：SMOKE DETECTION灯・サイレンとDPS表示の濃度から、乗員は火災の位置を特定し、実際の火災かを確かめる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p26-L_dat" source="p26-B-ALM" target="p26-B-OPS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-FDS-08&lt;br&gt;Halon放出" id="p26-IF-FDS-08" link="docs/SSD-FD-ECL-FDS-FIX-001.html#IF-FDS-08" tooltip="IF-FDS-08：AGENT DISCHでPICがボトルの火工弁を作動させ、Halon 1301をアビオニクスベイへ放出する。放出でベイ内のHalon濃度は7.5〜9.5%になり、消火には4〜5%が必要である。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.84;entryDx=0;entryDy=0;" edge="1" parent="p26-L_flu" source="p26-B-FIX" target="p26-B-AVB26">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-FDS-09&lt;br&gt;ボトル計測" id="p26-IF-FDS-09" link="docs/SSD-FD-ECL-FDS-FIX-001.html#IF-FDS-09" tooltip="IF-FDS-09：煙検知系と遠隔消火系の各種パラメータはテレメトリへ送られる。MCCはボトルが空になったことは分かるが、漏れの始まりや放出の時刻は分からない（A17-54A）。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.9706;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p26-L_dat" source="p26-B-FIX" target="p26-B-DPS26">
            <mxGeometry relative="1" as="geometry" x="-0.3733">
              <Array as="points">
                <mxPoint x="1080" y="600" />
                <mxPoint x="1080" y="160" />
                <mxPoint x="1040" y="160" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-FDS-10&lt;br&gt;PIC電源" id="p26-IF-FDS-10" link="docs/SSD-FD-ECL-FDS-FIX-001.html#IF-FDS-10" tooltip="IF-FDS-10：各ベイのボトルのPICには、FIRE SUPPR BAY 1（主母線B、O15）・BAY 2（主母線C、O16）・BAY 3（主母線A、O14）の遮断器から電力を供給する。ARMでAGENT DISCH押しボタンに電力が加わり、押すと1秒の時間遅れの後に主母線の電力がPICへ送られる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.7685;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p26-L_pow" source="p26-B-EPS26" target="p26-B-FIX">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-FDS-11&lt;br&gt;ポート放出" id="p26-IF-FDS-11" link="docs/SSD-FD-ECL-FDS-PFE-001.html#IF-FDS-11" tooltip="IF-FDS-11：携帯消火器はアビオニクスベイの火災では固定ボトルの予備で、ベイへ放出するとベイ内のHalon濃度は6〜7%になる。煙検知を失ったベイでは、再突入のための機器の電源投入前に携帯のHalonボトルをそのベイへ放出する（A17-51A）。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.24;entryDx=0;entryDy=0;" edge="1" parent="p26-L_flu" source="p26-B-PFE" target="p26-B-AVB26">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-FDS-12&lt;br&gt;携帯消火" id="p26-IF-FDS-12" link="docs/SSD-FD-ECL-FDS-PFE-001.html#IF-FDS-12" tooltip="IF-FDS-12：携帯消火器は、乗員室の開放空間の火災では炎の根元へ、計器盤内部の火災では消火ポートにノズルを差し込んで放出する。乗員室でHalonが有効なのはキャビンファンを止めたときだけで、空気が循環していると3本を放出しても濃度は1%未満にとどまる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p26-L_flu" source="p26-B-PFE" target="p26-B-CAB26">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-FDS-13&lt;br&gt;ARM・DISCH" id="p26-IF-FDS-13" link="docs/SSD-FD-ECL-FDS-OPS-001.html#IF-FDS-13" tooltip="IF-FDS-13：ベイの火災を確認したら、そのベイのHalonボトルを放出し、ベイファンを止める（A17-53A）。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p26-L_dat" source="p26-B-OPS" target="p26-B-FIX">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-FDS-14&lt;br&gt;放出判断" id="p26-IF-FDS-14" link="docs/SSD-FD-ECL-FDS-OPS-001.html#IF-FDS-14" tooltip="IF-FDS-14：乗員室の火災では、キャビンファンを止めてヘルメットを着けたうえで、携帯のHalonボトルを適切な消火ポートへ放出する（A17-53B）。放出の前に、乗員が火元を特定して火災を確かめる必要がある（A17-1A）。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p26-L_dat" source="p26-B-OPS" target="p26-B-PFE">
            <mxGeometry relative="1" as="geometry" x="0.2222">
              <Array as="points">
                <mxPoint x="1040" y="470" />
                <mxPoint x="1210" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-04&lt;br&gt;煙感知（還流）" id="p26-IF-CAC-04" link="docs/SSD-FD-CAC-RTN-001.html#IF-CAC-04" tooltip="IF-CAC-04：フライトデッキの左還流ダクトにA群、右還流ダクトにB群の煙感知器があり、還流空気の煙を検知する。C&amp;Wの訓練マニュアルも、A群をフライトデッキの左還流ダクト、B群を右還流ダクトに置くとする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p26-L_flu" source="p26-B-RTN26" target="p26-B-DET">
            <mxGeometry relative="1" as="geometry" x="-0.1111">
              <Array as="points">
                <mxPoint x="410" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-08&lt;br&gt;煙感知（出口）" id="p26-IF-CAC-08" link="docs/SSD-FD-CAC-FAN-001.html#IF-CAC-08" tooltip="IF-CAC-08：ミッドデッキ床下のECLSSベイのキャビンファン・プレナムに煙感知器があり、パネルL1のSMOKE DETECTIONのCABIN灯を点灯させる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p26-L_flu" source="p26-B-FAN26" target="p26-B-DET">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;図示を省略したIF（文書・図5に記載）&lt;/b&gt;&lt;br&gt;なし（IF-FDS-01〜14 をすべて図示）&lt;br&gt;&lt;br&gt;他の図と同じ物理IFのため、その番号のまま描いたIF：IF-CAC-04（図16）・IF-CAC-08（図16）&lt;br&gt;&lt;br&gt;各ブロックの「関連文書」ボタンは、機能別関連文書一覧（SSD-FDS-REF-001）の該当節を開きます。" id="p26-v-30" link="data:page/id,p5-register" tooltip="図5のIF一覧へ">
          <mxCell style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#FAFBFC;strokeColor=#9AA3AE;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#3B4654;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1175" y="950" width="310" height="170" as="geometry" />
          </mxCell>
        </UserObject>
