        </mxCell>
        <mxCell id="p133-v-112" value="手動パージは繰り返し実証したが、流量計の出力が低く自動パージのソフトウェアは働かず、50% の完了とされた。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
