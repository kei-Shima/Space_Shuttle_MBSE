        <UserObject label="▶ 節点・流れの表と根拠（SSD-BEH-ORB-004）" id="p86-v-33" link="docs/SSD-BEH-ORB-004.html" tooltip="SSD-BEH-ORB-004 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F5FAD;fontColor=#1F5FAD;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1">
