        <mxCell id="p133-v-141" value="再突入の加熱環境の検証" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="900" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-142" value="15,300 ft/sec より上のデータが得られず完全には満たされなかった。ペイロードベイドアのヒンジ7は許容最大 1200°F を超え 1530°F を示した。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="900" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-143" value="—" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="900" width="220" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-1-29&lt;/b&gt;" id="p133-v-144" link="docs/SSD-FLT-ORB-001.html#FT-1-29" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="924" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-145" value="STS-1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="924" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-146" value="未達" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="924" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-147" value="廃棄物収集系の運用（異常報告33）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="924" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-148" value="使い始めから不十分で、飛行の終わりには液体をまったく収集できなくなった。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="924" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-149" value="REQ-ECLSS-13" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="924" width="220" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-2-01&lt;/b&gt;" id="p133-v-150" link="docs/SSD-FLT-ORB-001.html#FT-2-01" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="948" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-151" value="STS-2" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="948" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-152" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="948" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-153" value="乗員室の騒音の測定（12か所）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="948" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-154" value="測定値はすべて 55 dB-A を大きく超え、前部アビオニクスベイ・WCS 運転中などは局所で 76 dB-A を超えた（音源の近くでの測定）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="948" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-155" value="REQ-CREW-03" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="948" width="220" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-2-08&lt;/b&gt;" id="p133-v-156" link="docs/SSD-FLT-ORB-001.html#FT-2-08" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="972" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-157" value="STS-2" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="972" width="80" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-158" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="972" width="90" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-159" value="軌道上の油圧の循環ポンプによる熱試験（FTO 243-01〜03）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="972" width="520" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-160" value="燃料電池1の故障で系統2だけに縮小し、15 分運転・45 分停止を3サイクル行った。系統1の模擬の隔離弁閉は手順の問題で 5 分中 4 分だけで、系統1と2の差の評価にはデータが足りない可能性がある。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="972" width="760" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-161" value="REQ-APU-06" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="972" width="220" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-2-10&lt;/b&gt;" id="p133-v-162" link="docs/SSD-FLT-ORB-001.html#FT-2-10" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1010" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-163" value="STS-2" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1010" width="80" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-164" value="未達" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1010" width="90" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-165" value="燃料電池1の故障（異常報告 8）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1010" width="520" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-166" value="飛行 4.33 時間で電圧が下がり、0.75 V の急な性能低下（KOH の排出による浸水）で母線から外して停止した。原因はアスピレータの閉塞で生成水を除けなくなりセル4つが浸水した。飛行は最小ミッションに短縮された。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1010" width="760" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-167" value="REQ-EPS-16" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1010" width="220" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-2-12&lt;/b&gt;" id="p133-v-168" link="docs/SSD-FLT-ORB-001.html#FT-2-12" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1048" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-169" value="STS-2" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1048" width="80" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-170" value="未達" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1048" width="90" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-171" value="上昇中の APU 3 の潤滑油の冷却（WSB 3 の凍結、異常報告 4）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1048" width="520" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-172" value="WSB 3 が凍結し、B 制御器へ切り替えても回復せず、潤滑油温度は C&amp;amp;W 限界 290°F を超えて 307°F 以上となり、APU 3 を早めに停止した。突入では WSB 3 に問題は無かった。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1048" width="760" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-173" value="REQ-APU-07" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1048" width="220" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-2-14&lt;/b&gt;" id="p133-v-174" link="docs/SSD-FLT-ORB-001.html#FT-2-14" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1086" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-175" value="STS-2" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1086" width="80" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-176" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1086" width="90" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-177" value="RMS 自動モードの性能：自動軌道で並進・回転の精度を確かめる（FTO 252-08 の操作員指令モードを含む）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1086" width="520" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-178" value="6つの自動軌道のうち重要な2つ（1と5）を行い所要の精度が得られた。操作員指令モード（FTO 252-08）も成功。残りは今後の飛行に移された。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1086" width="760" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-179" value="—" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1086" width="220" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-2-15&lt;/b&gt;" id="p133-v-180" link="docs/SSD-FLT-ORB-001.html#FT-2-15" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1124" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-181" value="STS-2" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1124" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-182" value="未達" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1124" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-183" value="RMS の予備モード（予備の駆動）の性能。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1124" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-184" value="予備電源で手首側から順に位相の確認をしたところ、肩ヨー関節だけがどちらの向きにも駆動できず、主電源に戻して収納した（異常報告 16）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1124" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-185" value="REQ-PLS-02" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1124" width="220" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-2-17&lt;/b&gt;" id="p133-v-186" link="docs/SSD-FLT-ORB-001.html#FT-2-17" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1148" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-187" value="STS-2" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1148" width="80" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-188" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1148" width="90" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-189" value="TPS の熱性能・構造の健全性・再使用性の検証。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1148" width="520" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-190" value="RSI の全体の性能は優れていたが、へこみ・えぐれ 334 か所とコーティングの欠け 19 か所、ボディフラップのタイルの気泡、右翼グローブのタイルの破断があり、右 OMS ポッドでは FRSI の過大な収縮でグラファイ" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1148" width="760" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-191" value="REQ-TPS-01" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1148" width="220" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-3-06&lt;/b&gt;" id="p133-v-192" link="docs/SSD-FLT-ORB-001.html#FT-3-06" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1186" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-193" value="STS-3" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1186" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-194" value="未達" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1186" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-195" value="APU と系3の水噴霧ボイラによる潤滑油の冷却" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1186" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-196" value="上昇中に WSB 3 が凍結して潤滑油を冷やせず、潤滑油温度が約 345°F に上がったため APU 3 を MECO 前（8分2秒）に停止し、主エンジン3は空圧で停止した。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1186" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-197" value="REQ-APU-07" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1186" width="220" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-3-11&lt;/b&gt;" id="p133-v-198" link="docs/SSD-FLT-ORB-001.html#FT-3-11" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1210" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-199" value="STS-3" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1210" width="80" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-200" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1210" width="90" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-201" value="乗員室の急減圧の警報（dP/dt）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1210" width="520" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-202" value="上昇中に乗員室の dP/dt が -0.05 psi/min の警報点を超えてクラクソンが鳴った（3回の試験飛行のすべてで発生）。通常の膨張によるもので、作動率を -0.08 psi/min に上げる変更を処理中である。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1210" width="760" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-203" value="REQ-ECLSS-02" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1210" width="220" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-3-13&lt;/b&gt;" id="p133-v-204" link="docs/SSD-FLT-ORB-001.html#FT-3-13" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1248" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-205" value="STS-3" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1248" width="80" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-206" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1248" width="90" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-207" value="ペイロードベイドアの熱環境での開閉（運用温度の範囲の確認）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1248" width="520" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-208" value="23時間の尾部太陽指向の後の左舷ドアの閉鎖で後部隔壁ラッチの表示が得られず、上面太陽指向と PTC の後に閉鎖・ラッチできた。そのほかの姿勢での閉鎖はすべて成功した。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1248" width="760" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-209" value="REQ-MECH-03" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1248" width="220" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-3-14&lt;/b&gt;" id="p133-v-210" link="docs/SSD-FLT-ORB-001.html#FT-3-14" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1286" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-211" value="STS-3" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1286" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-212" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1286" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-213" value="降着装置の展開" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1286" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-214" value="展開を 270 KEAS・高度 99 ft・接地9秒前に始め、接地の約2秒前に下げ位置でロックした。STS-4 からは高度 200 ft を展開の合図とする。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1286" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-215" value="REQ-MECH-07" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1286" width="220" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-3-15&lt;/b&gt;" id="p133-v-216" link="docs/SSD-FLT-ORB-001.html#FT-3-15" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1310" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-217" value="STS-3" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1310" width="80" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-218" value="未達" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1310" width="90" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-219" value="熱防護系の性能（RSI タイル・FRSI）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1310" width="520" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-220" value="上昇中に上部前胴でタイル21枚と破片16個、上部ボディフラップでタイル16枚を失ったが構造の過熱は無かった。FRSI は 900°F を超え（限界 700°F）、右 OMS ポッドの2か所でグラファイトエポキシ構造が軽い" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1310" width="760" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-221" value="REQ-TPS-01・REQ-TPS-02" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1310" width="220" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-3-16&lt;/b&gt;" id="p133-v-222" link="docs/SSD-FLT-ORB-001.html#FT-3-16" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1348" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-223" value="STS-3" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1348" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-224" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1348" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-225" value="RMS によるペイロードの展開・係留の性能" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1348" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-226" value="ステップ1の IECM の展開・係留は CCTV カメラの故障で行えず STS-4 に回した。最後のステップの PDP の展開・係留は3回、各10分未満で問題なく行った。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1348" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-227" value="REQ-PLS-01" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1348" width="220" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-3-18&lt;/b&gt;" id="p133-v-228" link="docs/SSD-FLT-ORB-001.html#FT-3-18" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1372" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-229" value="STS-3" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1372" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-230" value="未達" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1372" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-231" value="RMS の制御系の評価（負荷あり）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1372" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-232" value="IECM（830 lb）の代わりに PDP（383 lb）を負荷とし、必要な DAC カメラも働かず、FTO は未完了。FTO 352-05（RMS/RCS の干渉）も同じ理由で未完了。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1372" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-233" value="—" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1372" width="220" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-4-03&lt;/b&gt;" id="p133-v-234" link="docs/SSD-FLT-ORB-001.html#FT-4-03" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1396" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-235" value="STS-4" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1396" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-236" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1396" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-237" value="MECO 後の自動の推進薬ダンプの時間線を確立する。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1396" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-238" value="ダンプは MECO の2分後に始まり 3分2秒続き、その後真空不活性化した。ただし FTR は残量・装填精度の評価が要るため未完了とされた。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1396" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-239" value="REQ-MPS-10" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
