  <diagram id="p106-fta-a" name="図106 故障の木 A（28 VDC 主電力の喪失）">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1144" math="0" shadow="0" background="#FFFFFF">
