        <UserObject label="APU/HYD：主油圧ポンプ・供給" id="p46-B-APU46" tooltip="油圧系3系統（図56参照）" doc_no="SSD-FD-APU-HYD-001" abbr="APU" 分類="電力・環境・油圧">
          <mxCell style="swimlane;html=1;whiteSpace=wrap;startSize=30;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#FBF1CF;swimlaneFillColor=#FFFFFF;strokeColor=#A77B00;strokeWidth=1.5;fontColor=#15202B;fontStyle=1;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
            <mxGeometry x="30" y="670" width="220" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p46-v-39" value="・油圧系3系統（図56参照）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p46-B-APU46">
          <mxGeometry x="0" y="30" width="220" height="30" as="geometry" />
        </mxCell>
        <UserObject label="▶ 説明書 SSD-FD-APU-HYD-001" id="p46-v-40" link="docs/SSD-FD-APU-HYD-001.html" tooltip="クリックで SSD-FD-APU-HYD-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#A77B00;fontColor=#A77B00;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p46-B-APU46">
            <mxGeometry x="10" y="66" width="200" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="主推進系（MPS）" id="p46-B-MPS46" tooltip="SSME 3基・TVC作動器6基（図50参照）" doc_no="SSD-FD-MPS-001" abbr="MPS" 分類="推進">
          <mxCell style="swimlane;html=1;whiteSpace=wrap;startSize=30;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#FCE3D3;swimlaneFillColor=#FFFFFF;strokeColor=#C24A0C;strokeWidth=1.5;fontColor=#15202B;fontStyle=1;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
            <mxGeometry x="380" y="1120" width="280" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p46-v-41" value="・SSME 3基・TVC作動器6基（図50参照）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p46-B-MPS46">
          <mxGeometry x="0" y="30" width="280" height="30" as="geometry" />
        </mxCell>
        <UserObject label="▶ 機能説明書　SSD-FD-MPS-001" id="p46-v-42" link="docs/SSD-FD-MPS-001.html" tooltip="クリックで SSD-FD-MPS-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C24A0C;fontColor=#C24A0C;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p46-B-MPS46">
            <mxGeometry x="10" y="66" width="260" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="固体ロケットブースタ（SRB×2）" id="p46-B-SRB46" tooltip="TVC作動器・SRB RGA各2台" doc_no="SSD-FD-SRB-001" abbr="SRB" 分類="飛行系要素">
          <mxCell style="swimlane;html=1;whiteSpace=wrap;startSize=30;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#E3EEE6;swimlaneFillColor=#FFFFFF;strokeColor=#2E6B45;strokeWidth=1.5;fontColor=#15202B;fontStyle=1;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
            <mxGeometry x="30" y="540" width="220" height="110" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p46-v-43" value="・TVC作動器・SRB RGA各2台" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p46-B-SRB46">
          <mxGeometry x="0" y="30" width="220" height="40" as="geometry" />
        </mxCell>
        <UserObject label="▶ 説明書 SSD-FD-SRB-001" id="p46-v-44" link="docs/SSD-FD-SRB-001.html" tooltip="クリックで SSD-FD-SRB-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#2E6B45;fontColor=#2E6B45;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p46-B-SRB46">
            <mxGeometry x="10" y="76" width="200" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-01&lt;br&gt;速度・姿勢" id="p46-IF-GNC-01" link="docs/SSD-FD-GNC-INS-001.html#IF-GNC-01" tooltip="IF-GNC-01：IMUは慣性姿勢と速度のデータをGNCソフトウェアへ送り、航法はそれで状態ベクトルを伝播し、誘導は姿勢データと状態ベクトルから操舵指令を作る。IMU SOPは、速度のM50座標への変換、レゾルバ出力のジンバル角への変換、表示用の加速度の計算などを行う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-INS" target="p46-B-GNS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-02&lt;br&gt;航法データ" id="p46-IF-GNC-02" link="docs/SSD-FD-GNC-NAS-001.html#IF-GNC-02" tooltip="IF-GNC-02：TACANの斜距離・磁方位、MLSの斜距離・方位角・仰角、ADTAの気圧高度を再突入の航法ソフトウェアへ送り、期待誤差の範囲内のデータを状態ベクトルの更新に取り込む。各航法装置は、5台のGPCにつながる8台の飛行重要MDMの1台に配線される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-NAS" target="p46-B-GNS">
            <mxGeometry relative="1" as="geometry" x="0.148">
              <Array as="points">
                <mxPoint x="1860" y="900" />
                <mxPoint x="1860" y="430" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-03&lt;br&gt;エアデータ" id="p46-IF-GNC-03" link="docs/SSD-FD-GNC-NAS-001.html#IF-GNC-03" tooltip="IF-GNC-03：エアデータ系は、高度の航法の更新に加え、誘導の操舵・スピードブレーキ指令の計算と飛行制御則の計算の更新にデータを与える。エアデータをG&amp;Cに取り込まないとき、飛行制御は迎角を一定値（7.5°）とし、動圧を航法の対地相対速度の表から求める。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.7857;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-NAS" target="p46-B-FCS">
            <mxGeometry relative="1" as="geometry" x="-0.5146">
              <Array as="points">
                <mxPoint x="680" y="900" />
                <mxPoint x="680" y="490" />
                <mxPoint x="600" y="490" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-04&lt;br&gt;操舵指令" id="p46-IF-GNC-04" link="docs/SSD-FD-GNC-GNS-001.html#IF-GNC-04" tooltip="IF-GNC-04：誘導は航法の状態ベクトルと姿勢データから飛行制御への操舵指令を作り、飛行制御はIMUの姿勢データを使って舵面・エンジンジンバル・RCSジェットの指令に変換する。制御ソフトウェアは状態ベクトルの情報で舵効を選び、制御ゲインを設定する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=1;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-GNS" target="p46-B-FCS">
            <mxGeometry relative="1" as="geometry" x="-0.3738">
              <Array as="points">
                <mxPoint x="1210" y="470" />
                <mxPoint x="640" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-05&lt;br&gt;位置指令・FB" id="p46-IF-GNC-05" link="docs/SSD-FD-GNC-FCS-001.html#IF-GNC-05" tooltip="IF-GNC-05：飛行制御ソフトウェアの舵面とSSME・SRBの位置指令を、フライトアフトMDMを経てASAとATVCへ送る。舵面の位置フィードバックはASAを経て戻り、SOPがエレボン・ラダー・スピードブレーキ・ボディフラップの角度に変換する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-FCS" target="p46-B-ACT">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-06&lt;br&gt;手動指令" id="p46-IF-GNC-06" link="docs/SSD-FD-GNC-CCD-001.html#IF-GNC-06" tooltip="IF-GNC-06：RHCの入力は冗長管理とRHC SOPを経てエアロジェットDAPへ渡り、SOPが軸ごとに合成した回転指令を飛行制御ソフトウェアに与える。前方と後方のTHCの冗長な信号も冗長管理とSOPを経て飛行制御系へ渡り、両者が相反する並進指令を出すと指令は出ない。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-CCD" target="p46-B-FCS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-07&lt;br&gt;航法・誘導表示" id="p46-IF-GNC-07" link="docs/SSD-FD-GNC-GNS-001.html#IF-GNC-07" tooltip="IF-GNC-07：機体と目標の状態ベクトルの情報は、専用表示とGNCのDPS表示で乗員に示される。HSIのSOURCEスイッチをNAVにすると、HSIには航法処理部のデータが表示される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-GNS" target="p46-B-CCD">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-08&lt;br&gt;警報・表示" id="p46-IF-GNC-08" link="docs/SSD-FD-GNC-CCD-001.html#IF-GNC-08" tooltip="IF-GNC-08：TACAN・GPS・MSBLSの故障ではSM ALERTが点灯して故障メッセージが出、エアデータのジレンマではパネルF7のAIR DATAとBACKUP C/W ALARMの警報灯が点灯する。再突入前のAA・RGA・位置フィードバックの故障は、SPEC 53（ENTRY CONTROLS）で選択解除できる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-CCD" target="p46-B-OPS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-09&lt;br&gt;チャネル管理" id="p46-IF-GNC-09" link="docs/SSD-FD-GNC-OPS-001.html#IF-GNC-09" tooltip="IF-GNC-09：運用飛行規則A8-107に従い、パネルC3のFCS CHANNELスイッチでチャネルをAUTO・OVERRIDE・OFFに切り替え、複数のスイッチを動かすときは2秒の間隔をあける。SCOMのGNCの経験則も、同じアクチュエータに2つの故障があれば残りのFCSチャネルをOVERRIDEにするとする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-OPS" target="p46-B-ACT">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-10&lt;br&gt;アライン計画" id="p46-IF-GNC-10" link="docs/SSD-FD-GNC-OPS-001.html#IF-GNC-10" tooltip="IF-GNC-10：運用飛行規則A8-110に従い、IMUの恒星アラインメントをおよそ飛行日ごとに1回行い、軌道離脱噴射の70分前にIMU間のアラインメントを行う。IMU間のアラインメントはGNC OPS 2または3で行い、所要時間は3〜6分である。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-OPS" target="p46-B-INS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-11&lt;br&gt;28 VDC・AC" id="p46-IF-GNC-11" link="docs/SSD-FD-GNC-INS-001.html#IF-GNC-11" tooltip="IF-GNC-11：各IMUには2つの別々の遠隔電力制御器を通して冗長な28 VDCを供給し、IMU 1・2・3の電源スイッチはパネルO14・O15・O16にある。スタートラッカの扉は、DOOR CONTROL SYS 1・SYS 2スイッチで制御する各扉2台の三相交流モータで開閉する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.4545;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p46-L_pow" source="p46-B-EPS46" target="p46-B-INS">
            <mxGeometry relative="1" as="geometry" x="0.7368">
              <Array as="points">
                <mxPoint x="1440" y="800" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-12&lt;br&gt;主母線A/B/C" id="p46-IF-GNC-12" link="docs/SSD-FD-GNC-NAS-001.html#IF-GNC-12" tooltip="IF-GNC-12：MLS 1・2・3には、それぞれ主母線A・B・Cから電力を供給する。GPS受信機は単一のESS母線と前方電力制御器（FPC）の組合せから給電され、アンテナのプリアンプの遮断器はパネルO14・O15・O16にある。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.7273;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p46-L_pow" source="p46-B-EPS46" target="p46-B-NAS">
            <mxGeometry relative="1" as="geometry" x="-0.125">
              <Array as="points">
                <mxPoint x="1440" y="830" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-13&lt;br&gt;航法電波" id="p46-IF-GNC-13" link="docs/SSD-FD-GNC-NAS-001.html#IF-GNC-13" tooltip="IF-GNC-13：TACANは地上のTACAN局、MLSは着陸滑走路脇の地上局に対する機体の位置を電波で検知し、GPSは衛星の測距信号を受けて位置と速度を求める。機上のTACAN受信機は、地上局のビーコンが割り当てられたL帯の周波数で送り続けるパルス対を受信する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5F6B7A;strokeWidth=2;fontColor=#5F6B7A;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p46-L_rf" source="p46-B-GND46" target="p46-B-NAS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-14&lt;br&gt;噴射指令" id="p46-IF-GNC-14" link="docs/SSD-FD-GNC-FCS-001.html#IF-GNC-14" tooltip="IF-GNC-14：RCS DAPは、OMS噴射中を除く軌道上の全期間に、RCSジェットの噴射指令で機体の姿勢と角速度を制御する。再突入ではエアロジェットDAPがピッチの角速度誤差を動圧40 psfまでジェットの指令に変える。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-FCS" target="p46-B-RCS46">
            <mxGeometry relative="1" as="geometry" x="0.1111">
              <Array as="points">
                <mxPoint x="410" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-15&lt;br&gt;ジンバル・点火" id="p46-IF-GNC-15" link="docs/SSD-FD-GNC-FCS-001.html#IF-GNC-15" tooltip="IF-GNC-15：OMS TVC DAPは誘導の要求速度をOMSのジンバル指令に変換し、OMSの点火・停止の指令も生成する。OMS処理部は指定した推力方向を得るジンバルアクチュエータの指令を生成し、OMSの推力は重心を通るように加える。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-FCS" target="p46-B-OMS46">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-16&lt;br&gt;SSMEジンバル" id="p46-IF-GNC-16" link="docs/SSD-FD-GNC-ACT-001.html#IF-GNC-16" tooltip="IF-GNC-16：ATVCの4チャネルは各指令に相当するアナログ電圧を作り、SSMEの油圧作動器の4つのサーボ弁へ送ってノズルをジンバルさせる。各SSMEはピッチとヨーの作動器を1基ずつ持つ。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-ACT" target="p46-B-MPS46">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-17&lt;br&gt;スロットル" id="p46-IF-GNC-17" link="docs/SSD-FD-GNC-GNS-001.html#IF-GNC-17" tooltip="IF-GNC-17：第1段の誘導は、姿勢の指令に加えて、事前に定めたスロットル計画に従ってMPSのスロットルへ指令を送る。第2段では、誘導が主エンジンのスロットル指令を3 gを超えないように調整する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-GNS" target="p46-B-MPS46">
            <mxGeometry relative="1" as="geometry" x="0.5019">
              <Array as="points">
                <mxPoint x="1440" y="240" />
                <mxPoint x="1880" y="240" />
                <mxPoint x="1880" y="1100" />
                <mxPoint x="640" y="1100" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-18&lt;br&gt;SRBジンバル" id="p46-IF-GNC-18" link="docs/SSD-FD-GNC-ACT-001.html#IF-GNC-18" tooltip="IF-GNC-18：ATVCは各SRBの2基のTVC作動器へ指令電圧を送り、SRBの作動器はピッチ・ヨーに45°傾いたロック軸とチルト軸でノズルを動かす。第1段のステアリングは、主にSRBのノズルをジンバルさせて行う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.8182;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-ACT" target="p46-B-SRB46">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-19&lt;br&gt;SRB角速度" id="p46-IF-GNC-19" link="docs/SSD-FD-GNC-FCS-001.html#IF-GNC-19" tooltip="IF-GNC-19：各SRBの前部スカートにある2台のSRB RGAは、角速度に比例する電圧をフライトアフトMDMを経てGPCのSRB RGA SOPへ送る。SRB RGAは1回の飛行より多く使ってはならない。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.4545;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-SRB46" target="p46-B-FCS">
            <mxGeometry relative="1" as="geometry" x="-0.6765">
              <Array as="points">
                <mxPoint x="360" y="590" />
                <mxPoint x="360" y="490" />
                <mxPoint x="450" y="490" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-20&lt;br&gt;FCS警報" id="p46-IF-GNC-20" link="docs/SSD-FD-GNC-ACT-001.html#IF-GNC-20" tooltip="IF-GNC-20：ASAがサーボ弁をバイパスするとパネルF7の黄色のFCS CHANNEL警報灯が、エレボンの位置またはヒンジモーメントが飽和すると赤のFCS SATURATION警報灯が点灯する。主C&amp;Wのハードウェアの表には、FCS SATURATION・FCS CH BYPASSのほか、IMU・ADTA・RGA/AA・L RHC・R/AFT RHC・OMS TVCのチャネルがある。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-ACT" target="p46-B-CW46">
            <mxGeometry relative="1" as="geometry" x="0.36">
              <Array as="points">
                <mxPoint x="410" y="840" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-32&lt;br&gt;IMUの強制空冷" id="p46-IF-ECL-32" link="docs/SSD-FD-ECL-ARS-001.html#IF-ECL-32" tooltip="IF-ECL-32：IMUの強制空冷は3台のIMUすべてに供する3台のファンで行い、同時に使うのは1台である。ベイファンは交流で動くGould製TACANを冷却し、冷却を失ったTACANは5分以内に短絡しうる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p46-L_thm" source="p46-B-ARS46" target="p46-B-INS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-03&lt;br&gt;GNC機器I/O" id="p46-IF-DPS-03" link="docs/SSD-FD-DPS-BUS-001.html#IF-DPS-03" tooltip="IF-DPS-03：各MDMは指令を割り当てられたGPCから受け、配線されたGNC機器から要求されたデータを取得してGPCへ送る。同種のGNC機器は複数台が別々のMDMと飛行重要バスに配線され、冗長な機器は別々のストリングにある。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.6324;exitY=1;exitDx=0;exitDy=0;entryX=0.1071;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-DPS46" target="p46-B-GNS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-04&lt;br&gt;BFS ENGAGE" id="p46-IF-DPS-04" link="docs/SSD-FD-DPS-FSW-001.html#IF-DPS-04" tooltip="IF-DPS-04：CDRとPLTのRHCにあるBFS ENGAGE押しボタンの信号を予備飛行制御器（BFC）へ送り、BFCがエンゲージの論理を処理してBFSに機体の制御を移す。誤ってエンゲージしないよう押しボタンを押すには約8 lbの力を要し、軌道上ではBFSのOUTPUTスイッチの再構成で実質的に無効にする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2059;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-CCD" target="p46-B-DPS46">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-10&lt;br&gt;空力舵面" id="p46-IF-APU-10" link="docs/SSD-FD-APU-HYD-001.html#IF-APU-10" tooltip="IF-APU-10：3系統の油圧を7面の空力舵面を駆動する油圧アクチュエータへ供給し、4基のエレボンのサーボアクチュエータにはそれぞれ3系統すべての油圧を供給する。エレボンの切替弁は主系の圧力が約1,200〜1,500 psiaに下がると第1待機系に、さらに第1待機系が下がると第2待機系に切り替える。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B3FA0;strokeWidth=2;fontColor=#7B3FA0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="p46-L_hyd" source="p46-B-APU46" target="p46-B-ACT">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-08&lt;br&gt;レーダデータ" id="p46-IF-CT-08" link="docs/SSD-FD-CT-KU-001.html#IF-CT-08" tooltip="IF-CT-08：自動追尾モードでは、Ku帯系がアンテナの角度・角速度・距離・距離変化率をMDMを通してランデブ・近傍運用のために送り、GNC計算機のランデブ航法データの更新に使わせる。自動の角度追尾は航法データの更新に使える角度データを与える唯一の角度追尾モードで、パネルA2の表示器へのデータはGPCで処理しない配線の信号である。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p46-L_dat" source="p46-B-CT46" target="p46-B-GNS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;図示を省略したIF（文書・図5に記載）&lt;/b&gt;&lt;br&gt;DPS-22&lt;br&gt;&lt;br&gt;他の図・段と同じ物理IFのため、その番号のまま描いたIF：IF-ECL-32・IF-DPS-03（図48）・IF-DPS-04（図48）・IF-APU-10（図56）・IF-CT-08（図58）&lt;br&gt;&lt;br&gt;各ブロックの「関連文書」ボタンは、機能別関連文書一覧（SSD-GNC-REF-001）の該当節を開きます。" id="p46-v-45" link="data:page/id,p5-register" tooltip="図5のIF一覧へ">
          <mxCell style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#FAFBFC;strokeColor=#9AA3AE;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#3B4654;fontFamily=Helvetica;" vertex="1" parent="1">
