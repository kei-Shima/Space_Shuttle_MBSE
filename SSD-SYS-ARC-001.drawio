        <mxCell id="p99-v-29" value="&lt;b style='font-size:12px'&gt;遷移（トリガ［ガード］）&lt;/b&gt;&lt;table style='border-collapse:collapse;width:100%;font-size:10px;margin-top:4px;'&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;FCT-01&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;FC-STOP→FC-START&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;START/STOPをSTART（ΔP灰まで保持）［反応剤弁開・再使用可（40°F超）］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;FCT-02&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;FC-START→FC-GSE&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;READY FOR LOAD後に母線へ接続［打上げ前（地上電力あり）］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;FCT-03&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;FC-GSE→FC-FULL&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;T−50秒に地上電力を断&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;FCT-04&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;FC-START→FC-FULL&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;READY FOR LOAD後に母線へ接続［飛行中の再始動］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;FCT-05&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;FC-FULL→FC-PURGE&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;パージ弁を開く（自動・手動）［負荷350 A未満、離脱まで3時間超］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;FCT-06&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;FC-PURGE→FC-FULL&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;パージ弁を閉じる&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;FCT-07&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;FC-OPER→FC-STBY&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;母線から切り離す（負荷を外す）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;FCT-08&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;FC-STBY→FC-FULL&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;母線へ再接続&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;FCT-09&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;FC-STBY→FC-STOP&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;START/STOPをSTOP［区画温度40°F以上］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;FCT-10&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;FC-OPER→FC-COOLF&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;冷却材ポンプ差圧喪失&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;FCT-11&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;FC-COOLF→FC-STOP&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;FC SHUTDOWN手順［9分以内］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;FCT-12&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;FC-OPER→FC-SAFE&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;反応剤弁を閉じる［交差・内部短絡・KOH・冷却材高圧］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;FCT-13&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;FC-SAFE→FC-STOP&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;母線から切り離しSTOP［冷却材圧力15 psi未満］&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1370" y="130" width="600" height="299" as="geometry" />
