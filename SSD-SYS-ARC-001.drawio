        <UserObject label="" id="p152-v-20" link="" tooltip="LM-01 AL-SH-1 → AL-STD-2（一部）：火災＝サイレン・減圧＝クラクソンという音の分け方と、クラクソンの周波数（2560/256 Hz）は表と同じで、サイレンの周波数も近い（666〜1470 Hz に">
          <mxCell style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C79100;strokeWidth=1.8;fontColor=#C79100;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p152-v-8" target="p152-v-15">
