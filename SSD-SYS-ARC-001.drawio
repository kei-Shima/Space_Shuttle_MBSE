          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=1.5;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1">
