            <mxGeometry x="140" y="1312" width="130" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-233" value="RCRS を積むと LiOH は打上げと再突入の各1個で足り、LiOH の不足（−9%）は解消する" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="270" y="1312" width="1170" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-04" id="p109-v-234" link="docs/SSD-VAR-ORB-001.html#MK-04" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1336" width="100" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="BUD-CON-05" id="p109-v-235" link="docs/SSD-BUD-ORB-001.html#BUD-CON-05" tooltip="開く">
