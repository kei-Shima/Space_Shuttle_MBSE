        </UserObject>
        <mxCell id="p28-v-27" value="・SM GPC・SPEC 66・テレメトリ（図48参照）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p28-B-DPS28">
