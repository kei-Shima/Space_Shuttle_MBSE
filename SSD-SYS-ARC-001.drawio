        </UserObject>
        <UserObject label="OMST-07" id="p136-v-25" link="docs/SSD-BEH-ORB-006.html#OMST-07" tooltip="OMST-07：LEFT OMS 灯（左エンジン Pc 80% 未満・下向き矢印）→ 左の OMS ENG を OFF［Pc と速度の両試験で故障（センサ故障でない）］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p136-v-9" target="p136-v-11">
