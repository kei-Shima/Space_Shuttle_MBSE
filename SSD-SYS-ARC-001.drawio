        <UserObject label="▶ SSD-FMEA-EVA-001：EVA の故障解析表（EMU の CIL 課題）" id="p87-v-42" link="docs/SSD-FMEA-EVA-001.html#CIL" tooltip="SSD-FMEA-EVA-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F5FAD;fontColor=#1F5FAD;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1060" y="604" width="600" height="34" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="▶ 節点・流れの表と根拠（SSD-BEH-ORB-004）" id="p87-v-43" link="docs/SSD-BEH-ORB-004.html" tooltip="SSD-BEH-ORB-004 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F5FAD;fontColor=#1F5FAD;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1060" y="648" width="600" height="34" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p87-v-44" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;角丸＝行動（クリックで節点の行）、ひし形＝判断（矢印のラベルはガード）、小さなひし形＝合流、●＝開始、◎＝終了。根拠は SCOM の緊急手順と各系の機能説明書の文。&lt;br&gt;同じ活動を SysML v2 テキスト model/SSD-BEH-ORB-004.sysml の EvaOperation に示す。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="1416" width="1150" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p87-v-45" value="&lt;table style='border-collapse:collapse;width:100%;font-size:11px;text-align:left;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;文書番号&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;SSD-SYS-ARC-001&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;表題&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;スペースシャトル システム構成図（機能ブロック・インタフェース図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;図番&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;図87 EVA 準備〜再与圧 活動図（全158図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;版・日付&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;Rev. BF／2026-10-07&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;状態&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;検討用（公開資料に基づく）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;作成／確認／承認&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;　　　／　　　／　　　&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15202B;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1230" y="1416" width="430" height="150" as="geometry" />
        </mxCell>
      </root>
