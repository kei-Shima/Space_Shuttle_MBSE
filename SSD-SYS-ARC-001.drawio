        <UserObject label="IF-CO2-01&lt;br&gt;LiOH流路" id="p14-IF-CO2-01" link="docs/SSD-FD-CO2-ABS-001.html#IF-CO2-01" tooltip="IF-CO2-01：キャビンファン出口の空気を、2個のLiOHキャニスタとオリフィスを並列に置いたダクトに受け入れ、通過後の空気は同じダクトでキャビン温度制御弁とキャビン熱交換器へ向かう。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="p14-L_flu" source="p14-B-CAC14" target="p14-B-ABS">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CO2-02&lt;br&gt;通気" id="p14-IF-CO2-02" link="docs/SSD-FD-CO2-ABS-001.html#IF-CO2-02" tooltip="IF-CO2-02：ダクト内のオリフィスで配分した各120 lb/hrの空気を、2つのスロットに装着したキャニスタに通す。STS-122では開口端のテープ覆いを外し忘れたキャニスタを装着したため、キャビンファン差圧がわずかに上がり、PPCO2が通常の速さで下がらなかった。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="p14-L_flu" source="p14-B-ABS" target="p14-B-CAN">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CO2-03&lt;br&gt;計測点" id="p14-IF-CO2-03" link="docs/SSD-FD-CO2-ABS-001.html#IF-CO2-03" tooltip="IF-CO2-03：PPCO2トランスデューサはLiOHキャニスタへ分かれる手前のダクトに接続され、キャビンファン出口の空気のCO2分圧を測る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p14-L_flu" source="p14-B-ABS" target="p14-B-MON">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="520" y="505" />
                <mxPoint x="920" y="505" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CO2-04&lt;br&gt;収納・補給" id="p14-IF-CO2-04" link="docs/SSD-FD-CO2-STW-001.html#IF-CO2-04" tooltip="IF-CO2-04：予備のキャニスタを床下の収納区画（MD52M）に収め、交換時に取り出して使用位置（MD54G）へ装着する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.35;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="p14-L_str" source="p14-B-STW" target="p14-B-CAN">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CO2-05&lt;br&gt;ATCO分流" id="p14-IF-CO2-05" link="docs/SSD-FD-CO2-ATCO-001.html#IF-CO2-05" tooltip="IF-CO2-05：キャビン熱交換器を出た再生・調整済み空気の一部をATCOへ送り、COをCO2に変換する。ATCOを通った空気は調整済み空気とともに乗員室へ戻り、生じたCO2は循環してLiOHキャニスタで除去される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="p14-L_flu" source="p14-B-THC14" target="p14-B-ATCO">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CO2-06&lt;br&gt;PPCO2" id="p14-IF-CO2-06" link="docs/SSD-FD-CO2-MON-001.html#IF-CO2-06" tooltip="IF-CO2-06：キャビン空気のCO2分圧をSM GPCへ送り、SM OPS 2・4のDISP 66（ENVIRONMENT）に表示する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p14-L_dat" source="p14-B-MON" target="p14-B-DPS14">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CO2-07&lt;br&gt;AC1電源" id="p14-IF-CO2-07" link="docs/SSD-FD-CO2-MON-001.html#IF-CO2-07" tooltip="IF-CO2-07：遮断器AC1 CABIN AIR S/Cを通じて、CABIN AIR信号調整器にAC1 φBの交流電力を供給する。この信号調整器がPPCO2トランスデューサに給電する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="p14-L_pow" source="p14-B-EPS14" target="p14-B-MON">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
