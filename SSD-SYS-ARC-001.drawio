          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5948;exitY=1.0;exitDx=0;exitDy=0;entryX=0.3;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p137-v-5" target="p137-v-13">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="RCST-10" id="p137-v-28" link="docs/SSD-BEH-ORB-006.html#RCST-10" tooltip="RCST-10：RIGHT RCS 灯（右ポッドのタンク圧 200 psia 未満・312 psia 超、量の差 9.5% 超）→ 右ポッドを確保［独立した表示と計器で漏れを確認］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.6293;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p137-v-5" target="p137-v-13">
            <mxGeometry relative="1" as="geometry" x="-0.4" />
          </mxCell>
        </UserObject>
        <UserObject label="RCST-11" id="p137-v-29" link="docs/SSD-BEH-ORB-006.html#RCST-11" tooltip="RCST-11：推進薬タンクの漏れ → 健全な側からクロスフィード［漏れたタンクの枯渇前］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1.0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p137-v-13" target="p137-v-10">
            <mxGeometry relative="1" as="geometry" x="0.2069">
              <Array as="points">
                <mxPoint x="1010" y="720" />
                <mxPoint x="1010" y="530" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="RCST-12" id="p137-v-30" link="docs/SSD-BEH-ORB-006.html#RCST-12" tooltip="RCST-12：前部 He タンクの漏れ → −X 並進または前部 RCS ダンプで最大ブローダウンへ［OMS-2 の後］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9;exitY=1.0;exitDx=0;exitDy=0;entryX=0.15;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p137-v-12" target="p137-v-14">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="610" y="800" />
                <mxPoint x="1060" y="800" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="RCST-13" id="p137-v-31" link="docs/SSD-BEH-ORB-006.html#RCST-13" tooltip="RCST-13：前部 RCS ダンプ（EI−18 分）［重心の制御に要する場合を除く］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9;exitY=1.0;exitDx=0;exitDy=0;entryX=0.35;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p137-v-7" target="p137-v-14">
