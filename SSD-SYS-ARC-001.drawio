          <mxCell style="rounded=1;arcSize=25;html=1;fillColor=#15202B;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1170" y="24" width="190" height="32" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="TOP-A&lt;br&gt;&lt;span style='font-weight:normal;font-size:10px'&gt;再突入中に 28 VDC の主直流電力をすべて失う（飛行制御・航法の電力を失い突入できない）&lt;/span&gt;" id="p106-v-5" link="docs/SSD-ANA-ORB-001.html#FTAA" tooltip="TOP-A 頂上事象">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FDE2E2;strokeColor=#C62828;strokeWidth=2.5;fontColor=#15202B;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="390.0" y="150" width="420" height="70" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;A-G1　OR&lt;/b&gt;&lt;br&gt;全電源の喪失、または全主母線の喪失（推定：主母線3本が直流負荷の主電源。予備バッテリが無いことは SSD-FD-EPS-FCP-001 F-EPS-FCP-08 による）" id="p106-v-6" link="docs/SSD-ANA-ORB-001.html#A-G1" tooltip="A-G1 OR ゲート">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FBF1CF;strokeColor=#A77B00;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="460.0" y="260" width="280" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;A-G2　OR&lt;/b&gt;&lt;br&gt;燃料電池3基をすべて失う（推定：各燃料電池は独立した電源）" id="p106-v-7" link="docs/SSD-ANA-ORB-001.html#A-G2" tooltip="A-G2 OR ゲート">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FBF1CF;strokeColor=#A77B00;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="275.0" y="416" width="280" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;A-G4　AND&lt;/b&gt;&lt;br&gt;燃料電池1・2・3がそれぞれ独立に故障する（1基喪失で単一故障許容→MDF、2基で0故障許容→次の PLS（規則 A9-1001 注[4]・[5]））" id="p106-v-8" link="docs/SSD-ANA-ORB-001.html#A-G4" tooltip="A-G4 AND ゲート">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="60" y="572" width="280" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;A-E1&lt;/b&gt;&lt;br&gt;燃料電池1の喪失（内部短絡・冷却喪失で9分以内に停止・反応剤供給の喪失）" id="p106-v-9" link="docs/SSD-ANA-ORB-001.html#A-E1" tooltip="A-E1 基本事象">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=1.5;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="100" y="688" width="300" height="66" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;A-E2&lt;/b&gt;&lt;br&gt;燃料電池2の喪失（同上）" id="p106-v-10" link="docs/SSD-ANA-ORB-001.html#A-E2" tooltip="A-E2 基本事象">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=1.5;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="100" y="768" width="300" height="66" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;A-E3&lt;/b&gt;&lt;br&gt;燃料電池3の喪失（同上）" id="p106-v-11" link="docs/SSD-ANA-ORB-001.html#A-E3" tooltip="A-E3 基本事象">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=1.5;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="100" y="848" width="300" height="66" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;A-G5　AND&lt;/b&gt;&lt;br&gt;共通原因：PRSD 中央マニホールドの漏れで2基を失い、残る1基も故障する（規則 A9-252 の根拠文が2基喪失を述べる。3基目との組合せは推定）" id="p106-v-12" link="docs/SSD-ANA-ORB-001.html#A-G5" tooltip="A-G5 AND ゲート">
          <mxCell style="rounded=0;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#E3EEE6;strokeColor=#2E6B45;strokeWidth=2;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="430" y="572" width="280" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;A-E4&lt;/b&gt;&lt;br&gt;PRSD 中央マニホールドの漏れによる燃料電池2基の喪失（共通原因）" id="p106-v-13" link="docs/SSD-ANA-ORB-001.html#A-E4" tooltip="A-E4 基本事象">
          <mxCell style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=1.5;fontColor=#15202B;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontFamily=Helvetica;" vertex="1" parent="1">
