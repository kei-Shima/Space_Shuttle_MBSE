        <mxCell id="p109-v-242" value="窒素の容量は常設タンク数で決まり、OV-104 の5基では（143−83）lb×5＝300 lb に減る" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="270" y="1384" width="1170" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-03" id="p109-v-243" link="docs/SSD-VAR-ORB-001.html#MK-03" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1408" width="100" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="BUD-CON-02" id="p109-v-244" link="docs/SSD-BUD-ORB-001.html#BUD-CON-02" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="140" y="1408" width="130" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-245" value="追加の窒素タンクで最大8基（480 lb）まで増やせる" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
