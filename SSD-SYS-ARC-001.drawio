        <UserObject label="GPT-14" id="p98-v-30" link="docs/SSD-BEH-ORB-005.html#GPT-14" tooltip="GPT-14：POWERスイッチをOFF［着陸後の停止・故障GPC］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.0;exitY=0.0513;exitDx=0;exitDy=0;entryX=0.15;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p98-v-5" target="p98-v-6">
