        <mxCell id="p45-B-STR" value="STR　構造（STR）" style="swimlane;html=1;whiteSpace=wrap;startSize=36;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#FFF3C4;swimlaneFillColor=#FFFFFF;strokeColor=#A77B00;strokeWidth=2;fontColor=#15202B;fontStyle=1;fontSize=15;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="1540" y="840" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p45-v-35" value="&lt;b&gt;冗長&lt;/b&gt;：主構造は受動・窓は圧力ペイン＋冗長ペイン&lt;br&gt;&lt;b&gt;方式&lt;/b&gt;：受動・同種多重&lt;br&gt;&lt;b&gt;段階&lt;/b&gt;：1故障許容（窓の与圧）（推定）&lt;br&gt;&lt;b&gt;CIL 件数&lt;/b&gt;：—" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p45-B-STR">
          <mxGeometry x="0" y="36" width="300" height="110" as="geometry" />
        </mxCell>
        <UserObject label="▶ RED-STR（冗長度の表）" id="p45-v-36" link="docs/SSD-FMEA-ORB-001.html#RED-STR" tooltip="SSD-FMEA-ORB-001 の RED-STR を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#A77B00;fontColor=#A77B00;fontSize=12;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p45-B-STR">
            <mxGeometry x="12" y="150" width="276" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p45-v-37" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;2故障許容：任意の2故障に耐えて安全に軌道離脱・着陸できる。1故障許容：任意の1故障に耐えて安全に軌道離脱・着陸できる。0故障許容：重要機能は遂行できるが、追加の1故障に耐えられない（いずれも運用飛行規則 A2-101）。&lt;br&gt;CIL 件数は IOA の表1-1（1988年1月1日時点）で、その後の改修（AP-101S・MEDS・GPS など）を含まない。TPS と構造は IOA の評価の対象外。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="1060" width="1350" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p45-v-38" value="&lt;table style='border-collapse:collapse;width:100%;font-size:11px;text-align:left;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;文書番号&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;SSD-SYS-ARC-001&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;表題&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;スペースシャトル システム構成図（機能ブロック・インタフェース図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;図番&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;図45 冗長度の重ね図（全158図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;版・日付&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;Rev. BF／2026-10-07&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;状態&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;検討用（公開資料に基づく）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;作成／確認／承認&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;　　　／　　　／　　　&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15202B;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1430" y="1060" width="430" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
