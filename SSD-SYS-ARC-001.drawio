          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=11;fontStyle=1;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1814" y="174" width="104" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="通信・追跡（C&amp;T）" id="p39-v-28" link="docs/SSD-FD-CT-001.html" tooltip="クリックで SSD-FD-CT-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#DCE8F6;strokeColor=#1F5FAD;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="214" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="通信点検&lt;br&gt;（UHF・ICOM）" id="p39-v-29" link="docs/SSD-OPS-PHASE-001.html#ACT-CT-01" tooltip="ACT-CT-01：打上げ前、支援員が通信点検を行い、UHF の保護回線とヘッドセットのインタフェース装置、機内通話回線 A・B を確かめる。 機内通話（ICOM）回線は T-0 アンビリカルを通る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="214" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="S帯 PM&lt;br&gt;（STDN→TDRS）" id="p39-v-30" link="docs/SSD-OPS-PHASE-001.html#ACT-CT-02" tooltip="ACT-CT-02：上昇中の S帯 PM 通信は、MET 約7分30秒に BFS の保存プログラム指令で STDN から TDRS のモードに切り替わる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="214" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="S帯・Ku帯&lt;br&gt;（TDRS）" id="p39-v-31" link="docs/SSD-OPS-PHASE-001.html#ACT-CT-03" tooltip="ACT-CT-03：軌道投入後に S帯を TDRSS の高レートに設定し、Ku帯アンテナを展開して起動する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="670" y="214" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="S帯・Ku帯＋&lt;br&gt;UHF（EVA）" id="p39-v-32" link="docs/SSD-OPS-PHASE-001.html#ACT-CT-04" tooltip="ACT-CT-04：EVA 通信系は、オービタの UHF 系、EMU 無線、EMU 電気ハーネス、通信キャリア組立、生体センサなどから成る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="878" y="214" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Ku帯アンテナ収納" id="p39-v-33" link="docs/SSD-OPS-PHASE-001.html#ACT-CT-05" tooltip="ACT-CT-05：離脱準備では TIG の3時間48分前に Ku帯アンテナを収納する（前夜に収納済みでなければ）。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="774" y="214" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="S帯&lt;br&gt;（冗長構成）" id="p39-v-34" link="docs/SSD-OPS-PHASE-001.html#ACT-CT-06" tooltip="ACT-CT-06：再突入のスイッチ構成では、通信パネルを冗長度が最大になるように構成する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="982" y="214" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="MCC と交信" id="p39-v-35" link="docs/SSD-OPS-PHASE-001.html#ACT-CT-07" tooltip="ACT-CT-07：機体が停止すると、機長は MCC に「wheels stop」を報告する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1294" y="214" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止（地上処理）" id="p39-v-36" link="docs/SSD-OPS-PHASE-001.html#ACT-CT-08" tooltip="ACT-CT-08：乗員の退出後は地上員がオービタの電源を切り、機体は滑走路からオービタ整備施設（OPF）へ移る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="214" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="上昇・再突入と同じ（MCC の指示）" id="p39-v-37" link="docs/SSD-OPS-PHASE-001.html#ACT-CT-09" tooltip="ACT-CT-09：上昇中、乗員は MCC の音声で現在のアボート能力を把握し、通信を失った場合は NO COMM MODE BOUNDARIES のカードを使う。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="214" width="416" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="データ処理系（DPS）" id="p39-v-38" link="docs/SSD-FD-DPS-001.html" tooltip="クリックで SSD-FD-DPS-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#DCE8F6;strokeColor=#1F5FAD;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="260" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="OPS 1 をロード&lt;br&gt;（PASS・BFS）" id="p39-v-39" link="docs/SSD-OPS-PHASE-001.html#ACT-DPS-01" tooltip="ACT-DPS-01：L-1:00 に PASS の OPS 1 のロードを始め、L-58:30 に BFS を OPS 1 に遷移させる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="260" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="OPS 1&lt;br&gt;（MM 102〜106）" id="p39-v-40" link="docs/SSD-OPS-PHASE-001.html#ACT-DPS-02" tooltip="ACT-DPS-02：上昇中の GNC は、離昇から SRB 分離までが MM 102、SRB 分離から ET 分離までが MM 103、その後 OMS-2 の終了までが MM 104〜106 である。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="260" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="GNC OPS 2・SM&lt;br&gt;（GPC 1・2・4）" id="p39-v-41" link="docs/SSD-OPS-PHASE-001.html#ACT-DPS-03" tooltip="ACT-DPS-03：軌道では GNC OPS 2 を GPC 1・2 に、SM ソフトウェアを GPC 4 に読み込み、GPC 3 は待機、GPC 5 は BFS のまま停止させる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="670" y="260" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="GNC OPS 2・SM&lt;br&gt;（GPC 1・2・4）" id="p39-v-42" link="docs/SSD-OPS-PHASE-001.html#ACT-DPS-03" tooltip="ACT-DPS-03：軌道では GNC OPS 2 を GPC 1・2 に、SM ソフトウェアを GPC 4 に読み込み、GPC 3 は待機、GPC 5 は BFS のまま停止させる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="878" y="260" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="OPS 3 へ遷移" id="p39-v-43" link="docs/SSD-OPS-PHASE-001.html#ACT-DPS-04" tooltip="ACT-DPS-04：離脱準備では GPC 1〜4 を PASS OPS 3 に、GPC 5 を BFS OPS 3 に構成する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="774" y="260" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="OPS 3&lt;br&gt;（MM 302〜305）" id="p39-v-44" link="docs/SSD-OPS-PHASE-001.html#ACT-DPS-05" tooltip="ACT-DPS-05：離脱噴射の後は OPS 303 に進み、EI の5分前に OPS 304、TAEM で OPS 305 に遷移する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="982" y="260" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="OPS 9（MM 901）" id="p39-v-45" link="docs/SSD-OPS-PHASE-001.html#ACT-DPS-06" tooltip="ACT-DPS-06：着陸後、MCC の指示で DPS を GNC OPS 901 に遷移させ、GPC 2〜4 を止めてストリングを GPC 1 に割り当て直す。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1294" y="260" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止（地上処理）" id="p39-v-46" link="docs/SSD-OPS-PHASE-001.html#ACT-DPS-07" tooltip="ACT-DPS-07：乗員の退出後は地上員がオービタの電源を切り、機体は滑走路からオービタ整備施設（OPF）へ移る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="260" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="OPS 6&lt;br&gt;（MM 601〜603）" id="p39-v-47" link="docs/SSD-OPS-PHASE-001.html#ACT-DPS-08" tooltip="ACT-DPS-08：打上げ時の GNC のメモリ構成1は OPS 1 と OPS 6（RTLS）の両方を持ち、RTLS の選択で GNC ソフトウェアが RTLS に切り替わる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="260" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="OPS 1→MECO&lt;br&gt;後に OPS 3" id="p39-v-48" link="docs/SSD-OPS-PHASE-001.html#ACT-DPS-09" tooltip="ACT-DPS-09：TAL は MECO と ET 分離の後に GNC OPS 3 への遷移を要し、その時間は約3分しかない。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1606" y="260" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="OPS 1→OPS 3" id="p39-v-49" link="docs/SSD-OPS-PHASE-001.html#ACT-DPS-10" tooltip="ACT-DPS-10：AOA では離脱の目標を OPS 1 で呼び出し、OPS 3 への遷移に持ち越す。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1710" y="260" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="通常の上昇と同じ" id="p39-v-50" link="docs/SSD-OPS-PHASE-001.html#ACT-DPS-11" tooltip="ACT-DPS-11：ATO の動力飛行の手順は、MECO 前の OMS 投棄を除けば通常の上昇チェックリストの手順である。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1814" y="260" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="誘導・航法・制御（GN&amp;C）" id="p39-v-51" link="docs/SSD-FD-GNC-001.html" tooltip="クリックで SSD-FD-GNC-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#DCE8F6;strokeColor=#1F5FAD;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="306" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="航法援助の起動" id="p39-v-52" link="docs/SSD-OPS-PHASE-001.html#ACT-GNC-01" tooltip="ACT-GNC-01：L-5:30 の支援員チェックリストには、通信点検、LiOH キャニスタの取付け、航法援助の起動などが含まれる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="306" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="上昇誘導・ATVC" id="p39-v-53" link="docs/SSD-OPS-PHASE-001.html#ACT-GNC-02" tooltip="ACT-GNC-02：速度 127 fps 以上で機体はロール・ヨー・ピッチして上昇姿勢をとる。 ATVC の指令は GPC の飛行制御系が生成した位置指令に始まり、SSME と SRB のサーボアクチュエータでノズルを首振りさせて終わる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="306" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="OMS 燃焼の誘導" id="p39-v-54" link="docs/SSD-OPS-PHASE-001.html#ACT-GNC-03" tooltip="ACT-GNC-03：OMS-2 では点火前に姿勢誤差を直す必要は無く、OMS エンジンの推力方向制御が機体を正しい姿勢へ導く。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="566" y="306" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="姿勢制御・&lt;br&gt;IMU アライン" id="p39-v-55" link="docs/SSD-OPS-PHASE-001.html#ACT-GNC-04" tooltip="ACT-GNC-04：軌道ではスタートラッカの電源を入れて扉を開き、星のデータで IMU のアラインを行う。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="670" y="306" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="姿勢制御・&lt;br&gt;IMU アライン" id="p39-v-56" link="docs/SSD-OPS-PHASE-001.html#ACT-GNC-04" tooltip="ACT-GNC-04：軌道ではスタートラッカの電源を入れて扉を開き、星のデータで IMU のアラインを行う。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="878" y="306" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="FCS・&lt;br&gt;航法援助の起動" id="p39-v-57" link="docs/SSD-OPS-PHASE-001.html#ACT-GNC-05" tooltip="ACT-GNC-05：TIG の3時間15分前に、再突入に向けて FCS・DDU・航法援助の電源を入れる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="774" y="306" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="離脱噴射の誘導" id="p39-v-58" link="docs/SSD-OPS-PHASE-001.html#ACT-GNC-06" tooltip="ACT-GNC-06：離脱噴射では、機長と操縦手が OMS MNVR EXEC の表示で速度増分・残り時間・近地点高度を監視する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="982" y="306" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="再突入誘導・&lt;br&gt;舵面制御" id="p39-v-59" link="docs/SSD-OPS-PHASE-001.html#ACT-GNC-07" tooltip="ACT-GNC-07：動圧 2.0 psf で空力舵面の制御が始まり、約 8 psf で閉ループ誘導が始まる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1086" y="306" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="進入・着陸誘導・&lt;br&gt;MLS" id="p39-v-60" link="docs/SSD-OPS-PHASE-001.html#ACT-GNC-08" tooltip="ACT-GNC-08：高度 10,000 ft で乗員は進入・着陸誘導に入ったことを確かめ、それ以前に MLS を捕捉する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1190" y="306" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止&lt;br&gt;（NWS・操縦装置）" id="p39-v-61" link="docs/SSD-OPS-PHASE-001.html#ACT-GNC-09" tooltip="ACT-GNC-09：着陸後、機長は前輪操向・飛行操縦装置・HUD の電源を切る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1294" y="306" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止（地上処理）" id="p39-v-62" link="docs/SSD-OPS-PHASE-001.html#ACT-GNC-10" tooltip="ACT-GNC-10：乗員の退出後は地上員がオービタの電源を切り、機体は滑走路からオービタ整備施設（OPF）へ移る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="306" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="RTLS 誘導&lt;br&gt;（PPA）" id="p39-v-63" link="docs/SSD-OPS-PHASE-001.html#ACT-GNC-11" tooltip="ACT-GNC-11：RTLS では機体が来た道を戻るために向きを反転する必要があり、この旋回を動力ピッチアラウンド（PPA）という。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="306" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="TAL 誘導&lt;br&gt;（着陸地点へ）" id="p39-v-64" link="docs/SSD-OPS-PHASE-001.html#ACT-GNC-12" tooltip="ACT-GNC-12：アボートの選択で、TAL の誘導は選んだ着陸地点の面へ機体を向け始める。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1606" y="306" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="AOA 目標&lt;br&gt;（OMS-1/2）" id="p39-v-65" link="docs/SSD-OPS-PHASE-001.html#ACT-GNC-13" tooltip="ACT-GNC-13：OMS-1 の AOA は、MECO 後に乗員が OMS MNVR の表示で AOA の目標を選んで決める。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1710" y="306" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="ATO 目標・&lt;br&gt;可変 I-Y" id="p39-v-66" link="docs/SSD-OPS-PHASE-001.html#ACT-GNC-14" tooltip="ACT-GNC-14：MECO 前の ATO の選択は OMS 投棄を行い、アボート用の MECO 目標に切り替え、可変 I-Y 誘導を有効にすることがある。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1814" y="306" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="姿勢制御系（RCS）" id="p39-v-67" link="docs/SSD-FD-RCS-001.html" tooltip="クリックで SSD-FD-RCS-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FCE3D3;strokeColor=#C24A0C;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="352" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="待機&lt;br&gt;（クロスフィード弁）" id="p39-v-68" link="docs/SSD-OPS-PHASE-001.html#ACT-RCS-01" tooltip="ACT-RCS-01：L-25 分ごろ、OMS/RCS のクロスフィード弁を打上げ処理システムが打上げ用に構成する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="352" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="待機（姿勢は TVC）" id="p39-v-69" link="docs/SSD-OPS-PHASE-001.html#ACT-RCS-02" tooltip="ACT-RCS-02：誘導系の指令は ATVC ドライバへ送られ、ドライバは指令に比例した信号を主エンジンと SRB の各サーボアクチュエータへ送る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="352" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="SRB 分離時に&lt;br&gt;前方ジェット噴射" id="p39-v-70" link="docs/SSD-OPS-PHASE-001.html#ACT-RCS-03" tooltip="ACT-RCS-03：SRB 分離の間、前方 RCS の上向きジェット3基が操縦室の窓を SRB の破片から守るために噴射する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="462" y="352" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="ET 分離の並進・&lt;br&gt;姿勢制御" id="p39-v-71" link="docs/SSD-OPS-PHASE-001.html#ACT-RCS-04" tooltip="ACT-RCS-04：前方・後方の RCS ジェットは、姿勢制御、ET 分離時の並進、OMS 燃焼姿勢への運動を行う。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="566" y="352" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="姿勢制御・並進&lt;br&gt;（バーニア）" id="p39-v-72" link="docs/SSD-OPS-PHASE-001.html#ACT-RCS-05" tooltip="ACT-RCS-05：軌道では前方・後方の RCS ジェットが姿勢制御と小さな並進運動を行う。 MCC の GO の後、機長はバーニアジェットを起動し、DAP は通常 A/AUTO/VERN を選ぶ。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="670" y="352" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="姿勢制御・&lt;br&gt;前方 RCS 投棄" id="p39-v-73" link="docs/SSD-OPS-PHASE-001.html#ACT-RCS-06" tooltip="ACT-RCS-06：離脱噴射の後は RCS で機首を前に向け、EI の18分前に前方 RCS の推進薬を投棄する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="982" y="352" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="後方 RCS&lt;br&gt;（ロール→ピッチ停止）" id="p39-v-74" link="docs/SSD-OPS-PHASE-001.html#ACT-RCS-07" tooltip="ACT-RCS-07：再突入では後方 RCS だけを使い、動圧 10 psf でロール、40 psf でピッチの機能を止める。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1086" y="352" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止&lt;br&gt;（Mach 1 で全停止）" id="p39-v-75" link="docs/SSD-OPS-PHASE-001.html#ACT-RCS-08" tooltip="ACT-RCS-08：Mach 1 ですべての RCS ジェットの動作を止め、以後は空力舵面だけで機体を操る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1190" y="352" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="安全化" id="p39-v-76" link="docs/SSD-OPS-PHASE-001.html#ACT-RCS-09" tooltip="ACT-RCS-09：着陸後、機長と操縦手は RCS・OMS を安全化する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1294" y="352" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止（地上処理）" id="p39-v-77" link="docs/SSD-OPS-PHASE-001.html#ACT-RCS-10" tooltip="ACT-RCS-10：乗員の退出後は地上員がオービタの電源を切り、機体は滑走路からオービタ整備施設（OPF）へ移る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="352" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="OMS 推進薬の投棄（連結）" id="p39-v-78" link="docs/SSD-OPS-PHASE-001.html#ACT-RCS-11" tooltip="ACT-RCS-11：連結投棄では GPC が弁を切り替え、OMS 推進薬を RCS ジェットで燃やす。 TAL では、OMS 推進薬を OMS エンジンと OMS タンクに連結した後方 RCS 24 基から投棄するのが通常である。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="352" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="通常と同じ" id="p39-v-79" link="docs/SSD-OPS-PHASE-001.html#ACT-RCS-12" tooltip="ACT-RCS-12：AOA の再突入と着陸は、通常の再突入・着陸と同様である。 ATO の動力飛行の手順は、MECO 前の OMS 投棄を除けば通常の上昇チェックリストの手順である。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1710" y="352" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="電力系（EPS）" id="p39-v-80" link="docs/SSD-FD-EPS-001.html" tooltip="クリックで SSD-FD-EPS-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FBF1CF;strokeColor=#A77B00;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="398" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="地上電源＋燃料電池&lt;br&gt;（T-50秒〜燃料電池）" id="p39-v-81" link="docs/SSD-OPS-PHASE-001.html#ACT-EPS-01" tooltip="ACT-EPS-01：打上げの50秒前までは、地上電源と機上の燃料電池が電力を供給する。 T-8 分に操縦手が必須母線を燃料電池に接続する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="398" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="燃料電池3基" id="p39-v-82" link="docs/SSD-OPS-PHASE-001.html#ACT-EPS-02" tooltip="ACT-EPS-02：EPS は飛行のすべてのフェーズで動作し、3基の燃料電池が打上げの50秒前から着陸の滑走終了まで機体の 28 V 直流電力のすべてを発電する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="398" width="936" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="燃料電池3基" id="p39-v-83" link="docs/SSD-OPS-PHASE-001.html#ACT-EPS-02" tooltip="ACT-EPS-02：EPS は飛行のすべてのフェーズで動作し、3基の燃料電池が打上げの50秒前から着陸の滑走終了まで機体の 28 V 直流電力のすべてを発電する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="398" width="416" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="燃料電池（稼働継続）" id="p39-v-84" link="docs/SSD-OPS-PHASE-001.html#ACT-EPS-03" tooltip="ACT-EPS-03：着陸後の点検の間も燃料電池は稼働を続ける。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1294" y="398" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止&lt;br&gt;（地上員が電源断）" id="p39-v-85" link="docs/SSD-OPS-PHASE-001.html#ACT-EPS-04" tooltip="ACT-EPS-04：乗員の退出後は地上員がオービタの電源を切り、機体は滑走路からオービタ整備施設（OPF）へ移る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="398" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="環境制御・生命維持（ECLSS）" id="p39-v-86" link="docs/SSD-FD-ECLSS-001.html" tooltip="クリックで SSD-FD-ECLSS-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FBF1CF;strokeColor=#A77B00;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="444" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="地上冷却・&lt;br&gt;キャビン気密点検" id="p39-v-87" link="docs/SSD-OPS-PHASE-001.html#ACT-ECLSS-01" tooltip="ACT-ECLSS-01：打上げ前、フレオン冷却ループは地上支援設備で冷やす。 ハッチを閉じた後、キャビンを 16.7 psi に加圧してリーク点検を行う。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="444" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="能動冷却なし&lt;br&gt;（熱慣性）" id="p39-v-88" link="docs/SSD-OPS-PHASE-001.html#ACT-ECLSS-02" tooltip="ACT-ECLSS-02：離昇から SRB 分離のころまでは能動的な冷却手段が無く、フレオンループの熱慣性で温度上昇を抑える。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="444" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="FES で冷却" id="p39-v-89" link="docs/SSD-OPS-PHASE-001.html#ACT-ECLSS-03" tooltip="ACT-ECLSS-03：SRB 分離で FES が BFS から GPC ON 指令を受けて能動冷却を始め、上昇から軌道投入後の作業まで主な冷却源となる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="462" y="444" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="放熱器で冷却&lt;br&gt;（14.7 psia）" id="p39-v-90" link="docs/SSD-OPS-PHASE-001.html#ACT-ECLSS-04" tooltip="ACT-ECLSS-04：軌道投入後の作業で放熱器に冷却材を流し、ペイロードベイドアを開くと、放熱器が主な冷却源になる。 圧力制御系は通常、乗員室を 14.7 ± 0.2 psia に与圧する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="670" y="444" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="キャビン 10.2 psia・&lt;br&gt;エアロック減圧" id="p39-v-91" link="docs/SSD-OPS-PHASE-001.html#ACT-ECLSS-05" tooltip="ACT-ECLSS-05：EVA の前には、事前酸素呼吸を楽にするためにキャビンを 10.2 psia に減圧できる。 エアロック減圧弁は、キャビンを 10.2 psia に減圧するときと、EVA のためにエアロックを減圧するときに使う。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="878" y="444" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="放熱器の&lt;br&gt;コールドソーク" id="p39-v-92" link="docs/SSD-OPS-PHASE-001.html#ACT-ECLSS-06" tooltip="ACT-ECLSS-06：離脱準備では、再突入で使うために放熱器をコールドソークする。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="774" y="444" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="FES で冷却" id="p39-v-93" link="docs/SSD-OPS-PHASE-001.html#ACT-ECLSS-07" tooltip="ACT-ECLSS-07：コールドソークの後は放熱器をバイパスし、FES が離脱から EI を経て V=12k（約 175,000 ft）まで冷却する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="982" y="444" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="放熱器コールドソーク（V=12k〜）" id="p39-v-94" link="docs/SSD-OPS-PHASE-001.html#ACT-ECLSS-08" tooltip="ACT-ECLSS-08：V=12k で放熱器の制御器を起動し、蓄えた冷たいフレオンを使う。放熱器のコールドソークは通常、滑走終了までの主な冷却源となる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1086" y="444" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="NH3 ボイラ→&lt;br&gt;地上冷却" id="p39-v-95" link="docs/SSD-OPS-PHASE-001.html#ACT-ECLSS-09" tooltip="ACT-ECLSS-09：コールドソークを使い切るとアンモニアボイラが主な冷却源となり、地上支援設備の冷却車の接続が終わると地上冷却に切り替える。 着陸後の早い段階で、機長が放熱器の再構成とアンモニアボイラの起動を行う。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1294" y="444" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止（地上処理）" id="p39-v-96" link="docs/SSD-OPS-PHASE-001.html#ACT-ECLSS-10" tooltip="ACT-ECLSS-10：乗員の退出後は地上員がオービタの電源を切り、機体は滑走路からオービタ整備施設（OPF）へ移る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="444" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="FES→NH3 ボイラ&lt;br&gt;（ET 分離から）" id="p39-v-97" link="docs/SSD-OPS-PHASE-001.html#ACT-ECLSS-11" tooltip="ACT-ECLSS-11：RTLS では、アンモニアボイラが ET 分離（MM 602）で BFS から GPC ON 指令を受け、着陸まで冷却する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="444" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="FES→NH3 ボイラ（MM 304・120,000 ft）" id="p39-v-98" link="docs/SSD-OPS-PHASE-001.html#ACT-ECLSS-12" tooltip="ACT-ECLSS-12：TAL・AOA では、アンモニアボイラが MM 304・高度 120,000 ft で BFS から GPC ON 指令を受ける。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1606" y="444" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="通常の上昇と同じ" id="p39-v-99" link="docs/SSD-OPS-PHASE-001.html#ACT-ECLSS-13" tooltip="ACT-ECLSS-13：ATO の動力飛行の手順は、MECO 前の OMS 投棄を除けば通常の上昇チェックリストの手順である。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1814" y="444" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="補助動力・油圧（APU/HYD）" id="p39-v-100" link="docs/SSD-FD-APU-001.html" tooltip="クリックで SSD-FD-APU-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FBF1CF;strokeColor=#A77B00;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="490" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="T-5分に3基起動" id="p39-v-101" link="docs/SSD-OPS-PHASE-001.html#ACT-APU-01" tooltip="ACT-APU-01：T-5 分に操縦手が APU を起動して圧力を確かめる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="490" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="3基稼働（SSME・舵面の油圧）" id="p39-v-102" link="docs/SSD-OPS-PHASE-001.html#ACT-APU-02" tooltip="ACT-APU-02：APU や油圧の故障が破局につながらない限り、主エンジンへの油圧を途切れさせないため、系は MECO の後まで止めない。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="490" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="MPS 投棄の&lt;br&gt;後に停止" id="p39-v-103" link="docs/SSD-OPS-PHASE-001.html#ACT-APU-03" tooltip="ACT-APU-03：MPS 投棄の後、油圧の MPS/TVC 隔離弁を閉じ、MCC と確認して APU を停止する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="566" y="490" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止&lt;br&gt;（循環ポンプで保温）" id="p39-v-104" link="docs/SSD-OPS-PHASE-001.html#ACT-APU-04" tooltip="ACT-APU-04：軌道では油圧の熱調節を有効にし、圧力や温度が下がると GPC が油圧の循環ポンプを動かす。 最後の終日の FCS 点検では、MCC が指定した APU を1基使う（循環ポンプで代えることもある）。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="670" y="490" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止&lt;br&gt;（循環ポンプで保温）" id="p39-v-105" link="docs/SSD-OPS-PHASE-001.html#ACT-APU-04" tooltip="ACT-APU-04：軌道では油圧の熱調節を有効にし、圧力や温度が下がると GPC が油圧の循環ポンプを動かす。 最後の終日の FCS 点検では、MCC が指定した APU を1基使う（循環ポンプで代えることもある）。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="878" y="490" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="TIG-5分に&lt;br&gt;1基起動" id="p39-v-106" link="docs/SSD-OPS-PHASE-001.html#ACT-APU-05" tooltip="ACT-APU-05：TIG の5分前に操縦手が APU を1基起動する。離脱噴射の前に1基が低圧で動いていなければならない。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="774" y="490" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="1基→&lt;br&gt;EI-13分に3基" id="p39-v-107" link="docs/SSD-OPS-PHASE-001.html#ACT-APU-06" tooltip="ACT-APU-06：EI の13分前に残りの2基を起動し、3基とも通常圧力に切り替えて SSME の油圧再加圧に備える。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="982" y="490" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="3基稼働（舵面・脚・ブレーキ）" id="p39-v-108" link="docs/SSD-OPS-PHASE-001.html#ACT-APU-07" tooltip="ACT-APU-07：Mach 2.6 で操縦手は、それまでの故障を考えて APU を着陸に最適な構成にする。 脚下げを指令すると、油圧系1の圧力で各脚のアップロックフックが外れる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1086" y="490" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="主エンジン再配置&lt;br&gt;の後に停止" id="p39-v-109" link="docs/SSD-OPS-PHASE-001.html#ACT-APU-08" tooltip="ACT-APU-08：着陸後、主エンジンの再配置が終わると APU・油圧を停止する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1294" y="490" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止（地上処理）" id="p39-v-110" link="docs/SSD-OPS-PHASE-001.html#ACT-APU-09" tooltip="ACT-APU-09：乗員の退出後は地上員がオービタの電源を切り、機体は滑走路からオービタ整備施設（OPF）へ移る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="490" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="3基稼働（着陸まで）" id="p39-v-111" link="docs/SSD-OPS-PHASE-001.html#ACT-APU-10" tooltip="ACT-APU-10：APU・油圧の系は MECO の後まで止めない。 全油圧の喪失が迫る場合は、地上までの時間が最も短い経路を選ぶ。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="490" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="低圧で&lt;br&gt;運転を継続" id="p39-v-112" link="docs/SSD-OPS-PHASE-001.html#ACT-APU-11" tooltip="ACT-APU-11：OMS-1 の後に AOA を選ぶと、APU を停止せずに油圧系を減圧し、停止と再起動を避ける。低圧で運転すると再突入用の燃料を節約できる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1710" y="490" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="通常と同じ&lt;br&gt;（MECO 後に停止）" id="p39-v-113" link="docs/SSD-OPS-PHASE-001.html#ACT-APU-12" tooltip="ACT-APU-12：ATO の動力飛行の手順は、MECO 前の OMS 投棄を除けば通常の上昇チェックリストの手順である。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1814" y="490" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="軌道制御系（OMS）" id="p39-v-114" link="docs/SSD-FD-OMS-001.html" tooltip="クリックで SSD-FD-OMS-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FCE3D3;strokeColor=#C24A0C;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="536" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="GN2 加圧・待機" id="p39-v-115" link="docs/SSD-OPS-PHASE-001.html#ACT-OMS-01" tooltip="ACT-OMS-01：L-1:20 に機長が OMS エンジンのスイッチを ARM/PRESS にして GN2 で加圧する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="536" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="待機（OMS アシストは燃焼）" id="p39-v-116" link="docs/SSD-OPS-PHASE-001.html#ACT-OMS-02" tooltip="ACT-OMS-02：性能の厳しい一部のミッションでは、通常の上昇中に OMS アシスト燃焼を行う。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="536" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="OMS-1（必要時）・&lt;br&gt;OMS-2" id="p39-v-117" link="docs/SSD-OPS-PHASE-001.html#ACT-OMS-03" tooltip="ACT-OMS-03：直接投入では OMS-2 燃焼で軌道を安定させ、性能が大きく不足した場合は OMS-1 燃焼で安全な高度へ上げてから OMS-2 を行う。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="566" y="536" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="軌道変換・ランデブ" id="p39-v-118" link="docs/SSD-OPS-PHASE-001.html#ACT-OMS-04" tooltip="ACT-OMS-04：OMS エンジンは、ISS とのランデブのための軌道変換などに使う。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="670" y="536" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="待機（ヒータで保温）" id="p39-v-119" link="docs/SSD-OPS-PHASE-001.html#ACT-OMS-05" tooltip="ACT-OMS-05：軌道投入後に OMS・RCS のヒータを起動し、55〜90°F に保つ。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="774" y="536" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="離脱噴射（2〜3分）" id="p39-v-120" link="docs/SSD-OPS-PHASE-001.html#ACT-OMS-06" tooltip="ACT-OMS-06：離脱噴射では2基の OMS エンジンで軌道を下げる。燃焼時間は通常2〜3分である。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="982" y="536" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止（ジンバルを&lt;br&gt;再突入位置へ）" id="p39-v-121" link="docs/SSD-OPS-PHASE-001.html#ACT-OMS-07" tooltip="ACT-OMS-07：離脱噴射の後、機長はジンバルが再突入の位置へ動いたことを確かめて OMS ジンバルの電源を切る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1086" y="536" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="安全化" id="p39-v-122" link="docs/SSD-OPS-PHASE-001.html#ACT-OMS-08" tooltip="ACT-OMS-08：着陸後、機長と操縦手は RCS・OMS を安全化する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1294" y="536" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止（地上処理）" id="p39-v-123" link="docs/SSD-OPS-PHASE-001.html#ACT-OMS-09" tooltip="ACT-OMS-09：乗員の退出後は地上員がオービタの電源を切り、機体は滑走路からオービタ整備施設（OPF）へ移る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="536" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="推進薬の投棄" id="p39-v-124" link="docs/SSD-OPS-PHASE-001.html#ACT-OMS-10" tooltip="ACT-OMS-10：打上げ時の OMS 推進薬の量はミッションごとに決まり、RTLS では OMS 推進薬を投棄する。連結投棄では OMS 推進薬を RCS ジェットでも燃やす。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="536" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="推進薬の投棄&lt;br&gt;（OMS＋後方 RCS）" id="p39-v-125" link="docs/SSD-OPS-PHASE-001.html#ACT-OMS-11" tooltip="ACT-OMS-11：TAL では OMS 推進薬を OMS エンジンと後方 RCS 24 基から投棄する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1606" y="536" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="OMS-1・離脱噴射" id="p39-v-126" link="docs/SSD-OPS-PHASE-001.html#ACT-OMS-12" tooltip="ACT-OMS-12：AOA では1回目の OMS 燃焼で MECO 後の軌道を調整し、2回目の燃焼で離脱する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1710" y="536" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="MECO 前の投棄・&lt;br&gt;OMS-1/2" id="p39-v-127" link="docs/SSD-OPS-PHASE-001.html#ACT-OMS-13" tooltip="ACT-OMS-13：ATO では MECO 前に OMS 推進薬を投棄して重量を減らし推力を加え、2回の OMS 燃焼で約 105 n.mi. の円軌道に入る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1814" y="536" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="主推進系（MPS）" id="p39-v-128" link="docs/SSD-FD-MPS-001.html" tooltip="クリックで SSD-FD-MPS-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FCE3D3;strokeColor=#C24A0C;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="582" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="推進薬充填・&lt;br&gt;T-6.6秒に SSME 始動" id="p39-v-129" link="docs/SSD-OPS-PHASE-001.html#ACT-MPS-01" tooltip="ACT-MPS-01：T-6.6 秒に GPC がエンジン始動を指令し、各エンジンの主燃料弁が開く。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="582" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="SSME×3&lt;br&gt;（スロットルバケット）" id="p39-v-130" link="docs/SSD-OPS-PHASE-001.html#ACT-MPS-02" tooltip="ACT-MPS-02：最大動圧の領域では GPC がエンジンを通常 72% に絞り、MET 約65秒で通常 104% に戻す。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="582" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="SSME×3&lt;br&gt;（3g 制限→MECO）" id="p39-v-131" link="docs/SSD-OPS-PHASE-001.html#ACT-MPS-03" tooltip="ACT-MPS-03：MET 約7分30秒から加速度を 3g 以下に保つようにエンジンを絞り、所定の速度で GPC が MECO を指令する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="462" y="582" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="推進薬の投棄・&lt;br&gt;GH2 不活性化" id="p39-v-132" link="docs/SSD-OPS-PHASE-001.html#ACT-MPS-04" tooltip="ACT-MPS-04：直接投入では MECO の2分後に MPS 推進薬の投棄が自動で始まる。 操縦手は MPS エンジンの電源を切って GH2 を不活性化する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="566" y="582" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止" id="p39-v-133" link="docs/SSD-OPS-PHASE-001.html#ACT-MPS-05" tooltip="ACT-MPS-05：軌道投入後、上昇用の推力方向制御、エンジンインタフェース装置、主エンジン用の MEC を電源から切り離す。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="670" y="582" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止（ノズルを収納位置へ）" id="p39-v-134" link="docs/SSD-OPS-PHASE-001.html#ACT-MPS-06" tooltip="ACT-MPS-06：EI の13分前に主エンジンの油圧系を再加圧し、ノズルが正しく収納されていることを確かめる。 Mach 8 でドラッグシュートの展開に備えて SSME を再配置する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="982" y="582" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="主エンジンの再配置" id="p39-v-135" link="docs/SSD-OPS-PHASE-001.html#ACT-MPS-07" tooltip="ACT-MPS-07：着陸後、操縦手はボディフラップを TRAIL にし、OPS 9 の表示で主エンジンを再配置する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1294" y="582" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止（地上処理）" id="p39-v-136" link="docs/SSD-OPS-PHASE-001.html#ACT-MPS-08" tooltip="ACT-MPS-08：乗員の退出後は地上員がオービタの電源を切り、機体は滑走路からオービタ整備施設（OPF）へ移る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="582" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="PPA→MECO・&lt;br&gt;MM 602 で投棄" id="p39-v-137" link="docs/SSD-OPS-PHASE-001.html#ACT-MPS-09" tooltip="ACT-MPS-09：RTLS は機体が滑走路まで滑空できる速度と高度でエンジンを止める。MPS の投棄は MM 602 への遷移と同時に始まる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="582" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="MECO・&lt;br&gt;MM 304 で投棄" id="p39-v-138" link="docs/SSD-OPS-PHASE-001.html#ACT-MPS-10" tooltip="ACT-MPS-10：TAL では RTLS と同様の MPS 投棄が MM 304 で自動で始まる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1606" y="582" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="SSME（停止があれば2基）" id="p39-v-139" link="docs/SSD-OPS-PHASE-001.html#ACT-MPS-11" tooltip="ACT-MPS-11：エンジンの推力の喪失による性能の損失は、故障の時刻に大きく依存する。 PRESS TO ATO は、SSME 2基で設計上の速度不足以内の MECO を達成できる最も早い速度である。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1710" y="582" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="熱防護系（TPS）" id="p39-v-140" link="docs/SSD-FD-TPS-001.html" tooltip="クリックで SSD-FD-TPS-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#5F6B7A;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="628" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="受動（外板を保護）" id="p39-v-141" link="docs/SSD-OPS-PHASE-001.html#ACT-TPS-01" tooltip="ACT-TPS-01：TPS はオービタの外部構造外板に施工した各種材料から成り、主に再突入時に外板を許容温度内に保つ。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="628" width="728" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="受動（外板を保護）" id="p39-v-142" link="docs/SSD-OPS-PHASE-001.html#ACT-TPS-01" tooltip="ACT-TPS-01：TPS はオービタの外部構造外板に施工した各種材料から成り、主に再突入時に外板を許容温度内に保つ。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1294" y="628" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="受動（外板を保護）" id="p39-v-143" link="docs/SSD-OPS-PHASE-001.html#ACT-TPS-01" tooltip="ACT-TPS-01：TPS はオービタの外部構造外板に施工した各種材料から成り、主に再突入時に外板を許容温度内に保つ。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1814" y="628" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="受動（再突入の加熱）" id="p39-v-144" link="docs/SSD-OPS-PHASE-001.html#ACT-TPS-02" tooltip="ACT-TPS-02：EI の約6分後から表面温度が最大になる領域（Mach 24〜19）に入る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="982" y="628" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="受動（再突入の加熱）" id="p39-v-145" link="docs/SSD-OPS-PHASE-001.html#ACT-TPS-02" tooltip="ACT-TPS-02：EI の約6分後から表面温度が最大になる領域（Mach 24〜19）に入る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1710" y="628" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="受動（加熱は&lt;br&gt;通常より小さい）" id="p39-v-146" link="docs/SSD-OPS-PHASE-001.html#ACT-TPS-03" tooltip="ACT-TPS-03：RTLS の再突入の熱負荷は、ほかのアボートや通常の着陸より小さい。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="628" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="受動&lt;br&gt;（加熱が厳しい）" id="p39-v-147" link="docs/SSD-OPS-PHASE-001.html#ACT-TPS-04" tooltip="ACT-TPS-04：TAL の再突入軌道は熱的に厳しい。 TAL の引起こしでは、主翼前縁の高温を避けるために初期迎角を 43° とする。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1606" y="628" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="構造（STR）" id="p39-v-148" link="docs/SSD-FD-STR-001.html" tooltip="クリックで SSD-FD-STR-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#5F6B7A;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="674" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="受動（垂直姿勢で&lt;br&gt;ET に結合）" id="p39-v-149" link="docs/SSD-OPS-PHASE-001.html#ACT-STR-01" tooltip="ACT-STR-01：打上げ構成では、オービタと2本の SRB が発射台の上で外部タンクに機首を上にして結合されている。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="674" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="最大動圧&lt;br&gt;（MET 30〜60秒）" id="p39-v-150" link="docs/SSD-OPS-PHASE-001.html#ACT-STR-02" tooltip="ACT-STR-02：最大動圧は上昇の早い段階、通常は離昇の30〜60秒後に達する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="674" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="加速度 3g 以下" id="p39-v-151" link="docs/SSD-OPS-PHASE-001.html#ACT-STR-03" tooltip="ACT-STR-03：乗員室は普段着で過ごせる環境で、加速度は 3g を超えない。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="462" y="674" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="加速度 3g 以下" id="p39-v-152" link="docs/SSD-OPS-PHASE-001.html#ACT-STR-03" tooltip="ACT-STR-03：乗員室は普段着で過ごせる環境で、加速度は 3g を超えない。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="982" y="674" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="受動（与圧容器）" id="p39-v-153" link="docs/SSD-OPS-PHASE-001.html#ACT-STR-04" tooltip="ACT-STR-04：乗員室は 16 psia で設計されている。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="670" y="674" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="地上のパージで冷却" id="p39-v-154" link="docs/SSD-OPS-PHASE-001.html#ACT-STR-05" tooltip="ACT-STR-05：着陸後は右側の T-0 アンビリカルに空調パージ装置をつなぎ、後部胴体・ペイロードベイ・前部胴体・主翼・垂直尾翼・OMS/RCS ポッドに冷気を送って再突入の熱を逃がす。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1294" y="674" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止（地上処理）" id="p39-v-155" link="docs/SSD-OPS-PHASE-001.html#ACT-STR-06" tooltip="ACT-STR-06：乗員の退出後は地上員がオービタの電源を切り、機体は滑走路からオービタ整備施設（OPF）へ移る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="674" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="上昇・再突入と同じ（3g 以下）" id="p39-v-156" link="docs/SSD-OPS-PHASE-001.html#ACT-STR-07" tooltip="ACT-STR-07：加速度は 3g を超えない。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="674" width="416" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="機械系（MECH）" id="p39-v-157" link="docs/SSD-FD-MECH-001.html" tooltip="クリックで SSD-FD-MECH-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3E9DD;strokeColor=#8D5A2B;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="720" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="ベント扉&lt;br&gt;（パージ位置）" id="p39-v-158" link="docs/SSD-OPS-PHASE-001.html#ACT-MECH-01" tooltip="ACT-MECH-01：ベント扉の一部には中間位置があり、非与圧区画を乾燥空気または窒素でパージできる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="720" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="ベント扉（自動シーケンス）" id="p39-v-159" link="docs/SSD-OPS-PHASE-001.html#ACT-MECH-02" tooltip="ACT-MECH-02：ベント扉は、マスタタイミングユニット、メジャーモードの遷移、速度、DPS の項目入力で起動する GNC ソフトウェアのシーケンスで制御される。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="720" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="ET アンビリカル&lt;br&gt;扉を閉" id="p39-v-160" link="docs/SSD-OPS-PHASE-001.html#ACT-MECH-03" tooltip="ACT-MECH-03：操縦手は ET アンビリカル扉を閉じる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="566" y="720" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="PLBD 開（放熱器）" id="p39-v-161" link="docs/SSD-OPS-PHASE-001.html#ACT-MECH-04" tooltip="ACT-MECH-04：MET 1:28 ごろ PLBD を自動で開き、各扉は約63秒で開く。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="670" y="720" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="PLBD 開（放熱器）" id="p39-v-162" link="docs/SSD-OPS-PHASE-001.html#ACT-MECH-04" tooltip="ACT-MECH-04：MET 1:28 ごろ PLBD を自動で開き、各扉は約63秒で開く。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="878" y="720" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="PLBD 閉・ベント扉閉" id="p39-v-163" link="docs/SSD-OPS-PHASE-001.html#ACT-MECH-05" tooltip="ACT-MECH-05：TIG の2時間40分前に PLBD を閉じ、25分前に操縦手がベント扉を閉じる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="774" y="720" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="ベント扉閉" id="p39-v-164" link="docs/SSD-OPS-PHASE-001.html#ACT-MECH-06" tooltip="ACT-MECH-06：離脱噴射の前に、操縦手が GNC 51 の表示でベント扉を閉じる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="982" y="720" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="ベント扉開&lt;br&gt;（Mach 2.4）" id="p39-v-165" link="docs/SSD-OPS-PHASE-001.html#ACT-MECH-07" tooltip="ACT-MECH-07：Mach 2.4 で前部・後部・中部の区画のベントが開く。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1086" y="720" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="脚下げ・ブレーキ・&lt;br&gt;ドラッグシュート" id="p39-v-166" link="docs/SSD-OPS-PHASE-001.html#ACT-MECH-08" tooltip="ACT-MECH-08：高度 300 ft で操縦手が着陸装置を下げ、主脚接地の後にドラッグシュートを展開し、ブレーキを掛ける。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1190" y="720" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="ET 扉開・脚と&lt;br&gt;シュートの安全化" id="p39-v-167" link="docs/SSD-OPS-PHASE-001.html#ACT-MECH-09" tooltip="ACT-MECH-09：着陸後、ドラッグシュートと着陸装置を安全化し、MCC に知らせてから ET アンビリカル扉を開く。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1294" y="720" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止（地上処理）" id="p39-v-168" link="docs/SSD-OPS-PHASE-001.html#ACT-MECH-10" tooltip="ACT-MECH-10：乗員の退出後は地上員がオービタの電源を切り、機体は滑走路からオービタ整備施設（OPF）へ移る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="720" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="ET 扉を閉（2母線故障時は RTLS）" id="p39-v-169" link="docs/SSD-OPS-PHASE-001.html#ACT-MECH-11" tooltip="ACT-MECH-11：主母線2系統の故障は ET 扉の閉鎖を妨げ、TAL の再突入は熱的に厳しいため、この場合は RTLS を優先する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="720" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="通常と同じ" id="p39-v-170" link="docs/SSD-OPS-PHASE-001.html#ACT-MECH-12" tooltip="ACT-MECH-12：AOA の再突入と着陸は、通常の再突入・着陸と同様である。 ATO の動力飛行の手順は、MECO 前の OMS 投棄を除けば通常の上昇チェックリストの手順である。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1710" y="720" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="警報系（C/W）" id="p39-v-171" link="docs/SSD-FD-CW-001.html" tooltip="クリックで SSD-FD-CW-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#DCE8F6;strokeColor=#1F5FAD;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="766" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="音量調整・メモリ消去" id="p39-v-172" link="docs/SSD-OPS-PHASE-001.html#ACT-CW-01" tooltip="ACT-CW-01：打上げ前、空地通信が C/W の音より大きく聞こえるように C/W の音量を調整する。L-17 分に操縦手が C/W のメモリスイッチで F7 のライトを消す。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="766" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="上昇用の限界値で監視" id="p39-v-173" link="docs/SSD-OPS-PHASE-001.html#ACT-CW-02" tooltip="ACT-CW-02：軌道投入後に C/W 系を上昇用から軌道用の運用に再設定し、一部の限界値を変え、一部を抑止する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="766" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="軌道用の限界値で監視" id="p39-v-174" link="docs/SSD-OPS-PHASE-001.html#ACT-CW-03" tooltip="ACT-CW-03：軌道投入後に C/W 系を上昇用から軌道用の運用に再設定する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="670" y="766" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="軌道用の限界値で監視" id="p39-v-175" link="docs/SSD-OPS-PHASE-001.html#ACT-CW-03" tooltip="ACT-CW-03：軌道投入後に C/W 系を上昇用から軌道用の運用に再設定する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="878" y="766" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="再突入用の設定" id="p39-v-176" link="docs/SSD-OPS-PHASE-001.html#ACT-CW-04" tooltip="ACT-CW-04：離脱準備では MPS のヘリウム系の圧力の C/W を有効にし、油圧系の低圧の C/W も有効にする。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="774" y="766" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="監視" id="p39-v-177" link="docs/SSD-OPS-PHASE-001.html#ACT-CW-05" tooltip="ACT-CW-05：C/W 系は、APU、データ処理系、ECLSS、電力系、飛行制御系、誘導・航法、油圧、主推進系、RCS、OMS、ペイロードとインタフェースを持つ。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="982" y="766" width="416" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止（地上処理）" id="p39-v-178" link="docs/SSD-OPS-PHASE-001.html#ACT-CW-06" tooltip="ACT-CW-06：乗員の退出後は地上員がオービタの電源を切り、機体は滑走路からオービタ整備施設（OPF）へ移る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="766" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="監視（系統故障によるアボート）" id="p39-v-179" link="docs/SSD-OPS-PHASE-001.html#ACT-CW-07" tooltip="ACT-CW-07：SYS FLIGHT RULES のカードは、重大な系統故障に対して RTLS・TAL を選ぶ規則をまとめたものである。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="766" width="416" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="乗員系・脱出系（CREW）" id="p39-v-180" link="docs/SSD-FD-CREW-001.html" tooltip="クリックで SSD-FD-CREW-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3E9DD;strokeColor=#8D5A2B;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="812" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="搭乗・LES 着用&lt;br&gt;（T-2分に O2）" id="p39-v-181" link="docs/SSD-OPS-PHASE-001.html#ACT-CREW-01" tooltip="ACT-CREW-01：乗員は L-2:45 にホワイトルームへ到着して搭乗し、T-2 分に全員が酸素の流れを始めてバイザーを閉じる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="812" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="LES 着用・着座" id="p39-v-182" link="docs/SSD-OPS-PHASE-001.html#ACT-CREW-02" tooltip="ACT-CREW-02：MET 1:37 に機長と操縦手が座席を離れ、全員が打上げ・再突入服（LES）を脱いで収納する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="812" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="LES 収納・&lt;br&gt;ギャレー・WCS" id="p39-v-183" link="docs/SSD-OPS-PHASE-001.html#ACT-CREW-03" tooltip="ACT-CREW-03：軌道投入後にギャレーと廃棄物収集系（WCS）を構成して起動する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="670" y="812" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="事前酸素呼吸・&lt;br&gt;EMU 着用" id="p39-v-184" link="docs/SSD-OPS-PHASE-001.html#ACT-CREW-04" tooltip="ACT-CREW-04：EVA の手順は、マスクによる事前酸素呼吸、キャビンの 10.2 psi への減圧、EMU の点検と着用、事前酸素呼吸、エアロックの減圧の順に進む。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="878" y="812" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="座席取付け・LES&lt;br&gt;着用・水分補給" id="p39-v-185" link="docs/SSD-OPS-PHASE-001.html#ACT-CREW-05" tooltip="ACT-CREW-05：離脱準備では専門家が座席を取り付け、機長と操縦手は TIG の1時間24分前に LES を着る。乗員は水分を補給して重力への再適応に備える。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="774" y="812" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="LES 着用・着座" id="p39-v-186" link="docs/SSD-OPS-PHASE-001.html#ACT-CREW-06" tooltip="ACT-CREW-06：TIG の59分前に機長と操縦手が着座し、高度 10,000 ft で LES のバイザーを下ろす（KSC の場合）。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="982" y="812" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="健康確認・退出" id="p39-v-187" link="docs/SSD-OPS-PHASE-001.html#ACT-CREW-07" tooltip="ACT-CREW-07：着陸後、フライトサージャンが機内に入って健康を確認し、乗員は機外へ出る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1294" y="812" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="該当なし（退出済み）" id="p39-v-188" link="docs/SSD-OPS-PHASE-001.html#ACT-CREW-08" tooltip="ACT-CREW-08：乗員は着陸後6〜9時間で通常ヒューストンへ戻る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="812" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="上昇時と同じ（LES 着用）" id="p39-v-189" link="docs/SSD-OPS-PHASE-001.html#ACT-CREW-09" tooltip="ACT-CREW-09：T-2 分に全員が酸素の流れを始めてバイザーを閉じる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="812" width="416" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="ペイロード支援（PDRS・ODS）" id="p39-v-190" link="docs/SSD-FD-PLS-001.html" tooltip="クリックで SSD-FD-PLS-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3E9DD;strokeColor=#8D5A2B;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="858" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="収納（RMS 固定）" id="p39-v-191" link="docs/SSD-OPS-PHASE-001.html#ACT-PLS-01" tooltip="ACT-PLS-01：RMS を搭載する場合、MET 2:35 ごろに起動を始め、MCIU に電源を入れ、肩部のブレースを外す。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="858" width="416" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="RMS 起動・&lt;br&gt;ドッキング系" id="p39-v-192" link="docs/SSD-OPS-PHASE-001.html#ACT-PLS-02" tooltip="ACT-PLS-02：RMS はペイロード運用の必要に応じて展開する。ドッキングの前日にドッキング系を初期化・確認し、終わると電源を切る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="670" y="858" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="外部エアロック&lt;br&gt;（ODS）" id="p39-v-193" link="docs/SSD-OPS-PHASE-001.html#ACT-PLS-03" tooltip="ACT-PLS-03：エアロックはミッドデッキの外、ペイロードベイにあり、オービタドッキング系の節で詳しく扱う。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="878" y="858" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="収納（RMS を固定）" id="p39-v-194" link="docs/SSD-OPS-PHASE-001.html#ACT-PLS-04" tooltip="ACT-PLS-04：PLBD を閉じる準備として、RMS のカメラを位置決めし、RMS のヒータを切る（RMS を搭載した場合）。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="774" y="858" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="収納（RMS を固定）" id="p39-v-195" link="docs/SSD-OPS-PHASE-001.html#ACT-PLS-04" tooltip="ACT-PLS-04：PLBD を閉じる準備として、RMS のカメラを位置決めし、RMS のヒータを切る（RMS を搭載した場合）。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="982" y="858" width="416" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止（地上処理）" id="p39-v-196" link="docs/SSD-OPS-PHASE-001.html#ACT-PLS-05" tooltip="ACT-PLS-05：乗員の退出後は地上員がオービタの電源を切り、機体は滑走路からオービタ整備施設（OPF）へ移る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="858" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="収納（使用しない）" id="p39-v-197" link="docs/SSD-OPS-PHASE-001.html#ACT-PLS-06" tooltip="ACT-PLS-06：RMS の起動は、軌道投入後の MET 2:35 ごろに始める。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="858" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="通常と同じ&lt;br&gt;（軌道で使用）" id="p39-v-198" link="docs/SSD-OPS-PHASE-001.html#ACT-PLS-07" tooltip="ACT-PLS-07：ATO の動力飛行の手順は、MECO 前の OMS 投棄を除けば通常の上昇チェックリストの手順である。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1814" y="858" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="船外活動（EVA/EMU）" id="p39-v-199" link="docs/SSD-FD-EVA-001.html" tooltip="クリックで SSD-FD-EVA-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3E9DD;strokeColor=#8D5A2B;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="904" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="収納（エアロックに EMU×2）" id="p39-v-200" link="docs/SSD-OPS-PHASE-001.html#ACT-EVA-01" tooltip="ACT-EVA-01：通常、2着の EMU をエアロックに収納する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="904" width="416" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="収納（エアロックに EMU×2）" id="p39-v-201" link="docs/SSD-OPS-PHASE-001.html#ACT-EVA-01" tooltip="ACT-EVA-01：通常、2着の EMU をエアロックに収納する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="774" y="904" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="収納（エアロックに EMU×2）" id="p39-v-202" link="docs/SSD-OPS-PHASE-001.html#ACT-EVA-01" tooltip="ACT-EVA-01：通常、2着の EMU をエアロックに収納する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="982" y="904" width="416" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="EMU の点検・整備" id="p39-v-203" link="docs/SSD-OPS-PHASE-001.html#ACT-EVA-02" tooltip="ACT-EVA-02：EVA の後は EMU の電池と水酸化リチウムカートリッジを交換または再充填し、次の EVA に向けて水を再充填する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="670" y="904" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="EMU 稼働&lt;br&gt;（最大7時間・2名）" id="p39-v-204" link="docs/SSD-OPS-PHASE-001.html#ACT-EVA-03" tooltip="ACT-EVA-03：EMU は、脱出15分、有効作業6時間、進入15分、予備30分の、合計最大7時間の EVA に対応するよう設計されている。 計画・計画外の EVA はすべて2名で行う。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="878" y="904" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="停止（地上処理）" id="p39-v-205" link="docs/SSD-OPS-PHASE-001.html#ACT-EVA-04" tooltip="ACT-EVA-04：乗員の退出後は地上員がオービタの電源を切り、機体は滑走路からオービタ整備施設（OPF）へ移る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E7E9EC;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="904" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="収納" id="p39-v-206" link="docs/SSD-OPS-PHASE-001.html#ACT-EVA-05" tooltip="ACT-EVA-05：外部エアロックは、打上げと再突入の間に最大2着の EMU を収納する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="904" width="416" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="外部タンク（ET）" id="p39-v-207" link="docs/SSD-FD-ET-001.html" tooltip="クリックで SSD-FD-ET-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3EEE6;strokeColor=#2E6B45;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="950" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="推進薬充填・&lt;br&gt;タンク加圧" id="p39-v-208" link="docs/SSD-OPS-PHASE-001.html#ACT-ET-01" tooltip="ACT-ET-01：T-2 分55 秒に液体酸素タンク、T-1 分57 秒に液体水素タンクを、地上支援設備のヘリウムで加圧する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="950" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="SSME へ推進薬を供給" id="p39-v-209" link="docs/SSD-OPS-PHASE-001.html#ACT-ET-02" tooltip="ACT-ET-02：主燃料弁の開から MECO まで、液体水素は外部タンクとオービタの間の切離し弁を通って液体水素供給管のマニホールドへ流れる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="950" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="分離・投棄" id="p39-v-210" link="docs/SSD-OPS-PHASE-001.html#ACT-ET-03" tooltip="ACT-ET-03：MECO の後、外部タンクはオービタの指令で投棄され、弾道軌道で大気圏に入って崩壊する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="566" y="950" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="該当なし（分離済み）" id="p39-v-211" link="docs/SSD-OPS-PHASE-001.html#ACT-ET-04" tooltip="ACT-ET-04：外部タンクは MECO の後に投棄される。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="670" y="950" width="832" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="推進薬 2% 以下&lt;br&gt;で分離" id="p39-v-212" link="docs/SSD-OPS-PHASE-001.html#ACT-ET-05" tooltip="ACT-ET-05：RTLS で安全に分離するには、外部タンクの推進薬が 2% 以下でなければならない。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="950" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="MECO 後に分離" id="p39-v-213" link="docs/SSD-OPS-PHASE-001.html#ACT-ET-06" tooltip="ACT-ET-06：外部タンクは MECO の後に投棄される。 TAL では、ET の加熱を抑え ET 分離時に正しい再突入姿勢をとるため、所定の速度でヘッドアップにロールする。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1606" y="950" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="固体ロケットブースタ（SRB×2）" id="p39-v-214" link="docs/SSD-FD-SRB-001.html" tooltip="クリックで SSD-FD-SRB-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FCE3D3;strokeColor=#C24A0C;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="996" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="ホールドダウン&lt;br&gt;（T-0 に解放）" id="p39-v-215" link="docs/SSD-OPS-PHASE-001.html#ACT-SRB-01" tooltip="ACT-SRB-01：各 SRB は後部スカートで移動式発射台に4本のボルトで固定され、T-0 に GPC がホールドダウン解放の火工品を点火する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="996" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="燃焼（約2分）" id="p39-v-216" link="docs/SSD-OPS-PHASE-001.html#ACT-SRB-02" tooltip="ACT-SRB-02：約2分で2本の SRB は推進薬を使い切る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="996" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="分離・降下・回収" id="p39-v-217" link="docs/SSD-OPS-PHASE-001.html#ACT-SRB-03" tooltip="ACT-SRB-03：分離した SRB はパラシュートで減速して射点の約 141 n.mi. 先の海上に着水し、回収して再使用する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="462" y="996" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="該当なし（分離済み）" id="p39-v-218" link="docs/SSD-OPS-PHASE-001.html#ACT-SRB-04" tooltip="ACT-SRB-04：SRB は上昇の約2分で外部タンクから切り離される。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="566" y="996" width="936" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="燃焼終了後に&lt;br&gt;RTLS を選択" id="p39-v-219" link="docs/SSD-OPS-PHASE-001.html#ACT-SRB-05" tooltip="ACT-SRB-05：外部タンクの加熱のため、RTLS は離昇2分30秒より前には選べない。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="996" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="通常と同じ（第1段）" id="p39-v-220" link="docs/SSD-OPS-PHASE-001.html#ACT-SRB-06" tooltip="ACT-SRB-06：SRB 分離は、両 SRB の頭部の室圧が 50 psi 以下になると始まる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1606" y="996" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="追跡・通信網（TDRS／STDN）" id="p39-v-221" link="docs/SSD-FD-EXT-001.html" tooltip="クリックで SSD-FD-EXT-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1042" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="STDN（地上局）" id="p39-v-222" link="docs/SSD-OPS-PHASE-001.html#ACT-NET-01" tooltip="ACT-NET-01：上昇中の S帯 PM 通信は、MET 約7分30秒に STDN から TDRS のモードに切り替わる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="1042" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="TDRS" id="p39-v-223" link="docs/SSD-OPS-PHASE-001.html#ACT-NET-02" tooltip="ACT-NET-02：軌道投入後に S帯を TDRSS の高レートに設定する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="566" y="1042" width="520" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="TDRS・地上局（追跡）" id="p39-v-224" link="docs/SSD-OPS-PHASE-001.html#ACT-NET-03" tooltip="ACT-NET-03：Mach 7.5 ごろには、MCC は状態ベクトルの更新に十分な追跡データを得る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1086" y="1042" width="208" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="交信" id="p39-v-225" link="docs/SSD-OPS-PHASE-001.html#ACT-NET-04" tooltip="ACT-NET-04：機体が停止すると、機長は MCC に「wheels stop」を報告する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1294" y="1042" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="該当なし&lt;br&gt;（KSC へ引継ぎ）" id="p39-v-226" link="docs/SSD-OPS-PHASE-001.html#ACT-NET-05" tooltip="ACT-NET-05：MCC がオービタ試験指揮者（OTC）に引き継ぐと、支援員は機体を KSC の担当に渡す。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="1042" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="上昇・再突入と同じ" id="p39-v-227" link="docs/SSD-OPS-PHASE-001.html#ACT-NET-06" tooltip="ACT-NET-06：上昇中、乗員は MCC の音声で現在のアボート能力を把握し、通信を失った場合は NO COMM MODE BOUNDARIES のカードを使う。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="1042" width="416" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="打上げ処理システム（KSC）" id="p39-v-228" link="docs/SSD-FD-EXT-001.html" tooltip="クリックで SSD-FD-EXT-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1088" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="地上管制&lt;br&gt;（T-31秒に機上へ）" id="p39-v-229" link="docs/SSD-OPS-PHASE-001.html#ACT-LPS-01" tooltip="ACT-LPS-01：T-31 秒に打上げ処理システムが機上の冗長セット打上げシーケンスを有効にし、以後の手順は GPC が行う。 SSME 始動後のアボートは、地上打上げシーケンサ（GLS）が自動で制御する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="1088" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="該当なし（T-0 で切離し）" id="p39-v-230" link="docs/SSD-OPS-PHASE-001.html#ACT-LPS-02" tooltip="ACT-LPS-02：T-0 に GPC が T-0 アンビリカル切離しの火工品を点火する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="1088" width="936" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="地上支援&lt;br&gt;（冷却・パージ）" id="p39-v-231" link="docs/SSD-OPS-PHASE-001.html#ACT-LPS-03" tooltip="ACT-LPS-03：着陸後は約160人の打上げ運用チームが回収を支援し、T-0 アンビリカルに空調パージ装置と地上冷却装置をつなぐ。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1294" y="1088" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="OPF で整備" id="p39-v-232" link="docs/SSD-OPS-PHASE-001.html#ACT-LPS-04" tooltip="ACT-LPS-04：乗員の退出後は地上員がオービタの電源を切り、機体は滑走路からオービタ整備施設（OPF）へ移る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="1088" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="KSC の SLF へ帰還" id="p39-v-233" link="docs/SSD-OPS-PHASE-001.html#ACT-LPS-05" tooltip="ACT-LPS-05：RTLS は準軌道で KSC のシャトル着陸施設（SLF）へ戻る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="1088" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="該当なし（欧州・&lt;br&gt;アフリカに着陸）" id="p39-v-234" link="docs/SSD-OPS-PHASE-001.html#ACT-LPS-06" tooltip="ACT-LPS-06：TAL は欧州またはアフリカの滑走路に着陸する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1606" y="1088" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="着陸地点による&lt;br&gt;（KSC など）" id="p39-v-235" link="docs/SSD-OPS-PHASE-001.html#ACT-LPS-07" tooltip="ACT-LPS-07：AOA の着陸地点の候補は、エドワーズ空軍基地、ケネディ宇宙センター、ノースラップ・ストリップである。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1710" y="1088" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="該当なし（軌道へ）" id="p39-v-236" link="docs/SSD-OPS-PHASE-001.html#ACT-LPS-08" tooltip="ACT-LPS-08：ATO は通常より低い安全な軌道に入れるための非常手段である。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1814" y="1088" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="ミッション管制センター（JSC）" id="p39-v-237" link="docs/SSD-FD-EXT-001.html" tooltip="クリックで SSD-FD-EXT-001 を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontColor=#15202B;fontSize=11;fontStyle=1;align=left;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1134" width="214" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="上昇・アボートの&lt;br&gt;データ更新" id="p39-v-238" link="docs/SSD-OPS-PHASE-001.html#ACT-MCC-01" tooltip="ACT-MCC-01：乗員は MCC との空地音声点検を行い、上昇・アボートのデータの更新を受ける。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E3ECF7;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="254" y="1134" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="アボート判断（ARD）" id="p39-v-239" link="docs/SSD-OPS-PHASE-001.html#ACT-MCC-02" tooltip="ACT-MCC-02：MCC はアボート領域判定プログラム（ARD）で、性能の問題による速度不足を予測する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="358" y="1134" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="軌道運用の GO・&lt;br&gt;アップリンク" id="p39-v-240" link="docs/SSD-OPS-PHASE-001.html#ACT-MCC-03" tooltip="ACT-MCC-03：主要な系に問題が無ければ MCC は軌道運用の GO を出し、オービタの状態ベクトルなどをアップリンクする。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="670" y="1134" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="軌道運用の GO・&lt;br&gt;アップリンク" id="p39-v-241" link="docs/SSD-OPS-PHASE-001.html#ACT-MCC-03" tooltip="ACT-MCC-03：主要な系に問題が無ければ MCC は軌道運用の GO を出し、オービタの状態ベクトルなどをアップリンクする。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="878" y="1134" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="PAD の読上げ・&lt;br&gt;離脱の GO/NO-GO" id="p39-v-242" link="docs/SSD-OPS-PHASE-001.html#ACT-MCC-04" tooltip="ACT-MCC-04：TIG の1時間42分前に機長は MCC から PAD の読上げを受け、25分前に離脱噴射の GO/NO-GO が出る。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="774" y="1134" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="状態ベクトル・TACAN・エアデータの GO" id="p39-v-243" link="docs/SSD-OPS-PHASE-001.html#ACT-MCC-05" tooltip="ACT-MCC-05：Mach 7 で MCC と乗員は TACAN のデータを航法と比べ、良ければ MCC が TACAN の採用を指示する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#D4EDDA;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="982" y="1134" width="312" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="延長電源投入の&lt;br&gt;GO→OTC へ引継ぎ" id="p39-v-244" link="docs/SSD-OPS-PHASE-001.html#ACT-MCC-06" tooltip="ACT-MCC-06：MCC の延長電源投入の GO で系統の停止を始め、MCC はオービタ試験指揮者（OTC）に引き継ぐ。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1294" y="1134" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="該当なし&lt;br&gt;（KSC へ引継ぎ済み）" id="p39-v-245" link="docs/SSD-OPS-PHASE-001.html#ACT-MCC-07" tooltip="ACT-MCC-07：MCC がオービタ試験指揮者（OTC）に引き継ぐと、支援員は機体を KSC の担当に渡す。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1398" y="1134" width="104" height="46" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="アボートの指示" id="p39-v-246" link="docs/SSD-OPS-PHASE-001.html#ACT-MCC-08" tooltip="ACT-MCC-08：RTLS の実施を決めると、MCC は乗員に「Abort RTLS」を指示する。 AOA の実施は MCC の指示と、OMS-1 の目標の解を OMS 1/2 TGTING のカードで確かめて決める。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFF3C4;strokeColor=#9AA3AE;fontColor=#15202B;fontSize=10;align=center;verticalAlign=middle;spacing=2;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1502" y="1134" width="416" height="46" as="geometry" />
          </mxCell>
        </UserObject>
