            <mxGeometry x="140" y="1456" width="130" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-251" value="外部エアロックで与圧容積が約 2,703 立方フィートに増え、構成で容積が変わるため窒素の所要量に効く" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="270" y="1456" width="1170" height="24" as="geometry" />
