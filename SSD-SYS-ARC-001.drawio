        <UserObject label="IF-IMU-01&lt;br&gt;吸込み空気" id="p34-IF-IMU-01" link="docs/SSD-FD-ARS-IMU-INL-001.html#IF-IMU-01" tooltip="IF-IMU-01：乗員室の空気を300ミクロンフィルタを通して吸い込み、3台のIMUへ導く。IMU #1・2・3のフィルタ・スクリーンは、ミッドデッキ天井のパネルMO42F・MO58Fの上前方にある。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.6324;exitY=1;exitDx=0;exitDy=0;entryX=0.1071;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p34-L_flu" source="p34-B-CAB34" target="p34-B-INL">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-IMU-02&lt;br&gt;IMU通風" id="p34-IF-IMU-02" link="docs/SSD-FD-ARS-IMU-INL-001.html#IF-IMU-02" tooltip="IF-IMU-02：ファンがキャビン空気を各IMUの筐体に通し、IMUの発熱を運び去って強制空冷する。強制空冷は3台のIMUに共通の3台のファンで行い、同時に使うのは1台である。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p34-L_thm" source="p34-B-INL" target="p34-B-GNC34">
            <mxGeometry relative="1" as="geometry" x="0.25">
              <Array as="points">
                <mxPoint x="1040" y="160" />
                <mxPoint x="1210" y="160" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-IMU-03&lt;br&gt;IMU出口空気" id="p34-IF-IMU-03" link="docs/SSD-FD-ARS-IMU-INL-001.html#IF-IMU-03" tooltip="IF-IMU-03：IMUを通った空気を、3本のIMU出口ホースとIMUマニホールドを通してIMUファンの入口へ送る。ファンのすぐ上流には、ファン保護用の600ミクロンフィルタがある。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p34-L_flu" source="p34-B-INL" target="p34-B-FAN">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-IMU-04&lt;br&gt;送風" id="p34-IF-IMU-04" link="docs/SSD-FD-ARS-IMU-FAN-001.html#IF-IMU-04" tooltip="IF-IMU-04：運転中のファンは、出口の逆止弁を通して公称144 lb/hrの空気をIMU熱交換器へ送り、逆止弁は非運転ファンを通る逆流を防ぐ。ファンの出口空気は、フライトデッキにあるIMU熱交換器を流れる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p34-L_flu" source="p34-B-FAN" target="p34-B-HEX">
            <mxGeometry relative="1" as="geometry" x="0.4828">
              <Array as="points">
                <mxPoint x="640" y="600" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-IMU-05&lt;br&gt;回転数・ΔP" id="p34-IF-IMU-05" link="docs/SSD-FD-ARS-IMU-FAN-001.html#IF-IMU-05" tooltip="IF-IMU-05：IMU FAN信号調整器が給電する回転数センサでファンが正常に回っていることを確かめ、ΔPセンサでファンの差圧を測る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p34-L_dat" source="p34-B-FAN" target="p34-B-MON">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-IMU-06&lt;br&gt;AC1/2/3電力" id="p34-IF-IMU-06" link="docs/SSD-FD-ARS-IMU-FAN-001.html#IF-IMU-06" tooltip="IF-IMU-06：IMUファンA・B・CにはそれぞれAC1・AC2・AC3の三相115 V AC電力を、パネルL4の各3個の遮断器とパネルL1のIMU FANスイッチを通して供給する。各IMUファンは別々の交流電源から給電される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.3824;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p34-L_pow" source="p34-B-EPS34" target="p34-B-FAN">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-IMU-07&lt;br&gt;選択・入切" id="p34-IF-IMU-07" link="docs/SSD-FD-ARS-IMU-OPS-001.html#IF-IMU-07" tooltip="IF-IMU-07：運用規則と故障処置手順に従い、パネルL1のIMU FAN A・B・Cスイッチで運転するファンを選び、入切する。ONの位置で対応するファンが回り、OFFの位置で止まる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=1;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p34-L_dat" source="p34-B-OPS" target="p34-B-FAN">
            <mxGeometry relative="1" as="geometry" x="0.2222">
              <Array as="points">
                <mxPoint x="1210" y="530" />
                <mxPoint x="1040" y="530" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-IMU-08&lt;br&gt;IMU熱交換器" id="p34-IF-IMU-08" link="docs/SSD-FD-ARS-IMU-HEX-001.html#IF-IMU-08" tooltip="IF-IMU-08：暖まった空気をIMU熱交換器に通し、熱をARSの水冷却ループへ渡す。水冷却ループでは、インターチェンジャで冷えた水がLCG熱交換器・水チラー・キャビン熱交換器を経てIMU熱交換器を流れる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="p34-L_thm" source="p34-B-HEX" target="p34-B-WCL34">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-IMU-09&lt;br&gt;還流空気" id="p34-IF-IMU-09" link="docs/SSD-FD-ARS-IMU-HEX-001.html#IF-IMU-09" tooltip="IF-IMU-09：IMU熱交換器で水冷却ループにより冷やした空気を乗員室へ戻す。IMUワークブックも、空気は熱交換器で冷やされてキャビンへ戻るとする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2059;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p34-L_flu" source="p34-B-HEX" target="p34-B-CAB34">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-IMU-10&lt;br&gt;状態・ΔP表示" id="p34-IF-IMU-10" link="docs/SSD-FD-ARS-IMU-MON-001.html#IF-IMU-10" tooltip="IF-IMU-10：IMUファンの状態（運転中のファンの「*」と回転数低下の「↓」など）を、SM OPS 2のPASS ENVIRONMENT（DISP 66）とPASS・BFSのSM SYS SUMM 1（DISP 78）に表示する。ΔPまたは回転数が限界を外れると、SMアラートのメッセージ「S66 IMU FAN DP」「S66 IMU FN SPD A(B,C)」を出す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="p34-L_dat" source="p34-B-MON" target="p34-B-DPS34">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-IMU-11&lt;br&gt;計測器電源" id="p34-IF-IMU-11" link="docs/SSD-FD-ARS-IMU-MON-001.html#IF-IMU-11" tooltip="IF-IMU-11：IMU FAN信号調整器には、パネルL4の遮断器（SIG CONDR IMU FAN）からAC3のB相の電力を供給する。IMUファンΔPセンサには、パネルO14のMNAの遮断器（H2O BYP LOOP 1 SNSR）から電力を供給する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.6324;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p34-L_pow" source="p34-B-EPS34" target="p34-B-MON">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-IMU-12&lt;br&gt;ΔP・警報" id="p34-IF-IMU-12" link="docs/SSD-FD-ARS-IMU-MON-001.html#IF-IMU-12" tooltip="IF-IMU-12：ΔPと回転数の表示・SMアラートを、IMUファンの喪失判定（A17-104）とファンの切替の判断に使う。ΔPが失われたときは、回転数センサの「↓」表示でファンの故障を監視する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p34-L_dat" source="p34-B-MON" target="p34-B-OPS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
