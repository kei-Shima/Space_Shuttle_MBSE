          </mxCell>
        </UserObject>
        <UserObject label="■ 図5 一覧へ" id="p144-v-4" link="data:page/id,p5-register" tooltip="クリックでページ移動">
          <mxCell style="rounded=1;arcSize=25;html=1;fillColor=#15202B;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1650" y="24" width="190" height="32" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-5" value="ID" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#15202B;strokeColor=#15202B;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="90" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-6" value="3001 の要求" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#15202B;strokeColor=#15202B;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="150" width="100" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-7" value="要旨" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#15202B;strokeColor=#15202B;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="150" width="330" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-8" value="基準の値（3001 現行版）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#15202B;strokeColor=#15202B;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="150" width="300" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-9" value="シャトルの値・実績" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#15202B;strokeColor=#15202B;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="150" width="420" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-10" value="判定" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#15202B;strokeColor=#15202B;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="150" width="110" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-11" value="差・理由" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#15202B;strokeColor=#15202B;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="150" width="420" height="28" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-102&lt;/b&gt;" id="p144-v-12" link="docs/SSD-HSI-SYS-001.html#HSI-102" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="178" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-13" value="[V2 6004]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="178" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-14" value="居住区画の CO2 分圧の1時間平均を 3 mmHg 以下に保つ。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="178" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-15" value="≤3 mmHg（1時間平均）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="178" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-16" value="運用の限界は 7.6 mmHg（長期間の最大）、7.6〜15 mmHg は航空医官の評価、15 mmHg 以上で QDM・次の PLS（A13-52）。STS-4 は軌道上 0.8 mm Hg 以下、上昇の最大約 4.3" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="178" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-17" value="不適合 ◆" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="178" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-18" value="基準 3 mmHg（1時間平均）に対し、シャトルの通常の運用の限界は 7.6 mmHg（A13-52、STS-4 報告の通常の上限）で 4.6 mmHg 超える。STS-4 の実績（軌道上 0.8 mm Hg 以下）は基準を満たすが、上昇の" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="178" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-124&lt;/b&gt;" id="p144-v-19" link="docs/SSD-HSI-SYS-001.html#HSI-124" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="230" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-20" value="[V2 6050]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="230" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-21" value="居住区画の大気のガス状汚染物質を JSC-20584 の SMAC 未満に抑える。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="230" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-22" value="SMAC（JSC-20584）未満" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="230" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-23" value="STS-1 では有毒とされる濃度に達した微量物質は無かった。STS-2 ではトルエンが 17 ppm（SMAC 20 ppm）に達し、同じ区分との和が1を超えて限度超過となった（STS-3 の前に対策）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="230" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-24" value="不適合 ◆" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="230" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-25" value="STS-2 の実績で、トルエン 17 ppm は単独では SMAC 20 ppm の 85% だが、同じ区分の物質との和（T 値）が1を超え、SMAC の限度を超えた。対策後の飛行の値は取り込み済みの資料に無い。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="230" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-161&lt;/b&gt;" id="p144-v-26" link="docs/SSD-HSI-SYS-001.html#HSI-161" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="282" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-27" value="[V2 6078]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="282" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-28" value="作業区域の連続騒音のオクターブ帯の音圧を NC-50 の曲線（表 6.6-3）以下にする。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="282" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-29" value="NC-50（63 Hz 71 dB、125 Hz 64、250 Hz 58、500 Hz 54、1 kHz 51、2 kHz 49、4 kH" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="282" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-30" value="STS-1 の中甲板の睡眠区画 60・63・67・59・62・61・58・52 dB（67 dB-A）。運用のオービタの中甲板 62〜65 dBA、1991年以降の仕様 68 dBA。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="282" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-31" value="不適合 ◆" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="282" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-32" value="STS-1 の中甲板の睡眠区画は表 6.6-3 の NC-50 を 250 Hz で 9 dB（67 対 58）、1 kHz で 11 dB（62 対 51）、2 kHz で 12 dB（61 対 49）、4 kHz で 10 dB（58 " style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="282" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-162&lt;/b&gt;" id="p144-v-33" link="docs/SSD-HSI-SYS-001.html#HSI-162" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="334" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-34" value="[V2 6115]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="334" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-35" value="打上げ・再突入・アボート以外の24時間の騒音の線量 D を 100 以下にする（8時間 75 dBA、24時間 70 d" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="334" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-36" value="D ≤100（8時間 75 dBA TWA、24時間 70 dBA 相当）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="334" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-37" value="A13-29 は24時間平均（LEQ）74 dBA 以上で処置をとる。OFT の中甲板の睡眠位置 67〜69 dB-A。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="334" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-38" value="不適合 ◆" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="334" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-39" value="基準の24時間 70 dBA 相当に対し、シャトルが処置をとる24時間平均は 74 dBA で 4 dBA 超える（本書の計算：74 dBA の24時間は D 約 240）。OFT の睡眠位置 69 dB-A が24時間続くと D 約 75" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="334" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-220&lt;/b&gt;" id="p144-v-40" link="docs/SSD-HSI-SYS-001.html#HSI-220" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="386" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-41" value="[V2 7102]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="386" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-42" value="Table 7.3-1 の排泄物（便・下痢・尿・嘔吐物・月経血）を各ミッションの必要に応じて収集・封じ込めできる。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="386" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-43" value="尿 最大 1 L/回・50 mL/s、便 平均 150 g/回（1日2回）ほか（Table 7.3-1）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="386" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-44" value="WCS の設計の尿は最大 0.82 kg/回・0.04 kg/sec、便の公称は水 0.2 lb＋固形分 0.07 lb/man-day（約 0.12 kg/人日）、便器の収納 2.4 ft3。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="386" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-45" value="不適合 ◆" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="386" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-46" value="本書の判断：WCS の設計の値は 1回の尿 最大 0.82 kg で基準の最大 1 L（1027.6 g）より約 0.21 kg 少なく、流量 最大 0.04 kg/sec（約 40 mL/s）は基準の 50 mL/s を約 10 mL/s" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="386" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-376&lt;/b&gt;" id="p144-v-47" link="docs/SSD-HSI-SYS-001.html#HSI-376" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="438" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-48" value="[V2 9056]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="438" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-49" value="聴覚保護具を使わずに 6.6 節の音圧レベルの限界を満たす。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="438" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-50" value="6.6 節の SPL の限界（連続騒音 NC-50 など）を聴覚保護具なしで" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="438" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-51" value="STS-1 で 60〜67 dB-A、対策に耳栓を含む" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="438" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-52" value="不適合 ◆" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="438" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-53" value="STS-1 の騒音は中甲板の睡眠位置で 67 dB-A などで、後部操縦室は NC-50（55 dB-A）より 11 dB 高く、JSC の指針（65〜75 dB-A で睡眠中の聴覚保護具）と飛行規則 A13-29（74 dBA 以上で睡眠" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="438" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-401&lt;/b&gt;" id="p144-v-54" link="docs/SSD-HSI-SYS-001.html#HSI-401" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="490" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-55" value="[V2 10114]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="490" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-56" value="緊急・警告・注意と勧告の事象に、Table 10.3-1 のとおり区別できる視覚・聴覚の報知を行うこと。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="490" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-57" value="緊急：赤の点滅＋サイレン/クラクソン＋音声、警告：赤＋交互音＋音声、注意：黄＋512 Hz、勧告：青（Table 10.3-1）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="490" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-58" value="クラス1はサイレン・クラクソンと MASTER ALARM 灯、クラス2は C&amp;amp;W トーンと MASTER ALARM 灯・F7 の赤/黄の灯、クラス3は 512 Hz の音と青い SM ALERT 灯。音声の報知は無い" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="490" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-59" value="不適合 ◆" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="490" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-60" value="クラクソン（2560/256 Hz）と警告の交互音（400/1024 Hz・2.5 Hz）は表と同じだが、緊急の視覚の合図はクラス2と同じ MASTER ALARM 灯で赤の点滅ではなく、緊急・警告の音声の報知が無い。F7 の黄の灯（注意に" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="490" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-492&lt;/b&gt;" id="p144-v-61" link="docs/SSD-HSI-SYS-001.html#HSI-492" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="542" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-62" value="[V2 11032]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="542" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-63" value="LEA の服が客室の減圧のとき II 型の減圧症を防ぐのに足る圧力で働くこと。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="542" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-64" value="十分な服圧（根拠：14.7 psia に飽和して 40 kPa（5.8 psia）で II 型減圧症 15% 未満）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="542" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-65" value="ACES は全膨張で絶対圧 3.67 psia。客室は 14.7 psia。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="542" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-66" value="不適合 ◆" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="542" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-67" value="本書の判断：基準の根拠は 14.7 psia に飽和した乗員の急減圧で 5.8 psia（40 kPa）を示すが、ACES の全膨張の圧力は 3.67 psia で 2.13 psia 低い。シャトルの客室も 14.7 psia で、根拠の" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="542" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-052&lt;/b&gt;" id="p144-v-68" link="docs/SSD-HSI-SYS-001.html#HSI-052" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="594" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-69" value="[V1 4030]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="594" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-70" value="宇宙放射線による乗員の生涯の実効線量を 600 mSv 未満とする。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="594" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-71" value="&amp;lt;600 mSv（生涯の実効線量）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="594" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-72" value="OFT の飛行の線量当量は 1飛行 19 mrem 未満〜62.5 mrem（0.19〜0.63 mSv）、飛行前の全身等価線量（医療と以前の飛行を含む）は最大 9.73 rem（97.3 mSv）。当時の生涯の限度は骨" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="594" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-73" value="適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="594" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-74" value="本書の判断：OFT の乗員の1飛行の線量は最大 0.63 mSv、累積の全身等価線量も最大 97.3 mSv で、600 mSv を大きく下回る（線量当量・全身等価線量で比べた）。ただしシャトル当時の生涯の限度（骨髄 400 rem＝4 S" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="594" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-100&lt;/b&gt;" id="p144-v-75" link="docs/SSD-HSI-SYS-001.html#HSI-100" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="646" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-76" value="[V2 6002]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="646" width="100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-77" value="乗員室の大気は希釈ガスを30%以上含む（残りは酸素）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="646" width="330" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-78" value="≥30%（希釈ガス）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="646" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-79" value="通常は窒素約80%・酸素約20%（14.7 psia）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="646" width="420" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-80" value="適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="646" width="110" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-81" value="窒素約80%で、基準の30%を約50ポイント上回る。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="646" width="420" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-101&lt;/b&gt;" id="p144-v-82" link="docs/SSD-HSI-SYS-001.html#HSI-101" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="670" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-83" value="[V2 6003]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="670" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-84" value="吸気の酸素分圧（PIO2）を表 6.2-1 の範囲に保つ。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="670" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-85" value="PIO2 目標 145〜155 mmHg、上限 356 mmHg（無期限）、下限 127 mmHg（1時間平均、絶対 122 mmHg）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="670" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-86" value="通常 PPO2 2.95〜3.45 psi（14.7 psia）。非常時は 14.7 psia で PPO2 2.09 psia まで24時間以内を許す（A13-53）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="670" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-87" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="670" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-88" value="本書の計算：PIO2 =（PB − 47）× FIO2 で、通常の 2.95〜3.45 psi は PIO2 約 143〜167 mmHg となり、無期限の限界（127〜356 mmHg）の内にある（目標の 145〜155 mmHg からは" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="670" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-103&lt;/b&gt;" id="p144-v-89" link="docs/SSD-HSI-SYS-001.html#HSI-103" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="722" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-90" value="[V2 6006]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="722" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-91" value="乗員がさらされる全圧を 5 psia を超え 15.0 psia 以下に保つ（無期限の暴露）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="722" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-92" value="5 psia &amp;lt; 全圧 ≤ 15.0 psia" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="722" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-93" value="通常 14.7 ± 0.2 psia、EVA の前 10.2 psia、非常 8 psia。打上げ前の漏れ点検 16.7 psi、DCS 治療の再与圧は最大 15.56 psi（いずれも一時）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="722" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-94" value="適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="722" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-95" value="通常の上限 14.9 psia は 15.0 psia を 0.1 psi 下回り、長く滞在する圧（14.7・10.2・8 psia）はどれも 5 psia を超える。16.7 psi（漏れ点検）・15.56 psi（DCS 治療）は一時の" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="722" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-109&lt;/b&gt;" id="p144-v-96" link="docs/SSD-HSI-SYS-001.html#HSI-109" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="774" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-97" value="[V2 6013]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="774" width="100" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-98" value="通常の運用で居住区画の湿度・温度を図 6.2-3 の性能の範囲に到達できる。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="774" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-99" value="図 6.2-3（理由の欄：20〜25°C・湿度 30〜60%）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="774" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-100" value="温度を 65〜80°F（約 18.3〜26.7°C）で選べ、湿度は通常 30〜65%。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="774" width="420" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-101" value="適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="774" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-102" value="本書の判断：温度の選べる範囲 18.3〜26.7°C は 20〜25°C を含み、通常の湿度 30〜65% は 30〜60% と重なるので、性能の範囲に到達できる。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="774" width="420" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-120&lt;/b&gt;" id="p144-v-103" link="docs/SSD-HSI-SYS-001.html#HSI-120" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="812" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-104" value="[V2 6024]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="812" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-105" value="燃焼生成物（CO・HCN・HCl・HF または HX）を表 6.2-3 の範囲・精度で実時間に監視し、機内と遠隔に警報を" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="812" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-106" value="CO 5〜1000 ppm（±10%、1 ppm）、HCN・HCl・HF（または HX）2〜50 ppm（±25%、1 ppm）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="812" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-107" value="後期の CSA-CP は CO・HCN・HCl の3成分を実時間で分析する。試作の CPA（STS-41 以降）は CO・HF・HCN・HCl を測り、機器の上で音の警報を設定できた。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="812" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-108" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="812" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-109" value="SCOM の CSA-CP は HF（または HX）を測らず、表の4成分のうち1つが欠ける。警報は機器の上だけで、データの記録・データ系とのつなぎは宇宙ステーション用で加える計画とされ、遠隔への警報の手段が無い。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="812" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-122&lt;/b&gt;" id="p144-v-110" link="docs/SSD-HSI-SYS-001.html#HSI-122" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="864" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-111" value="[V2 6107]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="864" width="100" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-112" value="CO2 や熱のたまりができない換気を保つ（スーツ・毒物の事象・無人のときを除く）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="864" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-113" value="（理由の欄）時間平均の風速 15〜120 ft/min" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="864" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-114" value="乗員室の風速の範囲 15〜40 ft/min、通常 25 ft/min、空気流量 1400 lb/hr。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="864" width="420" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-115" value="適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="864" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-116" value="風速 15〜40 ft/min（通常 25 ft/min）は理由の欄の 15〜120 ft/min の内にある（本書の判断：要求の本文に数値は無く、理由の欄の範囲で比べた）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="864" width="420" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-133&lt;/b&gt;" id="p144-v-117" link="docs/SSD-HSI-SYS-001.html#HSI-133" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="902" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-118" value="[V2 6109]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="902" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-119" value="表 6.3-1 の最小の水量（飲用 2.5 L/人日、衛生、洗眼、医療、EVA、水分負荷など）を提供する。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="902" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-120" value="飲用 ≥2.5 L/人日、衛生 ≥400 mL/人日、医療 ≥5 L/件、再突入の水分負荷 ≥1 L/人 など" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="902" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-121" value="燃料電池が最大 25 lb/時の水を作り、給水タンク4基（各 165 lb）に貯める。水分負荷は8オンスの容器 3〜6 個（A13-202）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="902" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-122" value="適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="902" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-123" value="本書の計算：7人10日で飲用 175 L・衛生 28 L・水分負荷（2回分）14 L・医療 5 L などを合わせても約 230 L（約 510 lb）で、給水タンクの 660 lb と燃料電池の生成水（最大 25 lb/時）で足りる。水分負" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="902" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-134&lt;/b&gt;" id="p144-v-124" link="docs/SSD-HSI-SYS-001.html#HSI-134" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="954" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-125" value="[V2 6110]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="954" width="100" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-126" value="表 6.3-1 の用途ごとの水温（温水 68〜79°C、常温 18〜27°C、冷水 16°C 以下など）を提供する。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="954" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-127" value="温水 68〜79°C（155〜175°F）、常温 18〜27°C、冷水 ≤16°C（60°F）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="954" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-128" value="ガレーの温水 145〜165°F、冷水 40〜60°F。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="954" width="420" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-129" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="954" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-130" value="温水 145〜165°F（約 63〜74°C）の下側は基準の 155°F（68°C）を最大 10°F（約 5°C）下回る。冷水 40〜60°F は 60°F 以下を満たす。衛生用水の温度は資料に無い。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="954" width="420" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-144&lt;/b&gt;" id="p144-v-131" link="docs/SSD-HSI-SYS-001.html#HSI-144" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="992" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-132" value="[V2 6064]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="992" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-133" value="持続（0.5 秒超）の並進加速度の大きさ・方向・時間を図 6.5-2〜7・表 6.5-1〜6 の限界より下に保つ。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="992" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-134" value="例：着座・非デコンディショニングの +Ax 上限 157 m/s2（5 s）・73.5 m/s2（300 s）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="992" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-135" value="上昇 Nx ≤ +3.11 g、Ny ±0.18 g、Nz +0.73/−0.06 g。再突入の Nz の最大 2.5 g（構造の限界）。乗員は上昇で胸背方向、再突入で頭足方向に受ける。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="992" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-136" value="適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="992" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-137" value="本書の計算：上昇の 3.11 g（30.5 m/s2）は着座・非デコンディショニングの +Ax の 300 s の限界 73.5 m/s2 の約 42%。再突入の 2.5 g（24.5 m/s2）は +Az の 1200 s の限界 39." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="992" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-152&lt;/b&gt;" id="p144-v-138" link="docs/SSD-HSI-SYS-001.html#HSI-152" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1044" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-139" value="[V2 6113]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1044" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-140" value="打上げの姿勢（あお向け・足を上げた姿勢）の時間を3時間15分以下にする（安全化・脱出を除く）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="1044" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-141" value="≤3 時間15分" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="1044" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-142" value="乗員は L-2:45 にホワイトルームに着いて座席に入る（通常の時間割）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="1044" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-143" value="適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1044" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-144" value="通常の時間割では最初の乗員の座席への移乗は L-2:45 より後で、あお向けの時間は 2時間45分以下となり 3時間15分を 30分以上下回る。打上げの延期・保持で延びるときの上限は資料に無い（本書の判断）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1044" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-160&lt;/b&gt;" id="p144-v-145" link="docs/SSD-HSI-SYS-001.html#HSI-160" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1096" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-146" value="[V2 6077]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1096" width="100" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-147" value="異常時・放送・与圧の弁・保守の A 特性の音圧を時間によらず 85 dBA 未満にする。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="1096" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-148" value="&amp;lt;85 dBA（fast）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="1096" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-149" value="A13-29 は 76〜80 dBA を5分、81〜85 dBA を1分まで許し、86 dBA 以上を不可とする。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="1096" width="420" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-150" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1096" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-151" value="シャトルの規則は 85 dBA までを1分間許し、時間によらず 85 dBA 未満とする基準より上限が約 1 dBA ゆるい（86 dBA 以上だけを不可とする）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1096" width="420" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-164&lt;/b&gt;" id="p144-v-152" link="docs/SSD-HSI-SYS-001.html#HSI-164" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1134" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-153" value="[V2 6080]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1134" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-154" value="8時間以下で動く機器の間欠騒音を 0.6 m で表 6.6-4 の時間ごとの上限に抑える。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="1134" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-155" value="表 6.6-4（例：5分 ≤76 dBA、1分 ≤79 dBA、80 dBA 以上は不可）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="1134" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-156" value="A13-29 は 76〜80 dBA を5分、81〜85 dBA を1分まで許す。STS-2 の WCS の運転中は 87 dB-A（音源の近く）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="1134" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-157" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1134" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-158" value="基準は5分なら 76 dBA 以下、80 dBA 以上は不可とするが、シャトルの規則は 80 dBA を5分、85 dBA を1分まで許し、5分で 4 dBA、1分で 6 dBA 上限がゆるい。STS-2 の WCS の運転中の 87 dB" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1134" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-187&lt;/b&gt;" id="p144-v-159" link="docs/SSD-HSI-SYS-001.html#HSI-187" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1186" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-160" value="[V2 6102]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1186" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-161" value="乗員の RF 電磁界の暴露を表 6.8-2・図 6.8-1 の最大許容暴露以下に保つ。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="1186" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-162" value="300〜5000 MHz で電力密度 S = f/150 W/m2（30分平均）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="1186" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-163" value="SSOR（414.2 MHz）の近くの EVA の立入禁止域を、生理学の限度 72 V/m（推奨の限度 60 V/m）で定める（A15-26）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="1186" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-164" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1186" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-165" value="本書の計算：414.2 MHz で基準は S = 414.2/150 ≈ 2.76 W/m2、平面波の電界に換えて約 32 V/m。シャトルの生理学の限度 72 V/m（約 13.8 W/m2）は電界で約 40 V/m、電力密度で約5倍上回" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1186" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-222&lt;/b&gt;" id="p144-v-166" link="docs/SSD-HSI-SYS-001.html#HSI-222" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1238" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-167" value="[V2 7035]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1238" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-168" value="乗員1人あたり Vu = 3 + 2.5t リットルの尿を処理または廃棄のため収集・封じ込めできる。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="1238" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-169" value="Vu = 3 + 2.5t L/人（t：日数）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="1238" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-170" value="尿は廃水タンク（165 lb）へ送り、廃水ダンプノズルから船外へ捨てる。設計の尿は最大 8.8 lb（4.0 kg）/人日。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="1238" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-171" value="適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1238" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-172" value="本書の判断：16日では Vu＝43 L/人で、1日あたり 2.5 L/人は WCS の設計の最大 4.0 kg/人日以内である。廃水タンク（165 lb）を船外へダンプして空けるので、総量はタンクの容量に縛られない。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1238" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-404&lt;/b&gt;" id="p144-v-173" link="docs/SSD-HSI-SYS-001.html#HSI-404" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1290" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-174" value="[V2 10175]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1290" width="100" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-175" value="Table 10.3-1 の優先度（火災＞他の緊急＞警告＞注意＞勧告）でアラートを順位付けること。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="1290" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-176" value="優先度 1〜5（Table 10.3-1）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="1290" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-177" value="クラス1（火災・急減圧）を最優先、クラス3はクラス1・2より低い。クラス2は警告（赤）と注意（黄）を同じ報知で扱う。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="1290" width="420" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-178" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1290" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-179" value="シャトルの順位はクラス1〜3の3段（＋音の無いクラス0）で処置の優先の目安であり、火災と他の緊急、警告と注意を区別しない。3001 の5段の優先度に対し2段足りない。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1290" width="420" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-412&lt;/b&gt;" id="p144-v-180" link="docs/SSD-HSI-SYS-001.html#HSI-412" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1328" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-181" value="[V2 10058]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1328" width="100" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-182" value="聴覚の警報の周波数を人の感度の高い 200 Hz〜4 kHz とすること。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="1328" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-183" value="200 Hz〜4 kHz" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="1328" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-184" value="サイレン 666〜1470 Hz、クラクソン 2560 Hz と 256 Hz、C&amp;amp;W トーン 400/1024 Hz、アラートトーン 512 Hz。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="1328" width="420" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-185" value="適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1328" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-186" value="4つの警報音の周波数（256〜2560 Hz）はすべて 200 Hz〜4 kHz に入る。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1328" width="420" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-421&lt;/b&gt;" id="p144-v-187" link="docs/SSD-HSI-SYS-001.html#HSI-421" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1366" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-188" value="[V2 10201]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1366" width="100" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-189" value="表示灯を Table 10.4-3 の色の意味（赤の点滅＝緊急、赤＝警告、黄＝注意、緑＝電源・正常）に合わせること。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="1366" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-190" value="赤の点滅：緊急、赤：警告・故障、黄：注意、緑：電源・正常（Table 10.4-3）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="1366" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-191" value="F7 は赤（警告）と黄の灯、クラス3は青い SM ALERT 灯。緊急（クラス1）の合図は MASTER ALARM 灯の点灯で、クラス2と同じ灯である。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="1366" width="420" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-192" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1366" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-193" value="赤・黄の使い方は表と合うが、緊急はクラス2と同じ MASTER ALARM 灯の点灯で赤の点滅として区別されず、表に無い青の灯をアラートに使う。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1366" width="420" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-474&lt;/b&gt;" id="p144-v-194" link="docs/SSD-HSI-SYS-001.html#HSI-474" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1404" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-195" value="[V2 11028]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1404" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-196" value="EVA の服が尿 Vu = 0.5 + 2.24t/24 L（t は着用の時間）を集められること。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="1404" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-197" value="Vu = 0.5 + 2.24t/24 L" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="1404" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-198" value="MAG の容量 32 fl oz（約 0.95 L）。EMU の EVA の設計は最長7時間。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="1404" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-199" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1404" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-200" value="本書の計算：EVA の設計の最長 7時間で Vu = 0.5 + 2.24×7/24 ≈ 1.15 L に対し、MAG は 32 fl oz（約 0.95 L）で約 0.2 L 足りない。着用（約40分）と前呼吸（40〜70分）を t に含" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1404" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-489&lt;/b&gt;" id="p144-v-201" link="docs/SSD-HSI-SYS-001.html#HSI-489" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1456" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-202" value="[V2 11030]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1456" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-203" value="EVA の服で、1時間に 240 mL 以上の飲み水を求めに応じて飲めること。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="1456" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-204" value="240 mL（8.1 fl oz）/h" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="1456" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-205" value="飲み水袋（DIDB）は 32 oz（約 0.95 L）。EVA の設計は最長7時間、計画は最長6時間。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="1456" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-206" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1456" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-207" value="本書の計算：EVA 7時間で 240 mL × 7 = 1.68 L に対し DIDB は 32 oz（約 0.95 L）で約 0.73 L 足りない（計画の最長 6時間でも 1.44 L に対し約 0.49 L 不足）。運用飛行規則 A1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1456" width="420" height="52" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-497&lt;/b&gt;" id="p144-v-208" link="docs/SSD-HSI-SYS-001.html#HSI-497" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1508" width="90" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p144-v-209" value="[V2 11039]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1508" width="100" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-210" value="宇宙服の吸気の CO2 分圧（PICO2）を表 11.3-1 の時間の限界に収めること。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="230" y="1508" width="330" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-211" value="PICO2 &amp;gt;15 mmHg 禁止、&amp;gt;12.5：≤0.5 h/日、&amp;gt;10：≤1 h、&amp;gt;7：≤2.5 h、&amp;gt;4：≤8 h、≤4：無制限" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="1508" width="300" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-212" value="EMU の表示の正常は 0.2〜4.0 mmHg だが、表示 3〜8 mmHg でヘルメットの中は 11〜15 mmHg（19〜23 mmHg もありうる）。12.4 mm を超えても症状がなければ EVA を続ける。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="1508" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-213" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1508" width="110" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-214" value="本書の判断：運用飛行規則 A13-52 によれば表示 3〜8 mmHg のときヘルメットの中は 11〜15 mmHg で、基準の &amp;gt;10 mmHg は1日1時間まで・&amp;gt;12.5 mmHg は 0.5 時間までに対し、EVA は 6.5 時間" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1508" width="420" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p144-v-215" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;数値で比べられる主な基準 29件（大気・圧力・温湿度・騒音・加速度・放射線・水・容積など）。◆ 既存の判定と食い違うもの（照合表 §7）。基準の値の出どころ（文書・版・要求番号・表・頁）とシャトルの値の根拠の頁は照合表の行にある。ID をクリックすると行を開く。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="1590" width="1330" height="100" as="geometry" />
        </mxCell>
