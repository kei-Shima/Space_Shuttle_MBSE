          </mxCell>
        </UserObject>
        <UserObject label="RCST-08" id="p137-v-26" link="docs/SSD-BEH-ORB-006.html#RCST-08" tooltip="RCST-08：FWD RCS 灯（前部のタンク圧 200 psia 未満・312 psia 超、量の差 9.5% 超）→ 前部を確保［独立した表示と計器で漏れを確認］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.4397;exitY=1.0;exitDx=0;exitDy=0;entryX=0.9;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p137-v-5" target="p137-v-12">
