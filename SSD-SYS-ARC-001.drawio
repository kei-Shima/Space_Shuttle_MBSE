          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=5;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="700" y="672" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p105-v-151" value="OMS から RCS へ供給できる推進薬（各ポッド）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
