        <mxCell id="p3-v-1" value="&lt;div style='font-size:22px;font-weight:bold;'&gt;図3&lt;/div&gt;&lt;div style='font-size:12px;color:#3B4654;margin-top:4px;'&gt;SSD-SYS-ARC-001&lt;br&gt;ECLSS 機能構成（機能ブロック・IF）&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
