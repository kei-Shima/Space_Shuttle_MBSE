        <UserObject label="RCST-02" id="p137-v-20" link="docs/SSD-BEH-ORB-006.html#RCST-02" tooltip="RCST-02：バーニアを選択（軌道上の姿勢保持）［軌道上］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p137-v-7" target="p137-v-8">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="RCST-03" id="p137-v-21" link="docs/SSD-BEH-ORB-006.html#RCST-03" tooltip="RCST-03：主ジェットを選択（粗い姿勢制御・並進・離脱前の姿勢変更）">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.15;exitY=0.0;exitDx=0;exitDy=0;entryX=0.9;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p137-v-8" target="p137-v-7">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="460" y="450" />
                <mxPoint x="310" y="450" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="RCST-04" id="p137-v-22" link="docs/SSD-BEH-ORB-006.html#RCST-04" tooltip="RCST-04：インタコネクトを組む（RCS タンク隔離弁閉、RCS・OMS クロスフィード弁開）［軌道上は手動、上昇アボートは自動］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5603;exitY=1.0;exitDx=0;exitDy=0;entryX=0.15;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p137-v-5" target="p137-v-9">
            <mxGeometry relative="1" as="geometry" x="0.3333">
              <Array as="points">
                <mxPoint x="750" y="590" />
                <mxPoint x="760" y="590" />
