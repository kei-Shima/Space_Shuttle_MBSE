          </mxCell>
        </UserObject>
        <mxCell id="p152-v-35" value="AL-SH-1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="140" y="976" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-36" value="AL-STD-1・AL-STD-2" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="250" y="976" width="200" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-37" value="&lt;span style='color:#C79100'&gt;一部&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="450" y="976" width="80" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-38" value="火災＝サイレン・減圧＝クラクソンという音の分け方と、クラクソンの周波数（2560/256 Hz）は表と同じで、サイレンの周波数も近い（666〜1470 Hz に対し 650〜1,500 Hz、どちらも 5 s で往復）。違いは、(1) 視覚の合図がクラス2と同じ MASTER ALARM 灯の点灯で" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="530" y="976" width="1210" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;LM-02&lt;/b&gt;" id="p152-v-39" link="docs/SSD-CIF-ORB-001.html#LM-02" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="60" y="1014" width="80" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p152-v-40" value="AL-SH-2" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="140" y="1014" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-41" value="AL-STD-3・AL-STD-4" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="250" y="1014" width="200" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-42" value="&lt;span style='color:#C79100'&gt;一部&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="450" y="1014" width="80" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-43" value="C&amp;amp;W トーン（400/1024 Hz を 2.5 Hz で交互）は警告の音と同じで、F7 の赤の灯（警告灯）は Table 10.4-3 の赤＝警告と合う。しかし F7 の黄の灯も同じ C&amp;amp;W トーンと MASTER ALARM を伴い、注意の 512 Hz の音・注意の優先度として区別されない。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="530" y="1014" width="1210" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;LM-03&lt;/b&gt;" id="p152-v-44" link="docs/SSD-CIF-ORB-001.html#LM-03" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="60" y="1052" width="80" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p152-v-45" value="AL-SH-3" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="140" y="1052" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-46" value="AL-STD-4・AL-STD-5" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="250" y="1052" width="200" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-47" value="&lt;span style='color:#C79100'&gt;一部&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="450" y="1052" width="80" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-48" value="アラートトーンの 512 Hz は注意の音と同じ周波数だが、波形（3001 は三角波）の記述は資料に無く、連続音を乗員が決めた長さ（0〜99 秒）だけ鳴らす点が、1 s の音と 1 s の無音を終わるまで繰り返す注意の音と違う。視覚の青は 3001 では勧告の色で、Table 10.4-3 の表示灯" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="530" y="1052" width="1210" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;LM-04&lt;/b&gt;" id="p152-v-49" link="docs/SSD-CIF-ORB-001.html#LM-04" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="60" y="1090" width="80" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p152-v-50" value="AL-SH-0" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="140" y="1090" width="110" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-51" value="AL-STD-5" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="250" y="1090" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-52" value="&lt;span style='color:#C79100'&gt;一部&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="450" y="1090" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-53" value="音を出さず表示だけで知らせる点は音が任意の勧告に近いが、青の視覚の合図ではなく DPS 表示の矢印の記号であり、抑止したパラメータでも矢印は残る。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="530" y="1090" width="1210" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;LM-05&lt;/b&gt;" id="p152-v-54" link="docs/SSD-CIF-ORB-001.html#LM-05" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="60" y="1114" width="80" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p152-v-55" value="AL-SH-A1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="140" y="1114" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-56" value="AL-STD-5" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="250" y="1114" width="200" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-57" value="&lt;span style='color:#C79100'&gt;一部&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="450" y="1114" width="80" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-58" value="ACK でメッセージの点滅を止め、MSG RESET でメッセージ行を消し、故障要約（SPEC 99）に記録が残る点は、3001 の抑制（音を止めてもメッセージは表示し記録する）の考えと合う。故障メッセージ自体は勧告の青の灯や 900 Hz の音を伴わない。DPS 表示では黄色を注意を引く状態記号に" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="530" y="1114" width="1210" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;LM-06&lt;/b&gt;" id="p152-v-59" link="docs/SSD-CIF-ORB-001.html#LM-06" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="60" y="1152" width="80" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p152-v-60" value="AL-SH-A2" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="140" y="1152" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-61" value="AL-STD-3・AL-STD-4" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="250" y="1152" width="200" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-62" value="&lt;span style='color:#C79100'&gt;一部&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="450" y="1152" width="80" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-63" value="MAIN ENGINE STATUS の赤（停止・レッドライン違反）と琥珀（故障）、GPC STATUS の黄、REACH LIM の黄、PFD の黄色の枠（正常外の構成）は Table 10.4-3 の赤＝警告・故障、黄＝注意・正常外と合う。計器の緑は正常範囲を示し、表の緑（電源・正常）と同じ向き" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="530" y="1152" width="1210" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-64" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;左＝シャトルの警報の区分（クラス0〜3・補助）、右＝3001 の警報の階層。矢印＝本書の対応づけ（色：緑 一致、黄 一部、赤 不一致。ツールチップに差）。箱をクリックすると定義書の行を開く。下＝対応ごとの差。&lt;br&gt;同じ対応を SysML v2 テキスト model/SSD-CIF-ORB-001.sysml の AlertLevel の part def と #MapsTo に示す。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="1220" width="1250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p152-v-65" value="&lt;table style='border-collapse:collapse;width:100%;font-size:11px;text-align:left;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;文書番号&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;SSD-SYS-ARC-001&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;表題&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;スペースシャトル システム構成図（機能ブロック・インタフェース図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;図番&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;図152 警報の階層の対応（シャトル × 3001）（全158図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;版・日付&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;Rev. BF／2026-10-07&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;状態&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;検討用（公開資料に基づく）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;作成／確認／承認&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;　　　／　　　／　　　&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15202B;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1330" y="1220" width="430" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
