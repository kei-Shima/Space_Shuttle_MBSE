                <mxPoint x="260" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-44&lt;br&gt;衛生用温水" id="p2-IF-ORB-44" link="docs/SSD-FD-CREW-001.html#IF-ORB-44" tooltip="IF-ORB-44：洗顔用の常温の温水は、ギャレーの補助ポートにつないだ個人衛生ホース（PHH）から供給される。 ギャレー右下の補助ポートの迅速継手から、常温〜温水（70〜120°F）の飲料水を取り出せる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p2-L_flu" source="p2-B-ECLSS" target="p2-B-CREW">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-45&lt;br&gt;SCU" id="p2-IF-ORB-45" link="docs/SSD-FD-ECLSS-001.html#IF-ORB-45" tooltip="IF-ORB-45：サービス・冷却アンビリカル（SCU）は3本の水ホース、高圧酸素ホース、電気配線、水圧調整器から成り、EMUとオービタのエアロックを結んで、電力、有線通信、酸素供給、廃水排出、水冷、PLSSの酸素タンク・水タンク・電池の充填を行う。 PLSSの酸素は、SCUを通じてオービタのECLSSから充填される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.2333;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.2632;entryDx=0;entryDy=0;" edge="1" parent="p2-L_flu" source="p2-B-ECLSS" target="p2-B-EVA">
            <mxGeometry relative="1" as="geometry" x="0.2899">
              <Array as="points">
                <mxPoint x="770" y="940" />
                <mxPoint x="630" y="940" />
                <mxPoint x="630" y="1330" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-46&lt;br&gt;EVA 通信" id="p2-IF-ORB-46" link="docs/SSD-FD-CT-001.html#IF-ORB-46" tooltip="IF-ORB-46：SSORは、オービタとISS・EMUの間の情報の伝送に使われる。 EVA通信系は、オービタのUHF系、EMU無線、EMU電気ハーネス、通信キャリア組立、生体センサなどから成る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5F6B7A;strokeWidth=2;fontColor=#5F6B7A;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;startArrow=block;startFill=1;startSize=7;exitX=0;exitY=0.6316;exitDx=0;exitDy=0;entryX=0;entryY=0.2632;entryDx=0;entryDy=0;" edge="1" parent="p2-L_rf" source="p2-B-CT" target="p2-B-EVA">
