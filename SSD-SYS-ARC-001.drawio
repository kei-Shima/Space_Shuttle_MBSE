        <mxCell id="p82-v-35" value="&lt;b style='font-size:12px'&gt;行動と機能&lt;/b&gt;&lt;table style='border-collapse:collapse;width:100%;font-size:10px;margin-top:4px;'&gt;&lt;tr&gt;&lt;th align='left'&gt;ID&lt;/th&gt;&lt;th align='left'&gt;行動&lt;/th&gt;&lt;th align='left'&gt;機能&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;AC-FR-01&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;煙の警報（サイレン・MASTER ALARM・L1 の SMOKE DETECTION 灯）&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;F-ECL-FDS-ALM-02・F-ECL-FDS-ALM-03&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;AC-FR-02&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;QDM を着ける（軌道上）&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;F-ECL-FDS-OPS-12&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;AC-FR-03&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;バイザーを閉じてスーツの O2（上昇・再突入）&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;F-ECL-FDS-OPS-12・F-ECL-PCS-05&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;AC-FR-04&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;固定式または携帯式のハロン消火器で消火する&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;F-ECL-FDS-FIX-02・F-ECL-FDS-PFE-07・F-ECL-FDS-OPS-07&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;AC-FR-05&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;WCS の活性炭フィルタ・ATCO・LiOH で大気を浄化する&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;F-ARS-CO2-06・F-ECL-FDS-OPS-11&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;AC-FR-06&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;運用を続ける&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;F-ECL-FDS-OPS-11&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;AC-FR-07&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;早期の軌道離脱（N2 はヘルメット着用で4〜8時間分）&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;F-ECL-FDS-OPS-12&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1060" y="130" width="600" height="250" as="geometry" />
        </mxCell>
