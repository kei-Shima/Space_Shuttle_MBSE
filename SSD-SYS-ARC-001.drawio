            <mxGeometry x="12" y="150" width="276" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p45-B-PLS" value="PLS　ペイロード支援（PDRS・ODS）" style="swimlane;html=1;whiteSpace=wrap;startSize=36;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#FFF3C4;swimlaneFillColor=#FFFFFF;strokeColor=#A77B00;strokeWidth=2;fontColor=#15202B;fontStyle=1;fontSize=15;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="700" y="840" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p45-v-31" value="&lt;b&gt;冗長&lt;/b&gt;：MRL・MPMは冗長モータ駆動・RMS投棄は冗長火工品＋EVA&lt;br&gt;&lt;b&gt;方式&lt;/b&gt;：同種多重・手動の代替&lt;br&gt;&lt;b&gt;段階&lt;/b&gt;：1故障許容（規則）&lt;br&gt;&lt;b&gt;CIL 件数&lt;/b&gt;：CIL 448（IOA）・390（NASA）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p45-B-PLS">
