            <mxGeometry x="140" y="1432" width="130" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-248" value="経験則の窒素消費（OV-103/104、4人で 5.28 lb/日、1人ごとに +0.114 lb/日）は乗員数と機体の変数で表せる" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="270" y="1432" width="1170" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-06" id="p109-v-249" link="docs/SSD-VAR-ORB-001.html#MK-06" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1456" width="100" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="BUD-CON-02" id="p109-v-250" link="docs/SSD-BUD-ORB-001.html#BUD-CON-02" tooltip="開く">
