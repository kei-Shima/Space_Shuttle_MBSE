        <mxCell id="p105-v-152" value="1,000 lb 超" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1150" y="672" width="200" height="24" as="geometry" />
        </mxCell>
        <UserObject label="DV-22" id="p105-v-153" link="docs/SSD-ANA-ORB-001.html#DV-22" tooltip="本書の行を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=5;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="700" y="696" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p105-v-154" value="RCS の速度変化能力（資料の値）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
