        <UserObject label="&lt;b&gt;FT-4-05&lt;/b&gt;" id="p133-v-240" link="docs/SSD-FLT-ORB-001.html#FT-4-05" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1420" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-241" value="STS-4" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1420" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-242" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1420" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-243" value="主 RCS による狭いデッドバンド（±0.1 deg/軸）の姿勢保持を示す。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1420" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-244" value="計画どおり行い ±0.1 deg/軸の保持能力を示したが、推進薬の使用量は飛行前の予測の2倍を超えた。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1420" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-245" value="—" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1420" width="220" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-4-06&lt;/b&gt;" id="p133-v-246" link="docs/SSD-FLT-ORB-001.html#FT-4-06" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1444" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-247" value="STS-4" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1444" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-248" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1444" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-249" value="受動の重力傾斜による姿勢保持を評価する。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1444" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-250" value="第1部は日照中の負のロールトルク（4〜6 ft-lb）で不成功、2日目の再試行は 12 時間から 6 時間に短縮したがほぼ成功した。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1444" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-251" value="—" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1444" width="220" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-4-08&lt;/b&gt;" id="p133-v-252" link="docs/SSD-FLT-ORB-001.html#FT-4-08" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1468" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-253" value="STS-4" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1468" width="80" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-254" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1468" width="90" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-255" value="RCS ヘリウム加圧の B 系統（前部酸化剤の調圧器）を軌道上で使う。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1468" width="520" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-256" value="レグ A から B へ切り替えて使い、調圧器は一貫して働いたが、ロックアップ 257〜258 psia（要求の最大 253）・調圧値 255 psia（245 ±3）と要求を外れた。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1468" width="760" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-257" value="REQ-RCS-01" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1468" width="220" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-4-10&lt;/b&gt;" id="p133-v-258" link="docs/SSD-FLT-ORB-001.html#FT-4-10" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1506" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-259" value="STS-4" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1506" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-260" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1506" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-261" value="水噴霧ボイラ（WSB）による潤滑油の温度制御（WSB 3 は小さいベントノズルを試用）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1506" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-262" value="WSB 1・2 は制御点 253°F に達して正常、WSB 3 は凍結し1分後に解けて潤滑油を 230°F まで下げた。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1506" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-263" value="REQ-APU-07" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1506" width="220" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-4-16&lt;/b&gt;" id="p133-v-264" link="docs/SSD-FLT-ORB-001.html#FT-4-16" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1530" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-265" value="STS-4" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1530" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-266" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1530" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-267" value="S帯と UHF の飛行中のアンテナパターンを測る。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1530" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-268" value="STS-2 から持ち越した試験で、一部を完了したが、完了には STS-5 での試験が要る。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1530" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-269" value="—" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1530" width="220" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-4-18&lt;/b&gt;" id="p133-v-270" link="docs/SSD-FLT-ORB-001.html#FT-4-18" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1554" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-271" value="STS-4" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1554" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-272" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1554" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-273" value="放熱器の性能試験（前方パネル収納・展開）と FTO 462-01（表面のコーティング点検）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1554" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-274" value="FTO 462-01 は完了。FTO 466-01 は収納の部分のデータを得たが、展開した放熱器の部分は完了せず、のちに必須でないとされた。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1554" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-275" value="REQ-ECLSS-08" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1554" width="220" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-4-22&lt;/b&gt;" id="p133-v-276" link="docs/SSD-FLT-ORB-001.html#FT-4-22" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1578" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-277" value="STS-4" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1578" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-278" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1578" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-279" value="ペイロードベイドアの寒冷時の性能（底面太陽向き約 32 時間の後の閉鎖）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1578" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-280" value="左舷ドアの後部隔壁のラッチが完全なラッチ位置に達せず（ラッチのモータが停止）、熱調整の後に閉鎖・ラッチを完了した。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1578" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-281" value="REQ-MECH-03" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1578" width="220" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-4-23&lt;/b&gt;" id="p133-v-282" link="docs/SSD-FLT-ORB-001.html#FT-4-23" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1602" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-283" value="STS-4" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1602" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-284" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1602" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-285" value="降着装置の展開と制動（制動の FTO：8〜10 ft/sec²）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1602" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-286" value="展開時間 6 秒（設計要求 10 秒）、展開開始は 294 KEAS・406 ft。制動の FTO は達成せず（平均 約 7.5 ft/sec²）、内側ブレーキ2組が損傷した。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1602" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-287" value="REQ-MECH-07" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1602" width="220" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-4-25&lt;/b&gt;" id="p133-v-288" link="docs/SSD-FLT-ORB-001.html#FT-4-25" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1626" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-289" value="STS-4" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1626" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-290" value="一部達成" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1626" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-291" value="油圧系のタイマモード運転（循環ポンプの間欠運転）で配管の温度を保つ。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1626" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-292" value="系 2・3 のデータを得たが、デューティ比 2.4% では配管を 0°F 以上に保てなかった。FTO 444-01（暖機）は実施した。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1626" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-293" value="REQ-APU-06" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1626" width="220" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;FT-4-27&lt;/b&gt;" id="p133-v-294" link="docs/SSD-FLT-ORB-001.html#FT-4-27" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1650" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p133-v-295" value="STS-4" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1650" width="80" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-296" value="未達" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="210" y="1650" width="90" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-297" value="熱防護（タイル・FRSI・オービタの外板の温度）の飛行後の状態。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="1650" width="520" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-298" value="隙間の加熱で7枚のタイルがスランプし、OMS ポッドの1か所はグラファイトエポキシの過熱で構造の修理を要した。右 OMS ポッドのタイル1枚が脱落し、ボディフラップ上面のタイルはバーニアのプルームで激しく摩耗した。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="1650" width="760" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-299" value="REQ-TPS-01" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1580" y="1650" width="220" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-300" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;上＝系（要求の系）× 飛行の飛行試験の結果の数（色：&lt;font color='#C62828'&gt;■&lt;/font&gt; 未達を含む、&lt;font color='#A77B00'&gt;■&lt;/font&gt; 一部達成を含む、&lt;font color='#2E7D32'&gt;■&lt;/font&gt; 達成だけ）。ます目をクリックすると最初の結果の行を開く（ツールチップに全件の ID）。下＝未達・一部達成の結果。&lt;br&gt;同じ結果を SysML v2 テキスト model/SSD-FLT-ORB-001.sysml の FlightTestResult の occurrence と要求への #EvidenceFor に示す。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="1718" width="1250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-301" value="&lt;table style='border-collapse:collapse;width:100%;font-size:11px;text-align:left;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;文書番号&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;SSD-SYS-ARC-001&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;表題&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;スペースシャトル システム構成図（機能ブロック・インタフェース図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;図番&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;図133 飛行試験の結果と要求（全158図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;版・日付&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;Rev. BF／2026-10-07&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;状態&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;検討用（公開資料に基づく）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;作成／確認／承認&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;　　　／　　　／　　　&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15202B;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1330" y="1718" width="430" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
