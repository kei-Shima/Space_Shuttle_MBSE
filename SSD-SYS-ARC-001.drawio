            <mxGeometry x="140" y="1288" width="130" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-230" value="OV-104 の STS-135 では残量で平均 13.6 kW・71時間の延長が可能で、実績から余裕日数を照合できる" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="270" y="1288" width="1170" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-04" id="p109-v-231" link="docs/SSD-VAR-ORB-001.html#MK-04" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1312" width="100" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="BUD-CON-04" id="p109-v-232" link="docs/SSD-BUD-ORB-001.html#BUD-CON-04" tooltip="開く">
