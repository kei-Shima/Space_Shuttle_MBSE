          <mxCell style="swimlane;html=1;whiteSpace=wrap;startSize=30;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#DCE8F6;swimlaneFillColor=#FFFFFF;strokeColor=#1F5FAD;strokeWidth=1.5;fontColor=#15202B;fontStyle=1;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
            <mxGeometry x="1580" y="600" width="260" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p58-v-32" value="・トーン発生器A・B（R13U）（図62参照）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p58-B-CW58">
          <mxGeometry x="0" y="30" width="260" height="30" as="geometry" />
        </mxCell>
        <UserObject label="▶ 機能説明書　SSD-FD-CW-ANN-001" id="p58-v-33" link="docs/SSD-FD-CW-ANN-001.html" tooltip="クリックで SSD-FD-CW-ANN-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F5FAD;fontColor=#1F5FAD;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p58-B-CW58">
            <mxGeometry x="10" y="66" width="240" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="EVA：合図と運用管理" id="p58-B-EVA58" tooltip="EMU無線（SSER）・ISS（SSSR）" doc_no="SSD-FD-EVA-OPS-001" abbr="EVA" 分類="受動系">
          <mxCell style="swimlane;html=1;whiteSpace=wrap;startSize=30;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#E7E9EC;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=1.5;fontColor=#15202B;fontStyle=1;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
            <mxGeometry x="1580" y="900" width="260" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p58-v-34" value="・EMU無線（SSER）・ISS（SSSR）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p58-B-EVA58">
          <mxGeometry x="0" y="30" width="260" height="30" as="geometry" />
        </mxCell>
        <UserObject label="▶ 機能説明書　SSD-FD-EVA-OPS-001" id="p58-v-35" link="docs/SSD-FD-EVA-OPS-001.html" tooltip="クリックで SSD-FD-EVA-OPS-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontColor=#5F6B7A;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p58-B-EVA58">
            <mxGeometry x="10" y="66" width="240" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="PLS：RMSアーム" id="p58-B-PLS58" tooltip="RMSカメラ・ODSカメラ（図66参照）" doc_no="SSD-FD-PLS-ARM-001" abbr="PLS" 分類="受動系">
          <mxCell style="swimlane;html=1;whiteSpace=wrap;startSize=30;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#E7E9EC;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=1.5;fontColor=#15202B;fontStyle=1;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
            <mxGeometry x="1580" y="300" width="260" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p58-v-36" value="・RMSカメラ・ODSカメラ（図66参照）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p58-B-PLS58">
          <mxGeometry x="0" y="30" width="260" height="30" as="geometry" />
        </mxCell>
        <UserObject label="▶ 機能説明書　SSD-FD-PLS-ARM-001" id="p58-v-37" link="docs/SSD-FD-PLS-ARM-001.html" tooltip="クリックで SSD-FD-PLS-ARM-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#5F6B7A;fontColor=#5F6B7A;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p58-B-PLS58">
            <mxGeometry x="10" y="66" width="240" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-01&lt;br&gt;S帯PM" id="p58-IF-CT-01" link="docs/SSD-FD-CT-SBD-001.html#IF-CT-01" tooltip="IF-CT-01：S帯PMのフォワードリンク（2,041.9 MHz主・2,106.4 MHz副）とリターンリンクを、STDNの地上局またはTDRSとの間で送受信する。TDRSSを使うと通信の覆域は約80%となり、インド洋上空の不可視域（ZOE）ではどちらの衛星とも見通せない。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5F6B7A;strokeWidth=2;fontColor=#5F6B7A;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2059;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p58-L_rf" source="p58-B-SBD" target="p58-B-NET58">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-02&lt;br&gt;S帯FM" id="p58-IF-CT-02" link="docs/SSD-FD-CT-SBD-001.html#IF-CT-02" tooltip="IF-CT-02：S帯FM送信機から2,250 MHzのリターンリンクで、FM信号処理器が選んだ1つの源のデータをSTDNまたは空軍の地上局へ送る。S帯FMのリターンリンクはS帯PMのリターンリンクと同時に送れるが、TDRSは経由しない。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5F6B7A;strokeWidth=2;fontColor=#5F6B7A;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.3571;exitY=1;exitDx=0;exitDy=0;entryX=0.1471;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p58-L_rf" source="p58-B-SBD" target="p58-B-NET58">
            <mxGeometry relative="1" as="geometry" x="-0.2" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-03&lt;br&gt;Ku帯" id="p58-IF-CT-03" link="docs/SSD-FD-CT-KU-001.html#IF-CT-03" tooltip="IF-CT-03：展開したKu帯アンテナで、オービタとTDRSの間に見通しがあるときにTDRSを介して地上と送受信する。3チャネルのデータはKu帯信号処理器でリターンリンクにインタリーブされ、送信機を含む展開電子組立からKu帯アンテナを通してTDRSへ送られる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5F6B7A;strokeWidth=2;fontColor=#5F6B7A;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0.4412;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p58-L_rf" source="p58-B-KU" target="p58-B-NET58">
            <mxGeometry relative="1" as="geometry" x="0.0282">
              <Array as="points">
                <mxPoint x="1080" y="430" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-04&lt;br&gt;UHF音声" id="p58-IF-CT-04" link="docs/SSD-FD-CT-UHF-001.html#IF-CT-04" tooltip="IF-CT-04：UHFシンプレックス（ATC）系は、上昇・再突入でSTDN地上局を介してMCCとS帯PMのバックアップの音声通信を行い、着陸時には航空交通管制と随伴機との音声通信にも使える。ガードの243.0 MHzは航空交通管制施設との非常時の通信専用で軌道上では通常使わず、軌道上の259.7 MHz・296.8 MHzはTDRSを経由しない。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5F6B7A;strokeWidth=2;fontColor=#5F6B7A;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7941;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p58-L_rf" source="p58-B-UHF" target="p58-B-NET58">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-05&lt;br&gt;アップリンク指令" id="p58-IF-CT-05" link="docs/SSD-FD-CT-SBD-001.html#IF-CT-05" tooltip="IF-CT-05：NSPはフォワードリンクの地上コマンドを解読し、FF MDM（NSP 1はFF 1、NSP 2はFF 3）を通して機上の計算機へ送る。NSPはコマンドを検証してGPCが飛行重要MDMを通して要求したときにGPCへ送り、GPCも実行の前にコマンドを検証する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.6667;entryDx=0;entryDy=0;" edge="1" parent="p58-L_dat" source="p58-B-SBD" target="p58-B-DPS58">
            <mxGeometry relative="1" as="geometry" x="0.0345">
              <Array as="points">
                <mxPoint x="810" y="530" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-06&lt;br&gt;ダウンリスト" id="p58-IF-CT-06" link="docs/SSD-FD-CT-INST-001.html#IF-CT-06" tooltip="IF-CT-06：各GPCは専用の計装/PCMMUデータバスで自らのダウンリストを働いているPCMMUへ送り、PCMMUはこれをTFLに従って計装・ペイロードのデータとインタリーブする。PCMMUはOIとPDIのデータを、機上の表示と故障検知（クラス3アラーム）のためにSMとBFSのGPCへ供給する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.8667;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="p58-L_dat" source="p58-B-DPS58" target="p58-B-INST">
            <mxGeometry relative="1" as="geometry" x="-0.3529">
              <Array as="points">
                <mxPoint x="360" y="560" />
                <mxPoint x="360" y="600" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-07&lt;br&gt;GCIL指令" id="p58-IF-CT-07" link="docs/SSD-FD-CT-OPS-001.html#IF-CT-07" tooltip="IF-CT-07：GCILで制御する通信系を組み替える指令は、GPCからPF MDMを経てGCILへ送られる。ペイロード通信系への指令もペイロードMDM 1・2からGCILCを経て送られ、これらのMDMはオービタの指令にも使われる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.3333;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p58-L_dat" source="p58-B-DPS58" target="p58-B-OPS">
            <mxGeometry relative="1" as="geometry" x="-0.1579">
              <Array as="points">
                <mxPoint x="410" y="480" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-08&lt;br&gt;レーダデータ" id="p58-IF-CT-08" link="docs/SSD-FD-CT-KU-001.html#IF-CT-08" tooltip="IF-CT-08：自動追尾モードでは、Ku帯系がアンテナの角度・角速度・距離・距離変化率をMDMを通してランデブ・近傍運用のために送り、GNC計算機のランデブ航法データの更新に使わせる。自動の角度追尾は航法データの更新に使える角度データを与える唯一の角度追尾モードで、パネルA2の表示器へのデータはGPCで処理しない配線の信号である。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p58-L_dat" source="p58-B-KU" target="p58-B-GNC58">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-09&lt;br&gt;C/Wトーン" id="p58-IF-CT-09" link="docs/SSD-FD-CT-AUD-001.html#IF-CT-09" tooltip="IF-CT-09：C&amp;W電子ユニットの2台のトーン発生器（A・B）は、クラクソン・サイレン・C&amp;Wトーン・アラートトーンをパネルR13Uの音量調整器を通してACCUへ送り、ACCUがヘッドセットと各スピーカユニットの1基のスピーカへ配る。クラクソン（乗員室の圧力）とサイレン（火災）のC/W信号は、スピーカの電源が切れていても直接スピーカユニットへ送られる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p58-L_dat" source="p58-B-CW58" target="p58-B-AUD">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-10&lt;br&gt;SSOR" id="p58-IF-CT-10" link="docs/SSD-FD-CT-UHF-001.html#IF-CT-10" tooltip="IF-CT-10：SSORはSSCSの時分割多重の網で、EVA乗員の宇宙服無線（SSER、最大3台）とISSの無線（SSSR）と音声・データを交換する。EMUの無線は、他のEVA乗員・オービタとの音声通信、ECG/RTDSのテレメトリのオービタへの送信（記録・ダウンリンク用）、警報トーンを提供する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5F6B7A;strokeWidth=2;fontColor=#5F6B7A;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="p58-L_rf" source="p58-B-UHF" target="p58-B-EVA58">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-11&lt;br&gt;RMS/ODS映像" id="p58-IF-CT-11" link="docs/SSD-FD-CT-CCTV-001.html#IF-CT-11" tooltip="IF-CT-11：RMSのエンドエフェクタの固定カメラ（ズーム可）と肘の下のパン・チルト付きカメラの映像をCCTVに取り込み、PDRSの作業を監視する。ドッキングミッションでは、ODSに取り付けたCTVCをセンタラインカメラとして使う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p58-L_dat" source="p58-B-PLS58" target="p58-B-CCTV">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-12&lt;br&gt;28 VDC" id="p58-IF-CT-12" link="docs/SSD-FD-CT-AUD-001.html#IF-CT-12" tooltip="IF-CT-12：ACCUの主系にはパネルR14のESS 2CA AUD CTR 1、副系にはMN C AUD CTR 2の遮断器から、パネルC3のAUDIO CENTERスイッチの選択に応じて直流電力を供給する。音声の各パネルには、パネルR14のMNA・MNB・MNC・ESS 1BC・ESS 2CAの遮断器（AUD L、AUD Rなど）から給電する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.7273;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p58-L_pow" source="p58-B-EPS58" target="p58-B-AUD">
            <mxGeometry relative="1" as="geometry" x="-0.125">
              <Array as="points">
                <mxPoint x="1440" y="530" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-13&lt;br&gt;28 VDC" id="p58-IF-CT-13" link="docs/SSD-FD-CT-CCTV-001.html#IF-CT-13" tooltip="IF-CT-13：VCUにはGCILのドライバによりDC Main AまたはBからパネルR14を経て給電し、GCILのドライバは乗員とMCCが同時にVCUを入切するのを防ぐ。標準のCCTV機器はパネルR14の遮断器から給電され、飛行ごとのキールカメラは通常キャビンのペイロード母線から給電される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.4545;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p58-L_pow" source="p58-B-EPS58" target="p58-B-CCTV">
            <mxGeometry relative="1" as="geometry" x="0.7368">
              <Array as="points">
                <mxPoint x="1440" y="500" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-14&lt;br&gt;テレメトリ" id="p58-IF-CT-14" link="docs/SSD-FD-CT-INST-001.html#IF-CT-14" tooltip="IF-CT-14：PCMMUはインタリーブ・形式化したデータをNSPへ送り、NSPがACCUからのA/G音声と合わせてS帯PMのダウンリンクとKu帯のリターンリンクのチャネル1で送る。PCMMUのテレメトリはNSPを経てSSRへも送られて記録され、後でS帯FMまたはKu帯でダウンリンクされる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p58-L_dat" source="p58-B-INST" target="p58-B-SBD">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-15&lt;br&gt;A/G音声" id="p58-IF-CT-15" link="docs/SSD-FD-CT-AUD-001.html#IF-CT-15" tooltip="IF-CT-15：働いているNSPはACCUから1本（低データレート）または2本（高データレート）のA/Gのアナログ音声を受けてデジタル化し、フォワードリンクでは逆に1本または2本のアナログ音声をACCUへ出す。パネルA1RのVOICE RECORD SELECTで選んだ音声は、NSPを経て記録器へ送られる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p58-L_dat" source="p58-B-AUD" target="p58-B-SBD">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-16&lt;br&gt;NSP⇔Ku" id="p58-IF-CT-16" link="docs/SSD-FD-CT-KU-001.html#IF-CT-16" tooltip="IF-CT-16：通信モードでは、NSPがリターンリンクのデータ（音声とテレメトリ）をKu帯信号処理器へも送り、Ku帯のフォワードリンクの音声とコマンドはKu帯信号処理器からNSPへ送られる。フォワードリンクの源は地上がGCILで、または乗員がパネルA1LのNSP UPLINK DATAスイッチで選び、SMソフトウェアで自動で切り替えることもできる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p58-L_dat" source="p58-B-SBD" target="p58-B-KU">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-17&lt;br&gt;A/A・SSOR音声" id="p58-IF-CT-17" link="docs/SSD-FD-CT-UHF-001.html#IF-CT-17" tooltip="IF-CT-17：UHF MODEでSPLX・SPLX + G RCV・G T/Rのいずれかを選ぶと、UHF（ATC）送受信機は自動でACCUのA/A音声ループにつながる。SSORは、パネルA1Rの音声センタのUHFスイッチを通してオービタの音声系につながる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p58-L_dat" source="p58-B-AUD" target="p58-B-UHF">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-18&lt;br&gt;映像" id="p58-IF-CT-18" link="docs/SSD-FD-CT-CCTV-001.html#IF-CT-18" tooltip="IF-CT-18：DTVはCCTVの映像をKu帯のチャネル3でMCCへ送り、INCOがKu帯をデジタル（チャネル3 PL MAX）とアナログ（チャネル3 TV）のダウンリンクの間で構成する。パネルA7UのTV DOWNLINKスイッチは、VSUからアナログのKu帯とS帯FMのダウンリンクへの出力を禁止できる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p58-L_dat" source="p58-B-CCTV" target="p58-B-KU">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-19&lt;br&gt;S帯構成指令" id="p58-IF-CT-19" link="docs/SSD-FD-CT-OPS-001.html#IF-CT-19" tooltip="IF-CT-19：S帯PMのトランスポンダなどの選択は通常GCILを経た地上指令で行い、パネルC3のS-BAND PM CONTROLスイッチがPANELのときはパネルA1Lのスイッチで行う。S帯FM系の乗員の操作器はパネルA1Rにあり、電子機器の状態と構成はCONTROLスイッチの位置に応じてパネルのスイッチまたはGCILで選ぶ。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p58-L_dat" source="p58-B-OPS" target="p58-B-SBD">
            <mxGeometry relative="1" as="geometry" x="0.0645">
              <Array as="points">
                <mxPoint x="640" y="510" />
                <mxPoint x="850" y="510" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-20&lt;br&gt;Ku構成指令" id="p58-IF-CT-20" link="docs/SSD-FD-CT-OPS-001.html#IF-CT-20" tooltip="IF-CT-20：パネルA1UのKU BAND CONTROLスイッチは、COMMAND（GCILまたはキーボード指令による制御）とPANEL（パネルのスイッチによる乗員の制御）を選ぶ。MCCは飛行ごとの理由でKu帯のRF搬送波を地上指令で禁止でき、この放射の制御をKu帯アンテナのマスキングと呼ぶ。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p58-L_dat" source="p58-B-OPS" target="p58-B-KU">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
