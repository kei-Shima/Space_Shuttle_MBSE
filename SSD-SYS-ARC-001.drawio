          </mxCell>
        </UserObject>
        <UserObject label="OMST-08" id="p136-v-26" link="docs/SSD-BEH-ORB-006.html#OMST-08" tooltip="OMST-08：LEFT OMS 灯（残る左エンジンも故障）→ 左の OMS ENG を OFF［OMS→RCS インタコネクトで後部 RCS へ供給］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9;exitY=0.0;exitDx=0;exitDy=0;entryX=0.15;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p136-v-10" target="p136-v-12">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="610" y="450" />
                <mxPoint x="1060" y="450" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="OMST-09" id="p136-v-27" link="docs/SSD-BEH-ORB-006.html#OMST-09" tooltip="OMST-09：RIGHT OMS 灯（残る右エンジンも故障）→ 右の OMS ENG を OFF［OMS→RCS インタコネクトで後部 RCS へ供給］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1.0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="p136-v-11" target="p136-v-12">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="OMST-10" id="p136-v-28" link="docs/SSD-BEH-ORB-006.html#OMST-10" tooltip="OMST-10：カットオフ（TGO が 0）［パージが禁止されていない］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1638;exitY=1.0;exitDx=0;exitDy=0;entryX=0.8;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p136-v-5" target="p136-v-13">
