        <UserObject label="宇宙空間（船外）" id="p12-B-SPACE12" tooltip="RCRS再生時の真空ベント排気先" doc_no="—" abbr="SPACE" 分類="外部（地上・宇宙インフラ）">
          <mxCell style="swimlane;html=1;whiteSpace=wrap;startSize=30;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=1.5;fontColor=#15202B;fontStyle=1;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
            <mxGeometry x="780" y="40" width="280" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p12-v-47" value="・RCRS再生時の真空ベント排気先" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p12-B-SPACE12">
          <mxGeometry x="0" y="30" width="280" height="64" as="geometry" />
        </mxCell>
        <UserObject label="IF-ARS-01&lt;br&gt;LiOH分流" id="p12-IF-ARS-01" link="docs/SSD-FD-ARS-CAC-001.html#IF-ARS-01" tooltip="IF-ARS-01：キャビンファン出口の空気の一部を、ダクト内のオリフィスで約120 lb/hrずつ2個のLiOHキャニスタへ分流し、通過後の空気は主流に戻ってキャビン熱交換器へ向かう。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.7312;exitDx=0;exitDy=0;entryX=0;entryY=0.4237;entryDx=0;entryDy=0;" edge="1" parent="p12-L_flu" source="p12-B-CAC" target="p12-B-CO2">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-02&lt;br&gt;RCRS通気" id="p12-IF-ARS-02" link="docs/SSD-FD-ARS-CAC-001.html#IF-ARS-02" tooltip="IF-ARS-02：RCRS搭載時は、キャビン空気ループから乗員数に応じて72 lb/hrまたは110 lb/hrの空気をRCRSへ通す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.1976;exitDx=0;exitDy=0;entryX=0;entryY=0.4237;entryDx=0;entryDy=0;" edge="1" parent="p12-L_flu" source="p12-B-CAC" target="p12-B-RCRS">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-03&lt;br&gt;主流空気" id="p12-IF-ARS-03" link="docs/SSD-FD-ARS-CAC-001.html#IF-ARS-03" tooltip="IF-ARS-03：暖まったキャビン空気はキャビンファンでキャビン熱交換器へ送られる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3916;entryDx=0;entryDy=0;" edge="1" parent="p12-L_flu" source="p12-B-CAC" target="p12-B-THC">
            <mxGeometry relative="1" as="geometry" x="-0.77" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-04&lt;br&gt;浄化空気" id="p12-IF-ARS-04" link="docs/SSD-FD-ARS-RCRS-001.html#IF-ARS-04" tooltip="IF-ARS-04：RCRSでCO2を除去した空気はキャビン熱交換器へ送られる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.4237;exitDx=0;exitDy=0;entryX=0;entryY=0.1548;entryDx=0;entryDy=0;" edge="1" parent="p12-L_flu" source="p12-B-RCRS" target="p12-B-THC">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-05&lt;br&gt;ATCO分流" id="p12-IF-ARS-05" link="docs/SSD-FD-ARS-THC-001.html#IF-ARS-05" tooltip="IF-ARS-05：キャビン熱交換器を出た再生・調整済み空気の一部をATCOへ送り、COをCO2に変換する。ATCOを通った空気は調整済み空気とともに乗員室へ戻り、生じたCO2は循環してLiOHキャニスタで除去される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.5728;exitDx=0;exitDy=0;entryX=1;entryY=0.4237;entryDx=0;entryDy=0;" edge="1" parent="p12-L_flu" source="p12-B-THC" target="p12-B-CO2">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-06&lt;br&gt;キャビン熱交換器" id="p12-IF-ARS-06" link="docs/SSD-FD-ARS-THC-001.html#IF-ARS-06" tooltip="IF-ARS-06：キャビン熱交換器で空気の熱を水冷却ループへ移す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0;exitY=0.8823;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p12-L_thm" source="p12-B-THC" target="p12-B-WCL">
            <mxGeometry relative="1" as="geometry" x="0.41">
              <Array as="points">
                <mxPoint x="920" y="820" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-07&lt;br&gt;ベイ熱交換器" id="p12-IF-ARS-07" link="docs/SSD-FD-ARS-AVB-001.html#IF-ARS-07" tooltip="IF-ARS-07：各アビオニクスベイの熱交換器で、水冷却ループがベイファン出口空気を冷却する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8704;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p12-L_thm" source="p12-B-AVB" target="p12-B-WCL">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-08&lt;br&gt;IMU熱交換器" id="p12-IF-ARS-08" link="docs/SSD-FD-ARS-IMU-001.html#IF-ARS-08" tooltip="IF-ARS-08：IMUファン出口空気はフライトデッキのIMU熱交換器を通り、水冷却ループで冷却される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1296;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p12-L_thm" source="p12-B-IMU" target="p12-B-WCL">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-09&lt;br&gt;還流空気" id="p12-IF-ARS-09" link="docs/SSD-FD-ARS-CAC-001.html#IF-ARS-09" tooltip="IF-ARS-09：暖まったキャビン空気をキャビン空気ループへ吸い込み、300ミクロンフィルタを通してキャビンファンで送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.3092;exitDx=0;exitDy=0;entryX=0;entryY=0.4644;entryDx=0;entryDy=0;" edge="1" parent="p12-L_flu" source="p12-B-CAB12" target="p12-B-CAC">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-10&lt;br&gt;給気" id="p12-IF-ARS-10" link="docs/SSD-FD-ARS-THC-001.html#IF-ARS-10" tooltip="IF-ARS-10：熱交換器通過空気とバイパス空気を合流させ、CDR・PLTコンソールと各所のダクト吹出口から乗員室へ給気する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.8359;exitDx=0;exitDy=0;entryX=1;entryY=0.7105;entryDx=0;entryDy=0;" edge="1" parent="p12-L_flu" source="p12-B-THC" target="p12-B-CAB12">
            <mxGeometry relative="1" as="geometry" x="0.86" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-11&lt;br&gt;IMU冷却空気" id="p12-IF-ARS-11" link="docs/SSD-FD-ARS-IMU-001.html#IF-ARS-11" tooltip="IF-ARS-11：IMUファンはキャビン空気を300ミクロンフィルタを通して吸い込んで3台のIMUに流し、IMU熱交換器で冷やした後に乗員室へ戻す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.9342;exitDx=0;exitDy=0;entryX=0;entryY=0.1695;entryDx=0;entryDy=0;" edge="1" parent="p12-L_flu" source="p12-B-CAB12" target="p12-B-IMU">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-12&lt;br&gt;凝縮水" id="p12-IF-ARS-12" link="docs/SSD-FD-ARS-THC-001.html#IF-ARS-12" tooltip="IF-ARS-12：湿度分離器で分離した凝縮水を廃水タンクへ送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.1548;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p12-L_flu" source="p12-B-THC" target="p12-B-H2O12">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-15&lt;br&gt;煙感知・消火" id="p12-IF-ARS-15" link="docs/SSD-FD-ARS-AVB-001.html#IF-ARS-15" tooltip="IF-ARS-15：前方アビオニクスベイ1・2・3AにはそれぞれA群・B群の煙感知器が1個ずつあり、Halon消火ボトルもベイ1・2・3Aに常設される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.1695;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p12-L_flu" source="p12-B-AVB" target="p12-B-FDS12">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-16&lt;br&gt;真空ベント" id="p12-IF-ARS-16" link="docs/SSD-FD-ARS-RCRS-001.html#IF-ARS-16" tooltip="IF-ARS-16：RCRSは再生時にベッドを真空ベントダクトへ排気する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p12-L_flu" source="p12-B-RCRS" target="p12-B-SPACE12">
            <mxGeometry relative="1" as="geometry" x="0.45" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-17&lt;br&gt;GPC空冷" id="p12-IF-ARS-17" link="docs/SSD-FD-ARS-AVB-001.html#IF-ARS-17" tooltip="IF-ARS-17：GPC（ベイ1にGPC 1・4、ベイ2にGPC 2・5、ベイ3にGPC 3）はアビオニクスベイのファンで強制空冷される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.678;exitDx=0;exitDy=0;entryX=0;entryY=0.2273;entryDx=0;entryDy=0;" edge="1" parent="p12-L_thm" source="p12-B-AVB" target="p12-B-DPS12">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-19&lt;br&gt;IMU空冷" id="p12-IF-ARS-19" link="docs/SSD-FD-ARS-IMU-001.html#IF-ARS-19" tooltip="IF-ARS-19：IMUの強制空冷は3台のIMUすべてに供する3台のファンで行い、同時に使うのは1台である。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0;exitY=0.678;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p12-L_thm" source="p12-B-IMU" target="p12-B-GNC12">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-20&lt;br&gt;コールドプレート" id="p12-IF-ARS-20" link="docs/SSD-FD-ARS-WCL-001.html#IF-ARS-20" tooltip="IF-ARS-20：前方アビオニクスベイのFF・PL・LF・LM MDMは水冷却ループのコールドプレートで冷却される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.0596;exitDx=0;exitDy=0;entryX=0;entryY=0.8636;entryDx=0;entryDy=0;" edge="1" parent="p12-L_thm" source="p12-B-WCL" target="p12-B-DPS12">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-21&lt;br&gt;配電機器冷却" id="p12-IF-ARS-21" link="docs/SSD-FD-ARS-WCL-001.html#IF-ARS-21" tooltip="IF-ARS-21：前方アビオニクスベイ1〜3の電力制御組立・負荷制御組立・モータ制御組立・インバータはコールドプレートに搭載され、水冷却ループで冷却される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.7143;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p12-L_thm" source="p12-B-WCL" target="p12-B-EPS12">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ARS-22&lt;br&gt;LCG熱交換器" id="p12-IF-ARS-22" link="docs/SSD-FD-ARS-WCL-001.html#IF-ARS-22" tooltip="IF-ARS-22：水冷却ループの冷側経路は液冷服（LCG）熱交換器を通る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.4464;entryDx=0;entryDy=0;" edge="1" parent="p12-L_thm" source="p12-B-ALS12" target="p12-B-WCL">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-01&lt;br&gt;インターチェンジャ" id="p12-IF-TCS-01" link="docs/SSD-FD-TCS-HX-001.html#IF-TCS-01" tooltip="IF-TCS-01：ATCSは、水冷却ループとフレオン21冷却ループの熱交換器（インターチェンジャ）でARSの熱を受け取る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.3571;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p12-L_thm" source="p12-B-WCL" target="p12-B-HX12">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
