        <UserObject label="IF-H2O-01&lt;br&gt;処理水" id="p20-IF-H2O-01" link="docs/SSD-FD-ECL-H2O-FCW-001.html#IF-H2O-01" tooltip="IF-H2O-01：水素分離器と微生物フィルタを通った生成水をタンクAへ送り、タンクAが満杯か入口弁が閉じているときは1.5 psidの逆止弁を経てタンクB、さらにタンクC・Dへ送る。閉塞に備えて、水素分離器を通らずにタンクBの入口マニホールドへ向かう冗長経路もある。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p20-L_flu" source="p20-B-FCW" target="p20-B-SPL">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-H2O-02&lt;br&gt;水素排出" id="p20-IF-H2O-02" link="docs/SSD-FD-ECL-H2O-FCW-001.html#IF-H2O-02" tooltip="IF-H2O-02：水素分離器の銀パラジウム管を透過した水素は、真空ベント配管を通って船外へ排出される。運用飛行規則は、燃料電池の生成水から抽出した水素（約0.0000975 lb/hr）を船外へ排出することを真空ベントの主な機能に挙げる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p20-L_flu" source="p20-B-FCW" target="p20-B-SPACE20">
            <mxGeometry relative="1" as="geometry" x="-0.1891">
              <Array as="points">
                <mxPoint x="1860" y="430" />
                <mxPoint x="1860" y="840" />
                <mxPoint x="1470" y="840" />
                <mxPoint x="1470" y="800" />
                <mxPoint x="1440" y="800" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-H2O-03&lt;br&gt;飲料水" id="p20-IF-H2O-03" link="docs/SSD-FD-ECL-H2O-SPL-001.html#IF-H2O-03" tooltip="IF-H2O-03：タンクAの飲料水を、ギャレー給水弁を通してギャレーへ送る。ギャレー給水弁へは、微生物フィルタの下流の給水が導かれる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p20-L_flu" source="p20-B-SPL" target="p20-B-GAL">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-H2O-04&lt;br&gt;給水ダンプ" id="p20-IF-H2O-04" link="docs/SSD-FD-ECL-H2O-SPL-001.html#IF-H2O-04" tooltip="IF-H2O-04：給水ダンプ配管はA-B側の出口マニホールドにつながり、タンクC・Dの水はクロスオーバ弁を経てダンプ配管へ送られる。非常時は、廃水タンクに入れた給水をクロスタイ経由で給水系へ戻し、FESの冷却に使う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p20-L_flu" source="p20-B-SPL" target="p20-B-DMP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-H2O-05&lt;br&gt;水量・圧力" id="p20-IF-H2O-05" link="docs/SSD-FD-ECL-H2O-SPL-001.html#IF-H2O-05" tooltip="IF-H2O-05：給水タンク量A〜Dと給水圧を、軌道上はPASS SMのSPEC 66に、上昇・再突入時はBFSのTHERMAL表示に送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p20-L_dat" source="p20-B-SPL" target="p20-B-DPS20">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-H2O-07&lt;br&gt;尿・EMU凝縮水" id="p20-IF-H2O-07" link="docs/SSD-FD-ECL-H2O-WST-001.html#IF-H2O-07" tooltip="IF-H2O-07：WCSで処理した尿と、エアロックからのEMU凝縮水を廃水タンクへ受け入れる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p20-L_flu" source="p20-B-WCS20" target="p20-B-WST">
            <mxGeometry relative="1" as="geometry" x="-0.125">
              <Array as="points">
                <mxPoint x="1440" y="770" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-H2O-08&lt;br&gt;廃水ダンプ" id="p20-IF-H2O-08" link="docs/SSD-FD-ECL-H2O-WST-001.html#IF-H2O-08" tooltip="IF-H2O-08：廃水タンクの入口弁は出入口を兼ね、弁を開くとタンクの廃水を廃水ダンプ配管へ送れる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p20-L_flu" source="p20-B-WST" target="p20-B-DMP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-H2O-10&lt;br&gt;船外ダンプ" id="p20-IF-H2O-10" link="docs/SSD-FD-ECL-H2O-DMP-001.html#IF-H2O-10" tooltip="IF-H2O-10：給水はダンプ隔離弁（乗員室内）とダンプ弁（中胴）を開いて、ダンプノズルから船外へ捨てる。廃水は廃水ダンプ隔離弁とダンプ弁を開いて、廃水ダンプノズルから船外へ捨てる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0.1071;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p20-L_flu" source="p20-B-DMP" target="p20-B-SPACE20">
            <mxGeometry relative="1" as="geometry" x="0.125">
              <Array as="points">
                <mxPoint x="1040" y="800" />
                <mxPoint x="1210" y="800" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-H2O-11&lt;br&gt;DC電力" id="p20-IF-H2O-11" link="docs/SSD-FD-ECL-H2O-DMP-001.html#IF-H2O-11" tooltip="IF-H2O-11：パネルML86BのMNA H2O LINE HTR A・MNB H2O LINE HTR B遮断器から、給水・廃水ダンプ配管のヒータへ給電する（同じ遮断器が給電する真空ベント配管のヒータは廃棄物収集系のIF-WCS-11で扱う）。DUMP VLV ENABLE/NOZ HTRスイッチをONにすると、ダンプノズルのヒータとダンプ弁スイッチに電力が入る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p20-L_pow" source="p20-B-EPS20" target="p20-B-DMP">
            <mxGeometry relative="1" as="geometry" x="0.125">
              <Array as="points">
                <mxPoint x="640" y="770" />
                <mxPoint x="810" y="770" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-H2O-13&lt;br&gt;N2加圧" id="p20-IF-H2O-13" link="docs/SSD-FD-ECL-H2O-PRS-001.html#IF-H2O-13" tooltip="IF-H2O-13：共通のH2O TK N2マニホールドから給水タンク4基のベローズを加圧し、水を系統へ押し出す。打上げ時はタンクA供給弁を閉じてベント弁を開き、タンクAだけを乗員室圧にする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.7857;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p20-L_flu" source="p20-B-PRS" target="p20-B-SPL">
            <mxGeometry relative="1" as="geometry" x="0.1935">
              <Array as="points">
                <mxPoint x="600" y="470" />
                <mxPoint x="810" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-H2O-14&lt;br&gt;N2加圧" id="p20-IF-H2O-14" link="docs/SSD-FD-ECL-H2O-PRS-001.html#IF-H2O-14" tooltip="IF-H2O-14：同じN2マニホールドから廃水タンクを加圧する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p20-L_flu" source="p20-B-PRS" target="p20-B-WST">
            <mxGeometry relative="1" as="geometry" x="-0.3738">
              <Array as="points">
                <mxPoint x="640" y="530" />
                <mxPoint x="1210" y="530" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-PCS-06&lt;br&gt;水タンク加圧" id="p20-IF-PCS-06" link="docs/SSD-FD-ECL-PCS-N2S-001.html#IF-PCS-06" tooltip="IF-PCS-06：水タンク用N2レギュレータ入口弁を開くと窒素がレギュレータとH2O TK N2 ISOL弁へ流れ、レギュレータは200 psiの窒素を15.5〜17.0 psigに下げる。給水・廃水タンクは17 psigに加圧され、乗員の使用、船外ダンプ、FESへの給水に必要な圧力で水を押し出す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p20-L_flu" source="p20-B-PCS20" target="p20-B-PRS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ALS-03&lt;br&gt;EMU給水" id="p20-IF-ALS-03" link="docs/SSD-FD-ECL-ALS-SCU-001.html#IF-ALS-03" tooltip="IF-ALS-03：給水系のA・B出口系統の水を、フィルタ・逆止弁（EMUからオービタへの汚染を防ぐ）とその下流の給水遮断弁を通してエアロックへ送り、EMUの給水（昇華冷却用・飲用）に使う。給水タンクBの水は通常、FES給水系統AとエアロックのEMU給水に使われる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p20-L_flu" source="p20-B-SPL" target="p20-B-ALS20">
            <mxGeometry relative="1" as="geometry" x="0.25">
              <Array as="points">
                <mxPoint x="1040" y="160" />
                <mxPoint x="1210" y="160" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-EPS-06&lt;br&gt;生成水" id="p20-IF-EPS-06" link="docs/SSD-FD-EPS-FCP-001.html#IF-EPS-06" tooltip="IF-EPS-06：3基の燃料電池の生成水は単一の水リリーフ制御盤へ集まり、通常は飲料水タンクAへ送られ、凍結時に備えてタンクBへの冗長経路もある。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p20-L_flu" source="p20-B-FCP20" target="p20-B-FCW">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-16&lt;br&gt;FES給水A・B" id="p20-IF-TCS-16" link="docs/SSD-FD-TCS-FES-001.html#IF-TCS-16" tooltip="IF-TCS-16：FES用の水は、飲料水タンクから給水系統A・Bを通じて供給される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p20-L_flu" source="p20-B-SPL" target="p20-B-FES20">
            <mxGeometry relative="1" as="geometry" x="0.25">
              <Array as="points">
                <mxPoint x="810" y="160" />
                <mxPoint x="640" y="160" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-05&lt;br&gt;凝縮水" id="p20-IF-THC-05" link="docs/SSD-FD-ARS-THC-SEP-001.html#IF-THC-05" tooltip="IF-THC-05：分離した凝縮水を、分離器の共通出口から排出ラインを経て廃水タンクへ送る。ISS飛行では、軌道上で凝縮水をCWCへ切り替えて溜め、分離後に緊急クロスタイの廃水QDから機外へ捨てる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p20-L_flu" source="p20-B-THC20" target="p20-B-WST">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCL-22&lt;br&gt;飲料水チラー" id="p20-IF-WCL-22" link="docs/SSD-FD-ARS-WCL-CLD-001.html#IF-WCL-22" tooltip="IF-WCL-22：冷側経路の飲料水チラーで、ギャレーへ送る給水の一方の経路を冷やす。飲料水チラーは給水タンクからの乗員の飲料水を冷やす。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p20-L_thm" source="p20-B-WCL20" target="p20-B-GAL">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCS-08&lt;br&gt;非常時接続" id="p20-IF-WCS-08" link="docs/SSD-FD-ECL-WCS-VAC-001.html#IF-WCS-08" tooltip="IF-WCS-08：真空ベント系が故障したときは、真空ベントQDと非常用クロスタイの廃水QDを移送ホースでつなぎ、廃水ダンプ管から排気する。廃水タンクの弁が閉で故障した場合などは、同じQDを使ってARSの廃水（湿度分離器の凝縮水）を真空ベント管から船外へ捨てる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p20-L_flu" source="p20-B-WCSV20" target="p20-B-DMP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
