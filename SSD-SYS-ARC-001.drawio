        </UserObject>
        <UserObject label="OMST-11" id="p136-v-29" link="docs/SSD-BEH-ORB-006.html#OMST-11" tooltip="OMST-11：エンジンを確保し OMS・RCS の弁を軌道上（離脱後は突入）の構成へ［カットオフの2秒後］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p136-v-13" target="p136-v-14">
