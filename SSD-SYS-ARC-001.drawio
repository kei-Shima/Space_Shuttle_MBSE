        <mxCell id="p133-v-117" value="燃料電池のベント配管・ポートの再突入の熱環境の検証" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="790" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-118" value="反応剤のベント配管とポートは許容内であったが、水逃しノズルの温度は計測上限 450°F を超えた（異常報告23）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
