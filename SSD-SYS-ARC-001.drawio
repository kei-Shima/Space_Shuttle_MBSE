          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=11;fontStyle=1;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
