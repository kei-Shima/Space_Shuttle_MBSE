        <mxCell id="p109-v-218" value="PRSD の組数で反応剤で足りる日数が決まる（3組8日・5組12日・8組18日）。現行は5組12日で、組数を機体・キットの変数にできる" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="270" y="1192" width="1170" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-01" id="p109-v-219" link="docs/SSD-VAR-ORB-001.html#MK-01" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1216" width="100" height="24" as="geometry" />
          </mxCell>
        </UserObject>
