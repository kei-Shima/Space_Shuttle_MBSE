        <UserObject label="IF-WCL-02&lt;br&gt;合流水" id="p36-IF-WCL-02" link="docs/SSD-FD-ARS-WCL-AVL-001.html#IF-WCL-02" tooltip="IF-WCL-02：3つの並列経路はインターチェンジャの上流で合流し、再び分かれて一方はインターチェンジャへ、他方はバイパス経路へ流れる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p36-L_flu" source="p36-B-AVL" target="p36-B-ICH">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
