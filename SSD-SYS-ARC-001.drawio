          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p36-L_flu" source="p36-B-ICH" target="p36-B-PMP">
            <mxGeometry relative="1" as="geometry" x="-0.2" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCL-06&lt;br&gt;出口温度" id="p36-IF-WCL-06" link="docs/SSD-FD-ARS-WCL-PMP-001.html#IF-WCL-06" tooltip="IF-WCL-06：自動モードでは、バイパス制御器がポンプ出口温度を設定値63.0±2.5°Fと比べてバイパス弁を開閉する。">
