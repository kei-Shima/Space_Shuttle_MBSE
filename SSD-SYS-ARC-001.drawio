          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="780" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p154-v-108" value="私的医学会議（PMC）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="780" width="260" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-109" value="全飛行日に PMC を組み（通常は就寝前の活動の間、着陸日は軌道離脱の準備の前）、MET 72 時間より前の EVA・着陸の前にも組む。CD" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="780" width="640" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-110" value="4" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1010" y="780" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-111" value="&lt;span style='display:inline-block;width:165px;background:#C8E6C9'&gt;3&lt;/span&gt;&lt;span style='display:inline-block;width:55px;background:#FFF59D'&gt;1&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1100" y="780" width="260" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-112" value="—" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1360" y="780" width="360" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HF-14&lt;/b&gt;" id="p154-v-113" link="docs/SSD-HAB-ORB-001.html#HF-14" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="804" width="70" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p154-v-114" value="健康の監視（線量・生体）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="804" width="260" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-115" value="各乗員が飛行の全期間に受動線量計（TLD）を着け、非常時は能動線量計を読み出し、TEPC で線量率を記録する。OBS は航空医官の求めで心電" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="804" width="640" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-116" value="6" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1010" y="804" width="90" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-117" value="&lt;span style='display:inline-block;width:110px;background:#C8E6C9'&gt;3&lt;/span&gt;&lt;span style='display:inline-block;width:110px;background:#FFF59D'&gt;3&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1100" y="804" width="260" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-118" value="REQ-CREW-06" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1360" y="804" width="360" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HF-15&lt;/b&gt;" id="p154-v-119" link="docs/SSD-HAB-ORB-001.html#HF-15" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="842" width="70" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p154-v-120" value="飛行後の回復" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="842" width="260" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-121" value="軌道離脱の前に全乗員が水と食塩錠で水分負荷を行い、11日を超える飛行では耐Gスーツを膨らませる。着陸から1時間以内に医学の検査を行い、着陸場" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="842" width="640" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-122" value="6" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1010" y="842" width="90" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-123" value="&lt;span style='display:inline-block;width:36px;background:#C8E6C9'&gt;1&lt;/span&gt;&lt;span style='display:inline-block;width:183px;background:#FFF59D'&gt;5&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1100" y="842" width="260" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-124" value="—" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1360" y="842" width="360" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-125" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;上＝乗員の1日（起床からの時間。区分をクリックで定義書の行。区分の時刻の置き方は本書の判断を含む）。下＝居住・医療の機能（ID をクリックで定義書の行）と、照合表（SSD-HSI-SYS-001）の行の判定の数（帯の長さは割合）。&lt;br&gt;同じ内容を SysML v2 テキスト model/SSD-HAB-ORB-001.sysml の Functions・#EvaluatedBy・CrewDay に示す。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
