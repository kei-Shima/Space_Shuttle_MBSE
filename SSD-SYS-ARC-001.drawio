            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-11&lt;br&gt;油圧熱交換器" id="p3-IF-ECL-11" link="docs/SSD-FD-ECL-ATCS-001.html#IF-ECL-11" tooltip="IF-ECL-11：軌道上の循環時はフレオン21ループがフレオン／油圧作動油熱交換器で油圧作動油を加温する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p3-L_thm" source="p3-B-ATCS" target="p3-B-APU3">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-12&lt;br&gt;FES給水" id="p3-IF-ECL-12" link="docs/SSD-FD-ECL-H2O-001.html#IF-ECL-12" tooltip="IF-ECL-12：FES用の水は、飲料水タンクから給水系統A・Bを通じて供給される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.7203;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="p3-L_flu" source="p3-B-H2O" target="p3-B-ATCS">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="750" y="780" />
                <mxPoint x="750" y="1020" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-13&lt;br&gt;EMU給水" id="p3-IF-ECL-13" link="docs/SSD-FD-ECL-H2O-001.html#IF-ECL-13" tooltip="IF-ECL-13：タンクA・Bの水は、エアロックでのEMU補給に使われる。 飲料水は16±0.5 psiでEMUの給水リザーバへ送られる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p3-L_flu" source="p3-B-H2O" target="p3-B-ALS">
            <mxGeometry relative="1" as="geometry" x="-0.55">
              <Array as="points">
                <mxPoint x="618" y="535" />
                <mxPoint x="1236" y="535" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-14&lt;br&gt;尿・廃水" id="p3-IF-ECL-14" link="docs/SSD-FD-ECL-WCS-001.html#IF-ECL-14" tooltip="IF-ECL-14：WCSは尿を処理して廃水タンクへ送り、ARSの廃水も廃水タンクへ移す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p3-L_flu" source="p3-B-WCS" target="p3-B-H2O">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-16&lt;br&gt;EMU給電" id="p3-IF-ECL-16" link="docs/SSD-FD-ECL-ALS-001.html#IF-ECL-16" tooltip="IF-ECL-16：エアロック盤AW18Hは、主母線AまたはBの28 VDCから17±0.5 VDC・5 AをEMUへ供給し、EVA後はPLSSのバッテリを充電する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p3-L_pow" source="p3-B-EPS3" target="p3-B-ALS">
            <mxGeometry relative="1" as="geometry" x="-0.4">
              <Array as="points">
                <mxPoint x="206" y="215" />
                <mxPoint x="1404" y="215" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-17&lt;br&gt;均圧・減圧" id="p3-IF-ECL-17" link="docs/SSD-FD-ECL-ALS-001.html#IF-ECL-17" tooltip="IF-ECL-17：エアロックの再与圧は、内側ハッチの均圧弁でエアロックと乗員室の圧力を等しくして行う。 EVA前は乗員室を14.7 psiaから12.5 psiaを経て10.2 psiaへ減圧する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0;exitY=0.4237;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p3-L_flu" source="p3-B-ALS" target="p3-B-CAB">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-18&lt;br&gt;煙検知警報" id="p3-IF-ECL-18" link="docs/SSD-FD-ECL-FDS-001.html#IF-ECL-18" tooltip="IF-ECL-18：煙検知素子は警報を発し、煙濃度の情報をCRTと計器盤L1に表示する。">
