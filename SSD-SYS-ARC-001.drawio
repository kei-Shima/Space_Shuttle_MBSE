        <mxCell id="p56-v-30" value="・SM GPC・MEDS表示（図2参照）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p56-B-DPS56">
