        </mxCell>
        <mxCell id="p154-v-45" value="&lt;span style='display:inline-block;width:62px;background:#C8E6C9'&gt;2&lt;/span&gt;&lt;span style='display:inline-block;width:31px;background:#FFCDD2'&gt;1&lt;/span&gt;&lt;span style='display:inline-block;width:125px;background:#FFF59D'&gt;4&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
