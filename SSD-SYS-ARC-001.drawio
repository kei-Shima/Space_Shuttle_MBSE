        <UserObject label="▶ 機能説明書　SSD-FD-CO2-ABS-001" id="p16-v-29" link="docs/SSD-FD-CO2-ABS-001.html" tooltip="クリックで SSD-FD-CO2-ABS-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#A77B00;fontColor=#A77B00;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p16-B-ABS16">
            <mxGeometry x="10" y="66" width="240" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="温湿度制御：温度制御弁・給気混合" id="p16-B-THC16" tooltip="温度制御弁・熱交換器（図30参照）" doc_no="SSD-FD-ARS-THC-TCV-001" abbr="THC" 分類="電力・環境・油圧">
          <mxCell style="swimlane;html=1;whiteSpace=wrap;startSize=30;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#FBF1CF;swimlaneFillColor=#FFFFFF;strokeColor=#A77B00;strokeWidth=1.5;fontColor=#15202B;fontStyle=1;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
            <mxGeometry x="1580" y="370" width="260" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p16-v-30" value="・温度制御弁・熱交換器（図30参照）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p16-B-THC16">
          <mxGeometry x="0" y="30" width="260" height="30" as="geometry" />
        </mxCell>
        <UserObject label="▶ 機能説明書　SSD-FD-ARS-THC-TCV-001" id="p16-v-31" link="docs/SSD-FD-ARS-THC-TCV-001.html" tooltip="クリックで SSD-FD-ARS-THC-TCV-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#A77B00;fontColor=#A77B00;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p16-B-THC16">
            <mxGeometry x="10" y="66" width="240" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="エアロック支援系：換気・ブースタファン" id="p16-B-ALS16" tooltip="ブースタファン・ダクト（図24参照）" doc_no="SSD-FD-ECL-ALS-VNT-001" abbr="ALS" 分類="電力・環境・油圧">
          <mxCell style="swimlane;html=1;whiteSpace=wrap;startSize=30;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#FBF1CF;swimlaneFillColor=#FFFFFF;strokeColor=#A77B00;strokeWidth=1.5;fontColor=#15202B;fontStyle=1;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
            <mxGeometry x="1580" y="490" width="270" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p16-v-32" value="・ブースタファン・ダクト（図24参照）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p16-B-ALS16">
          <mxGeometry x="0" y="30" width="270" height="30" as="geometry" />
        </mxCell>
        <UserObject label="▶ 機能説明書　SSD-FD-ECL-ALS-VNT-001" id="p16-v-33" link="docs/SSD-FD-ECL-ALS-VNT-001.html" tooltip="クリックで SSD-FD-ECL-ALS-VNT-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#A77B00;fontColor=#A77B00;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p16-B-ALS16">
            <mxGeometry x="10" y="66" width="250" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-01&lt;br&gt;還流空気" id="p16-IF-CAC-01" link="docs/SSD-FD-CAC-RTN-001.html#IF-CAC-01" tooltip="IF-CAC-01：乗員室の暖まった空気を、フライトデッキ（電子機器のそばを通る）とミッドデッキの還流ダクトから吸い込む。WCS区画からも還流空気を取り込む。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5625;entryDx=0;entryDy=0;" edge="1" parent="p16-L_flu" source="p16-B-CAB16" target="p16-B-RTN">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-02&lt;br&gt;ろ過空気" id="p16-IF-CAC-02" link="docs/SSD-FD-CAC-RTN-001.html#IF-CAC-02" tooltip="IF-CAC-02：300ミクロンフィルタを通った空気を、2台のキャビンファンの入口へ送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.3125;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p16-L_flu" source="p16-B-RTN" target="p16-B-FAN">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-03&lt;br&gt;RCRS通気" id="p16-IF-CAC-03" link="docs/SSD-FD-CAC-RTN-001.html#IF-CAC-03" tooltip="IF-CAC-03：RCRS搭載時は、キャビンファンの上流からキャビン空気の一部（ARSの全流量の約6%）をRCRSへ引き出し、除去後の空気をファンのフィルタのすぐ上流に戻す。RCRSの流量は乗員数に応じて72 lb/hrまたは110 lb/hrに設定する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.9062;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p16-L_flu" source="p16-B-RTN" target="p16-B-RCRS16">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-04&lt;br&gt;煙感知（還流）" id="p16-IF-CAC-04" link="docs/SSD-FD-CAC-RTN-001.html#IF-CAC-04" tooltip="IF-CAC-04：フライトデッキの左還流ダクトにA群、右還流ダクトにB群の煙感知器があり、還流空気の煙を検知する。C&amp;Wの訓練マニュアルも、A群をフライトデッキの左還流ダクト、B群を右還流ダクトに置くとする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.1562;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p16-L_flu" source="p16-B-RTN" target="p16-B-FDS16">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-05&lt;br&gt;機器空冷" id="p16-IF-CAC-05" link="docs/SSD-FD-CAC-RTN-001.html#IF-CAC-05" tooltip="IF-CAC-05：キャビンファンは還流空気を乗員室の電子機器のそばに通して吸い込み、強制空冷する。CCTVのRCU・VSUはキャビンファンで強制空冷され、どちらも温度センサを持たない。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.1429;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="p16-L_thm" source="p16-B-RTN" target="p16-B-DPS16">
            <mxGeometry relative="1" as="geometry" x="0.55">
              <Array as="points">
                <mxPoint x="420" y="595" />
                <mxPoint x="300" y="595" />
                <mxPoint x="300" y="660" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-06&lt;br&gt;送風" id="p16-IF-CAC-06" link="docs/SSD-FD-CAC-FAN-001.html#IF-CAC-06" tooltip="IF-CAC-06：運転中のファンは逆止弁を通して約1,400 lb/hrの空気を出口ダクトへ送り、逆止弁は非運転ファンを通る逆流を防ぐ。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2941;entryDx=0;entryDy=0;" edge="1" parent="p16-L_flu" source="p16-B-FAN" target="p16-B-DCT">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-07&lt;br&gt;差圧計測点" id="p16-IF-CAC-07" link="docs/SSD-FD-CAC-FAN-001.html#IF-CAC-07" tooltip="IF-CAC-07：フィルタとファンの間と、ファンの下流のダクトに設けた圧力取出し口で、ファン前後の差圧を測る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1429;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p16-L_flu" source="p16-B-FAN" target="p16-B-MON">
            <mxGeometry relative="1" as="geometry" x="-0.1">
              <Array as="points">
                <mxPoint x="820" y="595" />
                <mxPoint x="520" y="595" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-08&lt;br&gt;煙感知（出口）" id="p16-IF-CAC-08" link="docs/SSD-FD-CAC-FAN-001.html#IF-CAC-08" tooltip="IF-CAC-08：ミッドデッキ床下のECLSSベイのキャビンファン・プレナムに煙感知器があり、パネルL1のSMOKE DETECTIONのCABIN灯を点灯させる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.2143;exitY=0;exitDx=0;exitDy=0;entryX=0.4783;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p16-L_flu" source="p16-B-FAN" target="p16-B-FDS16">
            <mxGeometry relative="1" as="geometry" x="-0.2">
              <Array as="points">
                <mxPoint x="840" y="175" />
                <mxPoint x="140" y="175" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-09&lt;br&gt;AC2/AC3電力" id="p16-IF-CAC-09" link="docs/SSD-FD-CAC-FAN-001.html#IF-CAC-09" tooltip="IF-CAC-09：キャビンファンAにはAC3、BにはAC2の三相115 V AC電力を、パネルL4の各3個の遮断器とパネルL1のCABIN FANスイッチを通して供給する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.7143;exitY=1;exitDx=0;exitDy=0;entryX=0.7143;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p16-L_pow" source="p16-B-EPS16" target="p16-B-FAN">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-10&lt;br&gt;選択・起動停止" id="p16-IF-CAC-10" link="docs/SSD-FD-CAC-OPS-001.html#IF-CAC-10" tooltip="IF-CAC-10：運用規則に従い、パネルL1のCABIN FAN A・Bスイッチで運転するファンを選び、起動・停止する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.6429;exitY=0;exitDx=0;exitDy=0;entryX=0.6429;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p16-L_dat" source="p16-B-OPS" target="p16-B-FAN">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-11&lt;br&gt;差圧・警報" id="p16-IF-CAC-11" link="docs/SSD-FD-CAC-MON-001.html#IF-CAC-11" tooltip="IF-CAC-11：差圧の表示と警報を、ファンの喪失判定（A17-101）と切替・点検の判断に使う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p16-L_dat" source="p16-B-MON" target="p16-B-OPS">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-12&lt;br&gt;差圧（C&amp;W 74）" id="p16-IF-CAC-12" link="docs/SSD-FD-CAC-MON-001.html#IF-CAC-12" tooltip="IF-CAC-12：キャビンファン差圧を、主C&amp;Wのハードウェアチャネル74（AV BAY/CABIN AIR灯）とSMの表示へ送る。表示はOPS 2・4のPASS SM SYS SUMM 1とSPEC 66、OPS 1・3のBFS SM SYS SUMM 1である。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p16-L_dat" source="p16-B-MON" target="p16-B-DPS16">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-13&lt;br&gt;主流空気" id="p16-IF-CAC-13" link="docs/SSD-FD-CAC-DCT-001.html#IF-CAC-13" tooltip="IF-CAC-13：LiOHキャニスタへの分流を除いた主流を、キャビン温度制御弁とキャビン熱交換器（バイパスを含む）へ送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p16-L_flu" source="p16-B-DCT" target="p16-B-THC16">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-14&lt;br&gt;エアロック送気" id="p16-IF-CAC-14" link="docs/SSD-FD-CAC-DCT-001.html#IF-CAC-14" tooltip="IF-CAC-14：ミッドデッキ床の継手から、乗員が張るダクトを通してエアロックのブースタファンへ空気を送る。ダクトはハッチ越しに張り、ハッチを閉じる前に外す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.8529;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p16-L_flu" source="p16-B-DCT" target="p16-B-ALS16">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CO2-01&lt;br&gt;LiOH流路" id="p16-IF-CO2-01" link="docs/SSD-FD-CO2-ABS-001.html#IF-CO2-01" tooltip="IF-CO2-01：キャビンファン出口の空気を、2個のLiOHキャニスタとオリフィスを並列に置いたダクトに受け入れ、通過後の空気は同じダクトでキャビン温度制御弁とキャビン熱交換器へ向かう。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.1471;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p16-L_flu" source="p16-B-DCT" target="p16-B-ABS16">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;図示を省略したIF（文書・図5に記載）&lt;/b&gt;&lt;br&gt;なし（IF-CAC-01〜14 をすべて図示）&lt;br&gt;&lt;br&gt;IF-CO2-01 は図14 と同じIF（キャビンファン出口→LiOH流路）を示します。&lt;br&gt;&lt;br&gt;各ブロックの「関連文書」ボタンは、機能別関連文書一覧（SSD-CAC-REF-001）の該当節を開きます。" id="p16-v-34" link="data:page/id,p5-register" tooltip="図5のIF一覧へ">
          <mxCell style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#FAFBFC;strokeColor=#9AA3AE;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#3B4654;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1175" y="890" width="310" height="170" as="geometry" />
