        <UserObject label="▶ 図76 の PH-4 離脱準備へ" id="p77-v-21" link="data:page/id,p76-mode-sm" tooltip="図76 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F5FAD;fontColor=#1F5FAD;fontSize=12;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1220" y="490" width="240" height="30" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p77-v-22" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;角丸の箱＝状態、●＝開始。黒＝通常の流れ、茶＝MDF へ、赤＝次の PLS へ。矢印のラベルは遷移の ID（クリックで遷移の行）。根拠は運用飛行規則 A2-102（MISSION DURATION REQUIREMENTS）。同じ状態機械を SysML v2 テキスト model/SSD-BEH-ORB-001.sysml の FlightContinuation に示す。&lt;br&gt;・故障の数（どの系で何故障なら MDF・次の PLS か）は、A2-1001 の表（MDF・NXT PLS の列）と各章の1001番の規則による。本図は判断の流れだけを示す。&lt;br&gt;・故障の状況によっては、故障の理解・系の構成の確認・乗員の休息のため、次の着陸機会に入るより軌道にとどまるほうが安全な場合がある。本図はこの例外を描かない。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="1570" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p77-v-23" value="&lt;table style='border-collapse:collapse;width:100%;font-size:11px;text-align:left;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;文書番号&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;SSD-SYS-ARC-001&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;表題&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;スペースシャトル システム構成図（機能ブロック・インタフェース図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;図番&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;図77 飛行継続判断（Go/No-Go）状態遷移図（全158図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;版・日付&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;Rev. BF／2026-10-07&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;状態&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;検討用（公開資料に基づく）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;作成／確認／承認&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;　　　／　　　／　　　&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15202B;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1650" y="680" width="430" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
