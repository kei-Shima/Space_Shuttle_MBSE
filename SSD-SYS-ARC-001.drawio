        <mxCell id="p133-v-123" value="上昇中の水噴霧ボイラによる APU 潤滑油の冷却" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="300" y="814" width="520" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p133-v-124" value="水噴霧ボイラが凍結し、WSB 3 の解凍に 1.5 分かかって潤滑油温度が 282°F に上がった（レッドライン 290°F 内）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
