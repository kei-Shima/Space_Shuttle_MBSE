        <UserObject label="IF-OMS-01&lt;br&gt;調圧ヘリウム" id="p52-IF-OMS-01" link="docs/SSD-FD-OMS-HE-001.html#IF-OMS-01" tooltip="IF-OMS-01：各ポッドの1基のヘリウムタンクから、圧力弁・二重調圧器・逆止弁を経て約250 psigに調圧したヘリウムで燃料タンクと酸化剤タンクを加圧する。1基のヘリウムタンクが両タンクを加圧するので、両タンクは同じ圧力に保たれて混合比の誤りが避けられる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p52-L_flu" source="p52-B-HE" target="p52-B-PSD">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-02&lt;br&gt;推進薬" id="p52-IF-OMS-02" link="docs/SSD-FD-OMS-PSD-001.html#IF-OMS-02" tooltip="IF-OMS-02：タンク隔離弁A・Bの一組を開くと、推進薬タンクの燃料と酸化剤が同じポッドのOMSエンジンとOMSクロスフィード弁へ流れる。加圧された推進薬はエンジンの二元推進薬弁組立で受けられ、二元推進薬弁が噴射の開始・停止のために流れを調整する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p52-L_flu" source="p52-B-PSD" target="p52-B-ENG">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-03&lt;br&gt;供給側推進薬" id="p52-IF-OMS-03" link="docs/SSD-FD-OMS-XFD-001.html#IF-OMS-03" tooltip="IF-OMS-03：供給側ポッドのタンク隔離弁とOMSクロスフィード弁A（またはB）の組を開き、そのポッドの燃料と酸化剤を左右のポッドを結ぶクロスフィード配管へ送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="p52-L_flu" source="p52-B-PSD" target="p52-B-XFD">
            <mxGeometry relative="1" as="geometry" x="0.5103">
              <Array as="points">
                <mxPoint x="1160" y="600" />
                <mxPoint x="1160" y="430" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-04&lt;br&gt;クロスフィード" id="p52-IF-OMS-04" link="docs/SSD-FD-OMS-XFD-001.html#IF-OMS-04" tooltip="IF-OMS-04：受け側ポッドのクロスフィード弁の組を開くと、他方のポッドの燃料と酸化剤がそのポッドのOMSエンジンへ送られ、受け側のタンク隔離弁は閉じておく。クロスフィードで噴射するときは一方のポッドのタンク隔離弁（2個）を開、他方を閉とし、左右のOMSクロスフィード弁B（2個）を開とする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p52-L_flu" source="p52-B-XFD" target="p52-B-ENG">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-05&lt;br&gt;エンジン推力" id="p52-IF-OMS-05" link="docs/SSD-FD-OMS-TVC-001.html#IF-OMS-05" tooltip="IF-OMS-05：ジンバルリング組立の2つの取付けパッドにエンジンを取り付け、エンジンの推力をリングで受ける。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p52-L_str" source="p52-B-ENG" target="p52-B-TVC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-06&lt;br&gt;ARM/PRESS" id="p52-IF-OMS-06" link="docs/SSD-FD-OMS-OPS-001.html#IF-OMS-06" tooltip="IF-OMS-06：乗員は各噴射の前にパネルC3のOMS ENGスイッチをARM/PRESSにしてGN2の圧力隔離弁を開き、それ以外のときはOFFにしておく。GN2の制御弁1・2は、C3のOMS ENGスイッチがARMかARM/PRESSで、O14（左）・O16（右）のOMS ENG VLVスイッチがONのときに計算機の指令で開く。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0.1071;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p52-L_dat" source="p52-B-OPS" target="p52-B-ENG">
            <mxGeometry relative="1" as="geometry" x="0.2222">
              <Array as="points">
                <mxPoint x="1040" y="530" />
                <mxPoint x="1210" y="530" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-07&lt;br&gt;He弁操作" id="p52-IF-OMS-07" link="docs/SSD-FD-OMS-OPS-001.html#IF-OMS-07" tooltip="IF-OMS-07：乗員はパネルO8のLEFT・RIGHT OMS He PRESS/VAPOR ISOLスイッチA・Bで、ヘリウム圧力弁と蒸気隔離弁を手動で開閉するか、GPC位置にして噴射シーケンスの自動制御に任せる。AかBのどちらかのスイッチがOPENなら両方の蒸気隔離弁が開き、両方がCLOSEなら両方が閉じる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=1;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p52-L_dat" source="p52-B-OPS" target="p52-B-HE">
            <mxGeometry relative="1" as="geometry" x="0.2222">
              <Array as="points">
                <mxPoint x="810" y="530" />
                <mxPoint x="640" y="530" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-08&lt;br&gt;弁構成" id="p52-IF-OMS-08" link="docs/SSD-FD-OMS-OPS-001.html#IF-OMS-08" tooltip="IF-OMS-08：乗員はパネルO8のLEFT・RIGHT OMS CROSSFEED A・Bスイッチで燃料・酸化剤のクロスフィード弁の組を開閉し、軌道上のインタコネクトはO7のRCSスイッチとあわせて手動で組む。スイッチがGPC位置のときは、A・Bの燃料・酸化剤弁の組がオービタの計算機の指令で自動的に開閉される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p52-L_dat" source="p52-B-OPS" target="p52-B-XFD">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-09&lt;br&gt;推進薬量" id="p52-IF-OMS-09" link="docs/SSD-FD-OMS-PSD-001.html#IF-OMS-09" tooltip="IF-OMS-09：トータライザの全量はパネルO3のRCS/OMS PRPLT QTY表示に、後室プローブの量はGNC SYS SUMM 2のOMS AFT QTYに示され、推進薬の予算とレッドラインの管理に使われる。OMSの使用可能推進薬は、計測した量から配管・タンクに捕捉される量と分散を差し引いて定義される（A6-301）。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p52-L_dat" source="p52-B-PSD" target="p52-B-OPS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-10&lt;br&gt;ヒータ系統" id="p52-IF-OMS-10" link="docs/SSD-FD-OMS-OPS-001.html#IF-OMS-10" tooltip="IF-OMS-10：乗員はパネルA14のRCS/OMS HTRスイッチで左右ポッドとOMSクロスフィード配管のヒータのA・B系統を選び、軌道上でヒータ系統を切り替える。ヒータは飛行中に少なくとも1回は冗長な系統（AかB）へ切り替える（A6-251B）。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p52-L_dat" source="p52-B-OPS" target="p52-B-THM">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-11&lt;br&gt;OMS推進薬" id="p52-IF-OMS-11" link="docs/SSD-FD-OMS-XFD-001.html#IF-OMS-11" tooltip="IF-OMS-11：OMS－RCSインタコネクトでは、OMSクロスフィード配管とRCSクロスフィード弁を通して、どちらかのOMSポッドの推進薬を後部RCSジェットへ送る。OMSエンジンが故障した場合は、インタコネクトでOMS推進薬を後部RCSへ送り、後部RCSの+Xジェットで予定のOMS噴射を完了できる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="p52-L_flu" source="p52-B-XFD" target="p52-B-RCS52">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-12&lt;br&gt;AC電力" id="p52-IF-OMS-12" link="docs/SSD-FD-OMS-PSD-001.html#IF-OMS-12" tooltip="IF-OMS-12：後部モータ制御組立（AMC 1〜3）は主母線とAC母線、主RCS/OMS母線とRCS/OMS AC母線から電力を受け、AC母線で後部RCS/OMSのタンク隔離弁・クロスフィード弁を駆動する。OMSには主母線・制御母線・交流母線から電力が供給され、スイッチ、弁、計装、ジンバルアクチュエータ、ヒータを動かす。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.3235;exitY=0;exitDx=0;exitDy=0;entryX=0.7857;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p52-L_pow" source="p52-B-EPS52" target="p52-B-PSD">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-13&lt;br&gt;主母線電力" id="p52-IF-OMS-13" link="docs/SSD-FD-OMS-TVC-001.html#IF-OMS-13" tooltip="IF-OMS-13：ジンバルアクチュエータの駆動系には主母線から給電され、MNA DA1を失うと左エンジンの一次TVCと右エンジンの二次TVCが失われる。このときはMNVR表示で左エンジンを二次、右エンジンを一次のジンバルに切り替える。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.6324;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p52-L_pow" source="p52-B-EPS52" target="p52-B-TVC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-14&lt;br&gt;エンジン異常" id="p52-IF-OMS-14" link="docs/SSD-FD-OMS-ENG-001.html#IF-OMS-14" tooltip="IF-OMS-14：エンジンを点火すべきときに燃焼室圧が80%未満か、停止すべきときに80%超になると、パネルF7のLEFT・RIGHT OMS警報灯が点灯する。C/Wのハードウェアのチャネルは、OMS ENG-Lが27、OMS ENG-Rが57である。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.3333;entryDx=0;entryDy=0;" edge="1" parent="p52-L_dat" source="p52-B-ENG" target="p52-B-CW52">
            <mxGeometry relative="1" as="geometry" x="0.1765">
              <Array as="points">
                <mxPoint x="1440" y="780" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-15&lt;br&gt;タンク圧" id="p52-IF-OMS-15" link="docs/SSD-FD-OMS-PSD-001.html#IF-OMS-15" tooltip="IF-OMS-15：推進薬タンク圧が232 psia未満か284 psia超になると、パネルF7のLEFT・RIGHT OMS警報灯が点灯する。C/Wのチャネルは、酸化剤タンク圧が7（左）・37（右）、燃料タンク圧が17（左）・47（右）である。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5333;entryDx=0;entryDy=0;" edge="1" parent="p52-L_dat" source="p52-B-PSD" target="p52-B-CW52">
            <mxGeometry relative="1" as="geometry" x="-0.26">
              <Array as="points">
                <mxPoint x="1040" y="810" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-16&lt;br&gt;ジンバル故障" id="p52-IF-OMS-16" link="docs/SSD-FD-OMS-TVC-001.html#IF-OMS-16" tooltip="IF-OMS-16：OMSのピッチまたはヨーのジンバル故障を検知するとパネルF7のOMS TVC警報灯（ハードウェアのチャネル67）が点灯し、LEFTまたはRIGHT OMS灯も点くことがある。指令位置とフィードバック位置に2°の差があると、L（R） OMS GMBLの故障メッセージが出る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.7333;entryDx=0;entryDy=0;" edge="1" parent="p52-L_dat" source="p52-B-TVC" target="p52-B-CW52">
            <mxGeometry relative="1" as="geometry" x="0.0667">
              <Array as="points">
                <mxPoint x="1440" y="840" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-17&lt;br&gt;計測データ" id="p52-IF-OMS-17" link="docs/SSD-FD-OMS-ENG-001.html#IF-OMS-17" tooltip="IF-OMS-17：OMSの圧力・温度・弁位置などの計測データをMDM経由でGPCへ返し、GNC SYS SUMM 2などの表示に使う。BFSのGNC SYS SUMM 2には、ヘリウム・推進薬タンク圧、N2タンク圧・調圧圧、エンジン入口圧、ボール弁の位置、燃料噴射器温度、後室量が示される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="p52-L_dat" source="p52-B-ENG" target="p52-B-DPS52">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-18&lt;br&gt;推力伝達" id="p52-IF-OMS-18" link="docs/SSD-FD-OMS-TVC-001.html#IF-OMS-18" tooltip="IF-OMS-18：ジンバルリングの2つのパッドでリングをオービタに取り付け、エンジンの推力をポッドとオービタへ伝える。OMS/RCSポッドは軽微な修理で最大100回の飛行に再使用でき、オービタの整備のために取り外せる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p52-L_str" source="p52-B-TVC" target="p52-B-STR52">
            <mxGeometry relative="1" as="geometry" x="-0.1429">
              <Array as="points">
                <mxPoint x="640" y="1030" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-19&lt;br&gt;ヒータ熱" id="p52-IF-OMS-19" link="docs/SSD-FD-OMS-THM-001.html#IF-OMS-19" tooltip="IF-OMS-19：ポッド内面のストリップヒータと断熱材、クロスフィード配管の巻付けヒータと断熱材が、OMSのタンクと配管の推進薬を凍結から守る。各ポッドのヒータ区域のA・B素子は、素子ごとのサーモスタットで55〜75°Fに制御される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p52-L_thm" source="p52-B-PTC52" target="p52-B-THM">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-15&lt;br&gt;ジンバル・点火" id="p52-IF-GNC-15" link="docs/SSD-FD-GNC-FCS-001.html#IF-GNC-15" tooltip="IF-GNC-15：OMS TVC DAPは誘導の要求速度をOMSのジンバル指令に変換し、OMSの点火・停止の指令も生成する。OMS処理部は指定した推力方向を得るジンバルアクチュエータの指令を生成し、OMSの推力は重心を通るように加える。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p52-L_dat" source="p52-B-GNC52" target="p52-B-TVC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
