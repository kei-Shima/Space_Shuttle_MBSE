        <mxCell id="p109-v-166" value="EDO クライオパレット（追加4組、タンク6〜9）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="846" width="330" height="24" as="geometry" />
        </mxCell>
        <UserObject label="SSD-FD-EPS-PRSD-001" id="p109-v-167" link="docs/SSD-FD-EPS-PRSD-001.html" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="440" y="846" width="200" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-168" value="8組で最大18日、EDO 全体で16＋2日。中央マニホールドを先に消費し、主電力は軌道上だけ入れ、DSC を追加する。OI-33 時点では使わない" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="846" width="800" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-03" id="p109-v-169" link="docs/SSD-VAR-ORB-001.html#MK-03" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="870" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-170" value="追加の窒素タンク" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="870" width="330" height="24" as="geometry" />
        </mxCell>
        <UserObject label="SSD-FD-ECL-PCS-N2S-001" id="p109-v-171" link="docs/SSD-FD-ECL-PCS-N2S-001.html" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="440" y="870" width="200" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-172" value="常設4基（OV-103・105 は6基、OV-104 は5基）から最大8基に増やし、長期の漏洩とごみの排気を補う" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="870" width="800" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-04" id="p109-v-173" link="docs/SSD-VAR-ORB-001.html#MK-04" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="894" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-174" value="再生式 CO2 除去装置（RCRS）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="894" width="330" height="24" as="geometry" />
        </mxCell>
        <UserObject label="SSD-FD-ARS-RCRS-001" id="p109-v-175" link="docs/SSD-FD-ARS-RCRS-001.html" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="440" y="894" width="200" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-176" value="LiOH は打上げと再突入の各1個に減り、木炭キャニスタ（10日超で中間交換）を使う。7人・10〜16日を可能にした" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="894" width="800" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-05" id="p109-v-177" link="docs/SSD-VAR-ORB-001.html#MK-05" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="918" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-178" value="EDO 廃棄物収集系（EDO WCS）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="918" width="330" height="24" as="geometry" />
        </mxCell>
        <UserObject label="SSD-FD-ECL-WCS-001" id="p109-v-179" link="docs/SSD-FD-ECL-WCS-001.html" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="440" y="918" width="200" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-180" value="長期飛行向けの WCS。STS-54（OV-105）で初飛行、STS-65（OV-102）でも使用" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="918" width="800" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-06" id="p109-v-181" link="docs/SSD-VAR-ORB-001.html#MK-06" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="942" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-182" value="オービタドッキング系（ODS：外部エアロック・トラス・APDS）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="942" width="330" height="24" as="geometry" />
        </mxCell>
        <UserObject label="SSD-FD-PLS-ODS-001" id="p109-v-183" link="docs/SSD-FD-PLS-ODS-001.html" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="440" y="942" width="200" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-184" value="ISS とのドッキングを可能にし、外部エアロックで EVA を行う。合計の与圧容積は約 2,703 立方フィートになる" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="942" width="800" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-07" id="p109-v-185" link="docs/SSD-VAR-ORB-001.html#MK-07" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="966" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-186" value="外部エアロックの搭載位置（ベイ2／ベイ3）とトンネルアダプタ" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="966" width="330" height="24" as="geometry" />
        </mxCell>
        <UserObject label="SSD-FD-ECL-ALS-001" id="p109-v-187" link="docs/SSD-FD-ECL-ALS-001.html" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="440" y="966" width="200" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-188" value="位置で X-CG が 649 in／731 in となり、エアロック内の収納は 990 lb から EMU の重量を引いた値に限る" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="966" width="800" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-08" id="p109-v-189" link="docs/SSD-VAR-ORB-001.html#MK-08" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="990" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-190" value="SSPTS（ISS からの電力受電）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="990" width="330" height="24" as="geometry" />
        </mxCell>
        <UserObject label="SSD-FD-EPS-DC-001" id="p109-v-191" link="docs/SSD-FD-EPS-DC-001.html" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="440" y="990" width="200" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-192" value="ドッキング中に ISS の 120 V 電力を 28 V 主母線へ送り、燃料電池の負荷と反応剤の消費を減らしてミッション延長日を生む（OV-103・105）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="990" width="800" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-09" id="p109-v-193" link="docs/SSD-VAR-ORB-001.html#MK-09" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1014" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-194" value="Spacehab モジュール" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="1014" width="330" height="24" as="geometry" />
        </mxCell>
        <UserObject label="SSD-FD-PLS-001" id="p109-v-195" link="docs/SSD-FD-PLS-001.html" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="440" y="1014" width="200" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-196" value="中甲板の実験の場の拡張と ISS 補給品の輸送。ODS と併用時はトラニオンで単一モジュールを取り付ける" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="1014" width="800" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-10" id="p109-v-197" link="docs/SSD-VAR-ORB-001.html#MK-10" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1038" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-198" value="Spacelab モジュール" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="1038" width="330" height="24" as="geometry" />
        </mxCell>
        <UserObject label="SSD-FD-PLS-001" id="p109-v-199" link="docs/SSD-FD-PLS-001.html" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="440" y="1038" width="200" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-200" value="乗員区画に4つ目の区画を加え、トンネルアダプタが第2のエアロックとなる（STS-65 の IML-2）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="1038" width="800" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-11" id="p109-v-201" link="docs/SSD-VAR-ORB-001.html#MK-11" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1062" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-202" value="遠隔操作アーム（RMS）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="1062" width="330" height="24" as="geometry" />
        </mxCell>
        <UserObject label="SSD-FD-PLS-ARM-001" id="p109-v-203" link="docs/SSD-FD-PLS-ARM-001.html" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="440" y="1062" width="200" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-204" value="必要なミッションでだけ左舷ロンジロンに取り付ける" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="1062" width="800" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-12" id="p109-v-205" link="docs/SSD-VAR-ORB-001.html#MK-12" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1086" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-206" value="オービタブームセンサ系（OBSS）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="1086" width="330" height="24" as="geometry" />
        </mxCell>
        <UserObject label="SSD-FD-PLS-OPS-001" id="p109-v-207" link="docs/SSD-FD-PLS-OPS-001.html" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="440" y="1086" width="200" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-208" value="右舷に 50 フィートのブームを積み、RMS で把持して熱防護の軌道上点検を行う（STS-114 から）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="640" y="1086" width="800" height="24" as="geometry" />
        </mxCell>
        <UserObject label="MK-13" id="p109-v-209" link="docs/SSD-VAR-ORB-001.html#MK-13" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1110" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-210" value="OMS キット" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
