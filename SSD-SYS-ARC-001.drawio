      <root>
        <mxCell id="0" />
        <mxCell id="1" value="ブロック・注記" parent="0" />
        <mxCell id="p144-v-1" value="&lt;div style='font-size:22px;font-weight:bold;'&gt;SSD-SYS-ARC-001　図144 人間系の基準の値とシャトルの値&lt;/div&gt;&lt;div style='font-size:12px;color:#3B4654;margin-top:4px;'&gt;主な基準の値とシャトルの設計値・運用の限界・実績。ID をクリックすると照合表の行を開きます。&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="64" as="geometry" />
        </mxCell>
        <UserObject label="◀ 図143 へ" id="p144-v-2" link="data:page/id,p143-hsi-coverage" tooltip="クリックでページ移動">
