          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p1-L_str" source="p1-B-SRB" target="p1-B-ET">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
