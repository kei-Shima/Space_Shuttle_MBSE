          </mxCell>
        </UserObject>
        <mxCell id="p154-v-66" value="運動" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="528" width="260" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-67" value="中甲板の床のスタッドに取り付ける自転車エルゴメータ（CE）で、CDR・PLT・MS2 に処方の運動を組む。運動の処方は飛行前に航空医官が説明" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="528" width="640" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-68" value="6" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1010" y="528" width="90" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-69" value="&lt;span style='display:inline-block;width:220px;background:#FFF59D'&gt;6&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
