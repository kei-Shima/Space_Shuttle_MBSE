        <mxCell id="p45-B-MECH" value="MECH　機械系（MECH）" style="swimlane;html=1;whiteSpace=wrap;startSize=36;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#FFF3C4;swimlaneFillColor=#FFFFFF;strokeColor=#A77B00;strokeWidth=2;fontColor=#15202B;fontStyle=1;fontSize=15;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1120" y="840" width="300" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p45-v-33" value="&lt;b&gt;冗長&lt;/b&gt;：PLBD駆動モータ 2/扉・ラッチ駆動モータ 2/ギャング・脚展開は油圧＋火工品&lt;br&gt;&lt;b&gt;方式&lt;/b&gt;：同種多重・異種&lt;br&gt;&lt;b&gt;段階&lt;/b&gt;：1故障許容（規則）&lt;br&gt;&lt;b&gt;CIL 件数&lt;/b&gt;：CIL：MAS 512・252、L&amp;amp;D 124・120、NWS 41・34（IOA・NASA）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p45-B-MECH">
