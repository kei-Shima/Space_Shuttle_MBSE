            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-19&lt;br&gt;Halon 1301消火" id="p3-IF-ECL-19" link="docs/SSD-FD-ECL-FDS-001.html#IF-ECL-19" tooltip="IF-ECL-19：乗員室の3つのアビオニクスベイには、それぞれFreon 1301（Halon 1301）の消火ボトルが1本ある。 計器盤の穴から携帯消火器のノズルを差し込み、パネル内部の火災に対処できる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.1271;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="p3-L_flu" source="p3-B-FDS" target="p3-B-CAB">
            <mxGeometry relative="1" as="geometry" x="-0.3">
              <Array as="points">
