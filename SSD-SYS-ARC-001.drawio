        <mxCell id="p38-v-596" value="＊：構成図（図1・図2）では図示省略" style="text;html=1;fontSize=11;align=left;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="510" y="1014" width="260" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p38-v-597" value="双方向のIFは両方向のセルに置く。IF-ORB-14（28 VDC 主母線）はEPSの行に負荷ごと、IF-ORB-41（C/W入力）は各系の行のC/W列に置く。オービタと外部要素の間のIF-SYS（01・03・04・06〜09）は下位のIF-ORBで示し、外部要素どうしのIF-SYS（02・05・10）は外部要素の行に示す。IF種別ごとの表示切替：表示 ＞ レイヤ（Ctrl+Shift+L）。" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#3B4654;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="56" y="1044" width="1150" height="64" as="geometry" />
        </mxCell>
        <mxCell id="p38-v-598" value="&lt;b&gt;集計&lt;/b&gt;&lt;br&gt;IF-ORB 49件（うち Rev. I で追加 29件）&lt;br&gt;IF-SYS 10件&lt;br&gt;IF のあるセル 77／420" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FFFFFF;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1240" y="916" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p38-v-599" value="&lt;table style='border-collapse:collapse;width:100%;font-size:11px;text-align:left;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;文書番号&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;SSD-SYS-ARC-001&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;表題&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;スペースシャトル システム構成図（機能ブロック・インタフェース図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;図番&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;図38 オービタ N2 インタフェース行列（全158図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;版・日付&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;Rev. BF／2026-10-07&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;状態&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;検討用（公開資料に基づく）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;作成／確認／承認&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;　　　／　　　／　　　&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15202B;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1416" y="1136" width="430" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
