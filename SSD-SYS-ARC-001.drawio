        <UserObject label="IF-MECH-01&lt;br&gt;MCA電力" id="p68-IF-MECH-01" link="docs/SSD-FD-MECH-ACT-001.html#IF-MECH-01" tooltip="IF-MECH-01：アクチュエータのモータとリミットスイッチの電力は、モータ制御組立（MCA）から供給される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p68-L_pow" source="p68-B-EPS68" target="p68-B-ACT">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MECH-02&lt;br&gt;ヒンジ" id="p68-IF-MECH-02" link="docs/SSD-FD-MECH-PLB-001.html#IF-MECH-02" tooltip="IF-MECH-02：各ペイロードベイドアは、13のヒンジ（固定5・浮動8）で中胴につながる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1296;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p68-L_str" source="p68-B-PLB" target="p68-B-STR68">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MECH-03&lt;br&gt;脚取付" id="p68-IF-MECH-03" link="docs/SSD-FD-MECH-LDG-001.html#IF-MECH-03" tooltip="IF-MECH-03：前脚は前胴の下部、主脚は中胴に隣接する左右の翼の下部に収められる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8704;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p68-L_str" source="p68-B-LDG" target="p68-B-STR68">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MECH-04&lt;br&gt;ベント口" id="p68-IF-MECH-04" link="docs/SSD-FD-MECH-VNT-001.html#IF-MECH-04" tooltip="IF-MECH-04：能動ベント系は胴体の左右各7つ、計14のベント口から成る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0.3519;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p68-L_str" source="p68-B-VNT" target="p68-B-STR68">
            <mxGeometry relative="1" as="geometry" x="-0.522">
              <Array as="points">
                <mxPoint x="760" y="430" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-MECH-05&lt;br&gt;ドア駆動" id="p68-IF-MECH-05" link="docs/SSD-FD-MECH-ACT-001.html#IF-MECH-05" tooltip="IF-MECH-05：各ドアは2つの3相交流モータを持つ1つの電動アクチュエータで開閉し、各ラッチギャングも1つの電動アクチュエータで駆動される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p68-L_str" source="p68-B-ACT" target="p68-B-PLB">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MECH-06&lt;br&gt;扉駆動" id="p68-IF-MECH-06" link="docs/SSD-FD-MECH-ACT-001.html#IF-MECH-06" tooltip="IF-MECH-06：各ベント扉は、それぞれの電動アクチュエータで内側へ動かされる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p68-L_str" source="p68-B-ACT" target="p68-B-VNT">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MECH-07&lt;br&gt;接地信号" id="p68-IF-MECH-07" link="docs/SSD-FD-MECH-LDG-001.html#IF-MECH-07" tooltip="IF-MECH-07：各主脚の3つのセンサが主脚の接地を検知してWOWを設定し、前輪操向とブレーキの条件になる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p68-L_dat" source="p68-B-LDG" target="p68-B-DEC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MECH-08&lt;br&gt;脚展開" id="p68-IF-MECH-08" link="docs/SSD-FD-MECH-OPS-001.html#IF-MECH-08" tooltip="IF-MECH-08：脚の展開は、CDR（パネルF6）またはPLT（パネルF8）がLANDING GEAR ARMボタン、続いてDNボタンを押して始める。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p68-L_dat" source="p68-B-OPS" target="p68-B-LDG">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MECH-09&lt;br&gt;シュート" id="p68-IF-MECH-09" link="docs/SSD-FD-MECH-OPS-001.html#IF-MECH-09" tooltip="IF-MECH-09：ドラッグシュートは、機首下げの前にCDRかPLTの冗長な指令で手動で展開する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p68-L_dat" source="p68-B-OPS" target="p68-B-DEC">
            <mxGeometry relative="1" as="geometry" x="0.2222">
              <Array as="points">
                <mxPoint x="1040" y="470" />
                <mxPoint x="1210" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-MECH-10&lt;br&gt;ベント指令" id="p68-IF-MECH-10" link="docs/SSD-FD-MECH-OPS-001.html#IF-MECH-10" tooltip="IF-MECH-10：ベント扉は、マスタタイミングユニット・メジャーモードの移行・速度・DPSの項目入力で始まるGNCのソフトウェアのシーケンスで操作する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p68-L_dat" source="p68-B-OPS" target="p68-B-VNT">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-10&lt;br&gt;MCA指令" id="p68-IF-DPS-10" link="docs/SSD-FD-DPS-BUS-001.html#IF-DPS-10" tooltip="IF-DPS-10：GPC、DPSの項目入力または配線スイッチから出た機構の指令を、MDM経由でMCAへ送って電動アクチュエータの交流モータを入切する。各アクチュエータのモータは別々のMDMから指令されるため、1台のMDMを失ってもアクチュエータ全体は失われない。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p68-L_dat" source="p68-B-DPS68" target="p68-B-ACT">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-11&lt;br&gt;脚・制動・操舵" id="p68-IF-APU-11" link="docs/SSD-FD-APU-HYD-001.html#IF-APU-11" tooltip="IF-APU-11：油圧系1の圧力を前脚・主脚のアップロックのアクチュエータへ送って脚を展開させ、油圧系1・2（系3が予備）を主脚ブレーキへ、油圧系1・2を前輪操舵へ供給する。ブレーキ隔離弁1・2・3は、主脚の接地を感知した後のGPC指令で開く。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B3FA0;strokeWidth=2;fontColor=#7B3FA0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p68-L_hyd" source="p68-B-APU68" target="p68-B-DEC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-11&lt;br&gt;手動操作" id="p68-IF-EVA-11" link="docs/SSD-FD-EVA-EMG-001.html#IF-EVA-11" tooltip="IF-EVA-11：非常時EVAで、放熱器アクチュエータの切り離し、PLBD駆動系の切断・切り離しとウインチによる扉の閉鎖、隔壁・中心線ラッチ工具の取り付けを行う。EVAウインチは、ペイロードベイドアの駆動系が故障したときに乗員が扉を閉じるためのものである。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p68-L_str" source="p68-B-EVA68" target="p68-B-PLB">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;図示を省略したIF（文書・図5に記載）&lt;/b&gt;&lt;br&gt;なし（IF-MECH-01〜10 をすべて図示）&lt;br&gt;&lt;br&gt;他の図・段と同じ物理IFのため、その番号のまま描いたIF：IF-DPS-10（図48）・IF-APU-11（図56）・IF-EVA-11（図60）&lt;br&gt;&lt;br&gt;各ブロックの「関連文書」ボタンは、機能別関連文書一覧（SSD-MECH-REF-001）の該当節を開きます。" id="p68-v-31" link="data:page/id,p5-register" tooltip="図5のIF一覧へ">
          <mxCell style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#FAFBFC;strokeColor=#9AA3AE;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#3B4654;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1175" y="950" width="310" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="▲ 図2 オービタへ" id="p68-v-32" link="data:page/id,p2-orbiter" tooltip="クリックでページ移動">
          <mxCell style="rounded=1;arcSize=25;html=1;fillColor=#15202B;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1540" y="40" width="300" height="32" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="■ 図69 MECH 関連文書マトリクスへ" id="p68-v-33" link="data:page/id,p69-mech-docs" tooltip="クリックでページ移動">
          <mxCell style="rounded=1;arcSize=25;html=1;fillColor=#15202B;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
