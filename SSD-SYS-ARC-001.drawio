              <Array as="points">
                <mxPoint x="310" y="680" />
                <mxPoint x="410" y="680" />
                <mxPoint x="410" y="820" />
                <mxPoint x="1100" y="820" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="RCST-14" id="p137-v-32" link="docs/SSD-BEH-ORB-006.html#RCST-14" tooltip="RCST-14：前部マニホールドを閉（EI−3 分）、突入インタフェース">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.55;exitY=1.0;exitDx=0;exitDy=0;entryX=0.9;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p137-v-14" target="p137-v-15">
