            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ORB-18&lt;br&gt;SRB 指令（MDM×4）" id="p2-IF-ORB-18" link="docs/SSD-FD-DPS-001.html#IF-ORB-18" tooltip="IF-ORB-18：DPSには、SRB用のMDMが4台含まれる。 ATVCは、打上げ・第1段上昇中にSRBの推力方向も制御する。">
