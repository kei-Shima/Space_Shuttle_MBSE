        <UserObject label="IF-THC-01&lt;br&gt;熱交換器へ" id="p30-IF-THC-01" link="docs/SSD-FD-ARS-THC-TCV-001.html#IF-THC-01" tooltip="IF-THC-01：キャビン温度制御弁が迂回させなかった空気を、キャビン熱交換器へ流す。FULL COOLでは熱交換器への流量が最大、FULL HEATでは最小となる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="p30-L_flu" source="p30-B-TCV" target="p30-B-HX">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-02&lt;br&gt;冷却空気" id="p30-IF-THC-02" link="docs/SSD-FD-ARS-THC-HX-001.html#IF-THC-02" tooltip="IF-THC-02：熱交換器で冷やした空気を、下流の給気ダクトでバイパス空気と合流させる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p30-L_flu" source="p30-B-HX" target="p30-B-TCV">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-03&lt;br&gt;キャビン熱交換器" id="p30-IF-THC-03" link="docs/SSD-FD-ARS-THC-HX-001.html#IF-THC-03" tooltip="IF-THC-03：キャビン熱交換器で、キャビン空気が拾った熱をARS水冷却ループへ移す。水冷却ループの冷えた水は、液冷服熱交換器と飲料水チラーに続いてキャビン熱交換器を通る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.7857;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p30-L_thm" source="p30-B-HX" target="p30-B-WCL30">
            <mxGeometry relative="1" as="geometry" x="0.4375">
              <Array as="points">
                <mxPoint x="1400" y="590" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-04&lt;br&gt;凝縮水・空気" id="p30-IF-THC-04" link="docs/SSD-FD-ARS-THC-HX-001.html#IF-THC-04" tooltip="IF-THC-04：熱交換器のslurperに集まった凝縮水を、湿度分離器が空気とともに吸い出す。分離器の入口流量（空気と水）は37〜41 lb/hrである。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=1;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p30-L_flu" source="p30-B-HX" target="p30-B-SEP">
            <mxGeometry relative="1" as="geometry" x="-0.2507">
              <Array as="points">
                <mxPoint x="1210" y="530" />
                <mxPoint x="640" y="530" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-05&lt;br&gt;凝縮水" id="p30-IF-THC-05" link="docs/SSD-FD-ARS-THC-SEP-001.html#IF-THC-05" tooltip="IF-THC-05：分離した凝縮水を、分離器の共通出口から排出ラインを経て廃水タンクへ送る。ISS飛行では、軌道上で凝縮水をCWCへ切り替えて溜め、分離後に緊急クロスタイの廃水QDから機外へ捨てる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p30-L_flu" source="p30-B-SEP" target="p30-B-H2O30">
            <mxGeometry relative="1" as="geometry" x="0.1429">
              <Array as="points">
                <mxPoint x="410" y="770" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-06&lt;br&gt;除湿空気" id="p30-IF-THC-06" link="docs/SSD-FD-ARS-THC-SEP-001.html#IF-THC-06" tooltip="IF-THC-06：分離器で水を除いた空気を、37 lb/hrでECLSSベイへ戻す。SCOMは、分離器の空気を排気ダクトで乗員室へ戻すとする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.65;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="p30-L_flu" source="p30-B-SEP" target="p30-B-CAB30">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-07&lt;br&gt;給気" id="p30-IF-THC-07" link="docs/SSD-FD-ARS-THC-TCV-001.html#IF-THC-07" tooltip="IF-THC-07：給気ダクトで合流した空気を、CDR・PLTのコンソールと各所のダクト吹出口から乗員室へ吹き出す。1979年の飛行運用マニュアルは、吹出口をコンソール、ミッドデッキ、MS・PSのステーションの給気口とする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p30-L_flu" source="p30-B-TCV" target="p30-B-CAB30">
            <mxGeometry relative="1" as="geometry" x="-0.42">
              <Array as="points">
                <mxPoint x="810" y="230" />
                <mxPoint x="270" y="230" />
                <mxPoint x="270" y="650" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-08&lt;br&gt;出口温度計測点" id="p30-IF-THC-08" link="docs/SSD-FD-ARS-THC-HX-001.html#IF-THC-08" tooltip="IF-THC-08：キャビン熱交換器の下流に空気出口温度センサを置き、熱交換器を出た空気の温度を測る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="p30-L_flu" source="p30-B-HX" target="p30-B-MON">
            <mxGeometry relative="1" as="geometry" x="0.4412">
              <Array as="points">
                <mxPoint x="1250" y="600" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-09&lt;br&gt;回転数" id="p30-IF-THC-09" link="docs/SSD-FD-ARS-THC-SEP-001.html#IF-THC-09" tooltip="IF-THC-09：HUM SEP信号調整器が給電する回転数センサで、湿度分離器が正常に回っているかを検知する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p30-L_dat" source="p30-B-SEP" target="p30-B-MON">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-10&lt;br&gt;ダクト温度" id="p30-IF-THC-10" link="docs/SSD-FD-ARS-THC-MON-001.html#IF-THC-10" tooltip="IF-THC-10：有効なコントローラは、給気ダクトと還流ダクトの温度を検知して、乗員が選んだ温度に制御する。SCOMの系統図は、キャビン温度センサとダクト温度センサをキャビン温度コントローラにつないで示す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p30-L_dat" source="p30-B-MON" target="p30-B-TCV">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-11&lt;br&gt;HX出口温度" id="p30-IF-THC-11" link="docs/SSD-FD-ARS-THC-MON-001.html#IF-THC-11" tooltip="IF-THC-11：キャビン熱交換器下流の空気出口温度をパネルO1の兼用のAIR TEMP計器（CAB HX OUT）へ直接送り、SM SYS SUMM 1とSPEC 66 ENVIRONMENTにも表示する。この温度はパネルF7の黄色のAV BAY/CABIN AIR警報灯の入力で、145°Fを超えると点灯する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="p30-L_dat" source="p30-B-MON" target="p30-B-DPS30">
            <mxGeometry relative="1" as="geometry" x="-0.0526">
              <Array as="points">
                <mxPoint x="1040" y="760" />
                <mxPoint x="1560" y="760" />
                <mxPoint x="1560" y="740" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-12&lt;br&gt;分離器・室温" id="p30-IF-THC-12" link="docs/SSD-FD-ARS-THC-MON-001.html#IF-THC-12" tooltip="IF-THC-12：湿度分離器A・Bの運転状態（HUMID SEP）とキャビン温度（CABIN T）をSMへ送り、SPEC 66 ENVIRONMENTに表示する。運転中の分離器の回転数が下がると、SMの警報「S66 HUMID SEP A(B)」が出る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p30-L_dat" source="p30-B-MON" target="p30-B-DPS30">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-13&lt;br&gt;表示・警報" id="p30-IF-THC-13" link="docs/SSD-FD-ARS-THC-MON-001.html#IF-THC-13" tooltip="IF-THC-13：熱交換器出口温度・キャビン温度・分離器の運転状態の表示と警報を、キャビン大気制御の喪失判定（A17-102）と故障処置に使う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p30-L_dat" source="p30-B-MON" target="p30-B-OPS">
            <mxGeometry relative="1" as="geometry" x="0.2222">
              <Array as="points">
                <mxPoint x="810" y="470" />
                <mxPoint x="640" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-14&lt;br&gt;温度選択" id="p30-IF-THC-14" link="docs/SSD-FD-ARS-THC-OPS-001.html#IF-THC-14" tooltip="IF-THC-14：パネルL1のCABIN TEMP CNTLRスイッチで有効なコントローラを選び、CABIN TEMPロータリスイッチで温度を選ぶ。コントローラで弁を制御できない場合は、MD44Fで弁アームを4つの固定穴の一つにピン止めする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p30-L_dat" source="p30-B-OPS" target="p30-B-TCV">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-15&lt;br&gt;入切り" id="p30-IF-THC-15" link="docs/SSD-FD-ARS-THC-OPS-001.html#IF-THC-15" tooltip="IF-THC-15：パネルL1のHUMIDITY SEP A・Bスイッチ（ON–OFF）で、湿度分離器の電源を個別に入切りする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p30-L_dat" source="p30-B-OPS" target="p30-B-SEP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-16&lt;br&gt;AC2/AC1 φA" id="p30-IF-THC-16" link="docs/SSD-FD-ARS-THC-TCV-001.html#IF-THC-16" tooltip="IF-THC-16：キャビン温度コントローラ1にはAC2 φA（CABIN T CNTLR 1）、コントローラ2にはAC1 φA（CABIN CNTLR 2）の交流電力を、パネルL4の遮断器からパネルL1のスイッチを通して供給する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9706;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p30-L_pow" source="p30-B-EPS30" target="p30-B-TCV">
            <mxGeometry relative="1" as="geometry" x="-0.6">
              <Array as="points">
                <mxPoint x="1040" y="780" />
                <mxPoint x="1860" y="780" />
                <mxPoint x="1860" y="230" />
                <mxPoint x="1040" y="230" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-17&lt;br&gt;AC1/AC2電力" id="p30-IF-THC-17" link="docs/SSD-FD-ARS-THC-SEP-001.html#IF-THC-17" tooltip="IF-THC-17：湿度分離器AにはAC1、BにはAC2の三相交流電力を、パネルL4の各3個の遮断器からパネルL1のHUMIDITY SEPスイッチを通して供給する。訓練マニュアル表3-6も、AC1とAC2の三相電力を分離器A・Bのスイッチへ送る遮断器を示す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.3824;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p30-L_pow" source="p30-B-EPS30" target="p30-B-SEP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-18&lt;br&gt;AC3 φA" id="p30-IF-THC-18" link="docs/SSD-FD-ARS-THC-MON-001.html#IF-THC-18" tooltip="IF-THC-18：遮断器AC3 φA SIG CONDR HUM SEPを通じて、湿度分離器の信号調整器（回転数センサに給電）にAC3 φAの交流電力を供給する。熱交換器空気出口温度とキャビン温度のセンサは、コントローラ1と同じCABIN CNTLR 1の遮断器から給電される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.6324;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p30-L_pow" source="p30-B-EPS30" target="p30-B-MON">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-13&lt;br&gt;主流空気" id="p30-IF-CAC-13" link="docs/SSD-FD-CAC-DCT-001.html#IF-CAC-13" tooltip="IF-CAC-13：LiOHキャニスタへの分流を除いた主流を、キャビン温度制御弁とキャビン熱交換器（バイパスを含む）へ送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p30-L_flu" source="p30-B-CAC30" target="p30-B-TCV">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCRS-02&lt;br&gt;浄化空気" id="p30-IF-RCRS-02" link="docs/SSD-FD-ARS-RCRS-BED-001.html#IF-RCRS-02" tooltip="IF-RCRS-02：吸着中のベッドでCO2を除いた空気をARSの空気流へ戻し、キャビン熱交換器を通して乗員室へ送る。訓練マニュアル付録C.2.1は、戻す位置をキャビンファンのフィルタのすぐ上流（RCRSの吸込み位置とほぼ同じ所）とする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p30-L_flu" source="p30-B-RCRS30" target="p30-B-HX">
            <mxGeometry relative="1" as="geometry" x="-0.125">
              <Array as="points">
                <mxPoint x="1440" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CO2-05&lt;br&gt;ATCO分流" id="p30-IF-CO2-05" link="docs/SSD-FD-CO2-ATCO-001.html#IF-CO2-05" tooltip="IF-CO2-05：キャビン熱交換器を出た再生・調整済み空気の一部をATCOへ送り、COをCO2に変換する。ATCOを通った空気は調整済み空気とともに乗員室へ戻り、生じたCO2は循環してLiOHキャニスタで除去される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="p30-L_flu" source="p30-B-HX" target="p30-B-ATCO30">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;図示を省略したIF（文書・図5に記載）&lt;/b&gt;&lt;br&gt;なし（IF-THC-01〜18 をすべて図示）&lt;br&gt;&lt;br&gt;他の図と同じ物理IFのため、その番号のまま描いたIF：IF-CAC-13（図16）・IF-RCRS-02（図28）・IF-CO2-05（図14）&lt;br&gt;&lt;br&gt;各ブロックの「関連文書」ボタンは、機能別関連文書一覧（SSD-THC-REF-001）の該当節を開きます。" id="p30-v-34" link="data:page/id,p5-register" tooltip="図5のIF一覧へ">
