          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#A77B00;fontColor=#A77B00;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p22-B-RCRS22">
            <mxGeometry x="10" y="66" width="300" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="宇宙空間（船外）" id="p22-B-SPACE22" tooltip="真空ベントノズルの排気先" doc_no="—" abbr="SPACE" 分類="外部（地上・宇宙インフラ）">
          <mxCell style="swimlane;html=1;whiteSpace=wrap;startSize=30;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=1.5;fontColor=#15202B;fontStyle=1;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
            <mxGeometry x="1580" y="370" width="260" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p22-v-36" value="・真空ベントノズルの排気先" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p22-B-SPACE22">
          <mxGeometry x="0" y="30" width="260" height="64" as="geometry" />
        </mxCell>
        <UserObject label="IF-WCS-01&lt;br&gt;尿・空気" id="p22-IF-WCS-01" link="docs/SSD-FD-ECL-WCS-URN-001.html#IF-WCS-01" tooltip="IF-WCS-01：乗員の尿を、小便器のファンネルからキャビン空気の搬送気流（毎分10 ft³以上）とともに吸い込む。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.2812;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="p22-L_flu" source="p22-B-CAB22" target="p22-B-URN">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCS-02&lt;br&gt;糞便・空気" id="p22-IF-WCS-02" link="docs/SSD-FD-ECL-WCS-CMD-001.html#IF-WCS-02" tooltip="IF-WCS-02：糞便を、座面下の穴から毎分30 ft³で流れるキャビン空気とともに便器へ引き込む。使用前の便器の加圧も、バラスト弁と校正オリフィスを通したキャビン空気で行う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5469;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="p22-L_flu" source="p22-B-CAB22" target="p22-B-CMD">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCS-03&lt;br&gt;尿・空気" id="p22-IF-WCS-03" link="docs/SSD-FD-ECL-WCS-URN-001.html#IF-WCS-03" tooltip="IF-WCS-03：尿と空気の混合物（EVAを行う飛行ではEMU凝縮水を含む）を、ホースブロックで選んだ一方のファンセパレータへ送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p22-L_flu" source="p22-B-URN" target="p22-B-FSP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCS-04&lt;br&gt;便器空気" id="p22-IF-WCS-04" link="docs/SSD-FD-ECL-WCS-CMD-001.html#IF-WCS-04" tooltip="IF-WCS-04：便器の搬送空気は疎水性の多孔質ライナを通って自由な液体と細菌を除かれ、ファンセパレータへ引かれる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p22-L_flu" source="p22-B-CMD" target="p22-B-FSP">
            <mxGeometry relative="1" as="geometry" x="0.0645">
              <Array as="points">
                <mxPoint x="640" y="490" />
                <mxPoint x="850" y="490" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCS-05&lt;br&gt;真空乾燥" id="p22-IF-WCS-05" link="docs/SSD-FD-ECL-WCS-CMD-001.html#IF-WCS-05" tooltip="IF-WCS-05：WCSを使わないときは、便器（廃棄物収集器）をWCSの真空弁を通して真空ベント系にさらし、固形廃棄物を乾燥させる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.8966;entryDx=0;entryDy=0;" edge="1" parent="p22-L_flu" source="p22-B-CMD" target="p22-B-VAC">
            <mxGeometry relative="1" as="geometry" x="0.0357">
              <Array as="points">
                <mxPoint x="640" y="770" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCS-06&lt;br&gt;浄化空気" id="p22-IF-WCS-06" link="docs/SSD-FD-ECL-WCS-FSP-001.html#IF-WCS-06" tooltip="IF-WCS-06：ファンセパレータから出た空気を臭気・細菌フィルタに通し、キャビン空気と混ぜて乗員室へ戻す。フィルタを通って乗員室へ戻る空気は毎分38 ft³である。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3438;entryDx=0;entryDy=0;" edge="1" parent="p22-L_flu" source="p22-B-FSP" target="p22-B-CAB22">
            <mxGeometry relative="1" as="geometry" x="0.0345">
              <Array as="points">
                <mxPoint x="810" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCS-07&lt;br&gt;ごみ区画排気" id="p22-IF-WCS-07" link="docs/SSD-FD-ECL-WCS-VAC-001.html#IF-WCS-07" tooltip="IF-WCS-07：ウェットトラッシュ区画の空気を、真空ベント管から約3 lb/dayで船外へ排気する。少量のキャビン空気が常にWCSのウェットトラッシュ区画を通って船外へ抜け、WCSの臭気を抑える。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.875;exitDx=0;exitDy=0;entryX=0;entryY=0.9655;entryDx=0;entryDy=0;" edge="1" parent="p22-L_flu" source="p22-B-CAB22" target="p22-B-VAC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCS-08&lt;br&gt;非常時接続" id="p22-IF-WCS-08" link="docs/SSD-FD-ECL-WCS-VAC-001.html#IF-WCS-08" tooltip="IF-WCS-08：真空ベント系が故障したときは、真空ベントQDと非常用クロスタイの廃水QDを移送ホースでつなぎ、廃水ダンプ管から排気する。廃水タンクの弁が閉で故障した場合などは、同じQDを使ってARSの廃水（湿度分離器の凝縮水）を真空ベント管から船外へ捨てる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.1379;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="p22-L_flu" source="p22-B-VAC" target="p22-B-DMP22">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCS-09&lt;br&gt;船外排気" id="p22-IF-WCS-09" link="docs/SSD-FD-ECL-WCS-VAC-001.html#IF-WCS-09" tooltip="IF-WCS-09：真空ベント管の気体を、ヒータで凍結を防いだ管とノズルから船外へ排出する。隔離弁が閉でも、弁板のオリフィスから3.0±0.25 lb/hrが流れる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.3448;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="p22-L_flu" source="p22-B-VAC" target="p22-B-SPACE22">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCS-10&lt;br&gt;AC/DC電力" id="p22-IF-WCS-10" link="docs/SSD-FD-ECL-WCS-FSP-001.html#IF-WCS-10" tooltip="IF-WCS-10：ファンセパレータ1・2に、パネルMA73CのAC1・AC2 WCS FAN SEP遮断器（計6個）から三相交流を、パネルML86BのMNA・MNB WCS CNTLR遮断器から制御用の直流を供給する。FAN SEP選択スイッチが1のとき主母線Aの直流がファンセパレータ1に、2のとき主母線Bの直流がファンセパレータ2に供給される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=1;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p22-L_pow" source="p22-B-EPS22" target="p22-B-FSP">
            <mxGeometry relative="1" as="geometry" x="0.25">
              <Array as="points">
                <mxPoint x="1210" y="230" />
                <mxPoint x="1040" y="230" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCS-11&lt;br&gt;弁・ヒータ電力" id="p22-IF-WCS-11" link="docs/SSD-FD-ECL-WCS-VAC-001.html#IF-WCS-11" tooltip="IF-WCS-11：真空ベント隔離弁にはMNAまたはMNBの直流を、真空ベント管のA・BヒータにはパネルML86BのH2O LINE HTR A・B遮断器から電力を供給する。MNA H2O LINE HTR A遮断器は、給水・廃水のダンプ管と真空ベント管のヒータに主母線Aの電力を供給する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p22-L_pow" source="p22-B-EPS22" target="p22-B-VAC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCS-12&lt;br&gt;温度・圧力" id="p22-IF-WCS-12" link="docs/SSD-FD-ECL-WCS-VAC-001.html#IF-WCS-12" tooltip="IF-WCS-12：真空ベントノズル温度（VAC VT NOZ T）をSMのDISP 66 ENVIRONMENTに表示する。廃棄物収集器の圧力はMCCが確認し、非常時の真空ベント運用では1 psia未満が5分続けば便器の使用を再開できる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p22-L_dat" source="p22-B-VAC" target="p22-B-DPS22">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCS-13&lt;br&gt;選択・起動" id="p22-IF-WCS-13" link="docs/SSD-FD-ECL-WCS-OPS-001.html#IF-WCS-13" tooltip="IF-WCS-13：FAN SEP選択スイッチで使うファンセパレータを選び、MODEスイッチがAUTOのときは小便器のホースをクレードルから外すと選んだ分離器が起動する。リミットスイッチが故障したときは、バイパススイッチで対応するリレーに直流を与えて分離器に交流を供給する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p22-L_dat" source="p22-B-OPS" target="p22-B-FSP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCS-14&lt;br&gt;モード連動" id="p22-IF-WCS-14" link="docs/SSD-FD-ECL-WCS-OPS-001.html#IF-WCS-14" tooltip="IF-WCS-14：MODEスイッチをOFFから動かすまでCOMMODE CONTROLハンドルを操作できないよう、機械的に連動させる。SCOMでは、MODEスイッチをCOMMODE/MANUAL/EMUにしないとハンドルを前へ押せない。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p22-L_dat" source="p22-B-OPS" target="p22-B-CMD">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCS-15&lt;br&gt;真空弁操作" id="p22-IF-WCS-15" link="docs/SSD-FD-ECL-WCS-OPS-001.html#IF-WCS-15" tooltip="IF-WCS-15：WCSのVACUUM VALVEで便器への真空ベント管を開閉し、軌道上は通常開き、打上げ・再突入とWCSの空気漏れなどの非常時に閉じる。真空ベント隔離弁はパネルML31CのWASTE H2O VACUUM VENT ISOL VLV CONTROLスイッチで開閉する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.7241;entryDx=0;entryDy=0;" edge="1" parent="p22-L_dat" source="p22-B-OPS" target="p22-B-VAC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ALS-04&lt;br&gt;EMU凝縮水" id="p22-IF-ALS-04" link="docs/SSD-FD-ECL-ALS-SCU-001.html#IF-ALS-04" tooltip="IF-ALS-04：EVAを行う飛行では、EMUの凝縮水をエアロックから受けてWCSで処理し、廃水タンクへ送る。EMUの排水はエアロックの廃水弁から排出され、WCSはEMU排水モードで受ける。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p22-L_flu" source="p22-B-ALS22" target="p22-B-URN">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-H2O-07&lt;br&gt;廃水" id="p22-IF-H2O-07" link="docs/SSD-FD-ECL-H2O-WST-001.html#IF-H2O-07" tooltip="IF-H2O-07：WCSで処理した尿と、エアロックからのEMU凝縮水を廃水タンクへ受け入れる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p22-L_flu" source="p22-B-FSP" target="p22-B-WST22">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-H2O-02&lt;br&gt;H2" id="p22-IF-H2O-02" link="docs/SSD-FD-ECL-H2O-FCW-001.html#IF-H2O-02" tooltip="IF-H2O-02：水素分離器の銀パラジウム管を透過した水素は、真空ベント配管を通って船外へ排出される。運用飛行規則は、燃料電池の生成水から抽出した水素（約0.0000975 lb/hr）を船外へ排出することを真空ベントの主な機能に挙げる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.5172;entryDx=0;entryDy=0;" edge="1" parent="p22-L_flu" source="p22-B-FCW22" target="p22-B-VAC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-PCS-09&lt;br&gt;N2逃し" id="p22-IF-PCS-09" link="docs/SSD-FD-ECL-PCS-N2S-001.html#IF-PCS-09" tooltip="IF-PCS-09：200 psigのN2レギュレータの逃し弁は275 psigで開いて245 psigで閉じ、レギュレータの故障による過圧から窒素系を守るため、真空ベント管から船外へ逃がす。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.931;entryDx=0;entryDy=0;" edge="1" parent="p22-L_flu" source="p22-B-PCS22" target="p22-B-VAC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCRS-03&lt;br&gt;RCRS排気" id="p22-IF-RCRS-03" link="docs/SSD-FD-ARS-RCRS-BED-001.html#IF-RCRS-03" tooltip="IF-RCRS-03：再生（脱着）中のベッドを機体の既存の真空ベント管へ開いて排気し、脱着したCO2を船外へ捨てる。標準構成では、パネルML31Cの真空ベント隔離弁を開にしておく（MAL 6.8a）。">
