        </UserObject>
        <UserObject label="IF-ET-04&lt;br&gt;荷重分配" id="p72-IF-ET-04" link="docs/SSD-FD-ET-ITK-001.html#IF-ET-04" tooltip="IF-ET-04：インタタンクの前部のSRB/ET結合の推力ビームと金具は、SRBの荷重をLO2・LH2タンクへ分配する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p72-L_str" source="p72-B-ITK" target="p72-B-LH2">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ET-05&lt;br&gt;断熱" id="p72-IF-ET-05" link="docs/SSD-FD-ET-TPS-001.html#IF-ET-05" tooltip="IF-ET-05：LH2タンクの取付部には、空気にさらされる金属の液化を防ぎ、LH2への熱の流れを減らす断熱材を使う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p72-L_thm" source="p72-B-TPS" target="p72-B-LH2">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ET-06&lt;br&gt;板の切離し" id="p72-IF-ET-06" link="docs/SSD-FD-ET-SEP-001.html#IF-ET-06" tooltip="IF-ET-06：オービタのGPCがETの分離を指令すると、アンビリカル板を締結するボルトが火工品で切られる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p72-L_str" source="p72-B-SEP" target="p72-B-UMB">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ET-07&lt;br&gt;タンブル" id="p72-IF-ET-07" link="docs/SSD-FD-ET-SEP-001.html#IF-ET-07" tooltip="IF-ET-07：タンブル系は分離の直前に作動し、LO2タンク前部の2 inの弁を開いて残りのガスを噴き出し、ETを回転させる推力とする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=1;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p72-L_flu" source="p72-B-SEP" target="p72-B-LOX">
            <mxGeometry relative="1" as="geometry" x="-0.3738">
              <Array as="points">
                <mxPoint x="1210" y="470" />
                <mxPoint x="640" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-EPS-11&lt;br&gt;28 VDC配電" id="p72-IF-EPS-11" link="docs/SSD-FD-EPS-DC-001.html#IF-EPS-11" tooltip="IF-EPS-11：EPDCは、28 V直流電力をオービタ各系、SRB、外部タンク、ペイロードへ制御・分配する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0.1071;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p72-L_pow" source="p72-B-EPS72" target="p72-B-UMB">
            <mxGeometry relative="1" as="geometry" x="0.25">
              <Array as="points">
                <mxPoint x="640" y="230" />
                <mxPoint x="810" y="230" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-01&lt;br&gt;LO2・LH2" id="p72-IF-MPS-01" link="docs/SSD-FD-MPS-PMS-001.html#IF-MPS-01" tooltip="IF-MPS-01：LO2・LH2は、外部タンクから17インチのET/オービタ切離し弁を通ってオービタの供給配管マニホールドへ流れる。打上げ前の充填では、推進薬はマニホールドから供給配管アンビリカル切離し部を通ってETのタンクへ入る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p72-L_flu" source="p72-B-UMB" target="p72-B-MPS72">
            <mxGeometry relative="1" as="geometry" x="-0.2" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-02&lt;br&gt;加圧ガス" id="p72-IF-MPS-02" link="docs/SSD-FD-MPS-PMS-001.html#IF-MPS-02" tooltip="IF-MPS-02：各エンジンからのGO2・GH2を2本のET加圧マニホールドで集めて外部タンクへ送り、運転中の推進薬タンクの圧力を保つ。GH2は各SSMEの加圧系統から2インチの加圧ラインを通ってETのLH2タンクのアレージへ送られる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.3571;exitY=1;exitDx=0;exitDy=0;entryX=0.3571;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p72-L_flu" source="p72-B-MPS72" target="p72-B-UMB">
            <mxGeometry relative="1" as="geometry" x="-0.6" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-09&lt;br&gt;ET分離" id="p72-IF-DPS-09" link="docs/SSD-FD-DPS-ASC-001.html#IF-DPS-09" tooltip="IF-DPS-09：MECは、外部タンクをオービタから切り離す火工品の起爆を開始する。オービタのGPCが外部タンクの分離を指令すると、後部アンビリカル板を結合するボルトが火工品で切断される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p72-L_dat" source="p72-B-DPS72" target="p72-B-SEP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-STR-01&lt;br&gt;前部結合" id="p72-IF-STR-01" link="docs/SSD-FD-STR-FWD-001.html#IF-STR-01" tooltip="IF-STR-01：前部のオービタ/ET結合金具は、Xo=378隔壁と前脚格納部の後方の外板構造にある。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.1071;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p72-L_str" source="p72-B-STR72" target="p72-B-LH2">
