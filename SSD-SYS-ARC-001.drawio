          </mxCell>
        </UserObject>
        <UserObject label="MPSS-10&lt;br&gt;&lt;span style='font-weight:normal'&gt;マニホールド過圧の処置&lt;/span&gt;" id="p138-v-14" link="docs/SSD-BEH-ORB-006.html#MPSS-10" tooltip="MPSS-10 マニホールド過圧の処置">
          <mxCell style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FDE2E2;strokeColor=#C62828;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="730" y="700" width="200" height="80" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="MPSS-11&lt;br&gt;&lt;span style='font-weight:normal'&gt;突入の He パージ・マニホールド加圧&lt;/span&gt;" id="p138-v-15" link="docs/SSD-BEH-ORB-006.html#MPSS-11" tooltip="MPSS-11 突入の He パージ・マニホールド加圧">
          <mxCell style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#DCE8F6;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1030" y="700" width="200" height="80" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="MPSS-12&lt;br&gt;&lt;span style='font-weight:normal'&gt;He 隔離（調圧器の高圧故障）&lt;/span&gt;" id="p138-v-16" link="docs/SSD-BEH-ORB-006.html#MPSS-12" tooltip="MPSS-12 He 隔離（調圧器の高圧故障）">
          <mxCell style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FDE2E2;strokeColor=#C62828;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="130" y="930" width="200" height="80" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p138-v-17" value="" style="ellipse;html=1;fillColor=#15202B;strokeColor=#15202B;" vertex="1" parent="1">
          <mxGeometry x="60" y="265.0" width="30" height="30" as="geometry" />
        </mxCell>
        <UserObject label="" id="p138-v-18" link="" tooltip="MpsStates：開始">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138-v-17" target="p138-v-6">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="MPST-01" id="p138-v-19" link="docs/SSD-BEH-ORB-006.html#MPST-01" tooltip="MPST-01：GPC がエンジン始動指令（T−6.6 秒）［T−31 秒に機上の打上げシーケンスが有効］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138-v-6" target="p138-v-7">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="MPST-02" id="p138-v-20" link="docs/SSD-BEH-ORB-006.html#MPST-02" tooltip="MPST-02：T−0 に SRB 点火・リフトオフ［3基とも T−3 秒までに推力 90%］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.15;exitY=1.0;exitDx=0;exitDy=0;entryX=0.9;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138-v-7" target="p138-v-8">
            <mxGeometry relative="1" as="geometry" x="0.3667">
              <Array as="points">
                <mxPoint x="460" y="450" />
                <mxPoint x="310" y="450" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="MPST-03" id="p138-v-21" link="docs/SSD-BEH-ORB-006.html#MPST-03" tooltip="MPST-03：全 SSME を停止（パッドアボート）［1基以上が T−3 秒に 90% 未達］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.15;exitY=0.0;exitDx=0;exitDy=0;entryX=0.9;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138-v-7" target="p138-v-6">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="460" y="220" />
                <mxPoint x="310" y="220" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="MPST-04" id="p138-v-22" link="docs/SSD-BEH-ORB-006.html#MPST-04" tooltip="MPST-04：MPS 灯（He タンク圧 1,150 psia 未満）・MPS HE メッセージ → He 漏れの隔離手順［隔離の試みでエンジンが停止しない］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138-v-8" target="p138-v-9">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="MPST-05" id="p138-v-23" link="docs/SSD-BEH-ORB-006.html#MPST-05" tooltip="MPST-05：漏れを隔離（故障した弁を閉じたまま運転を継続）">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.15;exitY=1.0;exitDx=0;exitDy=0;entryX=0.9;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138-v-9" target="p138-v-8">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="460" y="570" />
                <mxPoint x="310" y="570" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="MPST-06" id="p138-v-24" link="docs/SSD-BEH-ORB-006.html#MPST-06" tooltip="MPST-06：He の枯渇による停止、または押しボタンによる停止［漏れを隔離できない・隔離の時間がない］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138-v-9" target="p138-v-10">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="MPST-07" id="p138-v-25" link="docs/SSD-BEH-ORB-006.html#MPST-07" tooltip="MPST-07：制御器がレッドライン違反で自動停止（SSME FAIL）［リミットが有効］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.7;exitY=1.0;exitDx=0;exitDy=0;entryX=0.15;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138-v-8" target="p138-v-10">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="270" y="590" />
                <mxPoint x="760" y="590" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="MPST-08" id="p138-v-26" link="docs/SSD-BEH-ORB-006.html#MPST-08" tooltip="MPST-08：推力固着・指令経路故障の手動停止（AC/PB 停止）［MECO の約 30 秒前］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.35;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138-v-8" target="p138-v-10">
            <mxGeometry relative="1" as="geometry" x="-0.3304">
              <Array as="points">
                <mxPoint x="230" y="610" />
                <mxPoint x="800" y="610" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="MPST-09" id="p138-v-27" link="docs/SSD-BEH-ORB-006.html#MPST-09" tooltip="MPST-09：MECO（所定の速度、または低液位カットオフ）">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.375;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138-v-5" target="p138-v-11">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="MPST-10" id="p138-v-28" link="docs/SSD-BEH-ORB-006.html#MPST-10" tooltip="MPST-10：MPS ダンプの開始（MECO+2 分の自動、手動 START、LH2 マニホールド 60 psi 超で前倒し）［RTLS は MM 602、TAL は MM 304 で開始］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.15;exitY=1.0;exitDx=0;exitDy=0;entryX=0.9;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138-v-11" target="p138-v-12">
            <mxGeometry relative="1" as="geometry" x="0.1222">
              <Array as="points">
                <mxPoint x="1060" y="680" />
                <mxPoint x="310" y="680" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="MPST-11" id="p138-v-29" link="docs/SSD-BEH-ORB-006.html#MPST-11" tooltip="MPST-11：ダンプ終了、エンジン電源 OFF・He 隔離、15 分後に真空不活性化">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138-v-12" target="p138-v-13">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="MPST-12" id="p138-v-30" link="docs/SSD-BEH-ORB-006.html#MPST-12" tooltip="MPST-12：MPS 灯（LH2 マニホールド 65 psia 超・LO2 249 psia 超）→ 充填排出弁を開いて圧を逃がす［真の高圧（センサ故障でない）］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138-v-13" target="p138-v-14">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="MPST-13" id="p138-v-31" link="docs/SSD-BEH-ORB-006.html#MPST-13" tooltip="MPST-13：不活性化の完了で外側充填排出弁を閉じる">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.15;exitY=1.0;exitDx=0;exitDy=0;entryX=0.9;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138-v-14" target="p138-v-13">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="760" y="800" />
                <mxPoint x="610" y="800" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="MPST-14" id="p138-v-32" link="docs/SSD-BEH-ORB-006.html#MPST-14" tooltip="MPST-14：MM 303 への移行で He 系を突入構成へ［離脱準備で A 調圧器の C/W を再び有効］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.7;exitY=1.0;exitDx=0;exitDy=0;entryX=0.15;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138-v-13" target="p138-v-15">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="570" y="820" />
                <mxPoint x="1060" y="820" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="MPST-15" id="p138-v-33" link="docs/SSD-BEH-ORB-006.html#MPST-15" tooltip="MPST-15：MPS 灯（He 調圧器圧 810 psia 超）→ 該当する He 隔離弁を閉じる［ベントドア閉なら直ちに、開なら時間のあるとき］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.35;exitY=1.0;exitDx=0;exitDy=0;entryX=1.0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="p138-v-15" target="p138-v-16">
            <mxGeometry relative="1" as="geometry" x="0.1809">
              <Array as="points">
                <mxPoint x="1100" y="950" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <mxCell id="p138-v-34" value="&lt;b style='font-size:12px'&gt;遷移（トリガ［ガード］）&lt;/b&gt;&lt;table style='border-collapse:collapse;width:100%;font-size:10px;margin-top:4px;'&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;MPST-01&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;MPSS-01→MPSS-02&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;GPC がエンジン始動指令（T−6.6 秒）［T−31 秒に機上の打上げシーケンスが有効］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;MPST-02&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;MPSS-02→MPSS-04&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;T−0 に SRB 点火・リフトオフ［3基とも T−3 秒までに推力 90%］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;MPST-03&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;MPSS-02→MPSS-01&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;全 SSME を停止（パッドアボート）［1基以上が T−3 秒に 90% 未達］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;MPST-04&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;MPSS-04→MPSS-05&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;MPS 灯（He タンク圧 1,150 psia 未満）・MPS HE メッセージ → He 漏れの隔離手順［隔離の試みでエンジンが停止しない］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;MPST-05&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;MPSS-05→MPSS-04&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;漏れを隔離（故障した弁を閉じたまま運転を継続）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;MPST-06&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;MPSS-05→MPSS-06&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;He の枯渇による停止、または押しボタンによる停止［漏れを隔離できない・隔離の時間がない］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;MPST-07&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;MPSS-04→MPSS-06&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;制御器がレッドライン違反で自動停止（SSME FAIL）［リミットが有効］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;MPST-08&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;MPSS-04→MPSS-06&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;推力固着・指令経路故障の手動停止（AC/PB 停止）［MECO の約 30 秒前］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;MPST-09&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;MPSS-03→MPSS-07&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;MECO（所定の速度、または低液位カットオフ）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;MPST-10&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;MPSS-07→MPSS-08&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;MPS ダンプの開始（MECO+2 分の自動、手動 START、LH2 マニホールド 60 psi 超で前倒し）［RTLS は MM 602、TAL は MM 304 で開始］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;MPST-11&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;MPSS-08→MPSS-09&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;ダンプ終了、エンジン電源 OFF・He 隔離、15 分後に真空不活性化&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;MPST-12&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;MPSS-09→MPSS-10&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;MPS 灯（LH2 マニホールド 65 psia 超・LO2 249 psia 超）→ 充填排出弁を開いて圧を逃がす［真の高圧（センサ故障でない）］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;MPST-13&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;MPSS-10→MPSS-09&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;不活性化の完了で外側充填排出弁を閉じる&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;MPST-14&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;MPSS-09→MPSS-11&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;MM 303 への移行で He 系を突入構成へ［離脱準備で A 調圧器の C/W を再び有効］&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;&lt;b&gt;MPST-15&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;white-space:nowrap;'&gt;MPSS-11→MPSS-12&lt;/td&gt;&lt;td style='padding:1px 4px;border-bottom:1px solid #D5DAE1;'&gt;MPS 灯（He 調圧器圧 810 psia 超）→ 該当する He 隔離弁を閉じる［ベントドア閉なら直ちに、開なら時間のあるとき］&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1370" y="130" width="600" height="409" as="geometry" />
        </mxCell>
        <UserObject label="▶ SSD-FD-MPS-001（主推進系（MPS））" id="p138-v-35" link="docs/SSD-FD-MPS-001.html" tooltip="SSD-FD-MPS-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F5FAD;fontColor=#1F5FAD;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1">
