        <UserObject label="▶ 機能説明書　SSD-FD-EPS-001" id="p48-v-47" link="docs/SSD-FD-EPS-001.html" tooltip="クリックで SSD-FD-EPS-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#A77B00;fontColor=#A77B00;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p48-B-EPS48">
            <mxGeometry x="10" y="66" width="260" height="26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-01&lt;br&gt;BCE・データバス" id="p48-IF-DPS-01" link="docs/SSD-FD-DPS-GPC-001.html#IF-DPS-01" tooltip="IF-DPS-01：各GPCのIOPはバス制御素子（BCE）で24本のデータバスにつながり、割り当てられたバスで機体各系へ指令を送り、応答データを受信・検証する。上昇・再突入では冗長セットの各GPCが割り当てられたFCストリングの指令元となり、他のGNC GPCはそのストリングを聴取する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0.1071;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-GPC" target="p48-B-BUS">
            <mxGeometry relative="1" as="geometry" x="0.2222">
              <Array as="points">
                <mxPoint x="1040" y="530" />
                <mxPoint x="1210" y="530" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-02&lt;br&gt;28 VDC" id="p48-IF-DPS-02" link="docs/SSD-FD-DPS-GPC-001.html#IF-DPS-02" tooltip="IF-DPS-02：各GPCには、パネルO6の電源スイッチでESS 1BC・2CA・3ABの電力により働くRPCを通じて、MN A・B・Cの3つの主母線から直流電力を供給する。1台の消費電力は560 Wで、主母線または必須母線を2つ失ってもGPCは正常に動作する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=1;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p48-L_pow" source="p48-B-EPS48" target="p48-B-GPC">
            <mxGeometry relative="1" as="geometry" x="0.25">
              <Array as="points">
                <mxPoint x="1210" y="230" />
                <mxPoint x="1040" y="230" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-03&lt;br&gt;GNC機器I/O" id="p48-IF-DPS-03" link="docs/SSD-FD-DPS-BUS-001.html#IF-DPS-03" tooltip="IF-DPS-03：各MDMは指令を割り当てられたGPCから受け、配線されたGNC機器から要求されたデータを取得してGPCへ送る。同種のGNC機器は複数台が別々のMDMと飛行重要バスに配線され、冗長な機器は別々のストリングにある。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.8182;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-BUS" target="p48-B-GNC48">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-04&lt;br&gt;BFS ENGAGE" id="p48-IF-DPS-04" link="docs/SSD-FD-DPS-FSW-001.html#IF-DPS-04" tooltip="IF-DPS-04：CDRとPLTのRHCにあるBFS ENGAGE押しボタンの信号を予備飛行制御器（BFC）へ送り、BFCがエンゲージの論理を処理してBFSに機体の制御を移す。誤ってエンゲージしないよう押しボタンを押すには約8 lbの力を要し、軌道上ではBFSのOUTPUTスイッチの再構成で実質的に無効にする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.4545;exitDx=0;exitDy=0;entryX=0.7857;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-GNC48" target="p48-B-FSW">
            <mxGeometry relative="1" as="geometry" x="-0.7222">
              <Array as="points">
                <mxPoint x="1480" y="630" />
                <mxPoint x="1480" y="520" />
                <mxPoint x="1400" y="520" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-05&lt;br&gt;SSME指令" id="p48-IF-DPS-05" link="docs/SSD-FD-DPS-ASC-001.html#IF-DPS-05" tooltip="IF-DPS-05：EIUは冗長セットのGPCから受けたエンジン指令を検証し、制御器インタフェース組立（CIA）を通じて担当するSSMEの制御器へ送る。エンジン制御器は全エンジンデータを車両データ表にまとめてEIUへ送り、EIUはGPCが要求するまで主・副のデータをバッファに保持する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-ASC" target="p48-B-MPS48">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-06&lt;br&gt;LDB" id="p48-IF-DPS-06" link="docs/SSD-FD-DPS-ASC-001.html#IF-DPS-06" tooltip="IF-DPS-06：2本の打上げデータバスは5台のGPCをGSE・打上げ処理システムとオービタのLF1・LM1・LA1 MDMに結び、主に地上点検と打上げ段階に使う。GSE・打上げ処理システムとのインタフェースには2台のデータバス絶縁増幅器を使う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0;exitY=0.9;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-ASC" target="p48-B-LPS48">
            <mxGeometry relative="1" as="geometry" x="-0.3913">
              <Array as="points">
                <mxPoint x="1040" y="1030" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-07&lt;br&gt;SRB MDM" id="p48-IF-DPS-07" link="docs/SSD-FD-DPS-ASC-001.html#IF-DPS-07" tooltip="IF-DPS-07：打上げデータバスで5台のGPCを左右のSRBにある4台のMDM（LL1・LL2・LR1・LR2）に結ぶ。SRB MDMはSRB内で受動のコールドプレートで冷やされ、オービタの主母線につながるSRBバスA・Bから給電される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-ASC" target="p48-B-SRB48">
            <mxGeometry relative="1" as="geometry" x="-0.194">
              <Array as="points">
                <mxPoint x="640" y="990" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-08&lt;br&gt;点火・分離" id="p48-IF-DPS-08" link="docs/SSD-FD-DPS-ASC-001.html#IF-DPS-08" tooltip="IF-DPS-08：固体ロケットモータの点火指令を、GPCからMECを通じて各SRBのS&amp;A装置のNSI起爆器へ送る。SRB分離シーケンスがオービタから出す分離指令で、各ボルトのNSI圧力カートリッジを起爆し、ブースタ分離モータに点火する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.7857;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-ASC" target="p48-B-SRB48">
            <mxGeometry relative="1" as="geometry" x="-0.2267">
              <Array as="points">
                <mxPoint x="600" y="950" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-09&lt;br&gt;ET分離" id="p48-IF-DPS-09" link="docs/SSD-FD-DPS-ASC-001.html#IF-DPS-09" tooltip="IF-DPS-09：MECは、外部タンクをオービタから切り離す火工品の起爆を開始する。オービタのGPCが外部タンクの分離を指令すると、後部アンビリカル板を結合するボルトが火工品で切断される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-ASC" target="p48-B-ET48">
            <mxGeometry relative="1" as="geometry" x="-0.3851">
              <Array as="points">
                <mxPoint x="270" y="900" />
                <mxPoint x="270" y="350" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-10&lt;br&gt;MCA指令" id="p48-IF-DPS-10" link="docs/SSD-FD-DPS-BUS-001.html#IF-DPS-10" tooltip="IF-DPS-10：GPC、DPSの項目入力または配線スイッチから出た機構の指令を、MDM経由でMCAへ送って電動アクチュエータの交流モータを入切する。各アクチュエータのモータは別々のMDMから指令されるため、1台のMDMを失ってもアクチュエータ全体は失われない。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.6786;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-BUS" target="p48-B-MECH48">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="1370" y="830" />
                <mxPoint x="1560" y="830" />
                <mxPoint x="1560" y="890" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-11&lt;br&gt;C&amp;amp;W入力" id="p48-IF-DPS-11" link="docs/SSD-FD-DPS-BUS-001.html#IF-DPS-11" tooltip="IF-DPS-11：主C&amp;Wの120入力のうち、5入力はGPCの入出力プロセッサから、15入力はMDMから受け、98入力はトランスデューサから直接受ける。一部の入力は、GPCから飛行前方（FF）MDMを経由して主C&amp;Wに入る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.8182;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-BUS" target="p48-B-CW48">
            <mxGeometry relative="1" as="geometry" x="0.0667">
              <Array as="points">
                <mxPoint x="1440" y="540" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-12&lt;br&gt;予備C&amp;amp;W・警報" id="p48-IF-DPS-12" link="docs/SSD-FD-DPS-FSW-001.html#IF-DPS-12" tooltip="IF-DPS-12：GPCはMDMを通じた12の離散入力でC&amp;Wのマスタアラームの論理回路を使い、6つで予備C&amp;W灯とC&amp;W音（クラス2）を、6つでSMアラート音（クラス3）を作動させる。FDAソフトウェアが限界外を検出すると、DPS表示に故障メッセージを出し、前方またはペイロードMDM経由でC&amp;W系A・Bに信号を送ってMASTER ALARM灯・予備C&amp;W灯・警報音を作動させる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.4545;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-FSW" target="p48-B-CW48">
            <mxGeometry relative="1" as="geometry" x="0.2632">
              <Array as="points">
                <mxPoint x="1440" y="500" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-13&lt;br&gt;RMS（MCIU）" id="p48-IF-DPS-13" link="docs/SSD-FD-DPS-FSW-001.html#IF-DPS-13" tooltip="IF-DPS-13：RMSのMCIUは、SM GPC、表示・操作器、RMSの間の情報のやり取りを取り扱って評価する。打上げデータバス1は、軌道上でSM GPCがRMSの制御器とのインタフェースに使う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-FSW" target="p48-B-PLS48">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-14&lt;br&gt;FC5〜8" id="p48-IF-DPS-14" link="docs/SSD-FD-DPS-ASC-001.html#IF-DPS-14" tooltip="IF-DPS-14：FC5〜8は、GPCを同じ4台のFF MDM・4台のFA MDMと、2台のMEC・3台のEIUに結ぶ。各データバスは各EIUの1つのMIAにつながり、公称の上昇構成ではGPC 1〜4がそれぞれFC5〜8に出力する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-BUS" target="p48-B-ASC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-15&lt;br&gt;IPL・OPSロード" id="p48-IF-DPS-15" link="docs/SSD-FD-DPS-FSW-001.html#IF-DPS-15" tooltip="IF-DPS-15：IPL後のGPCにはシステムソフトウェアだけがあり、応用ソフトウェアはOPS遷移の際にMMUからロードする。各MMUは1本の大容量記憶データバスにだけつながり、そのバスは5台のGPCすべてにつながる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-FSW" target="p48-B-GPC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-16&lt;br&gt;GMT/MET" id="p48-IF-DPS-16" link="docs/SSD-FD-DPS-MTU-001.html#IF-DPS-16" tooltip="IF-DPS-16：MTUは累算器を通じて、要求に応じてシリアルデジタルの時刻データ（GMT/MET）をGPCへ出す。GPCは毎秒、累算器の時刻を自身の内部時刻と照合し、差が1 ms未満なら内部時計を累算器の時刻に合わせる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-MTU" target="p48-B-GPC">
            <mxGeometry relative="1" as="geometry" x="0.2222">
              <Array as="points">
                <mxPoint x="640" y="470" />
                <mxPoint x="810" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-17&lt;br&gt;DKバス" id="p48-IF-DPS-17" link="docs/SSD-FD-DPS-MEDS-001.html#IF-DPS-17" tooltip="IF-DPS-17：4本の表示/キーボード（DK）データバスはIDPごとに1本あって5台のGPCそれぞれにつながり、どのGPCが指令元になるかはMAJ FUNCスイッチ、メモリ構成、GPC/CRTキー入力などで決まる。IDPはDKバスで受けたデータでDPS表示を更新し、GPCにポーリングされると乗員の入力とMEDSの状態を送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-GPC" target="p48-B-MEDS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-18&lt;br&gt;停止・IPL" id="p48-IF-DPS-18" link="docs/SSD-FD-DPS-OPS-001.html#IF-DPS-18" tooltip="IF-DPS-18：故障したGPCは、上昇・再突入ではMODEスイッチでHALTにし、それ以外では電源を切り、軌道上ではDPSを構成し直して回復を試みる。GPCの故障は、搭載と地上の監視により、冗長セットの故障・分裂、GPC故障、データ経路の故障として宣言する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-OPS" target="p48-B-GPC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-19&lt;br&gt;ポートモード等" id="p48-IF-DPS-19" link="docs/SSD-FD-DPS-OPS-001.html#IF-DPS-19" tooltip="IF-DPS-19：MECO後のFC・ペイロードMDMの故障では、非普遍I/Oエラーの場合を除き、DPS UTILITY表示の項目入力でどの有効なOPSのどのメジャーモードでもポートモードによる回復を試みられる。データ経路の故障の後は、MDMの電源を切って入れ直して出力をリセットする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-OPS" target="p48-B-BUS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-20&lt;br&gt;時刻更新・切替" id="p48-IF-DPS-20" link="docs/SSD-FD-DPS-OPS-001.html#IF-DPS-20" tooltip="IF-DPS-20：MTUとGPCのGMTの誤差は、SPEC 2 TIMEが使えるときは100 ms以下に保ち、誤差がその閾値を超えたら15 msの更新を行う。MTUのBITEビット4が立ってMCCがMTUの時刻差の増加を見た場合などは、MECO後からHAC進入までの間に発振器を手動で切り替える。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-OPS" target="p48-B-MTU">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-08&lt;br&gt;アビオニクス冷却（水）" id="p48-IF-ECL-08" link="docs/SSD-FD-ECL-ARS-001.html#IF-ECL-08" tooltip="IF-ECL-08：水冷却ループは、3つのアビオニクスベイの空気／水熱交換器とコールドプレートを通じて電子機器を冷却する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.6324;exitY=1;exitDx=0;exitDy=0;entryX=0.1071;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p48-L_thm" source="p48-B-ECL48" target="p48-B-GPC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-25&lt;br&gt;フレオンは中胴の" id="p48-IF-ECL-25" link="docs/SSD-FD-ECL-ATCS-001.html#IF-ECL-25" tooltip="IF-ECL-25：フレオンは中胴のコールドプレート網と後部アビオニクスベイ4・5・6を通り、電子機器を冷却する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.0441;exitY=1;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p48-L_thm" source="p48-B-ECL48" target="p48-B-BUS">
            <mxGeometry relative="1" as="geometry" x="0.4258">
              <Array as="points">
                <mxPoint x="410" y="230" />
                <mxPoint x="360" y="230" />
                <mxPoint x="360" y="770" />
                <mxPoint x="1210" y="770" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-EPS-09&lt;br&gt;パージ制御・計測" id="p48-IF-EPS-09" link="docs/SSD-FD-EPS-FCP-001.html#IF-EPS-09" tooltip="IF-EPS-09：自動パージでは、GPCがパージ配管ヒータを入れて温度を確認し、燃料電池1・2・3のパージ弁を順に2分間開閉する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-FSW" target="p48-B-EPS48">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ECL-18&lt;br&gt;煙検知警報" id="p48-IF-ECL-18" link="docs/SSD-FD-ECL-FDS-001.html#IF-ECL-18" tooltip="IF-ECL-18：煙検知素子は警報を発し、煙濃度の情報をCRTと計器盤L1に表示する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.3824;exitY=1;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-ECL48" target="p48-B-MEDS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-05&lt;br&gt;アップリンク指令" id="p48-IF-CT-05" link="docs/SSD-FD-CT-SBD-001.html#IF-CT-05" tooltip="IF-CT-05：NSPはフォワードリンクの地上コマンドを解読し、FF MDM（NSP 1はFF 1、NSP 2はFF 3）を通して機上の計算機へ送る。NSPはコマンドを検証してGPCが飛行重要MDMを通して要求したときにGPCへ送り、GPCも実行の前にコマンドを検証する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.5455;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-CT48" target="p48-B-BUS">
            <mxGeometry relative="1" as="geometry" x="-0.125">
              <Array as="points">
                <mxPoint x="1440" y="770" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-07&lt;br&gt;GCIL指令" id="p48-IF-CT-07" link="docs/SSD-FD-CT-OPS-001.html#IF-CT-07" tooltip="IF-CT-07：GCILで制御する通信系を組み替える指令は、GPCからPF MDMを経てGCILへ送られる。ペイロード通信系への指令もペイロードMDM 1・2からGCILCを経て送られ、これらのMDMはオービタの指令にも使われる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.8214;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.8182;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-BUS" target="p48-B-CT48">
            <mxGeometry relative="1" as="geometry" x="-0.7727">
              <Array as="points">
                <mxPoint x="1410" y="800" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-12&lt;br&gt;APU計測" id="p48-IF-APU-12" link="docs/SSD-FD-APU-CTL-001.html#IF-APU-12" tooltip="IF-APU-12：APU制御器は燃料タンクの温度とGN2圧力をGPCへ送り、GPCが燃料量を計算して専用のMEDS表示のAPU FUEL/H2O QTY計に示す。潤滑油ポンプの出口圧力・出口温度とWSBからの戻り温度は、APU制御器からGPCを経てBFS SM SYS SUMM 2に表示される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-APU48" target="p48-B-FSW">
            <mxGeometry relative="1" as="geometry" x="0.0573">
              <Array as="points">
                <mxPoint x="340" y="230" />
                <mxPoint x="340" y="790" />
                <mxPoint x="1160" y="790" />
                <mxPoint x="1160" y="430" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-13&lt;br&gt;循環ポンプ制御" id="p48-IF-APU-13" link="docs/SSD-FD-APU-CIR-001.html#IF-APU-13" tooltip="IF-APU-13：HYD CIRC PUMPスイッチがGPCのとき、SM GPCは油圧配管の温度とアキュムレータ圧力に基づく制御プログラムで循環ポンプを入り切りする。循環ポンプの出口圧力と油圧配管・機器の温度は、PASSのSM HYD THERMAL表示（DISP 87）に示される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.1786;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p48-L_dat" source="p48-B-FSW" target="p48-B-APU48">
            <mxGeometry relative="1" as="geometry" x="-0.332">
              <Array as="points">
                <mxPoint x="1230" y="200" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
