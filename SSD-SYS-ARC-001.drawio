            <mxGeometry x="40" y="1432" width="100" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="BUD-CON-02" id="p109-v-247" link="docs/SSD-BUD-ORB-001.html#BUD-CON-02" tooltip="開く">
