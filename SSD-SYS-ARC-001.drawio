        </UserObject>
        <mxCell id="p154-v-42" value="飲料水" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="376" width="260" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-43" value="燃料電池の生成水を4基の給水タンクに貯め、タンクA の水を飲用に充てる。微生物フィルタでヨウ素を加え、ギャレーのヨウ素除去装置（GIRA）で" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="376" width="640" height="38" as="geometry" />
        </mxCell>
