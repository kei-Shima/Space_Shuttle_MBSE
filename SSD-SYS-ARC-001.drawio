        </UserObject>
        <mxCell id="p12-v-45" value="・交流電力・前方ベイの配電機器（図6参照）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p12-B-EPS12">
