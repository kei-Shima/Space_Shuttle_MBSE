        <mxCell id="p90-v-1" value="&lt;div style='font-size:22px;font-weight:bold;'&gt;SSD-SYS-ARC-001　図90 要求の導出・充足 行列&lt;/div&gt;&lt;div style='font-size:12px;color:#3B4654;margin-top:4px;'&gt;L1 の要求から系ごとの L2 の要求への導出と、充足・検証方法の集計。ます目をクリックすると要求書を開きます。&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="720" height="64" as="geometry" />
        </mxCell>
