        <UserObject label="IF-TCS-03&lt;br&gt;油圧熱交換器" id="p8-IF-TCS-03" link="docs/SSD-FD-TCS-HX-001.html#IF-TCS-03" tooltip="IF-TCS-03：軌道上の循環時はフレオンがフレオン／油圧作動油熱交換器で油圧作動油を加温する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;startArrow=block;startFill=1;startSize=7;exitX=0;exitY=0.4143;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p8-L_thm" source="p8-B-HXN" target="p8-B-APU8">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-04&lt;br&gt;O2加温（40°F）" id="p8-IF-TCS-04" link="docs/SSD-FD-TCS-HX-001.html#IF-TCS-04" tooltip="IF-TCS-04：フレオンの一方の流路はECLSS酸素リストリクタを通り、ECLSS用のPRSD酸素を40°Fに加温する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0;exitY=0.5857;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p8-L_thm" source="p8-B-HXN" target="p8-B-PCS8">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-05&lt;br&gt;コールドプレート" id="p8-IF-TCS-05" link="docs/SSD-FD-TCS-HX-001.html#IF-TCS-05" tooltip="IF-TCS-05：フレオンは中胴のコールドプレート網と後部アビオニクスベイ4・5・6、レートジャイロ組立のコールドプレートを通り、電子機器を冷却する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0;exitY=0.7571;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p8-L_thm" source="p8-B-HXN" target="p8-B-DPS8">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-06&lt;br&gt;ペイロード熱交換器" id="p8-IF-TCS-06" link="docs/SSD-FD-TCS-HX-001.html#IF-TCS-06" tooltip="IF-TCS-06：フレオンの流路は流量配分弁を経てペイロード熱交換器とARSインターチェンジャへ並列に流れる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0;exitY=0.9286;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p8-L_thm" source="p8-B-HXN" target="p8-B-PL8">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-07&lt;br&gt;熱輸送（フレオン21）" id="p8-IF-TCS-07" link="docs/SSD-FD-TCS-HX-001.html#IF-TCS-07" tooltip="IF-TCS-07：ATCSは同一構成の2系統のフレオン21冷却ループ、アビオニクス用コールドプレート網、液液熱交換器、3種のヒートシンクから成る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3933;entryDx=0;entryDy=0;" edge="1" parent="p8-L_thm" source="p8-B-HXN" target="p8-B-FCL">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-08&lt;br&gt;放熱器へ" id="p8-IF-TCS-08" link="docs/SSD-FD-TCS-FCL-001.html#IF-TCS-08" tooltip="IF-TCS-08：フレオンは油圧熱交換器から放熱器へ流れ、ペイロードベイドアが閉じている上昇・再突入時はバイパス弁で放熱器を迂回する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.1124;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p8-L_thm" source="p8-B-FCL" target="p8-B-RAD">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-09&lt;br&gt;FESへ" id="p8-IF-TCS-09" link="docs/SSD-FD-TCS-FCL-001.html#IF-TCS-09" tooltip="IF-TCS-09：FESは上昇時の高度140,000 ft超でフレオン21ループの熱を排出し、軌道上では必要に応じて放熱器を補い、軌道離脱・再突入では高度約100,000 ftまで排熱する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.3708;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p8-L_thm" source="p8-B-FCL" target="p8-B-FES">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-10&lt;br&gt;NH3ボイラへ" id="p8-IF-TCS-10" link="docs/SSD-FD-TCS-FCL-001.html#IF-TCS-10" tooltip="IF-TCS-10：アンモニアボイラは、再突入で高度100,000 ftを下回ってからフレオン21ループを冷却する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.6292;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p8-L_thm" source="p8-B-FCL" target="p8-B-NH3">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-11&lt;br&gt;GSE熱交換器へ" id="p8-IF-TCS-11" link="docs/SSD-FD-TCS-FCL-001.html#IF-TCS-11" tooltip="IF-TCS-11：地上作業（点検・打上げ前・着陸後）では、フレオン21ループ内のGSE熱交換器が地上冷却によって機体の熱を排出する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.8876;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p8-L_thm" source="p8-B-FCL" target="p8-B-GSEHX">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-12&lt;br&gt;放射" id="p8-IF-TCS-12" link="docs/SSD-FD-TCS-RAD-001.html#IF-TCS-12" tooltip="IF-TCS-12：ペイロードベイドアを軌道上で開くと、放熱器が熱を宇宙空間へ放射する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1515;entryDx=0;entryDy=0;" edge="1" parent="p8-L_thm" source="p8-B-RAD" target="p8-B-SPACE8">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-13&lt;br&gt;蒸気排出" id="p8-IF-TCS-13" link="docs/SSD-FD-TCS-FES-001.html#IF-TCS-13" tooltip="IF-TCS-13：トッピング蒸発器の蒸気は後部胴体両側の2つのソニックノズルから排出され、推力を生じない。高負荷蒸発器の蒸気は左側の1つのノズルから排出される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p8-L_flu" source="p8-B-FES" target="p8-B-SPACE8">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-14&lt;br&gt;NH3排気" id="p8-IF-TCS-14" link="docs/SSD-FD-TCS-NH3-001.html#IF-TCS-14" tooltip="IF-TCS-14：気化したアンモニアは、垂直尾翼の右下付近の上部後部胴体から船外へ排出される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8485;entryDx=0;entryDy=0;" edge="1" parent="p8-L_flu" source="p8-B-NH3" target="p8-B-SPACE8">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-15&lt;br&gt;地上冷却" id="p8-IF-TCS-15" link="docs/SSD-FD-TCS-GSE-001.html#IF-TCS-15" tooltip="IF-TCS-15：着陸後に地上冷却が始まるとアンモニアボイラを止め、GSE熱交換器で排熱する。 射点ではパッド地上冷却系がGSE熱交換器を通じて機上ループを十分に冷やし、軌道到達までの熱容量を確保する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p8-L_thm" source="p8-B-GND8" target="p8-B-GSEHX">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-16&lt;br&gt;FES給水（系統A・B）" id="p8-IF-TCS-16" link="docs/SSD-FD-TCS-FES-001.html#IF-TCS-16" tooltip="IF-TCS-16：FES用の水は、飲料水タンクから給水系統A・Bを通じて供給される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="p8-L_flu" source="p8-B-H2O8" target="p8-B-FES">
            <mxGeometry relative="1" as="geometry" x="-0.8">
              <Array as="points">
                <mxPoint x="1208" y="200" />
                <mxPoint x="1120" y="200" />
                <mxPoint x="1120" y="510" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-TCS-17&lt;br&gt;パージガス（T-0）" id="p8-IF-TCS-17" link="docs/SSD-FD-TCS-PTC-001.html#IF-TCS-17" tooltip="IF-TCS-17：打上げ前と着陸後は、3系統のパージ回路がT-0アンビリカルで地上設備に接続され、冷却・乾燥した空気と窒素が非与圧区画に供給される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p8-L_flu" source="p8-B-GND8" target="p8-B-PTC">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1606" y="1280" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
