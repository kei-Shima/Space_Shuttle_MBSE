        <UserObject label="IF-EVA-01&lt;br&gt;前呼吸時間" id="p60-IF-EVA-01" link="docs/SSD-FD-EVA-OPS-001.html#IF-EVA-01" tooltip="IF-EVA-01：キャビンを10.2 psiにしてからの時間（12時間・24時間）に応じてEMU内の前呼吸を1時間15分・40分とし、14.7 psiのままなら4時間とする。SCOMの選択肢1・2も、初期前呼吸60分の後の最終前呼吸を、10.2 psiaで12時間なら75分、24時間なら40分とする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p60-L_dat" source="p60-B-OPS" target="p60-B-CHK">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-02&lt;br&gt;前呼吸完了・GO" id="p60-IF-EVA-02" link="docs/SSD-FD-EVA-CHK-001.html#IF-EVA-02" tooltip="IF-EVA-02：EMU内の前呼吸の時間が終わったらMCCに減圧のGOを確かめ、DEPRESS/REPRESSのキューカードで減圧を始める。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p60-L_dat" source="p60-B-CHK" target="p60-B-DPR">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-03&lt;br&gt;MWS・BRT・工具" id="p60-IF-EVA-03" link="docs/SSD-FD-EVA-TLS-001.html#IF-EVA-03" tooltip="IF-EVA-03：EVA準備で必要に応じてMWSとBRTをEMUに取り付け、エアロックにEVA工具が入っていることを確かめる。MWSはEMUの前面に付けて工具を収め、作業場所で乗員をテザーで拘束する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p60-L_str" source="p60-B-TLS" target="p60-B-CHK">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-04&lt;br&gt;エアロック圧" id="p60-IF-EVA-04" link="docs/SSD-FD-EVA-DPR-001.html#IF-EVA-04" tooltip="IF-EVA-04：エアロック減圧弁でエアロックを5.0 psiまで下げてEMUの漏れを点検してから0 psiまで減圧し、再与圧は内側ハッチの均圧弁で5.0 psiまで戻して気密を確かめてから乗員室の圧力に合わせる。EMU 2着を入れて減圧するエアロックの容積は208 ft³である。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p60-L_flu" source="p60-B-ALD60" target="p60-B-DPR">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-05&lt;br&gt;キューカード" id="p60-IF-EVA-05" link="docs/SSD-FD-EVA-OPS-001.html#IF-EVA-05" tooltip="IF-EVA-05：減圧・再与圧はエアロックの構成ごとのDEPRESS/REPRESSキューカード（通常構成・トンネルアダプタ）に従い、漏れ点検の不合格時の手順はその裏面のFAILED LEAK CHECKに載せる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=1;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p60-L_dat" source="p60-B-OPS" target="p60-B-DPR">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="1210" y="940" />
                <mxPoint x="640" y="940" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-06&lt;br&gt;EVA後へ" id="p60-IF-EVA-06" link="docs/SSD-FD-EVA-DPR-001.html#IF-EVA-06" tooltip="IF-EVA-06：再与圧でエアロックの気密を確かめてO2 ACTをIVにした後にPOST EVAへ移り、再与圧でDCSの症状が消えた場合はMCCに確かめるまでEMUを脱がない。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p60-L_dat" source="p60-B-DPR" target="p60-B-MNT">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-07&lt;br&gt;5 psia保持" id="p60-IF-EVA-07" link="docs/SSD-FD-EVA-EMG-001.html#IF-EVA-07" tooltip="IF-EVA-07：EMUの汚染が疑われた場合はエアロックを5 psiaまで再与圧した状態で保ち、検知管による汚染試験を行ってから再与圧を続ける。汚染の除去では真空で15分保持した後に、エアロックを5 psiまで再与圧する（REPRESSの手順1〜8）。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=1;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p60-L_dat" source="p60-B-EMG" target="p60-B-DPR">
            <mxGeometry relative="1" as="geometry" x="-0.2507">
              <Array as="points">
                <mxPoint x="1210" y="530" />
                <mxPoint x="640" y="530" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-08&lt;br&gt;非常時用工具" id="p60-IF-EVA-08" link="docs/SSD-FD-EVA-TLS-001.html#IF-EVA-08" tooltip="IF-EVA-08：非常時EVAに使う中心線ラッチ工具・3点ラッチ工具、RMSロープリール、調整式テザーは左舷の軽量工具収納組立（TSA）に収める。ODSの96本ボルトのEVAでは、大型カッタとPRD 2個も左舷のTSAに収める。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p60-L_str" source="p60-B-TLS" target="p60-B-EMG">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-09&lt;br&gt;電池充電" id="p60-IF-EVA-09" link="docs/SSD-FD-EVA-MNT-001.html#IF-EVA-09" tooltip="IF-EVA-09：PGTの電池（2個）とヘルメットライトの電池（4個）は、EHIP充電器とアダプタケーブルでオービタの電源から充電する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p60-L_pow" source="p60-B-MNT" target="p60-B-TLS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-10&lt;br&gt;DC電源" id="p60-IF-EVA-10" link="docs/SSD-FD-EVA-MNT-001.html#IF-EVA-10" tooltip="IF-EVA-10：ミッドデッキのDC電源コンセント（MUP）から、EMU電池の充電器に給電する。REBAの充電器はY形ケーブルでオービタの電源につなぎ、着用中の充電では延長ケーブルを使う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p60-L_pow" source="p60-B-EPS60" target="p60-B-MNT">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-11&lt;br&gt;手動操作" id="p60-IF-EVA-11" link="docs/SSD-FD-EVA-EMG-001.html#IF-EVA-11" tooltip="IF-EVA-11：非常時EVAで、放熱器アクチュエータの切り離し、PLBD駆動系の切断・切り離しとウインチによる扉の閉鎖、隔壁・中心線ラッチ工具の取り付けを行う。EVAウインチは、ペイロードベイドアの駆動系が故障したときに乗員が扉を閉じるためのものである。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="p60-L_str" source="p60-B-EMG" target="p60-B-MECH60">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-12&lt;br&gt;手動操作" id="p60-IF-EVA-12" link="docs/SSD-FD-EVA-EMG-001.html#IF-EVA-12" tooltip="IF-EVA-12：RMS・PRLAの故障時に、RMSの固縛、MPMの手動での格納・展開、関節の位置合わせ、グラプル軸の解放、PRLAの手動での開閉をEVAで行う。ODSとPMAの捕獲ラッチも、EVAで手動で解放できる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p60-L_str" source="p60-B-EMG" target="p60-B-PLS60">
            <mxGeometry relative="1" as="geometry" x="0.125">
              <Array as="points">
                <mxPoint x="1440" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-13&lt;br&gt;DCS・ABORT" id="p60-IF-EVA-13" link="docs/SSD-FD-EVA-OPS-001.html#IF-EVA-13" tooltip="IF-EVA-13：カフチェックリストで減圧症の区分を判断し、カフ4ではABORT EVAとして患者をエアロックへ連れ戻して単独で再与圧し、DCSの処置の手順へ移る。DCSの処置の手順は、カフ4への進行を防ぐためにEVAを終えた後の処置を定める。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p60-L_dat" source="p60-B-OPS" target="p60-B-EMG">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-14&lt;br&gt;O2・N2" id="p60-IF-EVA-14" link="docs/SSD-FD-EVA-OPS-001.html#IF-EVA-14" tooltip="IF-EVA-14：マスク前呼吸では、LEH O2弁から簡易着用マスクへO2を送り、マスクの正のO2圧と密着で前呼吸を確保する。10.2 psiの維持では、PPO2が2.70 psia未満ならDIRECT O2弁でO2を、キャビン圧が10.40 psia未満なら14.7 CAB REG INLET SYS 1弁でN2を加える。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.7857;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p60-L_flu" source="p60-B-PCS60" target="p60-B-OPS">
            <mxGeometry relative="1" as="geometry" x="-0.4375">
              <Array as="points">
                <mxPoint x="1400" y="890" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-15&lt;br&gt;限界値" id="p60-IF-EVA-15" link="docs/SSD-FD-EVA-OPS-001.html#IF-EVA-15" tooltip="IF-EVA-15：10.2 psiへの減圧、10.2 psiでの運用、14.7 psiへの再与圧の各段階でキャビン圧・PPO2などのC/W・FDAの限界値を設定し直し、MCCがB/U C/WとSMアラートの限界値を送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p60-L_dat" source="p60-B-OPS" target="p60-B-CW60">
            <mxGeometry relative="1" as="geometry" x="0.125">
              <Array as="points">
                <mxPoint x="1440" y="770" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-ALS-06&lt;br&gt;SCU" id="p60-IF-ALS-06" link="docs/SSD-FD-ECL-ALS-SCU-001.html#IF-ALS-06" tooltip="IF-ALS-06：SCUは3本の水ホース、高圧O2ホース、電線、水圧調整器から成り、EMUとエアロックを結んで電力、有線通信、O2、廃水排出、水冷却と、PLSSのO2タンク・水リザーバ・バッテリの再充電を提供する。PLSSの一次O2系はSCUを通して850±50 psigで充填される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="p60-L_flu" source="p60-B-MNT" target="p60-B-SCU60">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-ALS-07&lt;br&gt;LCVG冷却水" id="p60-IF-ALS-07" link="docs/SSD-FD-ECL-ALS-LCG-001.html#IF-ALS-07" tooltip="IF-ALS-07：SCU接続中は、EMUの液体輸送系のポンプがLCVGの水（約240 lb/hr）をSCUを通してオービタの熱交換器へも流し、乗員を冷却する。LCVGの冷却水は、EMUごとの2本の閉ループでエアロックに出入りする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p60-L_flu" source="p60-B-CHK" target="p60-B-LCG60">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-10&lt;br&gt;SSOR" id="p60-IF-CT-10" link="docs/SSD-FD-CT-UHF-001.html#IF-CT-10" tooltip="IF-CT-10：SSORはSSCSの時分割多重の網で、EVA乗員の宇宙服無線（SSER、最大3台）とISSの無線（SSSR）と音声・データを交換する。EMUの無線は、他のEVA乗員・オービタとの音声通信、ECG/RTDSのテレメトリのオービタへの送信（記録・ダウンリンク用）、警報トーンを提供する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5F6B7A;strokeWidth=2;fontColor=#5F6B7A;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;startArrow=block;startFill=1;startSize=7;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p60-L_rf" source="p60-B-CT60" target="p60-B-OPS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;図示を省略したIF（文書・図5に記載）&lt;/b&gt;&lt;br&gt;なし（IF-EVA-01〜15 をすべて図示）&lt;br&gt;&lt;br&gt;他の図・段と同じ物理IFのため、その番号のまま描いたIF：IF-ALS-06・IF-ALS-07・IF-CT-10&lt;br&gt;&lt;br&gt;各ブロックの「関連文書」ボタンは、機能別関連文書一覧（SSD-EVA-REF-001）の該当節を開きます。" id="p60-v-39" link="data:page/id,p5-register" tooltip="図5のIF一覧へ">
          <mxCell style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#FAFBFC;strokeColor=#9AA3AE;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#3B4654;fontFamily=Helvetica;" vertex="1" parent="1">
