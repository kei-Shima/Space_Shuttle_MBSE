            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCL-08&lt;br&gt;ICH計測" id="p36-IF-WCL-08" link="docs/SSD-FD-ARS-WCL-ICH-001.html#IF-WCL-08" tooltip="IF-WCL-08：インターチェンジャ経路の流量センサと出口温度センサで、インターチェンジャ流量と出口温度を計測する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0.1071;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p36-L_flu" source="p36-B-ICH" target="p36-B-MON">
            <mxGeometry relative="1" as="geometry" x="0.2222">
              <Array as="points">
                <mxPoint x="1040" y="530" />
                <mxPoint x="1210" y="530" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCL-09&lt;br&gt;ポンプ操作" id="p36-IF-WCL-09" link="docs/SSD-FD-ARS-WCL-OPS-001.html#IF-WCL-09" tooltip="IF-WCL-09：パネルL1のH2O PUMP LOOP 1のA/B選択スイッチと、LOOP 1・2のGPC/OFF/ONスイッチで、運転するポンプを選び起動・停止する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.65;exitDx=0;exitDy=0;entryX=0;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="p36-L_dat" source="p36-B-OPS" target="p36-B-PMP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCL-10&lt;br&gt;バイパス操作" id="p36-IF-WCL-10" link="docs/SSD-FD-ARS-WCL-OPS-001.html#IF-WCL-10" tooltip="IF-WCL-10：パネルL1のLOOP 1・2 BYPASS MODEスイッチで自動・手動を選び、手動ではMAN INCR/DECRスイッチでバイパス弁の位置を調整する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p36-L_dat" source="p36-B-OPS" target="p36-B-ICH">
            <mxGeometry relative="1" as="geometry" x="0.2222">
              <Array as="points">
                <mxPoint x="640" y="470" />
                <mxPoint x="810" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCL-11&lt;br&gt;計測・警報" id="p36-IF-WCL-11" link="docs/SSD-FD-ARS-WCL-MON-001.html#IF-WCL-11" tooltip="IF-WCL-11：ポンプ出口圧・アキュムレータ量・インターチェンジャ流量・ポンプ出口温度などを、ARS水ループの喪失判定（A18-101）とループ切替の判断に使う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=1;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p36-L_dat" source="p36-B-MON" target="p36-B-OPS">
            <mxGeometry relative="1" as="geometry" x="0">
