  <diagram id="p59-ct-docs" name="図59 C&amp;T 関連文書マトリクス">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="662" math="0" shadow="0" background="#FFFFFF">
