        </mxCell>
        <UserObject label="▶ 機能説明書　SSD-FD-EPS-001" id="p16-v-27" link="docs/SSD-FD-EPS-001.html" tooltip="クリックで SSD-FD-EPS-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#A77B00;fontColor=#A77B00;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p16-B-EPS16">
            <mxGeometry x="10" y="66" width="260" height="26" as="geometry" />
          </mxCell>
        </UserObject>
