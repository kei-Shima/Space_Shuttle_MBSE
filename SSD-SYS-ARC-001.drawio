        <UserObject label="▶ 機能説明書　SSD-FD-EPS-001" id="p12-v-46" link="docs/SSD-FD-EPS-001.html" tooltip="クリックで SSD-FD-EPS-001 を開く">
          <mxCell style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#A77B00;fontColor=#A77B00;fontSize=11;fontStyle=1;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="p12-B-EPS12">
