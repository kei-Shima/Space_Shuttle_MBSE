        <UserObject label="OMST-06" id="p136-v-24" link="docs/SSD-BEH-ORB-006.html#OMST-06" tooltip="OMST-06：RIGHT OMS 灯（右エンジン Pc 80% 未満・下向き矢印）→ 右の OMS ENG を OFF［Pc と速度の両試験で故障（センサ故障でない）］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p136-v-9" target="p136-v-10">
