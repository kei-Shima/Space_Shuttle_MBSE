          <mxGeometry x="110" y="718" width="260" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-97" value="個人の好みのキット（PPK）を床下の Volume E に収め、乗員の好みで OCAC を積んで睡眠のための白色雑音を得る。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
