        <mxCell id="p153-v-11" value="照合表" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#15202B;strokeColor=#15202B;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
