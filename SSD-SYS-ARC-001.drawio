        </mxCell>
        <UserObject label="SSD-FD-OMS-001" id="p109-v-211" link="docs/SSD-FD-OMS-001.html" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="440" y="1110" width="200" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-212" value="追加の OMS 推進薬の計画だったが使われる見込みはない（スイッチと計器は残るが働かない）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
