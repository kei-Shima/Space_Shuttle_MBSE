        <UserObject label="IF-WCL-12&lt;br&gt;AC電力" id="p36-IF-WCL-12" link="docs/SSD-FD-ARS-WCL-PMP-001.html#IF-WCL-12" tooltip="IF-WCL-12：ループ1のポンプAにAC1、ポンプBにAC2、ループ2のポンプにAC3の三相電力を、パネルL4の遮断器とパネルL1のH2O PUMPスイッチを通して供給する。ループ2のポンプはGPC位置ではAC1から給電され、AC3を失っても運転を続けられる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5588;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="p36-L_pow" source="p36-B-EPS36" target="p36-B-PMP">
            <mxGeometry relative="1" as="geometry" x="-0.6167">
              <Array as="points">
                <mxPoint x="760" y="600" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCL-13&lt;br&gt;制御器電源" id="p36-IF-WCL-13" link="docs/SSD-FD-ARS-WCL-ICH-001.html#IF-WCL-13" tooltip="IF-WCL-13：バイパス弁を駆動するH2O CNTLRに、制御器1はAC3のA相、制御器2はAC1のA相からパネルL4の遮断器を通して給電する。H2O CNTLRはバイパス弁の駆動電力とポンプパッケージのすべての計装の電力を供給する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.6324;exitY=1;exitDx=0;exitDy=0;entryX=0.1071;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p36-L_pow" source="p36-B-EPS36" target="p36-B-ICH">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCL-14&lt;br&gt;センサ電源" id="p36-IF-WCL-14" link="docs/SSD-FD-ARS-WCL-MON-001.html#IF-WCL-14" tooltip="IF-WCL-14：パネルO14のH2O BYP LOOP 1 SNSR（MN A）はループ1のインターチェンジャ流量センサとIMUファン差圧センサに、パネルO15のLOOP 2 SNSR（MN B）はループ2のインターチェンジャ流量センサに給電する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9706;exitY=1;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p36-L_pow" source="p36-B-EPS36" target="p36-B-MON">
            <mxGeometry relative="1" as="geometry" x="-0.4924">
              <Array as="points">
                <mxPoint x="1040" y="220" />
                <mxPoint x="1880" y="220" />
                <mxPoint x="1880" y="790" />
                <mxPoint x="1440" y="790" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCL-15&lt;br&gt;ポンプ指令" id="p36-IF-WCL-15" link="docs/SSD-FD-ARS-WCL-PMP-001.html#IF-WCL-15" tooltip="IF-WCL-15：GPC位置では、SM GPCがPL MDM 1を通してループ1のポンプを、PL MDM 2を通してループ2のポンプを指令し、軌道上は6分ON・4時間OFFを繰り返す。OPS 1・3・6ではループ2のGPC-ON指令がBFSに常駐し、GPC位置にすると直ちにポンプが動く。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.3824;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p36-L_dat" source="p36-B-DPS36" target="p36-B-PMP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCL-16&lt;br&gt;H2O LOOP警報" id="p36-IF-WCL-16" link="docs/SSD-FD-ARS-WCL-MON-001.html#IF-WCL-16" tooltip="IF-WCL-16：各ループのポンプ出口圧を、主C&amp;Wのハードウェアチャネル105・115（パネルF7のH2O LOOP灯）とパネルO1の計器へ送る。ポンプ出口圧・差圧・出口温度、アキュムレータ量、インターチェンジャ流量と出口温度、キャビン熱交換器入口温度をSMへ送り、SPEC 88に表示する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7941;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p36-L_dat" source="p36-B-MON" target="p36-B-DPS36">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCL-17&lt;br&gt;MDM冷却" id="p36-IF-WCL-17" link="docs/SSD-FD-ARS-WCL-AVL-001.html#IF-WCL-17" tooltip="IF-WCL-17：前方アビオニクスベイのFF・PL・LF・LM MDMを、水冷却ループのコールドプレートで冷却する。ミッドデッキのAv Bay 3Bにあるマスタタイミングユニットも、水冷却ループのコールドプレートで冷却する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.0441;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p36-L_thm" source="p36-B-AVL" target="p36-B-DPS36">
            <mxGeometry relative="1" as="geometry" x="0.4615">
              <Array as="points">
                <mxPoint x="450" y="530" />
                <mxPoint x="360" y="530" />
                <mxPoint x="360" y="800" />
                <mxPoint x="810" y="800" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCL-18&lt;br&gt;配電機器冷却" id="p36-IF-WCL-18" link="docs/SSD-FD-ARS-WCL-AVL-001.html#IF-WCL-18" tooltip="IF-WCL-18：前方アビオニクスベイ1〜3の電力制御組立・負荷制御組立・モータ制御組立・インバータを、コールドプレートで冷却する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2059;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p36-L_thm" source="p36-B-AVL" target="p36-B-EPS36">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCL-19&lt;br&gt;窓の熱調整" id="p36-IF-WCL-19" link="docs/SSD-FD-ARS-WCL-AVL-001.html#IF-WCL-19" tooltip="IF-WCL-19：Av Bay 2経路の水で、オービタのすべての窓の周りのシールを熱調整する。IOAのCIL評価は、ハッチの熱調整系（ARS-191）の故障もシールの故障につながるとする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.1071;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p36-L_thm" source="p36-B-AVL" target="p36-B-CAB36">
            <mxGeometry relative="1" as="geometry" x="0.1111">
              <Array as="points">
                <mxPoint x="410" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCL-20&lt;br&gt;インターチェンジャ" id="p36-IF-WCL-20" link="docs/SSD-FD-ARS-WCL-ICH-001.html#IF-WCL-20" tooltip="IF-WCL-20：水冷却ループが集めた熱を、インターチェンジャでATCSのフレオン冷却ループへ移す。フレオン側は流量比例弁でペイロード熱交換器と並列に分けられてインターチェンジャへ流れ、インターチェンジャは中胴前方下部にある。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.8571;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p36-L_thm" source="p36-B-ICH" target="p36-B-HX36">
            <mxGeometry relative="1" as="geometry" x="0.2333">
              <Array as="points">
                <mxPoint x="1020" y="160" />
                <mxPoint x="1210" y="160" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCL-21&lt;br&gt;LCG熱交換器" id="p36-IF-WCL-21" link="docs/SSD-FD-ARS-WCL-CLD-001.html#IF-WCL-21" tooltip="IF-WCL-21：EMUごとの閉じたLCVG冷却ループの水を、エアロック内のLCVG熱交換器でオービタの水冷却ループにより冷やす。水冷却ループの冷側経路は、インターチェンジャの直後に液冷服熱交換器を通る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p36-L_thm" source="p36-B-ALS36" target="p36-B-CLD">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-WCL-22&lt;br&gt;飲料水チラー" id="p36-IF-WCL-22" link="docs/SSD-FD-ARS-WCL-CLD-001.html#IF-WCL-22" tooltip="IF-WCL-22：冷側経路の飲料水チラーで、ギャレーへ送る給水の一方の経路を冷やす。飲料水チラーは給水タンクからの乗員の飲料水を冷やす。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p36-L_thm" source="p36-B-CLD" target="p36-B-H2O36">
            <mxGeometry relative="1" as="geometry" x="0.125">
              <Array as="points">
                <mxPoint x="1440" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-THC-03&lt;br&gt;キャビン熱交換器" id="p36-IF-THC-03" link="docs/SSD-FD-ARS-THC-HX-001.html#IF-THC-03" tooltip="IF-THC-03：キャビン熱交換器で、キャビン空気が拾った熱をARS水冷却ループへ移す。水冷却ループの冷えた水は、液冷服熱交換器と飲料水チラーに続いてキャビン熱交換器を通る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p36-L_thm" source="p36-B-THC36" target="p36-B-CLD">
            <mxGeometry relative="1" as="geometry" x="0.6489">
              <Array as="points">
                <mxPoint x="1570" y="740" />
                <mxPoint x="1570" y="770" />
                <mxPoint x="1860" y="770" />
                <mxPoint x="1860" y="230" />
                <mxPoint x="1440" y="230" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-AVB-10&lt;br&gt;ベイ熱交換器" id="p36-IF-AVB-10" link="docs/SSD-FD-ARS-AVB-HX-001.html#IF-AVB-10" tooltip="IF-AVB-10：各ベイの空気/水熱交換器で、水冷却ループがファン出口空気から熱を受け取る。熱交換器を出る空気は、水冷却ループのポンプ出口温度より約10°F高い（A18-101C）。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p36-L_thm" source="p36-B-AVB36" target="p36-B-AVL">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-IMU-08&lt;br&gt;IMU熱交換器" id="p36-IF-IMU-08" link="docs/SSD-FD-ARS-IMU-HEX-001.html#IF-IMU-08" tooltip="IF-IMU-08：暖まった空気をIMU熱交換器に通し、熱をARSの水冷却ループへ渡す。水冷却ループでは、インターチェンジャで冷えた水がLCG熱交換器・水チラー・キャビン熱交換器を経てIMU熱交換器を流れる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.7857;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p36-L_thm" source="p36-B-IMU36" target="p36-B-CLD">
            <mxGeometry relative="1" as="geometry" x="-0.6875">
              <Array as="points">
                <mxPoint x="1480" y="590" />
                <mxPoint x="1480" y="490" />
                <mxPoint x="1400" y="490" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
