        <UserObject label="IF-EPS-01&lt;br&gt;反応剤充填" id="p6-IF-EPS-01" link="docs/SSD-FD-EPS-PRSD-001.html#IF-EPS-01" tooltip="IF-EPS-01：打上げ前は地上支援設備が燃料電池の反応剤を補給して搭載量を満たし、T-2分35秒で充填を終える。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.0714;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="p6-L_flu" source="p6-B-GSE6" target="p6-B-PRSD">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EPS-02&lt;br&gt;地上28 VDC" id="p6-IF-EPS-02" link="docs/SSD-FD-EPS-DC-001.html#IF-EPS-02" tooltip="IF-EPS-02：T-3分30秒までは、T-0アンビリカルから供給される地上電源と燃料電池で負荷を分担し、その時点で地上電源を切って燃料電池が全負荷を受け持つ。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.7857;exitDx=0;exitDy=0;entryX=0;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="p6-L_pow" source="p6-B-GSE6" target="p6-B-EDC">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EPS-03&lt;br&gt;H2/O2" id="p6-IF-EPS-03" link="docs/SSD-FD-EPS-PRSD-001.html#IF-EPS-03" tooltip="IF-EPS-03：反応剤はリリーフ弁／フィルタと弁モジュールを経て共通マニホールドから燃料電池へ流れ、酸素は815〜881 psia、水素は200〜243 psiaで供給される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p6-L_flu" source="p6-B-PRSD" target="p6-B-FCP">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EPS-04&lt;br&gt;O2（与圧用）" id="p6-IF-EPS-04" link="docs/SSD-FD-EPS-PRSD-001.html#IF-EPS-04" tooltip="IF-EPS-04：酸素弁モジュールは、ECLSSの大気圧力制御系1・2への酸素供給を含む。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p6-L_flu" source="p6-B-PRSD" target="p6-B-PCS6">
            <mxGeometry relative="1" as="geometry" x="0.6" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EPS-05&lt;br&gt;28 VDC" id="p6-IF-EPS-05" link="docs/SSD-FD-EPS-FCP-001.html#IF-EPS-05" tooltip="IF-EPS-05：各燃料電池の直流電力は対応する分配器へ送られ、燃料電池1は主母線A、2は主母線B、3は主母線Cに対応する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p6-L_pow" source="p6-B-FCP" target="p6-B-EDC">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EPS-06&lt;br&gt;生成水" id="p6-IF-EPS-06" link="docs/SSD-FD-EPS-FCP-001.html#IF-EPS-06" tooltip="IF-EPS-06：3基の燃料電池の生成水は単一の水リリーフ制御盤へ集まり、通常は飲料水タンクAへ送られ、凍結時に備えてタンクBへの冗長経路もある。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.225;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p6-L_flu" source="p6-B-FCP" target="p6-B-H2O6">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EPS-07&lt;br&gt;排熱（FC熱交換器）" id="p6-IF-EPS-07" link="docs/SSD-FD-EPS-FCP-001.html#IF-EPS-07" tooltip="IF-EPS-07：燃料電池の冷却材（フッ素系炭化水素）は、燃料電池熱交換器を通じてスタックの排熱を中胴のフレオン21冷却ループへ移す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.18;entryDx=0;entryDy=0;" edge="1" parent="p6-L_thm" source="p6-B-FCP" target="p6-B-TCS6">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EPS-08&lt;br&gt;水リリーフ・パージ" id="p6-IF-EPS-08" link="docs/SSD-FD-EPS-FCP-001.html#IF-EPS-08" tooltip="IF-EPS-08：水タンクが満杯または配管が閉塞した場合、水リリーフ弁が45 psiaで開いて生成水を船外へ排出する。 パージ時は反応剤を流して不活性ガスなどの不純物をパージ配管から船外へ吹き出す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p6-L_flu" source="p6-B-FCP" target="p6-B-SPACE6">
            <mxGeometry relative="1" as="geometry">
              <Array as="points">
                <mxPoint x="1018" y="215" />
                <mxPoint x="1320" y="215" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-EPS-09&lt;br&gt;パージ制御・計測" id="p6-IF-EPS-09" link="docs/SSD-FD-EPS-FCP-001.html#IF-EPS-09" tooltip="IF-EPS-09：自動パージでは、GPCがパージ配管ヒータを入れて温度を確認し、燃料電池1・2・3のパージ弁を順に2分間開閉する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p6-L_dat" source="p6-B-DPS6" target="p6-B-FCP">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EPS-10&lt;br&gt;インバータ入力" id="p6-IF-EPS-10" link="docs/SSD-FD-EPS-DC-001.html#IF-EPS-10" tooltip="IF-EPS-10：インバータ1は主母線Aのみ、2は主母線B、3は主母線Cから給電される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="p6-L_pow" source="p6-B-EDC" target="p6-B-EAC">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EPS-11&lt;br&gt;28 VDC配電" id="p6-IF-EPS-11" link="docs/SSD-FD-EPS-DC-001.html#IF-EPS-11" tooltip="IF-EPS-11：EPDCは、28 V直流電力をオービタ各系、SRB、外部タンク、ペイロードへ制御・分配する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p6-L_pow" source="p6-B-EDC" target="p6-B-LOADS6">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EPS-12&lt;br&gt;115 V 400 Hz" id="p6-IF-EPS-12" link="docs/SSD-FD-EPS-AC-001.html#IF-EPS-12" tooltip="IF-EPS-12：交流電力はインバータ分配制御組立から計器盤へ、モータ制御組立から3相モータ負荷へ分配される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8704;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p6-L_pow" source="p6-B-EAC" target="p6-B-LOADS6">
            <mxGeometry relative="1" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EPS-13&lt;br&gt;3相交流（ポンプ）" id="p6-IF-EPS-13" link="docs/SSD-FD-EPS-AC-001.html#IF-EPS-13" tooltip="IF-EPS-13：燃料電池の冷却材ポンプは3相交流で駆動され、電子制御ユニットが冷却材ポンプと水素ポンプ／水分離器への交流電力を制御する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.95;entryDx=0;entryDy=0;" edge="1" parent="p6-L_pow" source="p6-B-EAC" target="p6-B-FCP">
            <mxGeometry relative="1" as="geometry">
