        <UserObject label="宇宙空間（船外）" id="p28-B-SPACE28" tooltip="真空ベント管の排気先（図12参照）" doc_no="—" abbr="SPACE" 分類="外部（地上・宇宙インフラ）">
          <mxCell style="swimlane;html=1;whiteSpace=wrap;startSize=30;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#5F6B7A;strokeWidth=1.5;fontColor=#15202B;fontStyle=1;fontSize=13;align=left;spacingLeft=10;fontFamily=Helvetica;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
            <mxGeometry x="380" y="820" width="280" height="100" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p28-v-29" value="・真空ベント管の排気先（図12参照）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="p28-B-SPACE28">
          <mxGeometry x="0" y="30" width="280" height="64" as="geometry" />
        </mxCell>
        <UserObject label="IF-RCRS-01&lt;br&gt;通気" id="p28-IF-RCRS-01" link="docs/SSD-FD-ARS-RCRS-FAN-001.html#IF-RCRS-01" tooltip="IF-RCRS-01：RCRSファンで送り流量制御弁で設定した流量の空気を、真空サイクル弁の空気ポペットを通して吸着中のベッドへ流す。流量は乗員数に応じて72 lb/hrまたは110 lb/hrである。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p28-L_flu" source="p28-B-FAN" target="p28-B-BED">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCRS-02&lt;br&gt;浄化空気" id="p28-IF-RCRS-02" link="docs/SSD-FD-ARS-RCRS-BED-001.html#IF-RCRS-02" tooltip="IF-RCRS-02：吸着中のベッドでCO2を除いた空気をARSの空気流へ戻し、キャビン熱交換器を通して乗員室へ送る。訓練マニュアル付録C.2.1は、戻す位置をキャビンファンのフィルタのすぐ上流（RCRSの吸込み位置とほぼ同じ所）とする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="p28-L_flu" source="p28-B-BED" target="p28-B-THC28">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCRS-03&lt;br&gt;真空排気" id="p28-IF-RCRS-03" link="docs/SSD-FD-ARS-RCRS-BED-001.html#IF-RCRS-03" tooltip="IF-RCRS-03：再生（脱着）中のベッドを機体の既存の真空ベント管へ開いて排気し、脱着したCO2を船外へ捨てる。標準構成では、パネルML31Cの真空ベント隔離弁を開にしておく（MAL 6.8a）。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p28-L_flu" source="p28-B-BED" target="p28-B-SPACE28">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCRS-04&lt;br&gt;空気回収" id="p28-IF-RCRS-04" link="docs/SSD-FD-ARS-RCRS-BED-001.html#IF-RCRS-04" tooltip="IF-RCRS-04：再生に入るベッドの空気をullage-save圧縮機が均圧弁（PEV）を通して75秒間吸い出し、初めの14.7 psiaから約3 psiaまで下げる。その後、均圧弁で両ベッドをつないで圧力をそろえ、再生に入るベッドに残る空気の半分を他方のベッドへ移す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p28-L_flu" source="p28-B-BED" target="p28-B-USC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCRS-05&lt;br&gt;弁駆動" id="p28-IF-RCRS-05" link="docs/SSD-FD-ARS-RCRS-CTL-001.html#IF-RCRS-05" tooltip="IF-RCRS-05：作動中の制御器が真空サイクル弁のアクチュエータA・Bを回し、ベッドの空気ポペットと真空ポペットを開閉して吸着と再生を切り替える。作動中の制御器の制御論理が、各構成品と計装に出力信号と電力を供給する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="p28-L_dat" source="p28-B-CTL" target="p28-B-BED">
            <mxGeometry relative="1" as="geometry" x="-0.2761">
              <Array as="points">
                <mxPoint x="1250" y="210" />
                <mxPoint x="360" y="210" />
                <mxPoint x="360" y="600" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCRS-06&lt;br&gt;弁・圧縮機指令" id="p28-IF-RCRS-06" link="docs/SSD-FD-ARS-RCRS-CTL-001.html#IF-RCRS-06" tooltip="IF-RCRS-06：2台の制御器が6個の均圧弁それぞれの2つのコイルを1つずつ受け持ち、作動中の制御器が工程に応じて均圧弁を開閉し、ullage-save圧縮機を動かす。圧縮機は起動30秒後にベッド圧が開始時の2/3未満に下がったかを確かめ、下がらなければ制御器を入れ直すか他方を選ぶまで止められる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.1071;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p28-L_dat" source="p28-B-CTL" target="p28-B-USC">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="1210" y="230" />
                <mxPoint x="640" y="230" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCRS-07&lt;br&gt;入口計測" id="p28-IF-RCRS-07" link="docs/SSD-FD-ARS-RCRS-FAN-001.html#IF-RCRS-07" tooltip="IF-RCRS-07：入口フィルタの差圧と入口空気温度を、共通計装のセンサで測る。SCOMの系統図は、RCRSのCO2分圧・入口温度・フィルタ差圧の計測点を示す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p28-L_flu" source="p28-B-FAN" target="p28-B-MON">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCRS-08&lt;br&gt;圧力計測" id="p28-IF-RCRS-08" link="docs/SSD-FD-ARS-RCRS-BED-001.html#IF-RCRS-08" tooltip="IF-RCRS-08：各制御器が給電するベッドの圧力センサとベッド差圧センサ、共通計装の真空圧力センサで、ベッドと真空側の圧力を測る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p28-L_flu" source="p28-B-BED" target="p28-B-MON">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="640" y="530" />
                <mxPoint x="1210" y="530" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCRS-09&lt;br&gt;故障検知入力" id="p28-IF-RCRS-09" link="docs/SSD-FD-ARS-RCRS-MON-001.html#IF-RCRS-09" tooltip="IF-RCRS-09：ベッド圧力・ベッド差圧などの計測値を作動中の制御器へ入力し、故障検知に使う。自動停止の論理は、ベッド圧力・ベッド差圧・圧縮機回転数・弁位置の表示が許容できないとRCRSを停止する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p28-L_dat" source="p28-B-MON" target="p28-B-CTL">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCRS-10&lt;br&gt;RCRS計測値" id="p28-IF-RCRS-10" link="docs/SSD-FD-ARS-RCRS-MON-001.html#IF-RCRS-10" tooltip="IF-RCRS-10：RCRSの計測値（FILTER ΔP、PPCO2、TEMP、BED A・B PRESS、ΔP、VAC PRESS）をSMへ送り、SPEC 66 ENVIRONMENTの右下に表示する。SPEC 66はOPS 2・4で表示でき、共通計装の値はシステム評価のためにダウンリンクされる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.84;entryDx=0;entryDy=0;" edge="1" parent="p28-L_dat" source="p28-B-MON" target="p28-B-DPS28">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCRS-11&lt;br&gt;制御器状態" id="p28-IF-RCRS-11" link="docs/SSD-FD-ARS-RCRS-CTL-001.html#IF-RCRS-11" tooltip="IF-RCRS-11：制御器の状態をSPEC 66のCO2 CNTLR 1・2に示し、故障で停止すると故障ディスクリートのテレメトリを6秒間「1」にする。SMメッセージ「S66 CO2 RL SYS」は、制御器が故障したか、故障検知の論理がベッドの圧力異常を検知したときに出る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.24;entryDx=0;entryDy=0;" edge="1" parent="p28-L_dat" source="p28-B-CTL" target="p28-B-DPS28">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCRS-12&lt;br&gt;AC・DC電源" id="p28-IF-RCRS-12" link="docs/SSD-FD-ARS-RCRS-CTL-001.html#IF-RCRS-12" tooltip="IF-RCRS-12：制御器1にはAC1とMN A、制御器2にはAC3とMN Cの電力を、パネルMO51Fの交流遮断器・電源スイッチとパネルML86B:Eの直流遮断器を通して供給する。SCOMは、制御器1・2のAC・DC電源をパネルMO51Fで操作するとする。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.3333;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="p28-L_pow" source="p28-B-EPS28" target="p28-B-CTL">
            <mxGeometry relative="1" as="geometry" x="0.6157">
              <Array as="points">
                <mxPoint x="1480" y="820" />
                <mxPoint x="1480" y="430" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCRS-13&lt;br&gt;MN B電源" id="p28-IF-RCRS-13" link="docs/SSD-FD-ARS-RCRS-MON-001.html#IF-RCRS-13" tooltip="IF-RCRS-13：共通計装のセンサには、パネルML86Bの遮断器からMO51Fの共通計装電源スイッチを通して給電する。共通計装のセンサはMN Bから給電される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p28-L_pow" source="p28-B-EPS28" target="p28-B-MON">
            <mxGeometry relative="1" as="geometry" x="-0.44">
              <Array as="points">
                <mxPoint x="1440" y="860" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCRS-14&lt;br&gt;起動・停止" id="p28-IF-RCRS-14" link="docs/SSD-FD-ARS-RCRS-OPS-001.html#IF-RCRS-14" tooltip="IF-RCRS-14：運用規則と故障処置手順に従い、パネルMO51Fのモードスイッチ（OPER/STBY）と電源スイッチで制御器を起動・停止し、故障時は他方の制御器に切り替える。一方の制御器だけの故障では、他方の制御器（SYS 2(1)）で運転を続ける。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p28-L_dat" source="p28-B-OPS" target="p28-B-CTL">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCRS-15&lt;br&gt;表示・警報" id="p28-IF-RCRS-15" link="docs/SSD-FD-ARS-RCRS-MON-001.html#IF-RCRS-15" tooltip="IF-RCRS-15：PPCO2とRCRSの表示・SMメッセージを、RCRSの喪失判定（PPCO2 7.6 mmHg、PPCO2の把握）と故障処置の判断に使う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p28-L_dat" source="p28-B-MON" target="p28-B-OPS">
            <mxGeometry relative="1" as="geometry" x="0.1935">
              <Array as="points">
                <mxPoint x="1250" y="470" />
                <mxPoint x="1040" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CAC-03&lt;br&gt;RCRS通気" id="p28-IF-CAC-03" link="docs/SSD-FD-CAC-RTN-001.html#IF-CAC-03" tooltip="IF-CAC-03：RCRS搭載時は、キャビンファンの上流からキャビン空気の一部（ARSの全流量の約6%）をRCRSへ引き出し、除去後の空気をファンのフィルタのすぐ上流に戻す。RCRSの流量は乗員数に応じて72 lb/hrまたは110 lb/hrに設定する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p28-L_flu" source="p28-B-CAC28" target="p28-B-FAN">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
