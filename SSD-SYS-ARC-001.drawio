        <UserObject label="IF-PLS-08&lt;br&gt;初期化・点検" id="p66-IF-PLS-08" link="docs/SSD-FD-PLS-OPS-001.html#IF-PLS-08" tooltip="IF-PLS-08：RMSの運用の前に、肩のブレースの解除、MPMの展開、SPEC 94の呼出しとSM GPCとのインタフェースの確立を行う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p66-L_dat" source="p66-B-OPS" target="p66-B-CTL">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-PLS-09&lt;br&gt;ラッチ管理" id="p66-IF-PLS-09" link="docs/SSD-FD-PLS-OPS-001.html#IF-PLS-09" tooltip="IF-PLS-09：展開するペイロードのPRLA・AKAは、回収が選択肢でなくなるまで閉じない。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p66-L_dat" source="p66-B-OPS" target="p66-B-PRL">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-13&lt;br&gt;RMS（MCIU）" id="p66-IF-DPS-13" link="docs/SSD-FD-DPS-FSW-001.html#IF-DPS-13" tooltip="IF-DPS-13：RMSのMCIUは、SM GPC、表示・操作器、RMSの間の情報のやり取りを取り扱って評価する。打上げデータバス1は、軌道上でSM GPCがRMSの制御器とのインタフェースに使う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p66-L_dat" source="p66-B-DPS66" target="p66-B-CTL">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-11&lt;br&gt;RMS/ODS映像" id="p66-IF-CT-11" link="docs/SSD-FD-CT-CCTV-001.html#IF-CT-11" tooltip="IF-CT-11：RMSのエンドエフェクタの固定カメラ（ズーム可）と肘の下のパン・チルト付きカメラの映像をCCTVに取り込み、PDRSの作業を監視する。ドッキングミッションでは、ODSに取り付けたCTVCをセンタラインカメラとして使う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="p66-L_dat" source="p66-B-ARM" target="p66-B-CT66">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-12&lt;br&gt;手動操作" id="p66-IF-EVA-12" link="docs/SSD-FD-EVA-EMG-001.html#IF-EVA-12" tooltip="IF-EVA-12：RMS・PRLAの故障時に、RMSの固縛、MPMの手動での格納・展開、関節の位置合わせ、グラプル軸の解放、PRLAの手動での開閉をEVAで行う。ODSとPMAの捕獲ラッチも、EVAで手動で解放できる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p66-L_str" source="p66-B-EVA66" target="p66-B-OPS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
