        <UserObject label="IF-SRB-01&lt;br&gt;前部結合" id="p74-IF-SRB-01" link="docs/SSD-FD-SRB-ATT-001.html#IF-SRB-01" tooltip="IF-SRB-01：前部の結合点は、1本のボルトで保持されたSRBの玉とETの受けから成り、射場安全系のクロスストラップの配線も通す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p74-L_str" source="p74-B-ATT" target="p74-B-ET74">
            <mxGeometry relative="1" as="geometry" x="-0.2" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-SRB-02&lt;br&gt;後部支柱" id="p74-IF-SRB-02" link="docs/SSD-FD-SRB-ATT-001.html#IF-SRB-02" tooltip="IF-SRB-02：後部の結合点は上・斜め・下の3本の支柱から成り、上の支柱はSRBとETからオービタへのアンビリカルも通す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.3571;exitY=0;exitDx=0;exitDy=0;entryX=0.3571;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p74-L_str" source="p74-B-ATT" target="p74-B-ET74">
            <mxGeometry relative="1" as="geometry" x="0.6" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-SRB-03&lt;br&gt;保持ポスト" id="p74-IF-SRB-03" link="docs/SSD-FD-SRB-HDP-001.html#IF-SRB-03" tooltip="IF-SRB-03：各SRBの4つの保持ポストは移動発射台の支持ポストに合わさり、保持ボルトで固定される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="p74-L_str" source="p74-B-HDP" target="p74-B-KSC74">
            <mxGeometry relative="1" as="geometry" x="0.2051">
              <Array as="points">
                <mxPoint x="1560" y="600" />
                <mxPoint x="1560" y="330" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-SRB-04&lt;br&gt;ノズル駆動" id="p74-IF-SRB-04" link="docs/SSD-FD-SRB-TVC-001.html#IF-SRB-04" tooltip="IF-SRB-04：ロックとチルトのサーボアクチュエータが、推力方向制御のためにノズルをジンバルさせる力と制御を与える。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B3FA0;strokeWidth=2;fontColor=#7B3FA0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p74-L_hyd" source="p74-B-TVC" target="p74-B-MTR">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="640" y="470" />
                <mxPoint x="1210" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-SRB-05&lt;br&gt;APU制御" id="p74-IF-SRB-05" link="docs/SSD-FD-SRB-AVN-001.html#IF-SRB-05" tooltip="IF-SRB-05：APUの制御器の電子装置は、ETの後部結合リングにあるSRBの後部IEAに置かれる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p74-L_dat" source="p74-B-AVN" target="p74-B-TVC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-SRB-06&lt;br&gt;点火" id="p74-IF-SRB-06" link="docs/SSD-FD-SRB-HDP-001.html#IF-SRB-06" tooltip="IF-SRB-06：点火では、PICがS&amp;A装置の火工品を点火し、S&amp;Aの薬が起爆剤を、起爆剤がモータの点火器を、点火器がモータの推進薬を点火する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p74-L_dat" source="p74-B-HDP" target="p74-B-MTR">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-SRB-07&lt;br&gt;燃焼圧" id="p74-IF-SRB-07" link="docs/SSD-FD-SRB-MTR-001.html#IF-SRB-07" tooltip="IF-SRB-07：SRBの分離は、両方のSRBの頭部の燃焼圧が50 psi以下になったときに始まる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p74-L_dat" source="p74-B-MTR" target="p74-B-ATT">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-SRB-08&lt;br&gt;回収電源" id="p74-IF-SRB-08" link="docs/SSD-FD-SRB-AVN-001.html#IF-SRB-08" tooltip="IF-SRB-08：各SRBの回収用電池はRSSの系統Bと回収系に給電し、分離の手順で回収系の電源が入る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p74-L_pow" source="p74-B-AVN" target="p74-B-REC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EPS-11&lt;br&gt;28 VDC配電" id="p74-IF-EPS-11" link="docs/SSD-FD-EPS-DC-001.html#IF-EPS-11" tooltip="IF-EPS-11：EPDCは、28 V直流電力をオービタ各系、SRB、外部タンク、ペイロードへ制御・分配する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="p74-L_pow" source="p74-B-EPS74" target="p74-B-AVN">
            <mxGeometry relative="1" as="geometry" x="-0.5">
              <Array as="points">
                <mxPoint x="360" y="820" />
                <mxPoint x="360" y="730" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-07&lt;br&gt;SRB MDM" id="p74-IF-DPS-07" link="docs/SSD-FD-DPS-ASC-001.html#IF-DPS-07" tooltip="IF-DPS-07：打上げデータバスで5台のGPCを左右のSRBにある4台のMDM（LL1・LL2・LR1・LR2）に結ぶ。SRB MDMはSRB内で受動のコールドプレートで冷やされ、オービタの主母線につながるSRBバスA・Bから給電される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.2407;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p74-L_dat" source="p74-B-DPS74" target="p74-B-AVN">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-08&lt;br&gt;点火・分離" id="p74-IF-DPS-08" link="docs/SSD-FD-DPS-ASC-001.html#IF-DPS-08" tooltip="IF-DPS-08：固体ロケットモータの点火指令を、GPCからMECを通じて各SRBのS&amp;A装置のNSI起爆器へ送る。SRB分離シーケンスがオービタから出す分離指令で、各ボルトのNSI圧力カートリッジを起爆し、ブースタ分離モータに点火する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.7685;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p74-L_dat" source="p74-B-DPS74" target="p74-B-HDP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-18&lt;br&gt;SRBジンバル" id="p74-IF-GNC-18" link="docs/SSD-FD-GNC-ACT-001.html#IF-GNC-18" tooltip="IF-GNC-18：ATVCは各SRBの2基のTVC作動器へ指令電圧を送り、SRBの作動器はピッチ・ヨーに45°傾いたロック軸とチルト軸でノズルを動かす。第1段のステアリングは、主にSRBのノズルをジンバルさせて行う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.36;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="p74-L_dat" source="p74-B-GNC74" target="p74-B-TVC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-19&lt;br&gt;SRB角速度" id="p74-IF-GNC-19" link="docs/SSD-FD-GNC-FCS-001.html#IF-GNC-19" tooltip="IF-GNC-19：各SRBの前部スカートにある2台のSRB RGAは、角速度に比例する電圧をフライトアフトMDMを経てGPCのSRB RGA SOPへ送る。SRB RGAは1回の飛行より多く使ってはならない。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.84;entryDx=0;entryDy=0;" edge="1" parent="p74-L_dat" source="p74-B-AVN" target="p74-B-GNC74">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;図示を省略したIF（文書・図5に記載）&lt;/b&gt;&lt;br&gt;なし（IF-SRB-01〜08 をすべて図示）&lt;br&gt;&lt;br&gt;他の図・段と同じ物理IFのため、その番号のまま描いたIF：IF-EPS-11・IF-DPS-07（図48）・IF-DPS-08（図48）・IF-GNC-18（図46）・IF-GNC-19（図46）&lt;br&gt;&lt;br&gt;各ブロックの「関連文書」ボタンは、機能別関連文書一覧（SSD-SRB-REF-001）の該当節を開きます。" id="p74-v-31" link="data:page/id,p5-register" tooltip="図5のIF一覧へ">
          <mxCell style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#FAFBFC;strokeColor=#9AA3AE;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#3B4654;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1175" y="950" width="310" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="▲ 図1 システム構成へ" id="p74-v-32" link="data:page/id,p1-system" tooltip="クリックでページ移動">
          <mxCell style="rounded=1;arcSize=25;html=1;fillColor=#15202B;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1540" y="40" width="300" height="32" as="geometry" />
          </mxCell>
