            <mxGeometry x="140" y="1360" width="130" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p109-v-239" value="ISS に係留する飛行では ISS の CO2 除去で LiOH を節約でき（STS-108 で12個不要）、ドッキングの有無を変数にできる" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="270" y="1360" width="1170" height="24" as="geometry" />
        </mxCell>
