        <UserObject label="" id="p152-v-22" link="" tooltip="LM-02 AL-SH-2 → AL-STD-4（一部）：C&amp;W トーン（400/1024 Hz を 2.5 Hz で交互）は警告の音と同じで、F7 の赤の灯（警告灯）は Table 10.4-3 の赤＝警告と合う。し">
          <mxCell style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C79100;strokeWidth=1.8;fontColor=#C79100;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p152-v-9" target="p152-v-17">
