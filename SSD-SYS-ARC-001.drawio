          <mxGeometry relative="1" as="geometry">
            <mxPoint x="356" y="1282" as="sourcePoint" />
            <mxPoint x="412" y="1282" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p24-v-50" value="データ・指令" style="text;html=1;fontSize=12;align=left;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="420" y="1271" width="170" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p24-e-51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="356" y="1310" as="sourcePoint" />
            <mxPoint x="412" y="1310" as="targetPoint" />
          </mxGeometry>
