        <UserObject label="IF-CW-01&lt;br&gt;ESS 1BC・2CA" id="p62-IF-CW-01" link="docs/SSD-FD-CW-PRI-001.html#IF-CW-01" tooltip="IF-CW-01：C/W電子装置の電源AはESS 1BCからC/W A遮断器、電源BはESS 2CAからC/W B遮断器（パネルO13）を経て受電する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0.1071;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p62-L_pow" source="p62-B-EPS62" target="p62-B-PRI">
            <mxGeometry relative="1" as="geometry" x="0.1029">
              <Array as="points">
                <mxPoint x="640" y="230" />
                <mxPoint x="1210" y="230" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CW-02&lt;br&gt;ECLSS値" id="p62-IF-CW-02" link="docs/SSD-FD-CW-PRI-001.html#IF-CW-02" tooltip="IF-CW-02：主C/Wの入力には、客室圧力・PPO2・O2/N2流量・フレオンループ流量・水ループのポンプ出口圧などのECLSSのパラメータがある。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.4545;exitDx=0;exitDy=0;entryX=0.6429;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-ECL62" target="p62-B-PRI">
            <mxGeometry relative="1" as="geometry" x="0.3667">
              <Array as="points">
                <mxPoint x="1360" y="840" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CW-03&lt;br&gt;煙・急減圧" id="p62-IF-CW-03" link="docs/SSD-FD-CW-ANN-001.html#IF-CW-03" tooltip="IF-CW-03：煙検知器が煙濃度2,000（±200）μg/m3を5秒以上検知するとSMOKE DETECTION灯・MASTER ALARM灯・サイレンを作動させる。ΔP/Δtセンサは客室圧力の変化率が-0.08 psi/minを超える減圧でMASTER ALARM灯とクラクソンを作動させる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.8182;exitDx=0;exitDy=0;entryX=1;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-ECL62" target="p62-B-ANN">
            <mxGeometry relative="1" as="geometry" x="-0.2424">
              <Array as="points">
                <mxPoint x="1080" y="880" />
                <mxPoint x="1080" y="740" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CW-04&lt;br&gt;主C/W発報" id="p62-IF-CW-04" link="docs/SSD-FD-CW-PRI-001.html#IF-CW-04" tooltip="IF-CW-04：主C/Wの警報ではF7の該当灯・4つのMASTER ALARM灯・C/Wトーンが作動し、GPCの故障メッセージは出ない。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-PRI" target="p62-B-ANN">
            <mxGeometry relative="1" as="geometry" x="0.4412">
              <Array as="points">
                <mxPoint x="1250" y="610" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CW-05&lt;br&gt;B/U発報" id="p62-IF-CW-05" link="docs/SSD-FD-CW-BKP-001.html#IF-CW-05" tooltip="IF-CW-05：GPCは前方またはペイロードのMDMを経てC/W系A・Bの両方に信号を送り、MASTER ALARM灯・B/U C&amp;W灯・C/Wトーンを作動させる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-BKP" target="p62-B-ANN">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CW-06&lt;br&gt;SMアラート" id="p62-IF-CW-06" link="docs/SSD-FD-CW-ALT-001.html#IF-CW-06" tooltip="IF-CW-06：アラートの限界外れでは主C/Wへ離散信号が送られてアラートトーンが鳴り、F7の青いSM ALERT灯が点灯する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-ALT" target="p62-B-ANN">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CW-07&lt;br&gt;R13U設定" id="p62-IF-CW-07" link="docs/SSD-FD-CW-OPS-001.html#IF-CW-07" tooltip="IF-CW-07：パネルR13UのPARAMETER SELECTのつまみが、パラメータの有効化・抑止と限界の設定・読出しのためにC/W電子装置へ信号を送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-OPS" target="p62-B-PRI">
            <mxGeometry relative="1" as="geometry" x="-0.3516">
              <Array as="points">
                <mxPoint x="640" y="480" />
                <mxPoint x="1210" y="480" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-CW-08&lt;br&gt;SPEC 60" id="p62-IF-CW-08" link="docs/SSD-FD-CW-OPS-001.html#IF-CW-08" tooltip="IF-CW-08：SPEC 60では、PASS SMのバックアップC/W・アラートの各パラメータの上下限・ノイズフィルタ値・有効/抑止を読み、変えられる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-OPS" target="p62-B-BKP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CW-09&lt;br&gt;定数変更" id="p62-IF-CW-09" link="docs/SSD-FD-CW-OPS-001.html#IF-CW-09" tooltip="IF-CW-09：アラートの前提条件付けに使う定数は、乗員またはMCCがSPEC 60で変えられるが、変えることはまれである。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-OPS" target="p62-B-ALT">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-20&lt;br&gt;FCS警報" id="p62-IF-GNC-20" link="docs/SSD-FD-GNC-ACT-001.html#IF-GNC-20" tooltip="IF-GNC-20：ASAがサーボ弁をバイパスするとパネルF7の黄色のFCS CHANNEL警報灯が、エレボンの位置またはヒンジモーメントが飽和すると赤のFCS SATURATION警報灯が点灯する。主C&amp;Wのハードウェアの表には、FCS SATURATION・FCS CH BYPASSのほか、IMU・ADTA・RGA/AA・L RHC・R/AFT RHC・OMS TVCのチャネルがある。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.9048;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-GNC62" target="p62-B-PRI">
            <mxGeometry relative="1" as="geometry" x="-0.375">
              <Array as="points">
                <mxPoint x="1480" y="480" />
                <mxPoint x="1480" y="440" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-11&lt;br&gt;C&amp;amp;W入力" id="p62-IF-DPS-11" link="docs/SSD-FD-DPS-BUS-001.html#IF-DPS-11" tooltip="IF-DPS-11：主C&amp;Wの120入力のうち、5入力はGPCの入出力プロセッサから、15入力はMDMから受け、98入力はトランスデューサから直接受ける。一部の入力は、GPCから飛行前方（FF）MDMを経由して主C&amp;Wに入る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.6912;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-DPS62" target="p62-B-PRI">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-12&lt;br&gt;予備C&amp;amp;W・警報" id="p62-IF-DPS-12" link="docs/SSD-FD-DPS-FSW-001.html#IF-DPS-12" tooltip="IF-DPS-12：GPCはMDMを通じた12の離散入力でC&amp;Wのマスタアラームの論理回路を使い、6つで予備C&amp;W灯とC&amp;W音（クラス2）を、6つでSMアラート音（クラス3）を作動させる。FDAソフトウェアが限界外を検出すると、DPS表示に故障メッセージを出し、前方またはペイロードMDM経由でC&amp;W系A・Bに信号を送ってMASTER ALARM灯・予備C&amp;W灯・警報音を作動させる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.3824;exitY=1;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-DPS62" target="p62-B-BKP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-07&lt;br&gt;He圧警報" id="p62-IF-MPS-07" link="docs/SSD-FD-MPS-HE-001.html#IF-MPS-07" tooltip="IF-MPS-07：ヘリウムのタンク圧（1,150 psia未満）と調圧器Aの圧力（680 psia未満・810 psia超）の限界逸脱は、パネルF7のC/WマトリクスのMPSライト（赤）を点灯させる。ハードウェアC&amp;Wでは、中央・左・右のヘリウムのタンク圧と調圧器圧がそれぞれ別のチャネルに割り当てられている。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-MPS62" target="p62-B-PRI">
            <mxGeometry relative="1" as="geometry" x="-0.5">
              <Array as="points">
                <mxPoint x="1440" y="600" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-14&lt;br&gt;エンジン異常" id="p62-IF-OMS-14" link="docs/SSD-FD-OMS-ENG-001.html#IF-OMS-14" tooltip="IF-OMS-14：エンジンを点火すべきときに燃焼室圧が80%未満か、停止すべきときに80%超になると、パネルF7のLEFT・RIGHT OMS警報灯が点灯する。C/Wのハードウェアのチャネルは、OMS ENG-Lが27、OMS ENG-Rが57である。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.7857;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-OMS62" target="p62-B-PRI">
            <mxGeometry relative="1" as="geometry" x="0.4091">
              <Array as="points">
                <mxPoint x="1400" y="720" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-RCS-15&lt;br&gt;温度警報" id="p62-IF-RCS-15" link="docs/SSD-FD-RCS-HTR-001.html#IF-RCS-15" tooltip="IF-RCS-15：構造の温度がI-loadの上下限を超えると、SMアラート「S89 PRPLT THRM RCS」を出す（OPS 2）。故障処置10.3aでは、前部RCSの燃料（酸化剤）の温度が46°F未満か105°F超などで処置に入り、他方のヒータ系に切り替えて原因を切り分ける。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-RCS62" target="p62-B-ALT">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-15&lt;br&gt;過速度・低速度" id="p62-IF-APU-15" link="docs/SSD-FD-APU-CTL-001.html#IF-APU-15" tooltip="IF-APU-15：APU制御器が監視する回転数が80%未満または129%超になると、自動停止の有効・禁止によらずF7のAPU UNDERSPEED・APU OVERSPEEDの警報灯が点灯し、警報音が出る。主C/WのハードウェアにはAPU 1〜3のOVERSPEED（チャンネル68・78・88）とUNDERSPEED（98・108・118）が割り当てられている。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.5714;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-APU62" target="p62-B-PRI">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-CT-09&lt;br&gt;C/Wトーン" id="p62-IF-CT-09" link="docs/SSD-FD-CT-AUD-001.html#IF-CT-09" tooltip="IF-CT-09：C&amp;W電子ユニットの2台のトーン発生器（A・B）は、クラクソン・サイレン・C&amp;Wトーン・アラートトーンをパネルR13Uの音量調整器を通してACCUへ送り、ACCUがヘッドセットと各スピーカユニットの1基のスピーカへ配る。クラクソン（乗員室の圧力）とサイレン（火災）のC/W信号は、スピーカの電源が切れていても直接スピーカユニットへ送られる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-ANN" target="p62-B-CT62">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-EVA-15&lt;br&gt;限界値" id="p62-IF-EVA-15" link="docs/SSD-FD-EVA-OPS-001.html#IF-EVA-15" tooltip="IF-EVA-15：10.2 psiへの減圧、10.2 psiでの運用、14.7 psiへの再与圧の各段階でキャビン圧・PPO2などのC/W・FDAの限界値を設定し直し、MCCがB/U C/WとSMアラートの限界値を送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p62-L_dat" source="p62-B-EVA62" target="p62-B-OPS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;図示を省略したIF（文書・図5に記載）&lt;/b&gt;&lt;br&gt;MPS-08・OMS-15・OMS-16・RCS-12・RCS-13・RCS-14・APU-16&lt;br&gt;&lt;br&gt;他の図・段と同じ物理IFのため、その番号のまま描いたIF：IF-GNC-20（図46）・IF-DPS-11（図48）・IF-DPS-12（図48）・IF-MPS-07（図50）・IF-MPS-08（図50）・IF-OMS-14（図52）・IF-OMS-15（図52）・IF-OMS-16（図52）・IF-RCS-12（図54）・IF-RCS-13（図54）・IF-RCS-14（図54）・IF-RCS-15（図54）・IF-APU-15（図56）・IF-APU-16（図56）・IF-CT-09（図58）・IF-EVA-15（図60）&lt;br&gt;&lt;br&gt;各ブロックの「関連文書」ボタンは、機能別関連文書一覧（SSD-CW-REF-001）の該当節を開きます。" id="p62-v-38" link="data:page/id,p5-register" tooltip="図5のIF一覧へ">
