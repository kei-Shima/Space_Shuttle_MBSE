          <mxGeometry x="950" y="1248" width="100" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p39-v-259" value="同じ根拠の行が隣り合う列にまたがるときは、セルを横につないで示す。EVA と離脱準備は時間的には軌道フェーズの一部。アボートの列で SCOM にアボート固有の記述が無い系は「上昇・再突入と同じ」「通常と同じ」とした（定義書 8節）。アボートの境界と時刻は飛行ごとに異なる。" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#1B2430;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="56" y="1292" width="1070" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p39-v-260" value="&lt;b&gt;集計&lt;/b&gt;&lt;br&gt;要素 21（オービタ16・外部5）&lt;br&gt;列 16（フェーズ12・アボート4）&lt;br&gt;根拠の行 184（定義書 6節）&lt;br&gt;セル 198" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FFFFFF;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1160" y="1210" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p39-v-261" value="&lt;table style='border-collapse:collapse;width:100%;font-size:11px;text-align:left;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;文書番号&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;SSD-SYS-ARC-001&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;表題&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;スペースシャトル システム構成図（機能ブロック・インタフェース図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;図番&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;図39 フェーズ別 サブシステム稼働表（全158図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;版・日付&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;Rev. BF／2026-10-07&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;状態&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;検討用（公開資料に基づく）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;作成／確認／承認&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;　　　／　　　／　　　&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15202B;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1488" y="1380" width="430" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p40-ascent-seq" name="図40 上昇シーケンス">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2012" pageHeight="1296" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" value="ブロック・注記" parent="0" />
        <mxCell id="p40-L_pow" value="IF：電力（28 VDC）" parent="0" />
        <mxCell id="p40-L_dat" value="IF：データ・指令" parent="0" />
        <mxCell id="p40-L_flu" value="IF：推進薬・流体" parent="0" />
        <mxCell id="p40-L_thm" value="IF：熱" parent="0" />
        <mxCell id="p40-L_hyd" value="IF：油圧" parent="0" />
        <mxCell id="p40-L_rf" value="IF：RF（無線）" parent="0" />
        <mxCell id="p40-L_str" value="IF：構造・荷重" parent="0" />
        <mxCell id="p40-v-1" value="&lt;div style='font-size:22px;font-weight:bold;'&gt;SSD-SYS-ARC-001　図40 上昇シーケンス（T-9分〜OMS-2）&lt;/div&gt;&lt;div style='font-size:12px;color:#3B4654;margin-top:4px;'&gt;列＝上昇の主な事象（SSD-OPS-PHASE-001 の5節 EV-01〜16）、行＝その間に有効になる・切れるIF。帯はIFが有効な区間、◆は指令・切替の時点。帯・◆・行の見出しをクリックすると所有文書のIFの行を開きます。&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1362" height="64" as="geometry" />
        </mxCell>
        <UserObject label="▲ 図2 オービタへ" id="p40-v-2" link="data:page/id,p2-orbiter" tooltip="クリックでページ移動">
          <mxCell style="rounded=1;arcSize=25;html=1;fillColor=#15202B;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1412" y="24" width="180" height="32" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="■ 図5 一覧へ" id="p40-v-3" link="data:page/id,p5-register" tooltip="クリックでページ移動">
          <mxCell style="rounded=1;arcSize=25;html=1;fillColor=#15202B;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1602" y="24" width="180" height="32" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="◀ 図39 稼働表へ" id="p40-v-4" link="data:page/id,p39-phase-matrix" tooltip="クリックでページ移動">
          <mxCell style="rounded=1;arcSize=25;html=1;fillColor=#15202B;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1792" y="24" width="180" height="32" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p40-v-5" value="フェーズ" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#15202B;strokeColor=#15202B;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="300" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p40-v-6" value="IF ＼ 事象" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#15202B;strokeColor=#15202B;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="176" width="300" height="96" as="geometry" />
        </mxCell>
        <UserObject label="打上げ前&lt;br&gt;（T-9分より前）" id="p40-v-7" link="docs/SSD-OPS-PHASE-001.html#PH-1" tooltip="PH-1（クリックで定義書の該当行を開く）">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=1;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="340" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;T-9分&lt;/b&gt;&lt;br&gt;打上げ GO・タイマ始動" id="p40-v-8" link="docs/SSD-OPS-PHASE-001.html#EV-01" tooltip="EV-01：T-9 分で打上げの GO が出て、イベントタイマを始動する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=0;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="436" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;T-8分&lt;/b&gt;&lt;br&gt;必須母線を燃料電池へ" id="p40-v-9" link="docs/SSD-OPS-PHASE-001.html#EV-02" tooltip="EV-02：T-8 分に操縦手が必須母線を燃料電池に接続する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=0;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="532" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;T-5分&lt;/b&gt;&lt;br&gt;APU 起動（3基）" id="p40-v-10" link="docs/SSD-OPS-PHASE-001.html#EV-03" tooltip="EV-03：T-6:15 に APU の起動前準備を行い、T-5 分に操縦手が APU を起動して圧力を確かめる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=0;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="628" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;T-2分55秒&lt;/b&gt;&lt;br&gt;ET の LO2・LH2 を加圧" id="p40-v-11" link="docs/SSD-OPS-PHASE-001.html#EV-04" tooltip="EV-04：T-2 分55 秒に打上げ処理システムが液体酸素タンクのベント弁を閉じ、地上支援設備のヘリウムで 21 psig に加圧する。T-1 分57 秒には液体水素タンクを 42 psig に加圧する。 打上げ前は地上支援設備が燃料電池の反応剤を補給して搭載量を満たし、T-2分35秒で充填を終える。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=0;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="724" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;T-50秒&lt;/b&gt;&lt;br&gt;燃料電池が全電力を発電" id="p40-v-12" link="docs/SSD-OPS-PHASE-001.html#EV-05" tooltip="EV-05：3基の燃料電池は、打上げの50秒前から着陸の滑走終了まで機体の 28 V 直流電力のすべてを発電し、それ以前は地上電源と燃料電池が電力を供給する。 後部電力制御組立の電力接触器は、燃料電池が給電を引き継ぐまで、地上から T-0 アンビリカルを通じて 28 V 直流電力を配電する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=0;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="820" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;T-31秒&lt;/b&gt;&lt;br&gt;機上の RSLS へ移管" id="p40-v-13" link="docs/SSD-OPS-PHASE-001.html#EV-06" tooltip="EV-06：T-31 秒に打上げ処理システムが機上の冗長セット打上げシーケンス（RSLS）を有効にし、以後の手順は GPC が機上の時計で行う。GPC は打上げ処理システムからのホールド・再開・リサイクルの指令にはなお応じる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=0;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="916" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;T-6.6秒&lt;/b&gt;&lt;br&gt;SSME 始動指令" id="p40-v-14" link="docs/SSD-OPS-PHASE-001.html#EV-07" tooltip="EV-07：T-6.6 秒に GPC がエンジン始動を指令し、各エンジンの主燃料弁が開く。主燃料弁の開から MECO まで、液体水素が外部タンクから流れる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=0;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1012" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;T-0&lt;/b&gt;&lt;br&gt;SRB 点火・ホールドダウン解放・T-0 切離し" id="p40-v-15" link="docs/SSD-OPS-PHASE-001.html#EV-08" tooltip="EV-08：3基の SSME が T-3 秒までに定格推力の 90% に達すると、T-0 で GPC が SRB 点火、ホールドダウン解放、T-0 アンビリカル切離しの火工品制御器の点火を指令する。 T-0 から、SSME のジンバルアクチュエータは点火前の固定位置から中立位置に戻り、以後は推力方向制御のために動く。 固体ロケットモータの点火指令は、オービタのコンピュータから MEC を通じて各 SRB の S&amp;A 装置の NSI 起爆器へ送られる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=0;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1108" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;MET 0:30〜1:05&lt;/b&gt;&lt;br&gt;スロットルバケット・最大動圧" id="p40-v-16" link="docs/SSD-OPS-PHASE-001.html#EV-09" tooltip="EV-09：動圧の上昇に合わせて GPC はエンジンを通常 72% に絞り、最大動圧の領域での構造荷重を抑える。この推力の谷は通常 MET 約30〜65秒である。 最大動圧は通常、離昇の30〜60秒後に達する。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=0;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1204" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;MET 約2:00&lt;/b&gt;&lt;br&gt;SRB 分離（MM 103・FES 起動）" id="p40-v-17" link="docs/SSD-OPS-PHASE-001.html#EV-10" tooltip="EV-10：両 SRB の室圧が 50 psi を下回ると SRB 分離が始まり、分離の間は前方 RCS の上向きジェット3基が操縦室の窓を破片から守るために噴射する。 オービタの SRB 分離シーケンスが出す分離指令が各ボルトの NSI 起爆器を作動させ、分離モータを点火する。上部ストラットは SRB と外部タンク・オービタの間のアンビリカルも通している。 SRB 分離でフラッシュエバポレータ（FES）が BFS から GPC ON 指令を受け、能動冷却を始める。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=0;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1300" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;MET 約7:30&lt;/b&gt;&lt;br&gt;3g 制限・S帯を TDRS へ" id="p40-v-18" link="docs/SSD-OPS-PHASE-001.html#EV-11" tooltip="EV-11：MET 約7分30秒から、機体の加速度を 3g 以下に保つためにエンジンを絞る。 S帯 PM 通信は、BFS の保存プログラム指令で STDN から TDRS のモードに切り替わる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=0;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1396" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;MET 約8:30&lt;/b&gt;&lt;br&gt;主エンジン停止（MECO）" id="p40-v-19" link="docs/SSD-OPS-PHASE-001.html#EV-12" tooltip="EV-12：GPC は通常、機体が所定の速度に達すると MECO を指令する。 MECO の速度は約 25,820 fps である。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=0;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1492" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;MECO 後&lt;/b&gt;&lt;br&gt;ET 分離（-Z 並進・MM 104）" id="p40-v-20" link="docs/SSD-OPS-PHASE-001.html#EV-13" tooltip="EV-13：オービタの GPC が外部タンク分離を指令すると、アンビリカル板を結合するボルトが火工品で切断される。外部タンクの2本の電気アンビリカルは、オービタからタンクと SRB への電力と、SRB・タンクからの情報を通している。 ET 分離では -Z 方向の並進を行い、その完了で GNC はメジャーモード 104 に遷移する。 前方・後方の RCS ジェットは、分離時にオービタを外部タンクから遠ざける並進と姿勢制御を行う。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=0;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1588" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;MECO+2分&lt;/b&gt;&lt;br&gt;MPS 推進薬の投棄" id="p40-v-21" link="docs/SSD-OPS-PHASE-001.html#EV-14" tooltip="EV-14：直接投入では、MECO の2分後に MPS 推進薬の投棄が自動で始まる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=0;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1684" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;MET 約12:55&lt;/b&gt;&lt;br&gt;APU 停止・ET アンビリカル扉閉" id="p40-v-22" link="docs/SSD-OPS-PHASE-001.html#EV-15" tooltip="EV-15：MPS の投棄が終わると油圧の MPS/TVC 隔離弁を閉じ、MCC と確認して APU を停止する。 操縦手は MPS エンジンの電源を切って GH2 を不活性化し、ET アンビリカル扉を閉じる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=0;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1780" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;OMS-2&lt;/b&gt;&lt;br&gt;OMS-2 燃焼（約2分）" id="p40-v-23" link="docs/SSD-OPS-PHASE-001.html#EV-16" tooltip="EV-16：OMS-2 燃焼は、160 n.mi. の円軌道の場合で約2分である。 A1-104 では OMS-2 燃焼の終了で上昇フェーズが終わり、軌道フェーズが始まる。">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E9EDF2;strokeColor=#15202B;fontColor=#15202B;fontSize=10;fontStyle=0;align=center;spacingLeft=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1876" y="176" width="96" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p40-v-24" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#D5DBE3;fontFamily=Helvetica;" vertex="1" parent="1">
