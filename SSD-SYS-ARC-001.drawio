        <mxCell id="p45-B-EVA" value="EVA　船外活動（EVA/EMU）" style="swimlane;html=1;whiteSpace=wrap;startSize=36;container=1;collapsible=0;rounded=1;arcSize=4;fillColor=#FFF3C4;swimlaneFillColor=#FFFFFF;strokeColor=#A77B00;strokeWidth=2;fontColor=#15202B;fontStyle=1;fontSize=15;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1">
