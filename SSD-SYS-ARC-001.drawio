          </mxCell>
        </UserObject>
        <UserObject label="OMST-12" id="p136-v-30" link="docs/SSD-BEH-ORB-006.html#OMST-12" tooltip="OMST-12：LEFT OMS 灯（左ポッドのタンク圧 232 psi 未満・288 psi 超）→ 左ポッドを確保［独立した表示と計器で漏れ・調圧器故障を確認］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1.0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="p136-v-14" target="p136-v-15">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="OMST-13" id="p136-v-31" link="docs/SSD-BEH-ORB-006.html#OMST-13" tooltip="OMST-13：RIGHT OMS 灯（右ポッドのタンク圧 232 psi 未満・288 psi 超）→ 右ポッドを確保［独立した表示と計器で漏れ・調圧器故障を確認］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9;exitY=0.0;exitDx=0;exitDy=0;entryX=0.15;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p136-v-14" target="p136-v-15">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="610" y="680" />
                <mxPoint x="760" y="680" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="OMST-14" id="p136-v-32" link="docs/SSD-BEH-ORB-006.html#OMST-14" tooltip="OMST-14：推進薬タンクの漏れ → 他方のポッドからクロスフィードを組む［漏れたタンクの枯渇前、受け側のタンク隔離弁を閉］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p136-v-15" target="p136-v-16">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="OMST-15" id="p136-v-33" link="docs/SSD-BEH-ORB-006.html#OMST-15" tooltip="OMST-15：He タンク・レグの漏れの処置（最大ブローダウンへの噴射、He 隔離弁の手動操作）［推進薬タンクは健全］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.35;exitY=0.0;exitDx=0;exitDy=0;entryX=0.7;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p136-v-15" target="p136-v-14">
