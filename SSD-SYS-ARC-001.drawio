          <mxGeometry x="700" y="724" width="100" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-129" value="食い違いの内容" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#15202B;strokeColor=#15202B;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="800" y="724" width="1000" height="28" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-102&lt;/b&gt;" id="p143-v-130" link="docs/SSD-HSI-SYS-001.html#HSI-102" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="752" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p143-v-131" value="[V2 6004]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="752" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-132" value="REQ-ECLSS-06" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="240" y="752" width="130" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-133" value="VC-REQ-ECLSS-06 pass（SSD-VER-SYS-001）、REQ-ECLSS-06 は FT-1-12" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="752" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-134" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="700" y="752" width="100" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-135" value="FT-4-19 は CO2 分圧の最大約 4.3 mm Hg が通常の上限 7.6 mm Hg を下回ったことを達成として REQ-ECLSS-06（LiOH による CO2 除去）の証拠にしているが、3001 の 3 mmHg（1時間平均）で見ると運用の限界 7.6 mmHg は 4.6 mmHg" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="800" y="752" width="1000" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-124&lt;/b&gt;" id="p143-v-136" link="docs/SSD-HSI-SYS-001.html#HSI-124" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="790" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p143-v-137" value="[V2 6050]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="790" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-138" value="REQ-ECLSS-06" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="240" y="790" width="130" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-139" value="VC-REQ-ECLSS-06 pass（SSD-VER-SYS-001）、REQ-ECLSS-06 は FT-1-12" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="790" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-140" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="700" y="790" width="100" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-141" value="FT-1-12（STS-1 の微量汚染物質は有毒な濃度に達しなかった）は REQ-ECLSS-06（活性炭で臭気・微量の汚染物質を除く）の達成の証拠とされるが、同じ OFT の STS-2 では SMAC の和が1を超えた限度超過があり、3001 の SMAC の要求では不適合となる。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="800" y="790" width="1000" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-161&lt;/b&gt;" id="p143-v-142" link="docs/SSD-HSI-SYS-001.html#HSI-161" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="828" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p143-v-143" value="[V2 6078]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="828" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-144" value="REQ-CREW-03" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="240" y="828" width="130" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-145" value="VC-REQ-CREW-03 pass（SSD-VER-SYS-001）、REQ-CREW-03 は FT-1-30・F" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="828" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-146" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="700" y="828" width="100" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-147" value="FT-1-30 は STS-1 の騒音が JSC Standard 145（NC-50、55 dB-A）を超えたが生理学的に有害でないとして達成とし、REQ-CREW-03 の証拠にしているが、3001 の連続騒音の上限 NC-50（表 6.6-3）では中甲板の睡眠区画が 250 Hz〜8 kHz " style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="800" y="828" width="1000" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-162&lt;/b&gt;" id="p143-v-148" link="docs/SSD-HSI-SYS-001.html#HSI-162" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="866" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p143-v-149" value="[V2 6115]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="866" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-150" value="REQ-CREW-03" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="240" y="866" width="130" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-151" value="VC-REQ-CREW-03 pass（SSD-VER-SYS-001）、RF-049 noiseActionLevel" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="866" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-152" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="700" y="866" width="100" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-153" value="REQ-CREW-03 は24時間平均 74 dBA 以上で処置をとることを求め検証は pass だが、3001 の24時間の線量の限度（24時間 70 dBA 相当）より 4 dBA 高い値まで処置をとらないので、3001 では不適合となる。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="800" y="866" width="1000" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-220&lt;/b&gt;" id="p143-v-154" link="docs/SSD-HSI-SYS-001.html#HSI-220" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="904" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p143-v-155" value="[V2 7102]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="904" width="110" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-156" value="REQ-ECLSS-13" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="240" y="904" width="130" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-157" value="VC-REQ-ECLSS-13 pass（SSD-VER-SYS-001）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="904" width="330" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-158" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="700" y="904" width="100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-159" value="既存の要求は WCS で生物系の廃棄物を収集・処理することを求めて実証で pass だが、3001 の排泄物の量（Table 7.3-1）で見ると WCS の設計の量が下回り不適合となる。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="800" y="904" width="1000" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-376&lt;/b&gt;" id="p143-v-160" link="docs/SSD-HSI-SYS-001.html#HSI-376" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="928" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p143-v-161" value="[V2 9056]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="928" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-162" value="REQ-CREW-03" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="240" y="928" width="130" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-163" value="VC-REQ-CREW-03 pass（SSD-VER-SYS-001）、SSD-FLT-ORB-001 §7 証拠あり" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="928" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-164" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="700" y="928" width="100" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-165" value="既存は 24 時間平均 74 dBA 以上で処置（睡眠中の耳栓を含む）を満たすとするが、3001 は聴覚保護具なしで NC-50（約 55 dB-A）を求め、STS-1 の 60〜67 dB-A はこれを超える。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="800" y="928" width="1000" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-379&lt;/b&gt;" id="p143-v-166" link="docs/SSD-HSI-SYS-001.html#HSI-379" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="966" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p143-v-167" value="[V2 9059]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="966" width="110" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-168" value="REQ-ECLSS-11" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="240" y="966" width="130" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-169" value="VC-REQ-ECLSS-11 pass（SSD-VER-SYS-001）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="966" width="330" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-170" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="700" y="966" width="100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-171" value="既存は煙検知・警報と固定・携帯の消火器で消火できることを満たすとするが、3001 は消火の機器が危険な環境をつくらないことも求め、Halon 1301 の毒性・分解生成物はこれに届かない。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="800" y="966" width="1000" height="24" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-401&lt;/b&gt;" id="p143-v-172" link="docs/SSD-HSI-SYS-001.html#HSI-401" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="990" width="90" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p143-v-173" value="[V2 10114]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="990" width="110" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-174" value="REQ-CW-06" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="240" y="990" width="130" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-175" value="VC-REQ-CW-06 pass（SSD-VER-SYS-001）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="990" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-176" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="700" y="990" width="100" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-177" value="REQ-CW-06（クラス1のサイレン・クラクソンをハードウェアで鳴らす）は満たすとされるが、3001 の表は緊急の報知にサイレン/クラクソンに続く音声と赤の点滅を求め、シャトルの緊急の報知は 3001 では不適合となる。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="800" y="990" width="1000" height="38" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;HSI-492&lt;/b&gt;" id="p143-v-178" link="docs/SSD-HSI-SYS-001.html#HSI-492" tooltip="開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=4;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="40" y="1028" width="90" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p143-v-179" value="[V2 11032]" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="130" y="1028" width="110" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-180" value="REQ-CREW-08" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="240" y="1028" width="130" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-181" value="VC-REQ-CREW-08 pass（SSD-VER-SYS-001）" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="370" y="1028" width="330" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-182" value="不適合" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="700" y="1028" width="100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-183" value="REQ-CREW-08 は ACES の 3.67 psia を高度 30,000 ft 以下の脱出の手段として満たすとするが、3001 の LEA の服の減圧症の防護（根拠 5.8 psia）では同じ服圧が 2.13 psia 足りない。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="800" y="1028" width="1000" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-184" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;上＝NASA-STD-3001 の章 × 判定の件数（色：&lt;font color='#2E7D32'&gt;■&lt;/font&gt; 適合、&lt;font color='#C62828'&gt;■&lt;/font&gt; 不適合、&lt;font color='#A77B00'&gt;■&lt;/font&gt; データ不足、&lt;font color='#757575'&gt;■&lt;/font&gt; 対象外）。ます目をクリックするとその判定の最初の行を開く（ツールチップに全件の ID）。下＝既存の判定と 3001 による評価が食い違うもの（既存の判定は据え置き）。&lt;br&gt;3001 は評価基準で、シャトルの要求の上位ではない。同じ内容を SysML v2 テキスト model/SSD-HSI-SYS-001.sysml の requirement def・HsiEvaluation・#Evaluates に示す。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="1082" width="1250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p143-v-185" value="&lt;table style='border-collapse:collapse;width:100%;font-size:11px;text-align:left;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;文書番号&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;SSD-SYS-ARC-001&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;表題&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;スペースシャトル システム構成図（機能ブロック・インタフェース図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;図番&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;図143 人間系の基準の照合（章 × 判定）（全158図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;版・日付&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;Rev. BF／2026-10-07&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;状態&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;検討用（公開資料に基づく）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;作成／確認／承認&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;　　　／　　　／　　　&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15202B;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1330" y="1082" width="430" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p144-hsi-values" name="図144 人間系の基準の値とシャトルの値">
