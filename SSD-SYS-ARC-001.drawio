        <mxCell id="p35-v-152" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;● 当該機能に関係する文書&lt;br&gt;出典「ARS-REF（AR-nn）」：SSD-ARS-REF-001 の行 AR-nn から継承&lt;br&gt;出典「新規」：今回の調査で追加&lt;br&gt;機能の略号：全般 IMU空冷 全般（SSD-FD-ARS-IMU-001）／INL 吸込み・IMU通風（INL）／FAN IMUファン・逆止弁（FAN）／HEX IMU熱交換器・ダクト（HEX）／MON ファン監視・表示（MON）／OPS ファン運用管理（OPS）" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1456" y="110" width="430" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p35-v-153" value="&lt;table style='border-collapse:collapse;width:100%;font-size:11px;text-align:left;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;文書番号&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;SSD-SYS-ARC-001&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;表題&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;スペースシャトル システム構成図（機能ブロック・インタフェース図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;図番&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;図35 IMU空冷 関連文書マトリクス（全158図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;版・日付&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;Rev. BF／2026-10-07&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;状態&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;検討用（公開資料に基づく）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;作成／確認／承認&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;　　　／　　　／　　　&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15202B;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1456" y="330" width="430" height="150" as="geometry" />
        </mxCell>
