          </mxCell>
        </UserObject>
        <UserObject label="RCSS-11&lt;br&gt;&lt;span style='font-weight:normal'&gt;突入の姿勢制御（後部ジェット）&lt;/span&gt;" id="p137-v-15" link="docs/SSD-BEH-ORB-006.html#RCSS-11" tooltip="RCSS-11 突入の姿勢制御（後部ジェット）">
          <mxCell style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#DCE8F6;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="130" y="930" width="200" height="80" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="RCSS-12&lt;br&gt;&lt;span style='font-weight:normal'&gt;着陸後の安全化&lt;/span&gt;" id="p137-v-16" link="docs/SSD-BEH-ORB-006.html#RCSS-12" tooltip="RCSS-12 着陸後の安全化">
          <mxCell style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#DCE8F6;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="430" y="930" width="200" height="80" as="geometry" />
