        <UserObject label="RCSS-08&lt;br&gt;&lt;span style='font-weight:normal'&gt;前部 RCS の確保・漏れの切り分け&lt;/span&gt;" id="p137-v-12" link="docs/SSD-BEH-ORB-006.html#RCSS-08" tooltip="RCSS-08 前部 RCS の確保・漏れの切り分け">
          <mxCell style="rounded=1;arcSize=22;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#FDE2E2;strokeColor=#C62828;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="430" y="700" width="200" height="80" as="geometry" />
