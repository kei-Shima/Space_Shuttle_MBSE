          </mxCell>
        </UserObject>
        <mxCell id="p154-v-60" value="睡眠" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="110" y="490" width="260" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p154-v-61" value="各乗員に寝袋（枕・頭部の拘束具・調整できる帯）と睡眠キット（アイマスク・耳栓）を与え、24時間運用では4段の固定式睡眠ステーション（各段に照" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
