            <mxGeometry x="1180" y="357.5" width="560" height="96" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;AL-STD-3&lt;/b&gt; 警告（Warning）&lt;br&gt;&lt;span style='font-size:10px'&gt;視覚：赤&lt;br&gt;音：400 Hz と 1,024 Hz を 2.5 Hz で交互に出す音＋警告の音声（内容と&lt;/span&gt;" id="p152-v-16" link="docs/SSD-CIF-ORB-001.html#AL-STD-3" tooltip="AL-STD-3 警告（Warning）">
          <mxCell style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FCE4EC;strokeColor=#AD1457;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
