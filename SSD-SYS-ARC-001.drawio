        <UserObject label="" id="p121-v-45" link="docs/SSD-HAZ-ORB-001.html#HC-02" tooltip="HC-02 → HZ-01">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#5F6B7A;strokeWidth=2;fontColor=#5F6B7A;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;endArrow=block;endFill=1;endSize=7;exitX=1.0;exitY=0.4545;exitDx=0;exitDy=0;entryX=0.0;entryY=0.2755;entryDx=0;entryDy=0;" edge="1" parent="1" source="p121-v-10" target="p121-v-8">
