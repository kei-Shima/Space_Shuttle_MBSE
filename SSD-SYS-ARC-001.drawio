        <mxCell id="p107-v-46" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;赤の箱＝頂上事象、緑の箱＝AND ゲート（入力がすべて起きると起きる）、黄の箱＝OR ゲート（入力のどれかが起きると起きる）、白の角丸＝基本事象、灰の箱＝転送（同じゲートを別の場所で使う）。ゲートの説明の「規則」は運用飛行規則に書かれた論理、「推定」は系の構成から組み立てた論理。&lt;br&gt;箱をクリックすると定義書の行を開く。同じ木を SysML v2 テキスト model/SSD-ANA-ORB-001.sysml の FaultTreeB に Boolean の式で示す（確率は付けない）。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="1034" width="1310" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p107-v-47" value="&lt;table style='border-collapse:collapse;width:100%;font-size:11px;text-align:left;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;文書番号&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;SSD-SYS-ARC-001&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;表題&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;スペースシャトル システム構成図（機能ブロック・インタフェース図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;図番&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;図107 故障の木 B（空力舵面の油圧の喪失）（全158図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;版・日付&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;Rev. BF／2026-10-07&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;状態&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;検討用（公開資料に基づく）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;作成／確認／承認&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;　　　／　　　／　　　&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15202B;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1390" y="1034" width="430" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p108-fta-c" name="図108 故障の木 C（CO2 制御の喪失）">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1068" math="0" shadow="0" background="#FFFFFF">
      <root>
