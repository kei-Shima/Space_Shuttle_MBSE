        <UserObject label="IF-STR-01&lt;br&gt;前部結合" id="p70-IF-STR-01" link="docs/SSD-FD-STR-FWD-001.html#IF-STR-01" tooltip="IF-STR-01：前部のオービタ/ET結合金具は、Xo=378隔壁と前脚格納部の後方の外板構造にある。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2059;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p70-L_str" source="p70-B-FWD" target="p70-B-ET70">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-STR-02&lt;br&gt;後部結合" id="p70-IF-STR-02" link="docs/SSD-FD-STR-AFT-001.html#IF-STR-02" tooltip="IF-STR-02：オービタ/ETの2つの後部結合点は、後胴の縦通材の金具で結合する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.7941;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p70-L_str" source="p70-B-AFT" target="p70-B-ET70">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-STR-03&lt;br&gt;熱防護" id="p70-IF-STR-03" link="docs/SSD-FD-STR-MID-001.html#IF-STR-03" tooltip="IF-STR-03：突入中は、TPSの材料がアルミニウムとグラファイトエポキシの外板を350°Fを超える温度から守る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2E7D4F;strokeWidth=2;fontColor=#2E7D4F;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;dashed=1;dashPattern=8 5;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p70-L_thm" source="p70-B-TPS70" target="p70-B-MID">
            <mxGeometry relative="1" as="geometry" x="-0.0357">
              <Array as="points">
                <mxPoint x="640" y="790" />
                <mxPoint x="850" y="790" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-STR-04&lt;br&gt;4点支持" id="p70-IF-STR-04" link="docs/SSD-FD-STR-CRM-001.html#IF-STR-04" tooltip="IF-STR-04：乗員室は、熱伝導を小さくするため前胴の中に4つの取付点だけで支えられる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p70-L_str" source="p70-B-CRM" target="p70-B-FWD">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-STR-05&lt;br&gt;前胴結合" id="p70-IF-STR-05" link="docs/SSD-FD-STR-MID-001.html#IF-STR-05" tooltip="IF-STR-05：中胴の前後の端は開いていて、補強した外板と縦通材が前胴・後胴の隔壁と結合する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p70-L_str" source="p70-B-MID" target="p70-B-FWD">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-STR-06&lt;br&gt;荷重経路" id="p70-IF-STR-06" link="docs/SSD-FD-STR-AFT-001.html#IF-STR-06" tooltip="IF-STR-06：後胴は中胴の主縦通材への荷重経路と、前部隔壁を越える主翼桁の連続を受け持つ。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.1071;exitY=1;exitDx=0;exitDy=0;entryX=0.9286;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p70-L_str" source="p70-B-AFT" target="p70-B-MID">
            <mxGeometry relative="1" as="geometry" x="0.2222">
              <Array as="points">
                <mxPoint x="1210" y="530" />
                <mxPoint x="1040" y="530" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-STR-07&lt;br&gt;翼取付" id="p70-IF-STR-07" link="docs/SSD-FD-STR-WNG-001.html#IF-STR-07" tooltip="IF-STR-07：翼は上面の引張ボルトの継手と、胴体の通し構造の下面のせん断継手で胴体に取り付けられる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p70-L_str" source="p70-B-WNG" target="p70-B-MID">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-STR-08&lt;br&gt;尾翼取付" id="p70-IF-STR-08" link="docs/SSD-FD-STR-WNG-001.html#IF-STR-08" tooltip="IF-STR-08：垂直尾翼のフィンは、前桁の根元の2本の引張ボルトで後胴の前部隔壁に、後桁の根元の8本のせん断ボルトで後胴の上面に取り付けられる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p70-L_str" source="p70-B-WNG" target="p70-B-AFT">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-STR-09&lt;br&gt;窓の管理" id="p70-IF-STR-09" link="docs/SSD-FD-STR-OPS-001.html#IF-STR-09" tooltip="IF-STR-09：圧力ペインか冗長ペインが故障したときは客室圧を10.2 psiに下げ、軌道上では次のPLSで帰還する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p70-L_dat" source="p70-B-OPS" target="p70-B-CRM">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-STR-10&lt;br&gt;姿勢管理" id="p70-IF-STR-10" link="docs/SSD-FD-STR-OPS-001.html#IF-STR-10" tooltip="IF-STR-10：中胴の構造の応力は機体の温度勾配で生じるため、接着層の温度の限界を守るよう姿勢を管理する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p70-L_dat" source="p70-B-OPS" target="p70-B-MID">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MECH-02&lt;br&gt;ヒンジ" id="p70-IF-MECH-02" link="docs/SSD-FD-MECH-PLB-001.html#IF-MECH-02" tooltip="IF-MECH-02：各ペイロードベイドアは、13のヒンジ（固定5・浮動8）で中胴につながる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.3824;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p70-L_str" source="p70-B-MECH70" target="p70-B-MID">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MECH-03&lt;br&gt;脚取付" id="p70-IF-MECH-03" link="docs/SSD-FD-MECH-LDG-001.html#IF-MECH-03" tooltip="IF-MECH-03：前脚は前胴の下部、主脚は中胴に隣接する左右の翼の下部に収められる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.6324;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p70-L_str" source="p70-B-MECH70" target="p70-B-WNG">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-PLS-03&lt;br&gt;縦通材取付" id="p70-IF-PLS-03" link="docs/SSD-FD-PLS-MPM-001.html#IF-PLS-03" tooltip="IF-PLS-03：RMSはペイロードベイの左舷の縦通材に取り付け、受け台の3つのMPM台座のMRLで打上げ・突入の間アームを固定する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p70-L_str" source="p70-B-PLS70" target="p70-B-MID">
            <mxGeometry relative="1" as="geometry" x="0.4235">
              <Array as="points">
                <mxPoint x="360" y="500" />
                <mxPoint x="360" y="770" />
                <mxPoint x="810" y="770" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-OMS-18&lt;br&gt;推力伝達" id="p70-IF-OMS-18" link="docs/SSD-FD-OMS-TVC-001.html#IF-OMS-18" tooltip="IF-OMS-18：ジンバルリングの2つのパッドでリングをオービタに取り付け、エンジンの推力をポッドとオービタへ伝える。OMS/RCSポッドは軽微な修理で最大100回の飛行に再使用でき、オービタの整備のために取り外せる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2B2B2B;strokeWidth=4;fontColor=#2B2B2B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="p70-L_str" source="p70-B-OMS70" target="p70-B-AFT">
