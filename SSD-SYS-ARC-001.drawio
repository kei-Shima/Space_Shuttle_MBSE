        </mxCell>
        <mxCell id="p105-v-155" value="資料に無い" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1150" y="696" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p105-v-156" value="ID" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#15202B;strokeColor=#15202B;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="700" y="744" width="70" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p105-v-157" value="Δv の式と計算" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#15202B;strokeColor=#15202B;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=6;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="770" y="744" width="580" height="28" as="geometry" />
        </mxCell>
        <UserObject label="DE-01" id="p105-v-158" link="docs/SSD-ANA-ORB-001.html#DE-01" tooltip="本書の行を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=5;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="700" y="772" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p105-v-159" value="ロケット方程式：Δv = Isp·g0·ln(m0/m1)、m1 = m0 − mp（g0 = 32.174 ft/s²）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="770" y="772" width="580" height="24" as="geometry" />
        </mxCell>
        <UserObject label="DE-02" id="p105-v-160" link="docs/SSD-ANA-ORB-001.html#DE-02" tooltip="本書の行を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=5;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="700" y="796" width="70" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p105-v-161" value="推進薬使用率：dm/dv = m/(Isp·g0)。OMS（Isp 313.2 s、m = 220,000 lb）で 21.83 lb/(ft/s) となり、SCOM の 21.8 lb/(ft/s) と一致する（本書の計算）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="770" y="796" width="580" height="38" as="geometry" />
        </mxCell>
        <UserObject label="DE-03" id="p105-v-162" link="docs/SSD-ANA-ORB-001.html#DE-03" tooltip="本書の行を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=5;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="700" y="834" width="70" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p105-v-163" value="比推力の照合：Isp = F/ṁ = 6,000 / 19.16 = 313.2 s（表の 313.2 s と一致）。2.18 節の推力 6,087 lbf を使うと 317.7 s となり、表の推力 6,000 lbf と 1.4% 違う。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="770" y="834" width="580" height="38" as="geometry" />
        </mxCell>
        <UserObject label="DE-04" id="p105-v-164" link="docs/SSD-ANA-ORB-001.html#DE-04" tooltip="本書の行を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=5;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="700" y="872" width="70" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p105-v-165" value="OMS 満載 25,064 lb を使い切るときの Δv：m0 = 220,000 lb で 1219 ft/s、m0 = 245,064 lb（燃焼後 220,000 lb）で 1087 ft/s、m0 = 260,000 lb で 1021 ft/s。SCOM の「約1,000 ft/s」は重い機体（約 260k lb）か残留・使えない推進薬を見込んだ値と整合する（推定）。オービタの軌道上重量は資料に無い。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="770" y="872" width="580" height="52" as="geometry" />
        </mxCell>
        <UserObject label="DE-05" id="p105-v-166" link="docs/SSD-ANA-ORB-001.html#DE-05" tooltip="本書の行を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=5;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="700" y="924" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p105-v-167" value="加速度：a = 2×6,087/220,000×g0 = 1.78 ft/s²（SCOM「約2 ft/s²」）、1基で 0.89 ft/s²（「約1 fps²」）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="770" y="924" width="580" height="24" as="geometry" />
        </mxCell>
        <UserObject label="DE-06" id="p105-v-168" link="docs/SSD-ANA-ORB-001.html#DE-06" tooltip="本書の行を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=5;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="700" y="948" width="70" height="24" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p105-v-169" value="OMS 1%：130 lb ÷ 21.8 lb/(ft/s) = 5.96 ft/s（SCOM「6 fps」と一致。1%は片側の値）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="770" y="948" width="580" height="24" as="geometry" />
        </mxCell>
        <UserObject label="DE-07" id="p105-v-170" link="docs/SSD-ANA-ORB-001.html#DE-07" tooltip="本書の行を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=5;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="700" y="972" width="70" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p105-v-171" value="RCS：dm/dv = 220,000/(280.0×g0) = 24.4 lb/(ft/s)（SCOM「25 lbs (+X)」と整合）。後部 RCS 満載 4,970 lb を +X に使い切ったときの理論値は Δv = 206 ft/s、前部 RCS 満載 2,446 lb では 101 ft/s（本書の計算。噴射器の向き・多軸の損失は含まない）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="770" y="972" width="580" height="52" as="geometry" />
        </mxCell>
        <UserObject label="DE-08" id="p105-v-172" link="docs/SSD-ANA-ORB-001.html#DE-08" tooltip="本書の行を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=5;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="700" y="1024" width="70" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p105-v-173" value="面変更：Δv = 2·V·sin(Δi/2)。V = 26,000 ft/s（SCOM の抗力図の前提）で Δi = 1° のとき 454 ft/s（SCOM の 440 ft/s と 3% 違う。軌道速度の値は資料に無い）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="770" y="1024" width="580" height="38" as="geometry" />
        </mxCell>
        <UserObject label="DE-09" id="p105-v-174" link="docs/SSD-ANA-ORB-001.html#DE-09" tooltip="本書の行を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=5;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="700" y="1062" width="70" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p105-v-175" value="OMS の速度変化の収支：OMS-2 + 軌道離脱 + 軌道調整 ≤ 1,000 ft/s。2.18 節の上限（500 + 500）で余裕 0、1.1 節の上限（550 + 550）で −100 ft/s（SSD-BUD-ORB-001 BUD-PRP-01 と同じ）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="770" y="1062" width="580" height="38" as="geometry" />
        </mxCell>
        <UserObject label="DE-10" id="p105-v-176" link="docs/SSD-ANA-ORB-001.html#DE-10" tooltip="本書の行を開く">
          <mxCell style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#1F5FAD;fontStyle=5;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="700" y="1100" width="70" height="38" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p105-v-177" value="SODB の最大搭載量 2×(4,711.5 + 7,743.5) = 24,910 lb は SCOM の 25,064 lb より 154 lb（0.6%）少ない。資料の版の違い（推定）。" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F3F5F8;strokeColor=#B8C0CA;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontColor=#15202B;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="770" y="1100" width="580" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p105-v-178" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;左＝質量特性（着陸重量・重心・質量モーメント）、右＝OMS・RCS の Δv（ロケット方程式）。ID をクリックすると定義書の行を開く。「資料に無い」は一次資料に値が無いもの。計算は定義書の生成の中で計算し直して照らした（§7）。&lt;br&gt;同じ制約を SysML v2 テキスト model/SSD-ANA-ORB-001.sysml の LandingMassProperties・OmsDeltaV に示す。" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#1B2430;strokeColor=#9AA3AE;fillColor=#FAFBFC;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="1168" width="840" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p105-v-179" value="&lt;table style='border-collapse:collapse;width:100%;font-size:11px;text-align:left;'&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;文書番号&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;SSD-SYS-ARC-001&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;表題&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;スペースシャトル システム構成図（機能ブロック・インタフェース図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;図番&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;図105 質量特性・Δv の解析（全158図）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;版・日付&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;Rev. BF／2026-10-07&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;状態&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;検討用（公開資料に基づく）&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;background:#EEF1F5;white-space:nowrap;'&gt;作成／確認／承認&lt;/td&gt;&lt;td style='border:1px solid #15202B;padding:3px 6px;'&gt;　　　／　　　／　　　&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;strokeColor=#15202B;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1">
