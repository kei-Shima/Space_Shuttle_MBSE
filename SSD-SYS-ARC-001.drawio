        </UserObject>
        <UserObject label="RCST-05" id="p137-v-23" link="docs/SSD-BEH-ORB-006.html#RCST-05" tooltip="RCST-05：OMS He 弁・クロスフィード弁を閉じ RCS を自系の供給へ戻す［離脱噴射の後］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.15;exitY=0.0;exitDx=0;exitDy=0;entryX=0.7;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p137-v-9" target="p137-v-7">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="760" y="430" />
                <mxPoint x="270" y="430" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="RCST-06" id="p137-v-24" link="docs/SSD-BEH-ORB-006.html#RCST-06" tooltip="RCST-06：ジェットの fail-on（RCS JET 灯・RM の通報）→ マニホールドを閉［OPS 2・8 は AUT MANF CL 有効なら自動］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p137-v-7" target="p137-v-11">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="RCST-07" id="p137-v-25" link="docs/SSD-BEH-ORB-006.html#RCST-07" tooltip="RCST-07：誤通報と判断してマニホールドを再び開く［fail-on が誤り（本当の fail-on なら閉のまま）］">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#15202B;strokeWidth=2;fontColor=#15202B;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.3;exitY=0.0;exitDx=0;exitDy=0;entryX=0.3;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p137-v-11" target="p137-v-7">
