        <UserObject label="IF-MPS-01&lt;br&gt;LO2・LH2" id="p50-IF-MPS-01" link="docs/SSD-FD-MPS-PMS-001.html#IF-MPS-01" tooltip="IF-MPS-01：LO2・LH2は、外部タンクから17インチのET/オービタ切離し弁を通ってオービタの供給配管マニホールドへ流れる。打上げ前の充填では、推進薬はマニホールドから供給配管アンビリカル切離し部を通ってETのタンクへ入る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0;exitY=0.4545;exitDx=0;exitDy=0;entryX=0.7857;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p50-L_flu" source="p50-B-ET50" target="p50-B-PMS">
            <mxGeometry relative="1" as="geometry" x="-0.0222">
              <Array as="points">
                <mxPoint x="1540" y="950" />
                <mxPoint x="1540" y="1040" />
                <mxPoint x="1880" y="1040" />
                <mxPoint x="1880" y="220" />
                <mxPoint x="1400" y="220" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-02&lt;br&gt;加圧ガス" id="p50-IF-MPS-02" link="docs/SSD-FD-MPS-PMS-001.html#IF-MPS-02" tooltip="IF-MPS-02：各エンジンからのGO2・GH2を2本のET加圧マニホールドで集めて外部タンクへ送り、運転中の推進薬タンクの圧力を保つ。GH2は各SSMEの加圧系統から2インチの加圧ラインを通ってETのLH2タンクのアレージへ送られる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.8182;entryDx=0;entryDy=0;" edge="1" parent="p50-L_flu" source="p50-B-PMS" target="p50-B-ET50">
            <mxGeometry relative="1" as="geometry" x="-0.7089">
              <Array as="points">
                <mxPoint x="1440" y="230" />
                <mxPoint x="1860" y="230" />
                <mxPoint x="1860" y="1020" />
                <mxPoint x="1560" y="1020" />
                <mxPoint x="1560" y="990" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-03&lt;br&gt;充填" id="p50-IF-MPS-03" link="docs/SSD-FD-MPS-DMP-001.html#IF-MPS-03" tooltip="IF-MPS-03：打上げ前、地上支援設備のLO2・LH2はそれぞれのT-0アンビリカルから外側・内側の充填排出弁を通ってオービタの供給配管マニホールドへ送られる。充填中はパネルR4のPROPELLANT FILL/DRAINスイッチをGNDにして、打上げ処理システムが充填排出弁の位置を制御する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="p50-L_flu" source="p50-B-KSC50" target="p50-B-DMP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-04&lt;br&gt;地上He加圧" id="p50-IF-MPS-04" link="docs/SSD-FD-MPS-PMS-001.html#IF-MPS-04" tooltip="IF-MPS-04：打上げ前は、T-0アンビリカルから送る地上のヘリウムでET加圧マニホールドを通してETを加圧し、T-0のセルフシール式迅速継手は離昇時に切り離される。T-2分55秒にLPSがLO2タンクのベント弁を閉じ、地上支援設備のヘリウムでLO2タンクを21 psigに加圧する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.28;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="p50-L_flu" source="p50-B-KSC50" target="p50-B-PMS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-05&lt;br&gt;交流電力" id="p50-IF-MPS-05" link="docs/SSD-FD-MPS-CTL-001.html#IF-MPS-05" tooltip="IF-MPS-05：各制御器のDCU A・Bは別々の交流母線から受電し、どの2母線を失っても失うエンジンは1基だけになるよう3基の制御器に母線を割り当てる。各制御器は3系統の交流母線のうち2系統から受電し、1母線を失うと2基の制御器の冗長性を失う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.3824;exitY=0;exitDx=0;exitDy=0;entryX=0.9286;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p50-L_pow" source="p50-B-EPS50" target="p50-B-CTL">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-06&lt;br&gt;直流電力" id="p50-IF-MPS-06" link="docs/SSD-FD-MPS-HE-001.html#IF-MPS-06" tooltip="IF-MPS-06：EPSは、推進薬管理系とヘリウム系の弁・トランスデューサを動かす直流電力を供給する。ALC 1・2・3（APC 4・5・6）を失うと、中央・左・右のSSMEのヘリウム遮断弁Aが閉じる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#C62828;strokeWidth=2;fontColor=#C62828;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.6324;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p50-L_pow" source="p50-B-EPS50" target="p50-B-HE">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-07&lt;br&gt;He圧警報" id="p50-IF-MPS-07" link="docs/SSD-FD-MPS-HE-001.html#IF-MPS-07" tooltip="IF-MPS-07：ヘリウムのタンク圧（1,150 psia未満）と調圧器Aの圧力（680 psia未満・810 psia超）の限界逸脱は、パネルF7のC/WマトリクスのMPSライト（赤）を点灯させる。ハードウェアC&amp;Wでは、中央・左・右のヘリウムのタンク圧と調圧器圧がそれぞれ別のチャネルに割り当てられている。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.8182;entryDx=0;entryDy=0;" edge="1" parent="p50-L_dat" source="p50-B-HE" target="p50-B-CW50">
            <mxGeometry relative="1" as="geometry" x="0.1692">
              <Array as="points">
                <mxPoint x="1040" y="860" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-08&lt;br&gt;マニホールド圧" id="p50-IF-MPS-08" link="docs/SSD-FD-MPS-PMS-001.html#IF-MPS-08" tooltip="IF-MPS-08：LH2マニホールド圧が65 psiaを、LO2マニホールド圧が249 psiaを超えるとMPSライトとBACKUP C/W ALARMが点灯する。軌道上（OPS 2）ではMPSのソフトウェアC&amp;Wがないため、マニホールド圧の限界逸脱はハードウェアC&amp;W（MPSライトとマスタアラーム）だけで知らされる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.4545;entryDx=0;entryDy=0;" edge="1" parent="p50-L_dat" source="p50-B-PMS" target="p50-B-CW50">
            <mxGeometry relative="1" as="geometry" x="-0.8039">
              <Array as="points">
                <mxPoint x="1560" y="430" />
                <mxPoint x="1560" y="820" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-09&lt;br&gt;制御・計測" id="p50-IF-MPS-09" link="docs/SSD-FD-MPS-CTL-001.html#IF-MPS-09" tooltip="IF-MPS-09：制御器はエンジンのセンサ・弁・アクチュエータ・スパーク点火器とともに動作し、エンジンの制御・点検・監視を行う自己完結の系を成す。エンジンのセンサは圧力・温度・流量・ターボポンプ回転数・弁位置・サーボ弁アクチュエータ位置を制御器へ送る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.1071;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p50-L_dat" source="p50-B-CTL" target="p50-B-SSME">
            <mxGeometry relative="1" as="geometry" x="0.5556">
              <Array as="points">
                <mxPoint x="410" y="770" />
                <mxPoint x="360" y="770" />
                <mxPoint x="360" y="470" />
                <mxPoint x="810" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-10&lt;br&gt;推進薬供給" id="p50-IF-MPS-10" link="docs/SSD-FD-MPS-PMS-001.html#IF-MPS-10" tooltip="IF-MPS-10：各12インチ供給ラインの推進薬はプリバルブを通り、LH2は低圧燃料ターボポンプ、LO2は低圧酸化剤ターボポンプの入口からエンジンに入る。LO2はLO2供給配管マニホールドから3本のエンジン用LO2供給ラインでエンジンへ分配される。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="p50-L_flu" source="p50-B-PMS" target="p50-B-SSME">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-11&lt;br&gt;GO2・GH2" id="p50-IF-MPS-11" link="docs/SSD-FD-MPS-SSME-001.html#IF-MPS-11" tooltip="IF-MPS-11：各SSMEでは、高圧酸化剤ターボポンプの主ポンプからのLO2の一部を酸化剤熱交換器で気化したGO2と、低圧燃料ターボポンプからのGH2の一部を加圧ラインへ送る。GH2は逆止弁2個・オリフィス2個・流量制御弁を通ってからETへ入る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p50-L_flu" source="p50-B-SSME" target="p50-B-PMS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-12&lt;br&gt;エンジンHe" id="p50-IF-MPS-12" link="docs/SSD-FD-MPS-HE-001.html#IF-MPS-12" tooltip="IF-MPS-12：各タンク群のヘリウムは担当のエンジンへ送られ、飛行中のパージと緊急の空圧停止でのエンジン弁の作動に使われる。各SSMEの空圧制御組立はエンジン系統のヘリウムで加圧され、制御器の指令で中間シール空洞のパージ、ポゴ系のポストチャージ、空圧停止を行う。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p50-L_flu" source="p50-B-HE" target="p50-B-SSME">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-13&lt;br&gt;空圧He" id="p50-IF-MPS-13" link="docs/SSD-FD-MPS-HE-001.html#IF-MPS-13" tooltip="IF-MPS-13：空圧ヘリウム供給タンクは、推進薬管理系のすべての空圧作動弁を動かす圧力を供給する。タイプ1の弁では、開・閉の各ポートの電磁弁に通電するとヘリウムの圧力で空圧弁が開閉する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=0;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p50-L_flu" source="p50-B-HE" target="p50-B-PMS">
            <mxGeometry relative="1" as="geometry" x="0.2222">
              <Array as="points">
                <mxPoint x="1040" y="470" />
                <mxPoint x="1210" y="470" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-14&lt;br&gt;ダンプ用He" id="p50-IF-MPS-14" link="docs/SSD-FD-MPS-HE-001.html#IF-MPS-14" tooltip="IF-MPS-14：空圧ヘリウム調圧器下流のマニホールド加圧弁が、通常のLO2ダンプと再突入時のLH2・LO2マニホールドの再加圧のためにヘリウムを送る。MECO+20秒にGPCが空圧ヘリウムとエンジンヘリウムの系統を相互接続し、10個のタンクすべてを共通のマニホールドにつないでダンプに十分なヘリウムを確保する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p50-L_flu" source="p50-B-HE" target="p50-B-DMP">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-15&lt;br&gt;充填・ダンプ" id="p50-IF-MPS-15" link="docs/SSD-FD-MPS-DMP-001.html#IF-MPS-15" tooltip="IF-MPS-15：LO2・LH2の各マニホールドには、内側と外側の充填排出弁を直列に持つ8インチの充填排出ラインがつながる。MECO後のダンプでは、マニホールドのLH2が内側・外側の充填排出弁とトッピング弁から2分間船外へ流れ出る。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E4570E;strokeWidth=3;fontColor=#E4570E;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p50-L_flu" source="p50-B-DMP" target="p50-B-PMS">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-16&lt;br&gt;油圧・ジンバル" id="p50-IF-MPS-16" link="docs/SSD-FD-MPS-TVC-001.html#IF-MPS-16" tooltip="IF-MPS-16：MPS/TVC遮断弁を開くと、5個の油圧作動エンジン弁（主燃料弁・主酸化剤弁・燃料プリバーナ酸化剤弁・酸化剤プリバーナ酸化剤弁・冷却材制御弁）に油圧がかかる。各SSMEのピッチ・ヨーのサーボアクチュエータはオービタの推力構造とSSMEのパワーヘッドに取り付けられ、エンジンを首振りさせる。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B3FA0;strokeWidth=2;fontColor=#7B3FA0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p50-L_hyd" source="p50-B-TVC" target="p50-B-SSME">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-17&lt;br&gt;停止・状態" id="p50-IF-MPS-17" link="docs/SSD-FD-MPS-OPS-001.html#IF-MPS-17" tooltip="IF-MPS-17：乗員はパネルC3のMAIN ENGINE SHUT DOWN押しボタン（両接点が健全であること）でエンジンを手動停止し、指令経路故障のエンジンは交流電源スイッチと押しボタンで停止する。パネルF7のMAIN ENGINE STATUSライトは、停止・停止後の段階かレッドライン超過で赤、指令経路故障・油圧ロックアップ・電気的ロックアップ・データ経路故障で黄が点灯する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p50-L_dat" source="p50-B-OPS" target="p50-B-CTL">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-18&lt;br&gt;隔離・接続" id="p50-IF-MPS-18" link="docs/SSD-FD-MPS-OPS-001.html#IF-MPS-18" tooltip="IF-MPS-18：乗員はパネルR2のHe ISOLATION A・B（LEFT・CTR・RIGHT）スイッチで各エンジン系統の遮断弁を個別に操作し、ヘリウム漏れの隔離手順を行う。He INTERCONNECT LEFT・CTR・RIGHTスイッチ（IN OPEN・GPC・OUT OPEN）は、各エンジン系統の相互接続弁の組を1個のスイッチで操作する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="p50-L_dat" source="p50-B-OPS" target="p50-B-HE">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-19&lt;br&gt;ダンプ操作" id="p50-IF-MPS-19" link="docs/SSD-FD-MPS-OPS-001.html#IF-MPS-19" tooltip="IF-MPS-19：乗員はMPS PRPLT DUMP SEQUENCEスイッチのSTARTでMECO+20秒以降にダンプを手動で始め、STOPでET分離の遅れの間の自動ダンプを止める。自動の真空不活性化が十分でないときは、乗員がLO2・LH2の供給系統を手動で真空不活性化する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0.1071;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p50-L_dat" source="p50-B-OPS" target="p50-B-DMP">
            <mxGeometry relative="1" as="geometry" x="0">
              <Array as="points">
                <mxPoint x="640" y="770" />
                <mxPoint x="1210" y="770" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-MPS-20&lt;br&gt;遮断弁操作" id="p50-IF-MPS-20" link="docs/SSD-FD-MPS-OPS-001.html#IF-MPS-20" tooltip="IF-MPS-20：乗員はパネルR4のHYDRAULICS MPS/TVC ISOL VLV SYS 1〜3スイッチを軌道上ではCLOSEにし、遮断弁下流の油圧漏れから守る。弁はスイッチをOPENにすると開き、スイッチの上のトークバックが開でOP、閉でCLを示す。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="p50-L_dat" source="p50-B-OPS" target="p50-B-TVC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-DPS-05&lt;br&gt;SSME指令" id="p50-IF-DPS-05" link="docs/SSD-FD-DPS-ASC-001.html#IF-DPS-05" tooltip="IF-DPS-05：EIUは冗長セットのGPCから受けたエンジン指令を検証し、制御器インタフェース組立（CIA）を通じて担当するSSMEの制御器へ送る。エンジン制御器は全エンジンデータを車両データ表にまとめてEIUへ送り、EIUはGPCが要求するまで主・副のデータをバッファに保持する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;startArrow=block;startFill=1;startSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="p50-L_dat" source="p50-B-DPS50" target="p50-B-CTL">
            <mxGeometry relative="1" as="geometry" x="-0.5">
              <Array as="points">
                <mxPoint x="360" y="1120" />
                <mxPoint x="360" y="1030" />
              </Array>
            </mxGeometry>
          </mxCell>
        </UserObject>
        <UserObject label="IF-APU-09&lt;br&gt;SSME・TVC" id="p50-IF-APU-09" link="docs/SSD-FD-APU-HYD-001.html#IF-APU-09" tooltip="IF-APU-09：3系統の油圧を、パネルR4のMPS/TVC ISOL VLVスイッチで開閉する隔離弁を経て、各SSMEの油圧作動弁5個の作動と推力方向制御（TVC）のために供給する。各SSMEのサーボアクチュエータは3系統のうち2系統（主・待機）から油圧を受け、各アクチュエータの切替弁が1系統を選ぶ。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B3FA0;strokeWidth=2;fontColor=#7B3FA0;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="p50-L_hyd" source="p50-B-APU50" target="p50-B-TVC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-16&lt;br&gt;SSMEジンバル" id="p50-IF-GNC-16" link="docs/SSD-FD-GNC-ACT-001.html#IF-GNC-16" tooltip="IF-GNC-16：ATVCの4チャネルは各指令に相当するアナログ電圧を作り、SSMEの油圧作動器の4つのサーボ弁へ送ってノズルをジンバルさせる。各SSMEはピッチとヨーの作動器を1基ずつ持つ。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.225;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="p50-L_dat" source="p50-B-GNC50" target="p50-B-TVC">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="IF-GNC-17&lt;br&gt;スロットル" id="p50-IF-GNC-17" link="docs/SSD-FD-GNC-GNS-001.html#IF-GNC-17" tooltip="IF-GNC-17：第1段の誘導は、姿勢の指令に加えて、事前に定めたスロットル計画に従ってMPSのスロットルへ指令を送る。第2段では、誘導が主エンジンのスロットル指令を3 gを超えないように調整する。">
          <mxCell style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1F5FAD;strokeWidth=2;fontColor=#1F5FAD;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;endSize=7;fontFamily=Helvetica;exitX=1;exitY=0.8125;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="p50-L_dat" source="p50-B-GNC50" target="p50-B-CTL">
            <mxGeometry relative="1" as="geometry" x="0" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;図示を省略したIF（文書・図5に記載）&lt;/b&gt;&lt;br&gt;MPS-21・MPS-22&lt;br&gt;&lt;br&gt;他の図・段と同じ物理IFのため、その番号のまま描いたIF：IF-DPS-05（図48）・IF-APU-09（図56）・IF-GNC-16（図46）・IF-GNC-17（図46）&lt;br&gt;&lt;br&gt;各ブロックの「関連文書」ボタンは、機能別関連文書一覧（SSD-MPS-REF-001）の該当節を開きます。" id="p50-v-38" link="data:page/id,p5-register" tooltip="図5のIF一覧へ">
          <mxCell style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#FAFBFC;strokeColor=#9AA3AE;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#3B4654;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1175" y="1250" width="310" height="170" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="▲ 図2 オービタへ" id="p50-v-39" link="data:page/id,p2-orbiter" tooltip="クリックでページ移動">
          <mxCell style="rounded=1;arcSize=25;html=1;fillColor=#15202B;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1540" y="40" width="300" height="32" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="■ 図51 MPS 関連文書マトリクスへ" id="p50-v-40" link="data:page/id,p51-mps-docs" tooltip="クリックでページ移動">
          <mxCell style="rounded=1;arcSize=25;html=1;fillColor=#15202B;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1540" y="84" width="300" height="32" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="■ 図5 一覧へ" id="p50-v-41" link="data:page/id,p5-register" tooltip="クリックでページ移動">
          <mxCell style="rounded=1;arcSize=25;html=1;fillColor=#15202B;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
            <mxGeometry x="1540" y="128" width="300" height="32" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="p50-v-42" value="" style="rounded=0;html=1;fillColor=#FAFBFC;strokeColor=#9AA3AE;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="340" y="1250" width="820" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p50-v-43" value="凡例" style="text;html=1;fontSize=13;fontStyle=1;align=left;fontFamily=Helvetica;" vertex="1" parent="1">
