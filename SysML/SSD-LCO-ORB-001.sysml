        part <'LWR-016'> lwr_016 : WeatherRule { doc /* WEA-01 1.4.A.2.b */ :>> clause = "1.4.A.2.b"; :>> limitValues = "5 NM"; :>> ruleText = "There is at least one working field mill within 5 NM of each such lightning flash; -and-"; :>> sourcePage = 86; }
        part <'LWR-017'> lwr_017 : WeatherRule { doc /* WEA-01 1.4.A.2.c */ :>> clause = "1.4.A.2.c"; :>> limitValues = "5 NM・1000 V/m・15 分"; :>> ruleText = "The absolute values of all electric field measurements at the surface, within 5 NM of the flight path and at the mill(s) specified in subparagraph 1.4.A.2.b, have been less than 1000 Volts/meter (V/m)"; :>> sourcePage = 86; }
        part <'LWR-018'> lwr_018 : WeatherRule { doc /* WEA-01 1.4.A.2.c (注ii) */ :>> clause = "1.4.A.2.c (注ii)"; :>> limitValues = "30 分"; :>> ruleText = "If a cumulus cloud remains 30 minutes after the last lightning occurs in a thunderstorm, then section 1.4.B. applies. Definitions: Anvil, Electric Field Measurement at the Surface, Flight Path, Thunde"; :>> sourcePage = 86; }
        part <'LWR-019'> lwr_019 : WeatherRule { doc /* WEA-01 1.4.B.1 */ :>> clause = "1.4.B.1"; :>> limitValues = "10 NM・-20 °C"; :>> ruleText = "Do not launch if the flight path will carry the SSV within 10 NM of any cumulus cloud with its cloud top higher than the -20 degrees Celsius (C) level."; :>> sourcePage = 86; }
        part <'LWR-020'> lwr_020 : WeatherRule { doc /* WEA-01 1.4.B.2 */ :>> clause = "1.4.B.2"; :>> limitValues = "5 NM・-10 °C"; :>> ruleText = "Do not launch if the flight path will carry the SSV within 5 NM of any cumulus cloud with its cloud top higher than the -10 degrees C level."; :>> sourcePage = 86; }
        part <'LWR-021'> lwr_021 : WeatherRule { doc /* WEA-01 1.4.B.3 */ :>> clause = "1.4.B.3"; :>> limitValues = "-5 °C"; :>> ruleText = "Do not launch if the flight path will carry the SSV through any cumulus cloud with its cloud top higher than the -5 degrees C level."; :>> sourcePage = 86; }
        part <'LWR-022'> lwr_022 : WeatherRule { doc /* WEA-01 1.4.B.4 */ :>> clause = "1.4.B.4"; :>> limitValues = "5 °C・-5 °C"; :>> ruleText = "Do not launch if the flight path will carry the SSV through any cumulus cloud with its cloud top between the +5 degrees C and -5 degrees C levels unless:"; :>> sourcePage = 86; }
        part <'LWR-023'> lwr_023 : WeatherRule { doc /* WEA-01 1.4.B.4.b */ :>> clause = "1.4.B.4.b"; :>> limitValues = "2 NM"; :>> ruleText = "The horizontal distance from the center of the cloud top to at least one working field mill is less than 2 NM; -and-"; :>> sourcePage = 86; }
        part <'LWR-024'> lwr_024 : WeatherRule { doc /* WEA-01 1.4.B.4.c */ :>> clause = "1.4.B.4.c"; :>> limitValues = "5 NM"; :>> ruleText = "All electric field measurements at the surface within 5 NM of the flight path and at the mill(s) specified in subparagraph"; :>> sourcePage = 87; }
        part <'LWR-025'> lwr_025 : WeatherRule { doc /* WEA-01 1.4 */ :>> clause = "1.4"; :>> limitValues = "-100 V/m・500 V/m・15 分"; :>> ruleText = ".B.4.b. above have been between -100 V/m and +500 V/m for 15 minutes. Note: Cumulus clouds in section 1.4.B. do not include altocumulus, cirrocumulus or stratocumulus. Definitions: Cloud Top, Electric"; :>> sourcePage = 87; }
        part <'LWR-026'> lwr_026 : WeatherRule { doc /* WEA-01 1.4.C.1.a */ :>> clause = "1.4.C.1.a"; :>> limitValues = "10 NM・30 分"; :>> ruleText = "Do not launch if the flight path will carry the SSV through or within 10 NM of a nontransparent part of any attached anvil cloud for the first 30 minutes after the last lightning discharge in or from "; :>> sourcePage = 87; }
        part <'LWR-027'> lwr_027 : WeatherRule { doc /* WEA-01 1.4.C.1.b */ :>> clause = "1.4.C.1.b"; :>> limitValues = "5 NM・30 分"; :>> ruleText = "Do not launch if the flight path will carry the SSV through or within 5 NM of a nontransparent part of any attached anvil cloud between 30 minutes and three hours after the last lightning discharge in"; :>> sourcePage = 87; }
        part <'LWR-028'> lwr_028 : WeatherRule { doc /* WEA-01 1.4.C.1.b)1 */ :>> clause = "1.4.C.1.b)1"; :>> limitValues = "5 NM・0 °C"; :>> ruleText = "The portion of the attached anvil cloud within 5 NM of the flight path is located entirely at altitudes where the temperature is colder than 0 degrees C; -and-"; :>> sourcePage = 87; }
        part <'LWR-029'> lwr_029 : WeatherRule { doc /* WEA-01 1.4.C.1.b)2 */ :>> clause = "1.4.C.1.b)2"; :>> limitValues = "10 dBZ"; :>> ruleText = "The VAHIRR is less than +33 Range Corrected Reflectivity (dBZ)-thousand feet(kft) (+10 dBZ-kilometers (km)) everywhere along the portion of the flight path where any part of the attached anvil cloud i"; :>> sourcePage = 87; }
        part <'LWR-030'> lwr_030 : WeatherRule { doc /* WEA-01 1.4.C.1.c */ :>> clause = "1.4.C.1.c"; :>> limitValues = "3 時間"; :>> ruleText = "Do not launch if the flight path will carry the SSV through a nontransparent part of any attached anvil cloud more than 3 hours after the last lightning discharge in or from the parent cloud or anvil "; :>> sourcePage = 87; }
        part <'LWR-031'> lwr_031 : WeatherRule { doc /* WEA-01 1.4.C.1.c)1 */ :>> clause = "1.4.C.1.c)1"; :>> limitValues = "5 NM・0 °C"; :>> ruleText = "The portion of the attached anvil cloud within 5 NM miles of the flight path is located entirely at altitudes where the temperature is colder than 0 degrees C; -and-"; :>> sourcePage = 87; }
        part <'LWR-032'> lwr_032 : WeatherRule { doc /* WEA-01 1.4.C.1.c)2 */ :>> clause = "1.4.C.1.c)2"; :>> limitValues = "33 dBZ-kft・10 dBZ-km"; :>> ruleText = "The VAHIRR is less than +33 dBZ-kft (+10 dBZ-km) everywhere along the portion of the flight path where any part of the attached anvil cloud is within the specified volume."; :>> sourcePage = 87; }
        part <'LWR-033'> lwr_033 : WeatherRule { doc /* WEA-01 1.4.C.2.a */ :>> clause = "1.4.C.2.a"; :>> limitValues = "10 NM・30 分"; :>> ruleText = "Do not launch if the flight path will carry the SSV through or within 10 NM of a nontransparent part of a detached anvil cloud for the first 30 minutes after the last lightning discharge in or from th"; :>> sourcePage = 88; }
