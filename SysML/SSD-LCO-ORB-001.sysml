        part <'LWR-012'> lwr_012 : WeatherRule { doc /* WEA-01 1.3 */ :>> clause = "1.3"; :>> limitValues = "60 ft"; :>> ruleText = "Surface Wind Limits. Surface wind limits for launch (Measured at 60 feet above natural grade). Surface wind criteria are specified in LCC GSE-24."; :>> sourcePage = 85; }
        part <'LWR-013'> lwr_013 : WeatherRule { doc /* WEA-01 1.4.A.1 */ :>> clause = "1.4.A.1"; :>> limitValues = "30 分"; :>> ruleText = "Do not launch for 30 minutes after any type of lightning occurs in a thunderstorm if the flight path will carry the SSV within 10 Nautical Miles (NM) of that thunderstorm."; :>> sourcePage = 86; }
