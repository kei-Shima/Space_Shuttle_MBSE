    part lccWeather {
        doc /* LCC 本体 WEA-01 の数値つき規則（§1.1〜§1.4）。条項どうしの対応は 2010 の雷の基準とは取らない */
        part <'LWR-001'> lwr_001 : WeatherRule { doc /* WEA-01 1.1.A.1 */ :>> clause = "1.1.A.1"; :>> limitValues = "24 時間・41.3 °F"; :>> ruleText = "Propellant loading of the ET shall not be initiated if the average temperature for the 24 hours prior to tanking is below 41.3 degrees Fahrenheit (F)."; :>> sourcePage = 81; }
        part <'LWR-002'> lwr_002 : WeatherRule { doc /* WEA-01 1.1.A.2 */ :>> clause = "1.1.A.2"; :>> limitValues = "24 時間・33 °F"; :>> ruleText = "Propellant loading of the ET shall not be initiated if the temperature anytime during the 24 hours prior to tanking drops below 33 degrees F."; :>> sourcePage = 81; }
        part <'LWR-003'> lwr_003 : WeatherRule { doc /* WEA-01 1.1.B.1 */ :>> clause = "1.1.B.1"; :>> limitValues = "99 °F・30 分"; :>> ruleText = "The countdown shall not be continued nor the SSV launched if the ambient temperature during this time period exceeds 99 degrees F for more than 30 consecutive minutes."; :>> sourcePage = 82; }
        part <'LWR-004'> lwr_004 : WeatherRule { doc /* WEA-01 1.1.B.2 */ :>> clause = "1.1.B.2"; :>> limitValues = "30 分・64 %"; :>> ruleText = "The SSV shall not be launched if the ambient temperature (Tamb) is lower than the minimum temperature limit (Tmin) (Table 1.1A), for more than 30 consecutive minutes unless the Preplanned Contingency "; :>> sourcePage = 82; }
        part <'LWR-005'> lwr_005 : WeatherRule { doc /* WEA-01 1.1.B.2 表1.1A 風速 0-1 kt */ :>> clause = "1.1.B.2 表1.1A 風速 0-1 kt"; :>> limitValues = "48 °F・47 °F・46 °F・45 °F・44 °F"; :>> ruleText = "最低外気温（°F）。相対湿度 0-64%・65-74%・75-79%・80-89%・90-100% の順に 48・47・46・45・44"; :>> sourcePage = 82; }
        part <'LWR-006'> lwr_006 : WeatherRule { doc /* WEA-01 1.1.B.2 表1.1A 風速 2 kt */ :>> clause = "1.1.B.2 表1.1A 風速 2 kt"; :>> limitValues = "47 °F・46 °F・45 °F・44 °F・43 °F"; :>> ruleText = "最低外気温（°F）。相対湿度 0-64%・65-74%・75-79%・80-89%・90-100% の順に 47・46・45・44・43"; :>> sourcePage = 82; }
        part <'LWR-007'> lwr_007 : WeatherRule { doc /* WEA-01 1.1.B.2 表1.1A 風速 3 kt */ :>> clause = "1.1.B.2 表1.1A 風速 3 kt"; :>> limitValues = "41 °F・40 °F・39 °F"; :>> ruleText = "最低外気温（°F）。相対湿度 0-64%・65-74%・75-79%・80-89%・90-100% の順に 41・41・41・40・39"; :>> sourcePage = 82; }
        part <'LWR-008'> lwr_008 : WeatherRule { doc /* WEA-01 1.1.B.2 表1.1A 風速 4 kt */ :>> clause = "1.1.B.2 表1.1A 風速 4 kt"; :>> limitValues = "39 °F・38 °F"; :>> ruleText = "最低外気温（°F）。相対湿度 0-64%・65-74%・75-79%・80-89%・90-100% の順に 39・39・39・39・38"; :>> sourcePage = 82; }
        part <'LWR-009'> lwr_009 : WeatherRule { doc /* WEA-01 1.1.B.2 表1.1A 風速 5-7 kt */ :>> clause = "1.1.B.2 表1.1A 風速 5-7 kt"; :>> limitValues = "38 °F"; :>> ruleText = "最低外気温（°F）。相対湿度 0-64%・65-74%・75-79%・80-89%・90-100% の順に 38・38・38・38・38"; :>> sourcePage = 82; }
