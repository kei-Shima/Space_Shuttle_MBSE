package SSD_LCO_ORB_001 {
    doc /* SSD-LCO-ORB-001 LCC 原典定義書（NSTS 16007 Rev H の項目の索引と天候の規則）。LCC 本体（NSTS 16007 Rev H）の SSID を節（LccSection）の中の項目（LccItem）として持ち、境界は isCounted = false の項目で持つ。WEA-01 の数値つき規則を WeatherRule として持つ。Mission Report の LCC 違反の記録との結び 25件を LccJoin として持つ（結び直しはしない。測定値は持たない）。要求への関係は張らず、トレースの外に置く。 */
    private import ScalarValues::*;
    part def LccSection {
        doc /* LCC 本体の節（目次の節の番号・SSID の接頭辞）。目次に接頭辞が無い付録の SSID は節の番号を持たない */
        attribute sectionNo : String;
        attribute sectionTitle : String;
        attribute ssidPrefix : String;
    }
    part def LccItem {
        doc /* LCC 本体の SSID（項目）。題は LCC VIOLATION CALL の行（無ければ空）。適用範囲は頁の MISSION の行のとおり。測定値は持たない */
        attribute ssid : String;
        attribute title : String;
        attribute effectivity : String;
        attribute changeNo : String;
        attribute measurementCount : Integer;
        attribute numericLimitCount : Integer;
        attribute sourcePage : Integer;
        attribute isCounted : Boolean;
    }
    part def WeatherRule {
        doc /* LCC 本体 WEA-01（Change 056）の数値つき規則。条項は本文の番号どおり。数・単位は本文のまま */
        attribute clause : String;
        attribute limitValues : String;
        attribute ruleText : String;
        attribute sourcePage : Integer;
    }
