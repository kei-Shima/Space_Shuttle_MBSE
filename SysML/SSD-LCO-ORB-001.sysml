        part <'LWR-037'> lwr_037 : WeatherRule { doc /* WEA-01 1.4 */ :>> clause = "1.4"; :>> limitValues = "1000 V/m・15 分"; :>> ruleText = ".C.2.b.1)a) have been less than 1000 V/m for 15 minutes; -and-"; :>> sourcePage = 88; }
