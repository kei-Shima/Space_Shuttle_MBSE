        part <'LWR-039'> lwr_039 : WeatherRule { doc /* WEA-01 1.4)2)a */ :>> clause = "1.4)2)a"; :>> limitValues = "5 NM・0 °C"; :>> ruleText = "The portion of the detached anvil cloud within 5 NM of the flight path is located entirely at altitudes where the temperature is colder than 0 degrees C; -and-"; :>> sourcePage = 88; }
        part <'LWR-040'> lwr_040 : WeatherRule { doc /* WEA-01 1.4)2)b */ :>> clause = "1.4)2)b"; :>> limitValues = "33 dBZ-kft・10 dBZ-km"; :>> ruleText = "The VAHIRR is less than +33 dBZ-kft (+10 dBZ-km) everywhere along the portion of the flight path where any part of the detached anvil cloud is within the specified volume."; :>> sourcePage = 88; }
        part <'LWR-041'> lwr_041 : WeatherRule { doc /* WEA-01 1.4.c)1)a */ :>> clause = "1.4.c)1)a"; :>> limitValues = "4 時間"; :>> ruleText = "At least 4 hours have passed since the last lightning discharge in or from the detached anvil cloud; -and-"; :>> sourcePage = 89; }
        part <'LWR-042'> lwr_042 : WeatherRule { doc /* WEA-01 1.4.c)1)b */ :>> clause = "1.4.c)1)b"; :>> limitValues = "3 時間"; :>> ruleText = "At least 3 hours have passed since the time that the anvil cloud is observed to be detached from the parent cloud."; :>> sourcePage = 89; }
        part <'LWR-043'> lwr_043 : WeatherRule { doc /* WEA-01 1.4.c)2)a */ :>> clause = "1.4.c)2)a"; :>> limitValues = "5 NM・0 °C"; :>> ruleText = "The portion of the detached anvil cloud within 5 nautical miles of the flight path is located entirely at altitudes where the temperature is colder than 0 degrees C; -and-"; :>> sourcePage = 89; }
        part <'LWR-044'> lwr_044 : WeatherRule { doc /* WEA-01 1.4.c)2)b */ :>> clause = "1.4.c)2)b"; :>> limitValues = "33 dBZ-kft・10 dBZ-km"; :>> ruleText = "The Volume-Averaged, Height-Integrated Radar Reflectivity (VAHIRR) is less than +33 dBZ-kft (+10 dBZ-km) everywhere along the portion of the flight path where any part of the detached anvil cloud is w"; :>> sourcePage = 89; }
        part <'LWR-045'> lwr_045 : WeatherRule { doc /* WEA-01 1.4.D.1 */ :>> clause = "1.4.D.1"; :>> limitValues = "3 時間"; :>> ruleText = "Do not launch if the flight path will carry the SSV through any nontransparent parts of a debris cloud during the 3 hour period defined below."; :>> sourcePage = 89; }
        part <'LWR-046'> lwr_046 : WeatherRule { doc /* WEA-01 1.4.D.2 */ :>> clause = "1.4.D.2"; :>> limitValues = "5 NM・3 時間"; :>> ruleText = "Do not launch if the flight path will carry the vehicle within 5 NM of any nontransparent parts of a debris cloud during the 3 hour period defined below, unless:"; :>> sourcePage = 89; }
        part <'LWR-047'> lwr_047 : WeatherRule { doc /* WEA-01 1.4.D.2.a */ :>> clause = "1.4.D.2.a"; :>> limitValues = "5 NM"; :>> ruleText = "There is at least one working field mill within 5 NM of the debris cloud; -and-"; :>> sourcePage = 89; }
        part <'LWR-048'> lwr_048 : WeatherRule { doc /* WEA-01 1.4.D.2.b */ :>> clause = "1.4.D.2.b"; :>> limitValues = "5 NM・1000 V/m・15 分"; :>> ruleText = "The absolute values of all electric field measurements at the surface within 5 NM of the flight path and at the mill(s) specified in section 1.4.D.2.a. have been less than 1000 V/m for 15 minutes; -an"; :>> sourcePage = 90; }
        part <'LWR-049'> lwr_049 : WeatherRule { doc /* WEA-01 1.4.D.2.c */ :>> clause = "1.4.D.2.c"; :>> limitValues = "5 NM・10 dBZ・15 分・3 時間・-10 °C"; :>> ruleText = "The maximum radar return from any part of the debris cloud within 5 NM of the flight path has been less than 10 dBZ for 15 minutes. The 3 hour period in subparagraphs 1.4.D.2.a. and 1.4.D.2.b. begins "; :>> sourcePage = 90; }
        part <'LWR-050'> lwr_050 : WeatherRule { doc /* WEA-01 1.4.E */ :>> clause = "1.4.E"; :>> limitValues = "0 °C・5 NM"; :>> ruleText = "Disturbed Weather Do not launch if the flight path will carry the vehicle through any nontransparent clouds that are associated with a weather disturbance having clouds that extend to altitudes at or "; :>> sourcePage = 90; }
        part <'LWR-051'> lwr_051 : WeatherRule { doc /* WEA-01 1.4.F.1 */ :>> clause = "1.4.F.1"; :>> limitValues = "4500 ft・0 °C・-20 °C"; :>> ruleText = "Greater than 4,500 foot thick and any part of the cloud layer along flight path is located between the 0 degrees C and the -20 degrees C levels; -or-"; :>> sourcePage = 90; }
        part <'LWR-052'> lwr_052 : WeatherRule { doc /* WEA-01 1.4.F.2 */ :>> clause = "1.4.F.2"; :>> limitValues = "5 NM・4500 ft・0 °C・-20 °C・-15 °C"; :>> ruleText = "Connected to a cloud layer that, within 5 NM of the flight path, is greater than 4,500 foot thick and has any part located between the 0 degrees C and the -20 degrees C levels; unless the cloud layer "; :>> sourcePage = 90; }
        part <'LWR-053'> lwr_053 : WeatherRule { doc /* WEA-01 1.4.G */ :>> clause = "1.4.G"; :>> limitValues = "60 分"; :>> ruleText = "Smoke Plumes Do not launch if the flight path will carry the SSV through any cumulus cloud that has developed from a smoke plume while the cloud is attached to the smoke plume, or for the first 60 min"; :>> sourcePage = 91; }
        part <'LWR-054'> lwr_054 : WeatherRule { doc /* WEA-01 1.4.H.1 */ :>> clause = "1.4.H.1"; :>> limitValues = "15 分・5 NM・1500 V/m"; :>> ruleText = "Do not launch for 15 minutes after the absolute value of any electric field measurement at the surface within 5 NM of the flight path has been greater than 1500 V/m."; :>> sourcePage = 91; }
        part <'LWR-055'> lwr_055 : WeatherRule { doc /* WEA-01 1.4.H.2 */ :>> clause = "1.4.H.2"; :>> limitValues = "15 分・5 NM・1000 V/m"; :>> ruleText = "Do not launch for 15 minutes after the absolute value of any electric field measurement at the surface within 5 NM of the flight path has been greater than 1000 V/m unless:"; :>> sourcePage = 91; }
        part <'LWR-056'> lwr_056 : WeatherRule { doc /* WEA-01 1.4.H.2.a */ :>> clause = "1.4.H.2.a"; :>> limitValues = "10 NM"; :>> ruleText = "All clouds within 10 NM of the flight path are transparent; -or-"; :>> sourcePage = 91; }
        part <'LWR-057'> lwr_057 : WeatherRule { doc /* WEA-01 1.4.H.2.b */ :>> clause = "1.4.H.2.b"; :>> limitValues = "10 NM・5 °C・-10 °C・3 時間"; :>> ruleText = "All nontransparent clouds within 10 NM of the flight path have cloud tops below the +5 degrees C level and have not been part of convective clouds with cloud tops above the -10 degrees C level within "; :>> sourcePage = 91; }
    }
    part def LccJoin {
        doc /* Mission Report の LCC 違反の記録（SSD-LCC-ORB-001）1件と LCC 本体の SSID の結び。結べた 25件だけ（結び直しはしない）。測定値は持たない。effectivity は MISSION 欄の字面との照合 */
        attribute ddRecord : String;
        attribute flight : String;
        attribute ssid : String;
        attribute joinKey : String;
        attribute missionText : String;
        attribute effectivity : String;
        attribute limitNumberCheck : String;
    }
    part lccJoins {
        part join_lcc_002 : LccJoin { doc /* LCC-002 → ECL-04 */ :>> ddRecord = "LCC-002"; :>> flight = "STS-1"; :>> ssid = "ECL-04"; :>> joinKey = "K2"; :>> missionText = "119,120,122-999"; :>> effectivity = "Rev H 適用外"; :>> limitNumberCheck = "—"; }
